@using OpCentrix.Models
@model OpCentrix.ViewModels.Scheduler.AddEditJobViewModel

<!-- Add/Edit Job Modal (logic embedded in scheduler-ui.js) -->
<div class="modal-backdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;">
  <div class="opcentrix-card" style="width:100%;max-width:60rem;max-height:95vh;overflow-y:auto;background:#fff;border-radius:14px;box-shadow:0 25px 40px -10px rgba(0,0,0,.4);" onclick="event.stopPropagation()">
    <form hx-post="/Scheduler?handler=AddOrUpdateJob" hx-target="#modal-container" hx-swap="innerHTML" id="job-form" novalidate>
      @Html.AntiForgeryToken()
      <input type="hidden" name="Id" value="@Model.Job.Id" />
      <input type="hidden" name="StackLevel" id="hidden-stack-level" value="@(Model.Job.StackLevel?.ToString() ?? "")" />
      <input type="hidden" name="PartsPerBuild" id="hidden-parts-per-build" value="@(Model.Job.PartsPerBuild?.ToString() ?? "")" />
      <input type="hidden" name="PlannedStackDurationHours" id="hidden-stack-duration" value="@(Model.Job.PlannedStackDurationHours?.ToString("F2") ?? "")" />
      <input type="hidden" name="PartId" id="hidden-part-id" value="@Model.Job.PartId" />
      <input type="hidden" name="SuggestedStackLevel" id="hidden-suggested-stack-level" value="" />
      <input type="hidden" name="PartNumber" id="hidden-part-number" value="@Model.Job.PartNumber" />
      
      <header style="padding:1.25rem 1.75rem;border-bottom:1px solid #e5e7eb;background:linear-gradient(90deg,#f8fafc,#eef2ff);display:flex;justify-content:space-between;align-items:center;">
        <div>
          <h2 style="margin:0;font-size:1.35rem;font-weight:700;color:#1f2937;">@(Model.Job.Id==0?"Schedule Job":"Edit Job #"+Model.Job.Id)</h2>
          <p style="margin:.35rem 0 0;font-size:.75rem;color:#64748b;">Master part stacking enabled for SLS jobs</p>
        </div>
        <button type="button" onclick="closeJobModal()" style="background:#f1f5f9;border:none;border-radius:8px;padding:.6rem .8rem;cursor:pointer;color:#475569;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">✕</button>
      </header>

      @if(Model.Errors?.Any()==true){
        <div style="margin:1rem 1.75rem 0;padding:.9rem 1rem;border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;border-radius:8px;font-size:.75rem;">
          <strong>Validation Issues:</strong>
          <ul style="margin:.5rem 0 0;padding-left:1.1rem;">
            @foreach(var e in Model.Errors){<li>@e</li>}
          </ul>
        </div>
      }

      <section style="padding:1.5rem 1.75rem;display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
        <div>
          <label class="oc-label">Machine *</label>
          <select name="MachineId" id="machine-select" class="oc-input" required>
            <option value="">Select machine...</option>
            @foreach(var m in Model.Machines){
              <option value="@m.MachineId" selected="@(Model.Job.MachineId==m.MachineId)">@m.MachineId - @m.MachineName</option>
            }
          </select>

          <div style="margin-top:1rem;">
            <label class="oc-label">Master Part *</label>
            <select id="masterpart-select" name="MasterPartId" class="oc-input" required>
              <option value="">Select master part...</option>
              @foreach(var mp in Model.MasterParts.OrderBy(p=>p.PartNumber)){
                  var legacyMatch = Model.Parts.FirstOrDefault(p=>p.PartNumber==mp.PartNumber);
                  var singleHours = mp.SingleStackDurationHours ?? mp.StageEstimateSingle ?? 0;
                  var isSelected = Model.Job.MasterPartId == mp.Id;
                  <option value="@mp.Id" 
                          selected="@isSelected"
                          data-part-number="@mp.PartNumber" 
                          data-legacy-id="@(legacyMatch?.Id.ToString() ?? "")" 
                          data-single-hours="@(singleHours.ToString("F2"))" 
                          data-double-hours="@(mp.DoubleStackDurationHours?.ToString("F2")??"")" 
                          data-triple-hours="@(mp.TripleStackDurationHours?.ToString("F2")??"")" 
                          data-stage-single="@(mp.StageEstimateSingle?.ToString("F2") ?? "")" 
                          data-allow-stacking="@mp.AllowStacking.ToString().ToLower()" 
                          data-enable-double="@mp.EnableDoubleStack.ToString().ToLower()" 
                          data-enable-triple="@mp.EnableTripleStack.ToString().ToLower()" 
                          data-max-stack="@mp.MaxStackCount" 
                          data-parts-single="@mp.PartsPerBuildSingle" 
                          data-parts-double="@(mp.PartsPerBuildDouble?.ToString()??"")" 
                          data-parts-triple="@(mp.PartsPerBuildTriple?.ToString()??"")">
                    @mp.PartNumber - @mp.Name
                  </option>
              }
            </select>
            <small style="font-size:.6rem;color:#64748b;">Scheduler now requires master parts. Legacy part field removed.</small>
          </div>

          <div id="stacking-section" style="display:none;margin-top:1rem;border:1px dashed #cbd5e1;border-radius:10px;padding:.75rem .85rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;">
              <span style="font-size:.7rem;font-weight:600;color:#334155;letter-spacing:.5px;">STACKING</span>
              <span id="stack-recommend" style="font-size:.6rem;color:#6366f1;font-weight:600;"></span>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
              <button type="button" class="stack-chip" data-level="1">1x <span class="h" data-h="single">--</span></button>
              <button type="button" class="stack-chip" data-level="2" disabled>2x <span class="h" data-h="double">--</span></button>
              <button type="button" class="stack-chip" data-level="3" disabled>3x <span class="h" data-h="triple">--</span></button>
            </div>
            <div id="stack-override-banner" style="display:none;margin-top:.5rem;font-size:.6rem;font-weight:600;color:#b45309;background:#fffbeb;border:1px solid #fcd34d;padding:.35rem .55rem;border-radius:6px;">Override applied – admin changed recommended stack.</div>
            <small style="display:block;margin-top:.4rem;font-size:.6rem;color:#64748b;">Selecting a stack updates duration and end time automatically.</small>
            <div id="stack-summary" style="display:none;margin-top:.55rem;font-size:.6rem;font-weight:600;color:#334155;background:#f1f5f9;border:1px solid #e2e8f0;padding:.4rem .55rem;border-radius:6px;">
              <span>Level: <span id="stack-summary-level">-</span></span>
              <span style="margin-left:.75rem;">Parts/Build: <span id="stack-summary-ppb">-</span></span>
              <span style="margin-left:.75rem;">Total Units: <span id="stack-summary-total">-</span></span>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-top:1rem;">
            <div>
              <label class="oc-label">Quantity *</label>
              <input type="number" name="Quantity" class="oc-input" value="@Model.Job.Quantity" min="1" required />
            </div>
            <div>
              <label class="oc-label">Priority</label>
              <select name="Priority" class="oc-input">
                @for(int i=1;i<=5;i++){
                  <option value="@i" selected="@(Model.Job.Priority==i)">@i</option>
                }
              </select>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-top:1rem;">
            <div>
              <label class="oc-label">Start *</label>
              <input type="datetime-local" name="ScheduledStart" id="start-input" value="@Model.Job.ScheduledStart.ToString("yyyy-MM-ddTHH:mm")" class="oc-input" required />
            </div>
            <div>
              <label class="oc-label">End *</label>
              <input type="datetime-local" name="ScheduledEnd" id="end-input" value="@Model.Job.ScheduledEnd.ToString("yyyy-MM-ddTHH:mm")" class="oc-input" required />
              <small style="font-size:.6rem;color:#64748b;">Duration: <span id="duration-display">@((Model.Job.ScheduledEnd-Model.Job.ScheduledStart).TotalHours.ToString("F1")) h</span></small>
            </div>
          </div>

          <div style="margin-top:1rem;">
            <label class="oc-label">Notes</label>
            <textarea name="Notes" rows="3" class="oc-input">@Model.Job.Notes</textarea>
          </div>
        </div>

        <div>
          <div id="sls-params" class="machine-panel" style="display:none;">
            <h4 class="panel-title">SLS Parameters</h4>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;">
              <div><label class="oc-label">Material *</label>
                <select name="SlsMaterial" class="oc-input">
                  <option value="Ti-6Al-4V Grade 5" selected="@(Model.Job.SlsMaterial=="Ti-6Al-4V Grade 5")">Ti-6Al-4V Grade 5</option>
                  <option value="Ti-6Al-4V ELI Grade 23" selected="@(Model.Job.SlsMaterial=="Ti-6Al-4V ELI Grade 23")">Ti-6Al-4V ELI Grade 23</option>
                  <option value="Inconel 718" selected="@(Model.Job.SlsMaterial=="Inconel 718")">Inconel 718</option>
                  <option value="Inconel 625" selected="@(Model.Job.SlsMaterial=="Inconel 625")">Inconel 625</option>
                </select>
              </div>
              <div><label class="oc-label">Powder (kg)</label><input type="number" step="0.01" min="0" name="EstimatedPowderUsageKg" class="oc-input" value="@Model.Job.EstimatedPowderUsageKg.ToString("F2")" /></div>
              <div><label class="oc-label">Laser (W)</label><input type="number" name="LaserPowerWatts" class="oc-input" value="@Model.Job.LaserPowerWatts" min="50" max="400" /></div>
              <div><label class="oc-label">Scan (mm/s)</label><input type="number" name="ScanSpeedMmPerSec" class="oc-input" value="@Model.Job.ScanSpeedMmPerSec" /></div>
              <div><label class="oc-label">Layer (µm)</label><input type="number" name="LayerThicknessMicrons" class="oc-input" value="@Model.Job.LayerThicknessMicrons" /></div>
              <div><label class="oc-label">Hatch (µm)</label><input type="number" name="HatchSpacingMicrons" class="oc-input" value="@Model.Job.HatchSpacingMicrons" /></div>
              <div><label class="oc-label">Build Temp (°C)</label><input type="number" name="BuildTemperatureCelsius" class="oc-input" value="@Model.Job.BuildTemperatureCelsius" /></div>
            </div>
          </div>

          <div id="cnc-params" class="machine-panel" style="display:none;">
            <h4 class="panel-title">CNC Parameters</h4>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;">
              <div><label class="oc-label">Tool Set</label><input type="text" name="Notes" placeholder="Tool list / program" class="oc-input" /></div>
              <div><label class="oc-label">Program ID</label><input type="text" name="CustomerOrderNumber" placeholder="PRG-###" class="oc-input" /></div>
              <div style="grid-column:1 / span 2;"><small style="font-size:.6rem;color:#64748b;">CNC specifics placeholder – extend later.</small></div>
            </div>
          </div>

          <div style="margin-top:1rem;display:flex;gap:.75rem;align-items:center;">
            <label style="display:flex;align-items:center;gap:.35rem;font-size:.7rem;font-weight:600;color:#334155;">
              <input type="checkbox" name="IsRushJob" value="true" checked="@Model.Job.IsRushJob" /> Rush
            </label>
            <label style="display:flex;align-items:center;gap:.35rem;font-size:.7rem;font-weight:600;color:#334155;">
              <input type="checkbox" name="RequiresPreheating" value="true" checked disabled /> Preheat
            </label>
          </div>
        </div>
      </section>

      <footer style="padding:1rem 1.75rem;border-top:1px solid #e5e7eb;display:flex;justify-content:space-between;background:#f8fafc;align-items:center;">
        <div style="display:flex;flex-direction:column;gap:.35rem;">
          <div style="font-size:.65rem;color:#64748b;">Stack levels drive duration and resource planning. System recommends optimal level based on shift timing.</div>
          @if(Model.Job.Id > 0){
            <div>
              <button type="button"
                      class="oc-btn-danger"
                      hx-post="/Scheduler?handler=DeleteJob&id=@Model.Job.Id"
                      hx-target="#modal-container"
                      hx-swap="innerHTML"
                      hx-confirm="Delete this job permanently? This cannot be undone.">
                Delete
              </button>
            </div>
          }
        </div>
        <div style="display:flex;gap:.75rem;">
          <button type="button" onclick="closeJobModal()" class="oc-btn-secondary">Cancel</button>
          <button type="submit" form="job-form" class="oc-btn-primary">@(Model.Job.Id==0?"Schedule":"Update")</button>
        </div>
      </footer>
    </form>
  </div>
</div>

<style>
.oc-label{display:block;font-size:.65rem;font-weight:600;color:#334155;margin:0 0 .25rem;letter-spacing:.5px;text-transform:uppercase;}
.oc-input{width:100%;padding:.55rem .65rem;border:1.5px solid #cbd5e1;border-radius:8px;font-size:.8rem;background:#fff;transition:.15s;border-color:#cbd5e1;}
.oc-input:focus{outline:none;border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.25);} 
.stack-chip{background:#f1f5f9;border:1px solid #cbd5e1;border-radius:9999px;padding:.35rem .7rem;font-size:.65rem;font-weight:600;color:#334155;cursor:pointer;display:flex;align-items:center;gap:.35rem;transition:.15s;position:relative;} 
.stack-chip[disabled]{opacity:.35;cursor:not-allowed;} 
.stack-chip.active{background:#6366f1;color:#fff;border-color:#6366f1;box-shadow:0 2px 6px -1px rgba(99,102,241,.5);} 
.stack-chip.recommended:not(.active){border-color:#6366f1;background:#eef2ff;color:#3730a3;} 
.stack-chip.recommended:not(.active)::after{content:'★';font-size:.55rem;color:#6366f1;position:absolute;top:-4px;right:-4px;background:#fff;border:1px solid #6366f1;border-radius:50%;padding:2px;}
.panel-title{margin:.25rem 0 .75rem;font-size:.7rem;font-weight:700;color:#334155;letter-spacing:.6px;text-transform:uppercase;} 
.oc-btn-primary{background:#2563eb;color:#fff;border:none;padding:.55rem 1.1rem;font-size:.75rem;font-weight:600;border-radius:8px;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.15);} 
.oc-btn-primary:hover{background:#1d4ed8;} 
.oc-btn-secondary{background:#f1f5f9;color:#334155;border:1px solid #cbd5e1;padding:.55rem 1.1rem;font-size:.75rem;font-weight:600;border-radius:8px;cursor:pointer;} 
.oc-btn-secondary:hover{background:#e2e8f0;} 
.oc-btn-danger{background:#dc2626;color:#fff;border:none;padding:.45rem .9rem;font-size:.7rem;font-weight:600;border-radius:8px;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.15);} 
.oc-btn-danger:hover{background:#b91c1c;} 
</style>
