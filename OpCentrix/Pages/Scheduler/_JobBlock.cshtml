@model OpCentrix.Models.Job

@{
    var priorityClass = Model.Priority switch
    {
        1 => "priority-critical",
        2 => "priority-high", 
        3 => "priority-normal",
        4 => "priority-low",
        5 => "priority-lowest",
        _ => "priority-normal"
    };
    
    var rushIndicator = Model.IsRushJob ? "?" : "";
    var shortPartNumber = Model.PartNumber?.Length > 10 ? Model.PartNumber.Substring(0, 10) + "..." : Model.PartNumber;
    var isScheduled = Model.Status == "Scheduled";
    var isBuilding = Model.Status == "Building" || Model.Status == "In Progress";
    var isComplete = Model.Status == "Completed" || Model.Status == "Complete";
    var isDelayed = Model.ActualStart.HasValue && Model.ActualStart > Model.ScheduledStart.AddMinutes(15);
    var timeDisplay = isBuilding && Model.ActualStart.HasValue ? $"Started: {Model.ActualStart:HH:mm}" : $"{Model.ScheduledStart:HH:mm}-{Model.ScheduledEnd:HH:mm}";
    var slsMachines = new[]{"TI1","TI2","INC","INC1","INC2"};
    var isSlsJob = slsMachines.Contains(Model.MachineId);
}

<!-- Inline styles to avoid Razor compilation issues -->
<style>
    .delayed-job {
        outline: 2px solid #EF4444 !important;
        animation: pulse-red 2s infinite;
    }
    
    @@keyframes pulse-red {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        50% { box-shadow: 0 0 0 4px rgba(239, 68, 68, 0); }
    }
</style>

<div class="job-block-wrapper relative group" 
     data-job-id="@Model.Id"
     data-machine-id="@Model.MachineId"
     data-status="@Model.Status"
     data-machine="@Model.MachineId">
     
    <!-- Main Job Block -->
    <div class="job-block-content h-full flex flex-col justify-center p-1 @priorityClass relative overflow-hidden @(isDelayed ? "delayed-job" : "")"
         style="background:var(--machine-color,#6366F1);color:#fff"
         onclick="openJobModalSafely('@Model.MachineId', '@Model.ScheduledStart:yyyy-MM-ddTHH:mm', @Model.Id)">
        
        <div class="job-block-title font-bold text-xs leading-tight">
            @rushIndicator@shortPartNumber
        </div>
        
        <div class="job-block-details opacity-90 text-xs leading-tight mt-1">
            <div>Qty: @Model.Quantity</div>
            <div class="opacity-75">@timeDisplay</div>
        </div>
        
        @if (isBuilding)
        {
            <div class="absolute top-0 right-0 bg-amber-500 text-white text-[10px] px-1 rounded-bl animate-pulse">
                RUN
            </div>
        }
        else if (isComplete)
        {
            <div class="absolute top-0 right-0 bg-green-500 text-white text-[10px] px-1 rounded-bl">
                DONE
            </div>
        }
    </div>
</div>
