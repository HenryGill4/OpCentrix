@using OpCentrix.ViewModels.Scheduler
@model SchedulerPageViewModel
@{
    var slotsPerDay = Model.SlotsPerDay;
    var slotMinutes = Model.SlotMinutes;
    var slotTimes = Enumerable.Range(0, slotsPerDay).Select(i => TimeSpan.FromMinutes(i * slotMinutes)).ToList();
    var totalSlots = Model.Dates.Count * slotsPerDay;
    var zoom = Context.Request.Query["zoom"].FirstOrDefault() ?? "week";
    string GetColor(string m)=> Model.MachineColors != null && Model.MachineColors.TryGetValue(m, out var c) ? c : "#6366F1";
}
<style>
    .scheduler-horizontal-container .job-block { color:#fff; border-radius:6px; background:var(--machine-color,#6366F1); box-shadow:0 4px 14px -2px rgba(0,0,0,.12); }
    .scheduler-horizontal-container .scheduler-grid-cell .job-block { background:var(--machine-color,#6366F1); }
    .scheduler-horizontal-container .scheduler-time-header{z-index:60;}
    .scheduler-horizontal-container .scheduler-machine-header{z-index:61;}
    .job-qty-line{font-size:.6rem;opacity:.9;display:flex;align-items:center;gap:.35rem;margin-top:2px;}
</style>
<script>
if(typeof window.openJobModalSafely !== 'function'){
  window.openJobModalSafely = function(machineId, date, jobId){
    try {
      if(typeof window.openJobModal === 'function') return window.openJobModal(machineId,date,jobId);
      const params = new URLSearchParams({ handler:'ShowAddModal', machineId: machineId||'', date: date||'' });
      if(jobId) params.append('id', jobId);
      const url = '/Scheduler?' + params.toString();
      if(typeof htmx !== 'undefined'){
        return htmx.ajax('GET', url, { target:'#modal-container', swap:'innerHTML' }).then(()=>{
          const mc=document.getElementById('modal-container'); if(mc){ mc.style.display='flex'; mc.classList.remove('hidden'); document.body.style.overflow='hidden'; }
        });
      }
      window.location.href = url;
    } catch(err){ console.error('openJobModalSafely fallback error', err); }
    return false;
  };
}
</script>
<div class="scheduler-horizontal-container" data-zoom="@zoom" data-orientation="horizontal" data-total-slots="@totalSlots">
    <div class="scheduler-main-grid" style="display:grid; grid-template-columns: 200px repeat(@totalSlots, var(--slot-width)); min-width:fit-content;">
        <div class="scheduler-machine-header">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path></svg>
            <span>Resources</span>
        </div>
        @for (int d = 0; d < Model.Dates.Count; d++)
        {
            var date = Model.Dates[d];
            var isToday = date.Date == DateTime.Today;
            var dayOfWeek = date.ToString("ddd");
            var dayNumber = date.Day.ToString();
            for (int s = 0; s < slotsPerDay; s++)
            {
                var slotTime = slotTimes[s];
                var isFirstSlot = s == 0;
                var isHourBoundary = slotTime.Minutes == 0;
                var isHalfHour = slotTime.Minutes == 30;
                var headerClasses = new List<string> { "scheduler-time-header" };
                string timeDisplay = string.Empty;
                if (isFirstSlot)
                { headerClasses.Add("date-header"); if (isToday) { headerClasses.Add("today"); } }
                else if (isHourBoundary)
                { headerClasses.Add("hour-header"); var hour = slotTime.Hours; var displayHour = hour == 0 ? 12 : (hour > 12 ? hour - 12 : hour); var period = hour >= 12 ? "PM" : "AM"; timeDisplay = $"{displayHour}{period}"; }
                else if (isHalfHour)
                { headerClasses.Add("half-hour-header"); timeDisplay = ":30"; }
                else { headerClasses.Add("quarter-hour-header"); timeDisplay = ":" + slotTime.Minutes.ToString("00"); }
                <div class="@string.Join(" ", headerClasses)" data-date="@date.ToString("yyyy-MM-dd")" data-slot="@s">
                    @if (isFirstSlot){<div class="date-day">@dayOfWeek</div><div class="date-number">@dayNumber</div>@if (isToday){<div class="date-today">TODAY</div>;}} else { <div class="time-display">@timeDisplay</div>; }
                </div>
            }
        }
        @foreach (var machine in Model.Machines)
        {
            var color = GetColor(machine);
            var rowHeight = Model.MachineRowHeights.GetValueOrDefault(machine, 80);
            var machineJobs = Model.Jobs.Where(j => j.MachineId == machine).ToList();
            var jobCount = machineJobs.Count;
            var totalHours = machineJobs.Sum(j => j.DurationHours);
            var utilizationPercent = (totalHours / 24.0 * 100).ToString("F0");
            <div class="scheduler-machine-label" style="min-height:@(rowHeight)px; --machine-color:@color" data-machine="@machine" data-color="@color">
                <div class="machine-name flex items-center space-x-2"><span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:@color"></span><span>@machine</span></div>
                <div class="machine-stats"><div class="job-count">@jobCount job@(jobCount==1?"":"s") · @totalHours.ToString("F1")h</div><div class="utilization">@utilizationPercent% utilization</div></div>
                @{ var hasActive = machineJobs.Any(j => j.Status == "Building" || j.Status == "Running"); }
                <div class="machine-status @(hasActive ? "status-active" : "status-idle")"></div>
            </div>
            @for (int d = 0; d < Model.Dates.Count; d++)
            {
                var day = Model.Dates[d];
                for (int s = 0; s < slotsPerDay; s++)
                {
                    var slotTime = slotTimes[s];
                    var slotDateTime = day.Add(slotTime);
                    var isToday = day.Date == DateTime.Today;
                    var isCurrentTimeSlot = isToday && slotTime <= DateTime.Now.TimeOfDay && slotTime.Add(TimeSpan.FromMinutes(slotMinutes)) > DateTime.Now.TimeOfDay;
                    var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                    var isPastWorkHours = slotTime < TimeSpan.FromHours(6) || slotTime >= TimeSpan.FromHours(18);
                    var isHourBoundary = slotTime.Minutes == 0;
                    var cellClasses = new List<string>{"scheduler-grid-cell","group"};
                    if (isCurrentTimeSlot) cellClasses.Add("current-time");
                    if (isWeekend) cellClasses.Add("weekend");
                    if (isPastWorkHours) cellClasses.Add("off-hours");
                    if (isHourBoundary) cellClasses.Add("hour-boundary");
                    var slotJobs = machineJobs.Where(job => job.ScheduledStart < slotDateTime.AddMinutes(slotMinutes) && job.ScheduledEnd > slotDateTime).ToList();
                    if (slotJobs.Any()) cellClasses.Add("has-jobs");
                    var addTooltip = $"Click to add job at {slotDateTime:MMM dd, yyyy h:mm tt}";
                    <div class="@string.Join(" ", cellClasses)" style="min-height:@(rowHeight)px" onclick="openJobModalSafely('@machine','@slotDateTime.ToString("yyyy-MM-ddTHH:mm")')" title="@addTooltip" data-slot-time="@slotDateTime.ToString("yyyy-MM-ddTHH:mm")" data-machine="@machine">
                        @foreach (var job in slotJobs)
                        {
                            var startDate = Model.Dates.Count > 0 ? Model.Dates[0].Date : DateTime.Today;
                            var leftPosition = job.CalculateGridPosition(startDate, slotMinutes);
                            var widthSlots = job.CalculateGridWidth(slotMinutes);
                            var jobStartSlot = (int)Math.Floor(job.CalculateGridPosition(startDate, slotMinutes));
                            var currentSlot = d * slotsPerDay + s;
                            if (jobStartSlot == currentSlot)
                            {
                                var leftPct = (100.0 * (leftPosition - currentSlot)).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
                                var widthPct = (100.0 * widthSlots).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
                                var jobLabel = $"Job: {job.PartNumber} ({job.Status}) - {job.ScheduledStart:MMM dd HH:mm} to {job.ScheduledEnd:MMM dd HH:mm} - Qty: {job.Quantity}";
                                if(!string.IsNullOrEmpty(job.SlsMaterial)) jobLabel += $" - {job.SlsMaterial}";
                                jobLabel += $" - Duration: {job.DurationHours:F1}h";
                                if(job.Priority>0) jobLabel += $" - Priority P{job.Priority}";
                                var rush = false; try { rush = (bool)(job.GetType().GetProperty("IsRushJob")?.GetValue(job) ?? false); } catch { }
                                var stackLevel = job.StackLevel.HasValue && job.StackLevel.Value>0 ? job.StackLevel.Value : (byte)1;
                                var stackMulti = stackLevel>1;
                                <div class="job-block status-@job.Status.ToLower().Replace(" ", "-")@(rush ? " rush-job" : string.Empty)" style="left:@leftPct; width:@widthPct; --machine-color:@color;" data-color="@color" data-material="@job.SlsMaterial" data-priority="@job.Priority" data-status="@job.Status" data-machine="@machine" data-stack-level="@stackLevel" data-parts-per-build="@(job.PartsPerBuild?.ToString() ?? "")" onclick="event.stopPropagation(); openJobModalSafely('@machine','@job.ScheduledStart.ToString("yyyy-MM-ddTHH:mm")',@job.Id)" title="@jobLabel" aria-label="@jobLabel" data-job-id="@job.Id">
                                    <div class="job-badges">
                                        @if (job.Priority <= 2) { <span class="priority-badge p@job.Priority" title="Priority P@job.Priority">P@job.Priority</span>; }
                                        @if (rush) { <span class="rush-badge" title="Rush Job">⚡</span>; }
                                    </div>
                                    <div class="job-title">@job.PartNumber</div>
                                    @if (rowHeight > 50)
                                    {
                                        <div class="job-details">@job.Status · @job.DurationHours.ToString("F1")h</div>
                                        <div class="job-qty-line">Qty @job.Quantity@if(stackMulti){<span>• Stack @stackLevel x</span>}</div>
                                        @if (!string.IsNullOrEmpty(job.SlsMaterial)) { <div class="job-material">@job.SlsMaterial</div>; }
                                    }
                                    @if (job.Status == "Building" || job.Status == "Running")
                                    { <div class="job-progress"><div class="progress-bar"></div></div> }
                                </div>
                            }
                        }
                        <div class="add-job-btn" onclick="event.stopPropagation(); openJobModalSafely('@machine','@slotDateTime.ToString("yyyy-MM-ddTHH:mm")')" title="@addTooltip" aria-label="Add job at @slotDateTime.ToString("MMM dd h:mm tt")">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                        </div>
                        @if (isCurrentTimeSlot) { <div class="current-time-dot"></div>; }
                    </div>
                }
            }
        }
    </div>
</div>
<script>
(function(){
  document.querySelectorAll('.scheduler-horizontal-container .job-block[data-color]').forEach(b=>{const c=b.getAttribute('data-color'); if(c){ b.style.setProperty('--machine-color', c); }});
})();
</script>