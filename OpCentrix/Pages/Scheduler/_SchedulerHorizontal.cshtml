@using OpCentrix.ViewModels.Scheduler
@using System.Globalization
@model SchedulerPageViewModel
@{
    var slotsPerDay = Model.SlotsPerDay;
    var slotMinutes = Model.SlotMinutes;
    var visibleDates = Model.Dates;
    var earliestJobDate = Model.Jobs.Any() ? Model.Jobs.Min(j => j.ScheduledStart).Date : (visibleDates.FirstOrDefault().Date);
    var anchorDate = earliestJobDate;
    var visibleStart = visibleDates.FirstOrDefault().Date;
    var visibleOffsetSlots = (int)Math.Floor((visibleStart - anchorDate).TotalMinutes / slotMinutes);
    var allDates = visibleDates.ToList();
    var totalSlots = allDates.Count * slotsPerDay;
    var slotTimes = Enumerable.Range(0, slotsPerDay).Select(i => TimeSpan.FromMinutes(i * slotMinutes)).ToList();
    var zoom = Context.Request.Query["zoom"].FirstOrDefault() ?? "week";
    string GetColor(string m)=> Model.MachineColors != null && Model.MachineColors.TryGetValue(m, out var c) ? c : "#6366F1";
}
<style>
    .scheduler-horizontal-container{position:relative;}
    /* Initialization / reveal */
    .scheduler-horizontal-container.initializing .job-block{visibility:hidden;}
    .scheduler-horizontal-container.ready .job-block{visibility:visible;}
    .scheduler-horizontal-container .job-block { color:#fff; border-radius:6px; background:var(--machine-color,#6366F1); box-shadow:0 4px 14px -2px rgba(0,0,0,.12); }
    .scheduler-horizontal-container .scheduler-time-header{z-index:60;background:#fff;}
    .scheduler-horizontal-container .scheduler-machine-header{z-index:61;background:#fff;}
    .job-qty-line{font-size:.6rem;opacity:.9;display:flex;align-items:center;gap:.35rem;margin-top:2px;}
    .scheduler-horizontal-container .scheduler-grid-cell{position:relative;overflow:visible;}
    .machine-jobs-overlay{position:relative; grid-column:2 / span var(--overlay-slot-count); height:var(--row-height); margin-top:calc(var(--row-height) * -1); pointer-events:none;}
    .machine-jobs-overlay .job-block{position:absolute; top:2px; bottom:2px; left:0; width:1px; z-index:20; pointer-events:auto; height:auto !important;}
</style>
<script>
if(typeof window.openJobModalSafely !== 'function'){
  window.openJobModalSafely = function(machineId, date, jobId){
    try {
      if(typeof window.openJobModal === 'function') return window.openJobModal(machineId,date,jobId);
      const params = new URLSearchParams({ handler:'ShowAddModal', machineId: machineId||'', date: date||'' }); if(jobId) params.append('id', jobId);
      const url = '/Scheduler?' + params.toString();
      if(typeof htmx !== 'undefined'){
        return htmx.ajax('GET', url, { target:'#modal-container', swap:'innerHTML' }).then(()=>{
          const mc=document.getElementById('modal-container');
          if(mc){ mc.style.display='flex'; mc.classList.remove('hidden'); document.body.style.overflow='hidden'; }
        });
      }
      window.location.href = url;
    } catch(err){ console.error('[SCHED] openJobModalSafely fallback error', err); }
    return false;
  };
}
</script>
<div class="scheduler-horizontal-container initializing" data-zoom="@zoom" data-orientation="horizontal" data-total-slots="@totalSlots" data-anchor="@anchorDate.ToString("yyyy-MM-dd")" data-visible-offset-slots="@visibleOffsetSlots">
    <div class="scheduler-main-grid" style="display:grid; grid-template-columns: 200px repeat(@totalSlots, var(--slot-width)); min-width:fit-content;">
        <div class="scheduler-machine-header">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path></svg>
            <span>Resources</span>
        </div>
        @* Time / date headers *@
        @for (int d = 0; d < allDates.Count; d++)
        {
            var date = allDates[d];
            var isToday = date.Date == DateTime.Today;
            var dayOfWeek = date.ToString("ddd");
            var dayNumber = date.Day.ToString();
            for (int s = 0; s < slotsPerDay; s++)
            {
                var slotTime = slotTimes[s];
                var isFirstSlot = s == 0;
                var isHourBoundary = slotTime.Minutes == 0;
                var isHalfHour = slotTime.Minutes == 30;
                var headerClasses = new List<string> { "scheduler-time-header" };
                string timeDisplay = string.Empty;
                if (isFirstSlot)
                { headerClasses.Add("date-header"); if (isToday) { headerClasses.Add("today"); } }
                else if (isHourBoundary)
                { headerClasses.Add("hour-header"); var hour = slotTime.Hours; var displayHour = hour == 0 ? 12 : (hour > 12 ? hour - 12 : hour); var period = hour >= 12 ? "PM" : "AM"; timeDisplay = $"{displayHour}{period}"; }
                else if (isHalfHour)
                { headerClasses.Add("half-hour-header"); timeDisplay = ":30"; }
                else { headerClasses.Add("quarter-hour-header"); timeDisplay = ":" + slotTime.Minutes.ToString("00"); }
                <div class="@string.Join(" ", headerClasses)" data-date="@date.ToString("yyyy-MM-dd")" data-slot="@s">
                    @if (isFirstSlot)
                    {<div class="date-day">@dayOfWeek</div><div class="date-number">@dayNumber</div>@if (isToday){<div class="date-today">TODAY</div>; }}
                    else { <div class="time-display">@timeDisplay</div>; }
                </div>
            }
        }
        @* Machine rows *@
        @foreach (var machine in Model.Machines)
        {
            var color = GetColor(machine);
            var rowHeight = Model.MachineRowHeights.GetValueOrDefault(machine, 80);
            var machineJobs = Model.Jobs.Where(j => j.MachineId == machine).ToList();
            var jobCount = machineJobs.Count;
            var totalHours = machineJobs.Sum(j => j.DurationHours);
            var utilizationPercent = (totalHours / 24.0 * 100).ToString("F0");
            <div class="scheduler-machine-label" style="min-height:@(rowHeight)px; --machine-color:@color" data-machine="@machine" data-color="@color">
                <div class="machine-name flex items-center space-x-2"><span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:@color"></span><span>@machine</span></div>
                <div class="machine-stats"><div class="job-count">@jobCount job@(jobCount==1?"":"s") · @totalHours.ToString("F1")h</div><div class="utilization">@utilizationPercent% utilization</div></div>
                @{ var hasActive = machineJobs.Any(j => j.Status == "Building" || j.Status == "Running"); }
                <div class="machine-status @(hasActive ? "status-active" : "status-idle")"></div>
            </div>
            @* Slot cells *@
            @for (int d = 0; d < allDates.Count; d++)
            {
                var date = allDates[d];
                for (int s = 0; s < slotsPerDay; s++)
                {
                    var slotTime = slotTimes[s];
                    var slotDateTime = date.Add(slotTime);
                    var isToday = date.Date == DateTime.Today;
                    var isCurrentTimeSlot = isToday && slotTime <= DateTime.Now.TimeOfDay && slotTime.Add(TimeSpan.FromMinutes(slotMinutes)) > DateTime.Now.TimeOfDay;
                    var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                    var isPastWorkHours = slotTime < TimeSpan.FromHours(6) || slotTime >= TimeSpan.FromHours(18);
                    var isHourBoundary = slotTime.Minutes == 0;
                    var cellClasses = new List<string>{"scheduler-grid-cell","group"};
                    if (isCurrentTimeSlot) cellClasses.Add("current-time");
                    if (isWeekend) cellClasses.Add("weekend");
                    if (isPastWorkHours) cellClasses.Add("off-hours");
                    if (isHourBoundary) cellClasses.Add("hour-boundary");
                    var addTooltip = $"Click to add job at {slotDateTime:MMM dd, yyyy h:mm tt}";
                    <div class="@string.Join(" ", cellClasses)" style="min-height:@(rowHeight)px" onclick="openJobModalSafely('@machine','@slotDateTime.ToString("yyyy-MM-ddTHH:mm")')" title="@addTooltip" data-slot-time="@slotDateTime.ToString("yyyy-MM-ddTHH:mm")" data-machine="@machine">
                        <div class="add-job-btn" onclick="event.stopPropagation(); openJobModalSafely('@machine','@slotDateTime.ToString("yyyy-MM-ddTHH:mm")')" title="@addTooltip" aria-label="Add job at @slotDateTime.ToString("MMM dd h:mm tt")">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                        </div>
                        @if (isCurrentTimeSlot) { <div class="current-time-dot"></div>; }
                    </div>
                }
            }
            @* Overlay job container spanning all slot columns *@
            <div class="machine-jobs-overlay" style="--overlay-slot-count:@totalSlots; --row-height:@(rowHeight)px; grid-column:2 / span @totalSlots;">
                @foreach (var job in machineJobs)
                {
                    var absoluteLeftSlots = job.CalculateGridPosition(anchorDate, slotMinutes);
                    var widthSlotsRaw = job.CalculateGridWidthAbsolute(anchorDate, slotMinutes);
                    var displayLeftSlots = absoluteLeftSlots - visibleOffsetSlots;
                    if (displayLeftSlots + widthSlotsRaw < 0) { continue; }
                    double trimmedLeftSlots = displayLeftSlots;
                    double trimmedWidthSlots = widthSlotsRaw;
                    if (trimmedLeftSlots < 0){ trimmedWidthSlots += trimmedLeftSlots; trimmedLeftSlots = 0; }
                    if (trimmedWidthSlots < 0.25) trimmedWidthSlots = 0.25;
                    var jobLabel = $"Job: {job.PartNumber} ({job.Status}) - {job.ScheduledStart:MMM dd HH:mm} to {job.ScheduledEnd:MMM dd HH:mm} - Qty: {job.Quantity}";
                    if(!string.IsNullOrEmpty(job.SlsMaterial)) jobLabel += $" - {job.SlsMaterial}";
                    jobLabel += $" - Duration: {job.DurationHours:F1}h";
                    if(job.Priority>0) jobLabel += $" - Priority P{job.Priority}";
                    var rush = false; try { rush = (bool)(job.GetType().GetProperty("IsRushJob")?.GetValue(job) ?? false); } catch { }
                    var stackLevel = job.StackLevel.HasValue && job.StackLevel.Value>0 ? job.StackLevel.Value : (byte)1;
                    var stackMulti = stackLevel>1;
                    <div class="job-block status-@job.Status.ToLower().Replace(" ", "-")@(rush?" rush-job":"")" style="--machine-color:@color;" data-left-slots="@trimmedLeftSlots.ToString("0.###", CultureInfo.InvariantCulture)" data-width-slots="@trimmedWidthSlots.ToString("0.###", CultureInfo.InvariantCulture)" data-color="@color" data-material="@job.SlsMaterial" data-priority="@job.Priority" data-status="@job.Status" data-machine="@machine" data-stack-level="@stackLevel" data-parts-per-build="@(job.PartsPerBuild?.ToString() ?? "")" onclick="event.stopPropagation(); openJobModalSafely('@machine','@job.ScheduledStart.ToString("yyyy-MM-ddTHH:mm")',@job.Id)" title="@jobLabel" aria-label="@jobLabel" data-job-id="@job.Id">
                        <div class="job-badges">
                            @if (job.Priority <= 2) { <span class="priority-badge p@job.Priority" title="Priority P@job.Priority">P@job.Priority</span>; }
                            @if (rush) { <span class="rush-badge" title="Rush Job">⚡</span>; }
                        </div>
                        <div class="job-title">@job.PartNumber</div>
                        @if (rowHeight > 50)
                        {
                            <div class="job-details">@job.Status · @job.DurationHours.ToString("F1")h</div>
                            <div class="job-qty-line">Qty @job.Quantity@if(stackMulti){<span>• Stack @stackLevel x</span>}</div>
                            @if (!string.IsNullOrEmpty(job.SlsMaterial)) { <div class="job-material">@job.SlsMaterial</div>; }
                        }
                        @if (job.Status == "Building" || job.Status == "Running")
                        { <div class="job-progress"><div class="progress-bar"></div></div> }
                    </div>
                }
            </div>
        }
    </div>
</div>
<script>
(function(){
  const container=document.querySelector('.scheduler-horizontal-container');
  if(!container) return;
  const sizing={done:false, attempts:0, max:120};
  const scroller=container;
  const scrollKeyBase='schedulerScroll';
  function scrollKey(){ return `${scrollKeyBase}:${container.dataset.orientation||'h'}:${container.dataset.zoom||'default'}:${container.dataset.anchor||''}`; }
  let restored=false;
  function restoreScroll(){ if(restored) return; try{ const raw=localStorage.getItem(scrollKey()); if(!raw) return; const d=JSON.parse(raw); if(!d) return; if(d.anchor && d.anchor!==container.dataset.anchor) return; scroller.scrollLeft=d.left||0; scroller.scrollTop=d.top||0; restored=true; }catch{} }
  function saveScroll(){ try{ localStorage.setItem(scrollKey(), JSON.stringify({left:scroller.scrollLeft, top:scroller.scrollTop, anchor:container.dataset.anchor||'', ts:Date.now()})); }catch{} }
  scroller.addEventListener('scroll', ()=> requestAnimationFrame(saveScroll), {passive:true});
  window.addEventListener('beforeunload', saveScroll);
  document.addEventListener('scheduler:zoomChanged', ()=>{ saveScroll(); restored=false; setTimeout(restoreScroll,40); });

  function slotWidth(){ let v=getComputedStyle(document.documentElement).getPropertyValue('--slot-width').trim(); if(!v) return 0; if(v.endsWith('px')) v=v.slice(0,-2); const n=parseFloat(v); return isNaN(n)?0:n; }
  function normalizeHeights(){ document.querySelectorAll('.scheduler-horizontal-container .job-block').forEach(j=>{ j.style.top='2px'; j.style.bottom='2px'; j.style.removeProperty('height'); }); }
  function allSized(){ return Array.from(document.querySelectorAll('.scheduler-horizontal-container .job-block')).every(j=>{ const w=parseFloat(j.style.width); return !isNaN(w) && w>1; }); }
  function finalize(){ if(sizing.done) return; normalizeHeights(); container.classList.remove('initializing'); container.classList.add('ready'); sizing.done=true; try{ window.__schedulerSized=true; }catch{} document.dispatchEvent(new CustomEvent('scheduler:sized')); }
  function size(force){ if(sizing.done && !force) return; const sw=slotWidth(); if(sw<=0){ if(sizing.attempts++<sizing.max){ return requestAnimationFrame(()=>size(force)); } return finalize(); }
    document.querySelectorAll('.scheduler-horizontal-container .job-block[data-left-slots][data-width-slots]').forEach(el=>{
        const ls=parseFloat(el.getAttribute('data-left-slots'))||0; const ws=parseFloat(el.getAttribute('data-width-slots'))||0.25;
        if(force || !el.style.left) el.style.left=(ls*sw)+'px';
        if(force || !el.style.width) el.style.width=(ws*sw)+'px';
    });
    if(allSized()) requestAnimationFrame(()=>requestAnimationFrame(()=>{ restoreScroll(); finalize(); })); else if(sizing.attempts++<sizing.max) requestAnimationFrame(()=>size(force)); else finalize();
  }
  window.ocSchedulerSizeJobs=size;
  window.ocSchedulerForceRescan=(reason)=>{ sizing.done=false; sizing.attempts=0; size(true); };
  document.addEventListener('scheduler:jobAdded', ()=>window.ocSchedulerForceRescan('jobAdded'));
  document.addEventListener('scheduler:jobUpdated', ()=>window.ocSchedulerForceRescan('jobUpdated'));
  document.addEventListener('scheduler:jobDeleted', ()=>window.ocSchedulerForceRescan('jobDeleted'));
  document.addEventListener('scheduler:jobsDeleted', ()=>window.ocSchedulerForceRescan('jobsDeleted'));
  document.addEventListener('htmx:afterSwap', e=>{ if(e.target && e.target.id==='scheduler-main-content'){ window.ocSchedulerForceRescan('afterSwap'); } });
  window.addEventListener('resize', ()=>window.ocSchedulerForceRescan('resize'));
  document.addEventListener('scheduler:zoomChanged', ()=>window.ocSchedulerForceRescan('zoom'));
  size(true);
  restoreScroll();
})();
</script>