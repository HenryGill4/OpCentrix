@page
@using OpCentrix.ViewModels.Scheduler;
@model OpCentrix.Pages.Scheduler.IndexModel

@{
    ViewData["Title"] = "Production Scheduler";
    ViewData["Description"] = "Schedule and manage production jobs across all machines";
    var adminLayout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
    var userLayout = "~/Pages/Shared/_UserLayout.cshtml";
    Layout = (User.IsInRole("Admin") || User.IsInRole("Manager")) ? adminLayout : userLayout;

    var zoomLevels = new[] { "2month", "month", "week", "12h", "6h", "4h", "2h", "1h", "30min", "15min" };
    var zoomParam = Request.Query["zoom"].FirstOrDefault() ?? "week";
    var zoomIndex = Array.IndexOf(zoomLevels, zoomParam);
    if (zoomIndex < 0) zoomIndex = 2; // default to week
    var zoom = zoomLevels[zoomIndex];

    var orientationParam = Request.Query["orientation"].FirstOrDefault();
    string currentOrientation;
    if (!string.IsNullOrEmpty(orientationParam) && (orientationParam == "horizontal" || orientationParam == "vertical"))
    {
        currentOrientation = orientationParam;
    }
    else
    {
        currentOrientation = "horizontal";
    }
    var isVertical = currentOrientation == "vertical";

    var viewModel = Model.ViewModel;
}

<!-- Enhanced Header with Controls -->
<div class="opcentrix-card p-6 mb-6">
    <div class="scheduler-header-wrapper">
        <!-- Controls Wrapper -->
        <div class="scheduler-controls">
            <!-- Navigation Controls -->
            <div class="control-group">
                <button onclick="navigatePeriod(-1)" class="icon-btn" title="Previous period">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button onclick="navigateToToday()" class="text-btn" title="Go to today">Today</button>
                <button onclick="navigatePeriod(1)" class="icon-btn" title="Next period">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>

            <!-- Zoom Controls -->
            <div class="control-group">
                <span class="group-label">Zoom</span>
                <button id="zoomOut" @(zoomIndex <= 0 ? "disabled" : "") onclick="changeZoom(-1)" class="icon-btn" title="Zoom out">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10h-6"/></svg>
                </button>
                <span class="chip-active !cursor-default">@zoom</span>
                <button id="zoomIn" @(zoomIndex >= zoomLevels.Length - 1 ? "disabled" : "") onclick="changeZoom(1)" class="icon-btn" title="Zoom in">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </button>
            </div>

            <!-- Orientation Toggle -->
            <div class="control-group orientation-group">
                <span class="group-label">Layout</span>
                <button class="toggle-btn @(isVertical?"":"active")" onclick="toggleOrientation('horizontal')" title="Horizontal layout">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>H
                </button>
                <button class="toggle-btn @(isVertical?"active":"")" onclick="toggleOrientation('vertical')" title="Vertical layout">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4v16M12 4v16M18 4v16"/></svg>V
                </button>
            </div>

            <!-- Machine Type Filter (Scrollable Chips) -->
            <div class="control-group filter-group">
                <span class="group-label">Type</span>
                <div class="chip-scroll" title="Filter by machine type">
                    @{ var types = (IEnumerable<string>) (ViewData["MachineTypes"] ?? new List<string>()); var currentType = (string)(ViewData["CurrentMachineTypeFilter"] ?? "all"); }
                    <a class="chip @(currentType=="all"?"chip-active":"")" href="@Url.Page("/Scheduler/Index", new { machineType = "all", zoom = zoom, startDate = viewModel.StartDate.ToString("yyyy-MM-dd"), orientation = currentOrientation })">All</a>
                    @foreach(var t in types){
                        <a class="chip @(currentType==t?"chip-active":"")" href="@Url.Page("/Scheduler/Index", new { machineType = t, zoom = zoom, startDate = viewModel.StartDate.ToString("yyyy-MM-dd"), orientation = currentOrientation })">@t</a>
                    }
                </div>
            </div>

            <!-- Status Summary -->
            <div class="control-group summary-group">
                <span class="group-label">Status</span>
                <span class="mini-pill bg-green-100 text-green-700">@viewModel.Jobs.Count jobs</span>
                <span class="mini-pill bg-blue-100 text-blue-700">@viewModel.Machines.Count machines</span>
            </div>

            <!-- Schedule-side machine management buttons -->
            <div class="control-group">
                <a href="/Admin/Machines?showCreate=1" class="primary-btn" title="Add machine">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                    Add Machine
                </a>
                <button type="button" class="secondary-btn" onclick="openModifySelectedMachine()" title="Modify selected machine">Modify Machine</button>
            </div>
        </div>
    </div>
</div>

<!-- Main Scheduler Content -->
<div id="scheduler-main-content" class="@(isVertical ? "scheduler-vertical" : "scheduler-horizontal")">
    @if (isVertical)
    {
        <partial name="_SchedulerVertical" model="viewModel" />
    }
    else
    {
        <partial name="_SchedulerHorizontal" model="viewModel" />
    }
</div>

<!-- Footer Summary -->
<div class="mt-6" id="footer-summary">
    <partial name="_FooterSummary" model="Model.Summary" />
</div>

<!-- CRITICAL: Modal Container (must exist for HTMX to work) -->
<div id="modal-container" class="fixed inset-0 z-50 hidden" style="display: none;"></div>

@section Styles {
    <link rel="stylesheet" href="~/css/scheduler.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/scheduler-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stage-cohort-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive-master.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/scheduler-header.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/scheduler-ui.js" asp-append-version="true"></script>
    <!-- job-form.js now contains unified stacking + SLS logic (replaces scheduler-addjob-modal.js) -->
    <script src="~/js/job-form.js" asp-append-version="true"></script>
    <script>
        let lastSelectedMachineId = null;
        document.addEventListener('click', function(e){
            const cell = e.target.closest('[data-machine]');
            if(cell){ lastSelectedMachineId = cell.getAttribute('data-machine'); }
        });
        function openModifySelectedMachine(){
            if(!lastSelectedMachineId){
                alert('Click on a machine row or column first to select a machine.');
                return;
            }
            window.location.href = '/Admin/Machines?editMachine=' + encodeURIComponent(lastSelectedMachineId);
        }
    </script>
}