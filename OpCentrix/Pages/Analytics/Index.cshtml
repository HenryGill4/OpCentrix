@page
@model OpCentrix.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 p-6">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center">
            <i class="fa-solid fa-chart-pie mr-3 text-blue-600"></i>
            Analytics Overview
        </h1>
        <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Manufacturing metrics and performance insights</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalJobs</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Total Jobs</div>
                </div>
                <i class="fa-solid fa-list text-2xl text-blue-500"></i>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-bold text-green-600">@Model.CompletedJobs</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Completed</div>
                </div>
                <i class="fa-solid fa-check-circle text-2xl text-green-500"></i>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-bold text-yellow-600">@Model.ActiveJobs</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">In Progress</div>
                </div>
                <i class="fa-solid fa-spinner text-2xl text-yellow-500"></i>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-bold text-red-600">@Model.DelayedJobs</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Delayed</div>
                </div>
                <i class="fa-solid fa-exclamation-triangle text-2xl text-red-500"></i>
            </div>
        </div>
    </div>

    <!-- Analytics Links -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <a href="/Analytics/Dashboard" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow group">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-chart-line text-blue-600 dark:text-blue-400 text-xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600">Analytics Dashboard</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">OEE, utilization & trends</p>
                </div>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
                View detailed machine performance metrics, OEE calculations, and production trends.
            </p>
        </a>

        <a href="/Analytics/BuildTimeAnalytics" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow group">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-clock text-purple-600 dark:text-purple-400 text-xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-purple-600">Build Time Analytics</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Duration analysis</p>
                </div>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
                Analyze build durations, compare estimated vs actual times, and identify optimization opportunities.
            </p>
        </a>

        <a href="/Operations/StageDashboard" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow group">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-tasks text-green-600 dark:text-green-400 text-xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-green-600">Stage Performance</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Workflow insights</p>
                </div>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
                Monitor multi-stage workflow progress and stage completion metrics.
            </p>
        </a>
    </div>

    <!-- Performance Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Quality Metrics -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow border border-gray-200 dark:border-gray-700 p-6">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center">
                <i class="fa-solid fa-star mr-2 text-yellow-500"></i>
                Quality Metrics
            </h2>
            <div class="space-y-4">
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span class="text-gray-600 dark:text-gray-400">Overall Quality Rate</span>
                        <span class="font-bold @(Model.OverallQualityRate >= 95 ? "text-green-600" : Model.OverallQualityRate >= 85 ? "text-yellow-600" : "text-red-600")">
                            @Model.OverallQualityRate.ToString("F1")%
                        </span>
                    </div>
                    <div class="h-2 bg-gray-200 dark:bg-gray-600 rounded-full overflow-hidden">
                        <div class="h-full @(Model.OverallQualityRate >= 95 ? "bg-green-500" : Model.OverallQualityRate >= 85 ? "bg-yellow-500" : "bg-red-500")" 
                             style="width: @Model.OverallQualityRate%"></div>
                    </div>
                </div>
                <div class="flex justify-between">
                    <div class="text-center">
                        <div class="text-xl font-bold text-red-600">@Model.QualityFailures</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Failures</div>
                    </div>
                    <div class="text-center">
                        <div class="text-xl font-bold text-yellow-600">@Model.QualityHolds</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">On Hold</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow border border-gray-200 dark:border-gray-700 p-6">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center">
                <i class="fa-solid fa-gauge-high mr-2 text-blue-500"></i>
                Performance Metrics
            </h2>
            <div class="space-y-4">
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 dark:text-gray-400">Avg Job Duration</span>
                    <span class="font-bold text-gray-900 dark:text-white">@Model.AverageJobDuration.ToString("F1") hrs</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 dark:text-gray-400">On-Time Delivery</span>
                    <span class="font-bold @(Model.OnTimeDeliveryRate >= 90 ? "text-green-600" : "text-yellow-600")">
                        @Model.OnTimeDeliveryRate.ToString("F1")%
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600 dark:text-gray-400">Machine Utilization</span>
                    <span class="font-bold text-gray-900 dark:text-white">@Model.MachineUtilization.ToString("F1")%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Jobs -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow border border-gray-200 dark:border-gray-700 p-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center">
            <i class="fa-solid fa-clock-rotate-left mr-2 text-purple-500"></i>
            Recent Jobs
        </h2>
        @if (Model.RecentJobs.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                            <th class="pb-2">Part</th>
                            <th class="pb-2">Machine</th>
                            <th class="pb-2">Status</th>
                            <th class="pb-2 text-right">Quantity</th>
                            <th class="pb-2 text-right">Modified</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var job in Model.RecentJobs)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="font-medium text-gray-900 dark:text-white">@job.PartNumber</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">@job.Part?.Name</div>
                                </td>
                                <td class="py-3 text-gray-600 dark:text-gray-400">@job.MachineId</td>
                                <td class="py-3">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium
                                        @(job.Status == "Completed" ? "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200" :
                                          job.Status == "Building" || job.Status == "Active" ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200" :
                                          job.Status == "Delayed" ? "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200" :
                                          "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200")">
                                        @job.Status
                                    </span>
                                </td>
                                <td class="py-3 text-right text-gray-600 dark:text-gray-400">@job.Quantity</td>
                                <td class="py-3 text-right text-gray-500 dark:text-gray-400 text-xs">
                                    @job.LastModifiedDate.ToString("MMM dd, HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-gray-500 dark:text-gray-400 text-center py-8">No recent jobs found</p>
        }
    </div>
</div>
