@using OpCentrix.ViewModels.PrintTracking
@model PrintStartViewModel

<div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" id="start-print-modal" hx-preserve>
    <div class="relative top-10 mx-auto p-5 border w-11/12 md:w-5/6 lg:w-4/5 max-w-4xl shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <div class="flex items-center justify-between pb-4 border-b">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Start Print</h3>
                    <p class="text-sm text-gray-600 mt-1">Confirm start info, (optional) powder added, and estimated completion.</p>
                </div>
                <button type="button" onclick="closeModalSafely()" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form hx-post="/PrintTracking?handler=StartPrint" hx-target="#modal-container" hx-swap="innerHTML" class="mt-6 space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AddPowder" id="AddPowderHidden" value="@Model.AddPowder.ToString().ToLower()" />
                <!-- Hidden canonical printer name used for POST binding (kept in sync with dropdown) -->
                <input type="hidden" name="PrinterName" id="HiddenPrinterName" value="@Model.PrinterName" />
                @if(Model.AssociatedScheduledJobId.HasValue){ <input type="hidden" name="AssociatedScheduledJobId" value="@Model.AssociatedScheduledJobId" /> }

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Printer</label>
                        <select name="printerName" id="PrinterNameSelect"
                                class="mt-1 w-full rounded-md border-gray-300 focus:ring-blue-500 focus:border-blue-500"
                                hx-get="/PrintTracking?handler=StartPrintModal"
                                hx-target="#start-print-modal"
                                hx-swap="outerHTML"
                                hx-include="[name='printerName'],[name='AssociatedScheduledJobId']"
                                hx-on:htmx:beforeRequest="this.disabled=true;"
                                hx-on:htmx:afterOnLoad="this.disabled=false;"
                                onchange="if(!window.htmx){reloadStartPrintModal(this.value);}" >
                            <option value="">Select printer...</option>
                            @if(Model.AvailablePrinters != null){
                                foreach(var p in Model.AvailablePrinters){
                                    if(string.Equals(p, Model.PrinterName, StringComparison.OrdinalIgnoreCase)){
                                        @:<option value="@p" selected>@p</option>
                                    } else {
                                        @:<option value="@p">@p</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Start Time</label>
                        <input type="datetime-local" name="ActualStartTime" value="@Model.ActualStartTime.ToString("yyyy-MM-ddTHH:mm")" required class="mt-1 w-full rounded-md border-gray-300" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Estimated End Time</label>
                        <input type="datetime-local" name="EstimatedEndTime" id="EstimatedEndTime" value="@Model.EstimatedEndTime.ToString("yyyy-MM-ddTHH:mm")" required onchange="updateDuration()" class="mt-1 w-full rounded-md border-gray-300" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Scheduled Part</label>
                        <input type="text" value="@Model.PartNumber" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                        <input type="hidden" name="PartNumber" value="@Model.PartNumber" />
                        <input type="hidden" name="PartId" value="@Model.PartId" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Stack Level</label>
                        <input type="text" value="@Model.StackLevel" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                        <input type="hidden" name="StackLevel" value="@Model.StackLevel" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Parts / Build</label>
                        <input type="text" value="@Model.PartsPerBuild" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                        <input type="hidden" name="PartsPerBuild" value="@Model.PartsPerBuild" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Loaded Material</label>
                        <input type="text" value="@Model.CurrentMachineMaterial" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                        <input type="hidden" name="SelectedMaterial" value="@Model.CurrentMachineMaterial" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="md:col-span-2">
                        <div class="flex items-center justify-between">
                            <label class="block text-sm font-medium text-gray-700">Add Powder (kg)</label>
                            <label class="inline-flex items-center text-xs text-gray-600">
                                <input type="checkbox" id="AddPowderToggle" @(Model.AddPowder ? "checked" : "") onchange="togglePowderInput()" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500" />
                                <span class="ml-1">Enable</span>
                            </label>
                        </div>
                        <input type="number" step="0.01" min="0" name="PowderAddedKg" id="PowderAddedKg" value="@(Model.PowderAddedKg?.ToString() ?? "")" class="mt-1 w-full rounded-md border-gray-300 disabled:bg-gray-100" placeholder="0.00" />
                        <p id="PowderDisabledHint" class="text-xs text-gray-500 mt-1 @(Model.AddPowder ? "hidden" : "")">Powder addition disabled. Toggle to record powder added.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Duration (hrs)</label>
                        <input type="text" id="CalculatedDuration" value="@Model.OperatorEstimatedHours.ToString("F2")" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Total Parts (Auto)</label>
                        <input type="text" value="@Model.TotalPartsInBuild" readonly class="mt-1 w-full rounded-md border-gray-300 bg-gray-100" />
                        <input type="hidden" name="TotalPartsInBuild" value="@Model.TotalPartsInBuild" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Setup Notes (Optional)</label>
                    <textarea name="SetupNotes" rows="2" class="mt-1 w-full rounded-md border-gray-300">@Model.SetupNotes</textarea>
                </div>

                <div class="bg-purple-50 border rounded p-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-purple-800">Add Prototypes</span>
                        <label class="flex items-center text-sm text-purple-700">
                            <input type="checkbox" name="AddPrototypes" value="true" onchange="togglePrototypes(this)" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500" />
                            <span class="ml-2">Enable</span>
                        </label>
                    </div>
                    <div id="prototypeContainer" class="hidden space-y-3"></div>
                    <button type="button" id="addPrototypeBtn" onclick="addPrototype()" class="hidden text-sm bg-purple-600 text-white px-3 py-1 rounded">+ Prototype</button>
                </div>

                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="closeModalSafely()" class="px-4 py-2 text-sm bg-white border rounded-md">Cancel</button>
                    <button type="submit" class="px-4 py-2 text-sm bg-green-600 text-white rounded-md">Start Print</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function closeModalSafely(){ if(window.closeJobModal) window.closeJobModal(); const m=document.getElementById('start-print-modal'); if(m) m.remove(); try{ document.body.style.overflow=''; }catch{} }
function updateDuration(){const s=new Date(document.querySelector('input[name=ActualStartTime]').value);const e=new Date(document.getElementById('EstimatedEndTime').value);if(e>s){const h=(e-s)/36e5;document.getElementById('CalculatedDuration').value=h.toFixed(2);} }
function togglePrototypes(cb){const c=document.getElementById('prototypeContainer');const btn=document.getElementById('addPrototypeBtn'); if(cb.checked){c.classList.remove('hidden');btn.classList.remove('hidden'); if(!c.children.length) addPrototype();} else {c.classList.add('hidden');btn.classList.add('hidden');}}
let protoIndex=0;function addPrototype(){const c=document.getElementById('prototypeContainer');const idx=protoIndex++;const div=document.createElement('div');div.className='border p-3 rounded bg-white';div.innerHTML=`<div class="grid grid-cols-5 gap-2 items-end"><div class="col-span-2"><label class=\"text-xs text-gray-600\">Part #</label><input name="PrototypeAdditions[${idx}].PartNumber" required class="mt-1 w-full border-gray-300 rounded" /></div><div><label class=\"text-xs text-gray-600\">Qty</label><input type=\"number\" min=\"1\" value=\"1\" name="PrototypeAdditions[${idx}].Quantity" class="mt-1 w-full border-gray-300 rounded" /></div><div class="col-span-2"><label class=\"text-xs text-gray-600\">Notes</label><input name="PrototypeAdditions[${idx}].Notes" class="mt-1 w-full border-gray-300 rounded" /></div></div>`;c.appendChild(div);} 
function togglePowderInput(){const t=document.getElementById('AddPowderToggle');const input=document.getElementById('PowderAddedKg');const hint=document.getElementById('PowderDisabledHint');const hidden=document.getElementById('AddPowderHidden');if(t.checked){input.disabled=false;hint.classList.add('hidden');hidden.value='true';}else{input.disabled=true;input.value='';hint.classList.remove('hidden');hidden.value='false';}}
// Sync hidden printer name on change (for POST)
const printerSelect=document.getElementById('PrinterNameSelect');if(printerSelect){printerSelect.addEventListener('change',()=>{const h=document.getElementById('HiddenPrinterName'); if(h) h.value=printerSelect.value;});}
// Fallback reload if HTMX not present
function reloadStartPrintModal(printer){if(!printer) return; fetch(`/PrintTracking?handler=StartPrintModal&printerName=${encodeURIComponent(printer)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}}).then(r=>r.text()).then(html=>{const modal=document.getElementById('start-print-modal'); if(modal){modal.outerHTML=html;}}).catch(err=>console.error('Reload start print modal failed',err));}
// initialize state
if(!document.getElementById('AddPowderToggle').checked){document.getElementById('PowderAddedKg').disabled=true;}
updateDuration();
</script>
