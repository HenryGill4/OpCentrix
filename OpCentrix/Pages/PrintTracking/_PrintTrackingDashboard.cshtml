@functions {
    private string GetMachineCardClasses(string status) => status?.ToLower() switch
    {
        "running" or "building" or "printing" => "border-orange-200 bg-orange-50",
        "idle" => "border-green-200 bg-green-50",
        "maintenance" => "border-gray-200 bg-gray-50",
        "error" or "offline" => "border-red-200 bg-red-50",
        _ => "border-gray-200"
    };

    private string GetStatusBadgeClasses(string status) => status?.ToLower() switch
    {
        "idle" => "bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200",
        "running" or "building" or "printing" => "bg-orange-100 dark:bg-orange-900/50 text-orange-800 dark:text-orange-200",
        "cooling" => "bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200",
        "urgent" => "bg-red-100 dark:bg-red-900/50 text-red-800 dark:text-red-200",
        "preheating" => "bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200",
        "started" => "bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200",
        "completed" => "bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200",
        "maintenance" => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200",
        "error" or "offline" => "bg-red-100 dark:bg-red-900/50 text-red-800 dark:text-red-200",
        "aborted" => "bg-red-100 dark:bg-red-900/50 text-red-800 dark:text-red-200",
        "setup" => "bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200",
        _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200"
    };

    private string GetUtilizationBarClass(double utilization)
    {
        return utilization switch
        {
            >= 90 => "bg-red-500",
            >= 70 => "bg-yellow-500",
            >= 50 => "bg-blue-500",
            _ => "bg-green-500"
        };
    }

    private string GetJobCardClasses(bool isNext, bool isRunning, bool isOverdue)
        => isRunning ? "bg-green-50 border-l-2 border-green-400" :
           isOverdue ? "bg-red-50 border-l-2 border-red-400" :
           isNext ? "bg-blue-50 border-l-2 border-blue-400" :
           "bg-gray-50 border-l-2 border-gray-200";

    private string GetJobTimeDisplay(Job job, bool isRunning)
    {
        if (isRunning && job.ActualStart.HasValue)
        {
            var elapsed = DateTime.Now - job.ActualStart.Value;
            return $"Running {elapsed.TotalHours:F1}h";
        }
        if (job.ScheduledStart < DateTime.Now && !isRunning)
        {
            return $"Overdue {Math.Abs((DateTime.Now - job.ScheduledStart).TotalHours):F1}h";
        }
        if (job.ScheduledStart.Date == DateTime.Today)
            return $"Today {job.ScheduledStart:HH:mm}";
        if (job.ScheduledStart.Date == DateTime.Today.AddDays(1))
            return $"Tomorrow {job.ScheduledStart:HH:mm}";
        return job.ScheduledStart.ToString("MM/dd HH:mm");
    }

    private string FormatDowntime(double minutes)
    {
        var totalMinutes = Math.Max(0, (int)Math.Round(minutes));
        if (totalMinutes < 60)
        {
            return $"{totalMinutes} min";
        }
        var span = TimeSpan.FromMinutes(totalMinutes);
        var hours = (int)span.TotalHours;
        var mins = span.Minutes;
        return mins > 0 ? $"{hours}h {mins}m" : $"{hours}h";
    }
}

<script>
/* Enhanced Print Tracking Dashboard JavaScript with Scheduler Integration */
(function() {
    'use strict';

    console.log('📌 [PRINT-TRACKING] Initializing enhanced dashboard with scheduler integration');

    window.PrintTracking = window.PrintTracking || {};

    // prevent stacked intervals across swaps
    window.PrintTracking.refreshTimer && clearInterval(window.PrintTracking.refreshTimer);
    window.PrintTracking.refreshTimer = null;
    window.PrintTracking.isRefreshing = false;
    window.PrintTracking.lastRefreshTs = 0;

    window.PrintTracking.init = function() {
        setupPrintTrackingActions();
        setupAutoRefresh();
        setupSchedulerCommunication();
        // persistAutoStatuses disabled for demo to preserve manual status
        // persistAutoStatuses();
        console.log('✅ [PRINT-TRACKING] Dashboard initialized');
    };

    function setupPrintTrackingActions() {
        document.addEventListener('click', function(e) {
            const target = e.target.closest('[data-action]');
            if(!target) return;
            const action = target.getAttribute('data-action');
            if(action === 'start-print') {
                e.preventDefault();
                handleStartPrint(target.getAttribute('data-printer'), target.getAttribute('data-job-id'));
            } else if(action === 'complete-print') {
                e.preventDefault();
                handleCompletePrint(target.getAttribute('data-printer'), target.getAttribute('data-build-id'), target.getAttribute('data-job-id'));
            } else if(action === 'schedule-job' || action === 'schedule') { // support legacy
                e.preventDefault();
                const printer = target.getAttribute('data-machine') || target.getAttribute('data-printer');
                handleScheduleJob(printer);
            }
        });
    }

    function setupAutoRefresh() {
        const refreshInterval = 90000; // 90s to reduce chattiness
        if (window.PrintTracking.refreshTimer) clearInterval(window.PrintTracking.refreshTimer);
        window.PrintTracking.refreshTimer = setInterval(function() {
            // Do not refresh while any modal is open (including start/complete modals)
            if (document.getElementById('start-print-modal') || document.getElementById('post-print-modal')) return;
            const openModals = document.querySelectorAll('.modal:not(.hidden), [style*="display: flex"]');
            if (openModals.length > 0) return;
            refreshDashboardDebounced();
        }, refreshInterval);
    }

    function setupSchedulerCommunication() {
        window.addEventListener('message', function(e) {
            if (e.origin !== window.location.origin) return;
            const data = e.data;
            if (data.type === 'schedulerJobUpdated') {
                refreshDashboardDebounced();
            } else if (data.type === 'requestPrintTrackingRefresh') {
                refreshDashboardDebounced();
            }
        });
        // Listen for HX-Trigger header events from server (htmx) to refresh dashboard
        document.body.addEventListener('requestPrintTrackingRefresh', function(){
            refreshDashboardDebounced();
        });
        // Lightweight card update when only a single machine status changes
        document.body.addEventListener('machineStatusUpdated', function(e){
            try{
                const data = e.detail || {}; // { machineId, status }
                if(!data.machineId) return;
                const card = document.querySelector(`.machine-card[data-machine-id="${CSS.escape(data.machineId)}"]`);
                if(!card) return;
                const newStatus = data.status || '';
                const badge = card.querySelector('.status-toggle');
                if(badge){
                    badge.textContent = newStatus;
                    badge.className = 'status-badge ' + statusBadgeClass(newStatus);
                }
                const normalized = (newStatus || '').toLowerCase();
                card.setAttribute('data-status', normalized);
            } catch(err) { console.warn('machineStatusUpdated handler error', err); }
        });
        // Attach anti-forgery token to all HTMX requests
        document.body.addEventListener('htmx:configRequest', function (evt) {
            try {
                const form = document.getElementById('__afTokenSourcePT');
                const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) {
                    evt.detail.headers['RequestVerificationToken'] = token;
                }
            } catch { /* no-op */ }
        });
        // Basic diagnostics for network errors
        document.body.addEventListener('htmx:sendError', function (evt) {
            console.warn('[HTMX] sendError', evt.detail);
        });
        document.body.addEventListener('htmx:responseError', function (evt) {
            console.warn('[HTMX] responseError', evt.detail);
        });
    }

    // Status badge class mapping (canonical statuses only)
    function statusBadgeClass(status){
        const s = (status||'').toLowerCase();
        if(s==='idle') return 'bg-green-100 text-green-800 status-toggle';
        if(s==='preheating') return 'bg-amber-100 text-amber-800 status-toggle';
        if(s==='printing') return 'bg-orange-100 text-orange-800 status-toggle';
        if(s==='cooling') return 'bg-blue-100 text-blue-800 status-toggle';
        if(s==='urgent') return 'bg-red-100 text-red-800 status-toggle';
        if(s==='maintenance') return 'bg-gray-100 text-gray-800 status-toggle';
        if(s==='error' || s==='offline' || s==='aborted') return 'bg-red-100 text-red-800 status-toggle';
        return 'bg-gray-100 text-gray-800 status-toggle';
    }

    function handleStartPrint(printerName, jobId = null) {
        if (!printerName) { console.warn('[PRINT-TRACKING] Missing printer for start'); return; }
        const params = new URLSearchParams();
        params.append('printerName', printerName);
        if (jobId) params.append('jobId', jobId);
        if (typeof htmx !== 'undefined') {
            htmx.ajax('GET', `/PrintTracking?handler=StartPrintModal&${params}`, { target: 'body', swap: 'beforeend' })
                .then(()=> showModal())
                .catch(err=>console.error('Start print modal load failed', err));
        } else {
            window.open(`/PrintTracking?handler=StartPrintModal&${params}`,'_blank');
        }
    }

    function handleCompletePrint(printerName, buildId = null, jobId = null) {
        if (!printerName && !buildId && !jobId) { console.warn('[PRINT-TRACKING] Missing identifiers for completion'); return; }
        const params = new URLSearchParams();
        if (printerName) params.append('printerName', printerName);
        if (buildId) params.append('buildId', buildId);
        if (jobId) params.append('jobId', jobId);
        if (typeof htmx !== 'undefined') {
            htmx.ajax('GET', `/PrintTracking?handler=PostPrintModal&${params}`, { target: 'body', swap: 'beforeend' })
                .then(()=> showModal())
                .catch(err=>console.error('Complete print modal load failed', err));
        } else {
            window.open(`/PrintTracking?handler=PostPrintModal&${params}`,'_blank');
        }
    }

    function handleScheduleJob(machineId) {
        if (!machineId) { console.warn('[PRINT-TRACKING] Missing machine for schedule'); return; }
        const schedulerUrl = `/Scheduler?handler=ShowAddModal&machineId=${encodeURIComponent(machineId)}&date=${new Date().toISOString().slice(0,16)}`;
        if (typeof htmx !== 'undefined') {
            htmx.ajax('GET', schedulerUrl, { target: '#modal-container', swap: 'innerHTML' })
                .then(()=> showModal())
                .catch(()=> window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank'));
        } else {
            window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank');
        }
    }

    // Alias for legacy global dispatcher logs expecting these functions
    window.handleScheduleJob = handleScheduleJob;
    window.handleStartPrint = handleStartPrint;
    window.handleCompletePrint = handleCompletePrint;

    function refreshDashboardDebounced(){
        const now = Date.now();
        if (window.PrintTracking.isRefreshing) return;
        if (now - (window.PrintTracking.lastRefreshTs||0) < 5000) return; // 5s debounce
        window.PrintTracking.lastRefreshTs = now;
        window.refreshDashboard();
    }

    window.refreshDashboard = function() {
        if (window.PrintTracking.isRefreshing) return;
        window.PrintTracking.isRefreshing = true;
        if (typeof htmx !== 'undefined') {
            htmx.ajax('GET', '/PrintTracking?handler=RefreshDashboard', { target: '#dashboard-content', swap: 'innerHTML' })
                .finally(()=> { window.PrintTracking.isRefreshing = false; });
        } else {
            window.PrintTracking.isRefreshing = false;
        }
    }

    // persistAutoStatuses disabled to avoid overriding manual demo statuses
    function persistAutoStatuses(){ /* no-op for demo */ }

    // Minimal showModal helper to disable body scroll while modal is open
    function showModal(){ try { document.body.style.overflow = 'hidden'; } catch{} }

    // Close helpers to restore body scroll from modals that don’t define their own
    window.closePostPrintModalSafely = function(){ try{ document.body.style.overflow=''; }catch{} const m=document.getElementById('post-print-modal'); if(m) m.remove(); };

    // Stylized status dropdown from badge
    document.addEventListener('click', function(e){
        const btn = e.target.closest('.status-toggle');
        document.querySelectorAll('.status-menu').forEach(m=> m.classList.add('hidden'));
        if(btn){
            const id = btn.getAttribute('data-menu');
            const menu = document.getElementById(id);
            if(menu){ menu.classList.toggle('hidden'); }
        }
    });

    // Optimistic update: when selecting a status in the menu, immediately reflect it on the card
    document.addEventListener('click', function(e){
        const opt = e.target.closest('.status-menu button[data-status-value]');
        if(!opt) return;
        const newStatus = opt.getAttribute('data-status-value') || '';
        const card = opt.closest('.machine-card');
        if(!card) return;
        const badge = card.querySelector('.status-toggle');
        if(badge){
            badge.textContent = newStatus;
            badge.className = 'status-badge ' + statusBadgeClass(newStatus);
        }
        card.setAttribute('data-status', (newStatus||'').toLowerCase());
    });
    document.body.addEventListener('htmx:afterRequest', function(){
        document.querySelectorAll('.status-menu').forEach(m=> m.classList.add('hidden'));
    });

    // Global console helpers for quick testing
    window.PrintTrackingTest = window.PrintTrackingTest || {};
    const getAfToken = () => {
        const form = document.getElementById('__afTokenSourcePT');
        if(!form) return null;
        const inp = form.querySelector('input[name="__RequestVerificationToken"]');
        return inp ? inp.value : null;
    };
    const postStatus = async (machineId, status) => {
        const token = getAfToken();
        const body = new URLSearchParams();
        body.append('machineId', machineId);
        body.append('status', status);
        const res = await fetch('/PrintTracking?handler=UpdateMachineStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token || ''
            },
            body
        });
        if(!res.ok) throw new Error('Status POST failed: '+res.status);
        // Do not auto-refresh immediately; optimistic UI already updated
        return true;
    };
    window.PrintTrackingTest.setStatus = (machineId, status) => postStatus(machineId, status);
    window.PrintTrackingTest.simulateCooldownElapsed = async (machineId) => {
        try {
            await postStatus(machineId, 'Cooling');
        } catch(err){ console.error(err); }
    };
    window.PrintTrackingTest.simulateUrgent = async (machineId, minutes) => {
        try {
            await postStatus(machineId, 'Urgent');
            const card = document.querySelector(`.machine-card[data-status][data-machine-id="${machineId}"]`);
            if(card){ card.setAttribute('data-status','urgent'); }
        } catch(err){ console.error(err); }
    };
    window.PrintTrackingTest.refresh = () => refreshDashboardDebounced();
})();

// Ensure initialization runs so event listeners are attached
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){
        if(window.PrintTracking && typeof window.PrintTracking.init === 'function') window.PrintTracking.init();
    });
} else {
    if(window.PrintTracking && typeof window.PrintTracking.init === 'function') window.PrintTracking.init();
}
</script>