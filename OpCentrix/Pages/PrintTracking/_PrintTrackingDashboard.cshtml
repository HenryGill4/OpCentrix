@using OpCentrix.ViewModels.PrintTracking
@using OpCentrix.Models
@model PrintTrackingDashboardViewModel

<!-- Modernized Print Tracking Dashboard (Enhanced Production Styling) -->
<div id="dashboard-content" class="space-y-6 md:space-y-8 stagger-animation">
    <!-- Role-Based Header with Reduced Height -->
    <style>
        .p-5 { padding: 1.25rem !important; }
    </style>
    @if (ViewBag.IsAdminView == true)
    {
        <!-- Admin View Header - Compact professional admin theme -->
        <div class="relative overflow-hidden rounded-xl p-4 md:p-5 text-white shadow-lg bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 scale-in">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_20%,white,transparent_60%)]"></div>
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_70%_80%,white,transparent_50%)]"></div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between relative z-10 gap-4 md:gap-0">
                <div class="flex-1">
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight flex items-center gap-2 mb-1">
                        <span class="text-gradient-white">SLS Print Tracking</span>
                        <span class="px-2 py-1 text-xs font-bold rounded-full bg-white/25 backdrop-blur border border-white/40 hover-scale">ADMIN</span>
                    </h2>
                    <p class="text-blue-100 text-sm md:text-base font-medium">Complete system oversight and control</p>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wide text-blue-200 font-semibold">System Administrator</div>
                    <div class="font-bold text-base md:text-lg text-white">@Model.OperatorName</div>
                    <div class="text-xs text-blue-200 mt-0.5">
                        <span class="inline-flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" /></svg>
                            @DateTime.Now.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2 relative z-10">
                <button onclick="openSchedulerIntegrationPanel()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Scheduler
                    </span>
                </button>
                <button onclick="refreshAllData()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Refresh
                    </span>
                </button>
                <a href="/Admin/Machines" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        Manage
                    </span>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Operator View Header - Compact friendly operator theme -->
        <div class="relative overflow-hidden rounded-xl p-4 md:p-5 text-white shadow-lg bg-gradient-to-br from-green-600 via-green-700 to-emerald-800 scale-in">
            <div class="absolute inset-0 opacity-15 bg-[radial-gradient(circle_at_70%_30%,white,transparent_55%)]"></div>
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_20%_80%,white,transparent_45%)]"></div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between relative z-10 gap-4 md:gap-0">
                <div class="flex-1">
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-1">SLS Print Operations</h2>
                    <p class="text-green-100 text-sm md:text-base font-medium">Your daily print tracking dashboard</p>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wide text-green-200 font-semibold">Print Operator</div>
                    <div class="font-bold text-base md:text-lg text-white">@Model.OperatorName</div>
                    <div class="text-xs text-green-200 mt-0.5">
                        <span class="inline-flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
                            @DateTime.Now.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2 relative z-10">
                <button onclick="quickStartPrint()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        Quick Start
                    </span>
                </button>
                <button onclick="viewMySchedule()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        My Schedule
                    </span>
                </button>
            </div>
        </div>
    }

    <!-- Enhanced Quick Stats with improved visual hierarchy -->
    <div class="stats-grid fade-in">
        <div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-200/70 p-6 hover-lift transition-all hover:shadow-lg">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 text-white group-hover:scale-110 transition-transform">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 font-bold">Active SLS Builds</div>
                    <div class="text-2xl font-bold text-gray-900 mt-1">@Model.ActiveBuilds.Count</div>
                    <div class="text-xs text-gray-500 mt-1">Currently printing</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-200/70 p-6 hover-lift transition-all hover:shadow-lg">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-green-500 to-green-600 text-white group-hover:scale-110 transition-transform">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 font-bold">Completed Today</div>
                    <div class="text-2xl font-bold text-gray-900 mt-1">@Model.RecentCompletedBuilds.Count</div>
                    <div class="text-xs text-gray-500 mt-1">SLS builds finished</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-200/70 p-6 hover-lift transition-all hover:shadow-lg">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 text-white group-hover:scale-110 transition-transform">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 font-bold">SLS Hours Today</div>
                    <div class="text-2xl font-bold text-gray-900 mt-1">@Model.HoursToday.Values.Sum().ToString("F1")</div>
                    <div class="text-xs text-gray-500 mt-1">Production hours</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-200/70 p-6 hover-lift transition-all hover:shadow-lg">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 text-white group-hover:scale-110 transition-transform">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 font-bold">@(ViewBag.IsAdminView == true ? "Total Issues" : "Issues Today")</div>
                    <div class="text-2xl font-bold text-gray-900 mt-1">@Model.TotalDelaysToday</div>
                    <div class="text-xs text-gray-500 mt-1">Delays reported</div>
                </div>
            </div>
        </div>
    </div>

    <!-- SLS Machine Status Overview with Enhanced Visual Design -->
    <div class="bg-white shadow-lg rounded-2xl border border-gray-200 overflow-hidden fade-in">
        <div class="px-6 pt-6 pb-4 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-gray-900 flex items-center gap-3">
                        <span class="relative">SLS Machine Status & Schedule</span>
                        @if (Model.AvailableMachines?.Any() == true)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                                @Model.AvailableMachines.Count machines
                            </span>
                        }
                    </h3>
                    <p class="text-sm text-gray-600 mt-1 font-medium">Selective Laser Sintering printers with upcoming jobs</p>
                </div>
                <div class="flex items-center gap-3">
                    @if (ViewBag.IsAdminView == true)
                    {
                        <a href="/Admin/Machines" class="btn btn-primary text-sm px-4 py-2 rounded-xl flex items-center gap-2 transition-all hover-lift">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span>Manage Machines</span>
                        </a>
                        <a href="/Scheduler?machineType=SLS" class="btn btn-primary text-sm px-4 py-2 rounded-xl flex items-center gap-2 transition-all hover-lift">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span>Full Scheduler</span>
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="p-6" id="machine-summary">
            @if (Model.AvailableMachines?.Any() == true)
            {
                <div class="machine-grid">
                    @foreach (var machine in Model.AvailableMachines.OrderBy(m => m.Priority))
                    {
                        var activeCount = Model.ActiveJobsByPrinter.GetValueOrDefault(machine.MachineId, 0);
                        var utilization = Model.UtilizationByMachine.GetValueOrDefault(machine.MachineId, 0);
                        var activeBuild = Model.ActiveBuilds.FirstOrDefault(b => b.PrinterName == machine.MachineId);
                        var derivedStatus = (activeBuild != null || activeCount > 0) ? "Printing" : machine.Status;
                        <div class="machine-card" data-status="@derivedStatus.ToLower()">
                            <div class="p-5 flex flex-col h-full">
                                <!-- Enhanced Machine Header -->
                                <div class="flex items-start justify-between mb-4">
                                    <div class="min-w-0 flex-1">
                                        <h4 class="font-bold text-gray-900 text-lg flex items-center flex-wrap gap-2 mb-1">
                                            <span class="truncate max-w-[140px]">@machine.MachineId</span>
                                            @if (machine.Priority <= 2) { <span class="status-badge bg-gradient-to-r from-red-500 to-red-600 text-white text-xs px-2 py-1 rounded-full">Priority</span>; }
                                            <span class="status-badge bg-gradient-to-r from-blue-500 to-blue-600 text-white text-xs px-2 py-1 rounded-full">SLS</span>
                                        </h4>
                                        <p class="text-sm text-gray-600 truncate font-medium">@machine.MachineName</p>
                                        @if (ViewBag.IsAdminView == true && !string.IsNullOrEmpty(machine.Location)) {
                                            <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                                @machine.Location
                                            </p>
                                        }
                                    </div>
                                    <div class="flex flex-col items-end gap-2">
                                        <span class="status-badge @GetStatusBadgeClasses(derivedStatus)">@derivedStatus</span>
                                        @if (utilization > 0) { <div class="text-xs text-gray-500 text-right"><div class="font-semibold">@utilization.ToString("F0")% utilized</div></div>; }
                                    </div>
                                </div>

                                <!-- Current Job Display (Fixed resolution) -->
                                @{ 
                                    // Resolve all scheduled jobs for this machine
                                    var scheduledJobsRaw = Model.ScheduledJobsByMachine?.GetValueOrDefault(machine.MachineId, new List<Job>()) ?? new List<Job>();
                                    Job? currentJob = null;
                                    if (activeBuild != null && activeBuild.AssociatedScheduledJobId.HasValue)
                                    {
                                        currentJob = scheduledJobsRaw.FirstOrDefault(j => j.Id == activeBuild.AssociatedScheduledJobId.Value);
                                    }
                                    if (currentJob == null)
                                    {
                                        currentJob = scheduledJobsRaw.FirstOrDefault(j => j.Status == "In Progress" || j.Status == "Building");
                                    }
                                }
                                @if (currentJob != null)
                                {
                                    <div class="mb-4">
                                        <div class="text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                                            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                            Current Job
                                            <span class="text-gray-500 font-semibold">(@currentJob.PartNumber)</span>
                                        </div>
                                        <div class="px-3 py-3 rounded-xl text-sm leading-tight border-l-4 bg-green-50 border-green-400">
                                            <div class="font-bold text-gray-900 flex items-center flex-wrap gap-2 mb-1">
                                                @currentJob.PartNumber
                                                @if (currentJob.GetType().GetProperty("StackLevel") != null) { var slProp = currentJob.GetType().GetProperty("StackLevel"); var slVal = slProp?.GetValue(currentJob); if (slVal != null) { <span class="px-2 py-1 bg-white text-gray-700 rounded-lg text-xs font-bold border">@slVal x</span>; } }
                                                <span class="status-badge bg-gradient-to-r from-green-500 to-green-600 text-white text-xs px-2 py-1 rounded-full">ACTIVE</span>
                                                @if (currentJob.Quantity > 1) { <span class="text-gray-600 font-semibold">(&times;@currentJob.Quantity)</span>; }
                                            </div>
                                            <div class="text-xs text-gray-600 flex items-center flex-wrap gap-3">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    @GetJobTimeDisplay(currentJob, true)
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                                    @currentJob.EstimatedHours.ToString("F1")h
                                                </span>
                                                @if (currentJob.Priority <= 2) { <span class="text-red-600 font-bold flex items-center gap-1"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>P@currentJob.Priority</span>; }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Detailed Active Build Card -->
                                @if (activeBuild != null)
                                {
                                    var elapsed = DateTime.Now - activeBuild.ActualStartTime;
                                    double? est = activeBuild.OperatorEstimatedHours.HasValue ? (double)activeBuild.OperatorEstimatedHours.Value : null;
                                    var pct = est.HasValue && est.Value > 0 ? Math.Min(100, (elapsed.TotalHours / est.Value) * 100) : (double?)null;
                                    <div class="mb-4 rounded-xl border-2 border-blue-200 bg-gradient-to-br from-blue-50 to-blue-100 p-4 text-sm">
                                        <div class="flex justify-between items-start mb-3">
                                            <div class="font-bold text-blue-900 truncate flex-1">
                                                Build #@activeBuild.BuildId
                                                @if (!string.IsNullOrEmpty(activeBuild.Part?.PartNumber)) { <span class="text-gray-700 font-semibold">- @activeBuild.Part.PartNumber</span>; }
                                            </div>
                                            <button data-action="complete-print" data-build-id="@activeBuild.BuildId" data-printer="@machine.MachineId" class="ml-3 px-3 py-1.5 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white rounded-lg text-xs font-bold transition-all hover-lift">Complete</button>
                                        </div>
                                        <div class="grid grid-cols-3 gap-3 text-xs text-gray-700 mb-3">
                                            <div><div class="font-semibold text-gray-600">Started</div><div class="font-bold">@activeBuild.ActualStartTime.ToString("MM/dd HH:mm")</div></div>
                                            <div><div class="font-semibold text-gray-600">Elapsed</div><div class="font-bold">@elapsed.TotalHours.ToString("F1")h</div></div>
                                            @if (est.HasValue) { <div><div class="font-semibold text-gray-600">Estimated</div><div class="font-bold">@est.Value.ToString("F1")h</div></div>; }
                                        </div>
                                        @if (pct.HasValue)
                                        {
                                            <div>
                                                <div class="flex justify-between text-xs text-gray-700 mb-2"><span class="font-semibold">Progress</span><span class="font-bold">@pct.Value.ToString("F0")%</span></div>
                                                <div class="progress-container h-3 bg-gray-300 rounded-full overflow-hidden">
                                                    <div class="progress-bar h-3 rounded-full transition-all duration-500 @(pct>100?"bg-gradient-to-r from-red-500 to-red-600":pct>80?"bg-gradient-to-r from-yellow-500 to-yellow-600":"bg-gradient-to-r from-blue-500 to-blue-600")" style="width: @Math.Min(100,pct.Value)%"></div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Material -->
                                @if (!string.IsNullOrEmpty(machine.CurrentMaterial))
                                {
                                    <div class="mb-4 px-3 py-2 bg-gradient-to-r from-gray-100 to-gray-200 rounded-xl text-sm flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"/></svg>
                                        <span class="font-bold text-gray-800">Material:</span>
                                        <span class="text-gray-700 font-semibold">@machine.CurrentMaterial</span>
                                    </div>
                                }

                                <!-- Upcoming (exclude current/running) -->
                                @{ var upcomingJobs = (Model.ScheduledJobsByMachine?.GetValueOrDefault(machine.MachineId, new List<Job>()) ?? new List<Job>())
                                        .Where(j => (currentJob == null || j.Id != currentJob.Id) && !(j.Status == "In Progress" || j.Status == "Building") && j.ScheduledStart > DateTime.Now)
                                        .OrderBy(j => j.ScheduledStart)
                                        .ToList();
                                   var nextJob = upcomingJobs.FirstOrDefault(); }
                                @if (upcomingJobs.Any())
                                {
                                    <div class="mb-4">
                                        <div class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-2">
                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            Upcoming Jobs <span class="text-gray-500 font-semibold">(@upcomingJobs.Count)</span>
                                        </div>
                                        <div class="space-y-2">
                                            @for (int i=0;i<Math.Min(2, upcomingJobs.Count);i++)
                                            {
                                                var job = upcomingJobs[i];
                                                var isNext = i == 0;
                                                <div class="px-3 py-3 rounded-xl text-sm leading-tight border-l-4 @GetJobCardClasses(isNext, false, false)">
                                                    <div class="flex items-start justify-between gap-3">
                                                        <div class="flex-1 min-w-0">
                                                            <div class="font-bold text-gray-900 truncate flex items-center flex-wrap gap-2 mb-1">
                                                                @job.PartNumber
                                                                @if (job.GetType().GetProperty("StackLevel") != null) { var slProp = job.GetType().GetProperty("StackLevel"); var slVal = slProp?.GetValue(job); if (slVal != null) { <span class="px-2 py-1 bg-white text-gray-700 rounded-lg text-xs font-bold border">@slVal x</span>; } }
                                                                @if (isNext) { <span class="status-badge bg-gradient-to-r from-blue-500 to-blue-600 text-white text-xs px-2 py-1 rounded-full">NEXT</span>; }
                                                                @if (job.Quantity > 1) { <span class="text-gray-600 font-semibold">(&times;@job.Quantity)</span>; }
                                                            </div>
                                                            <div class="text-xs text-gray-600 flex items-center flex-wrap gap-3">
                                                                <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>@GetJobTimeDisplay(job, false)</span>
                                                                <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>@job.EstimatedHours.ToString("F1")h</span>
                                                                @if (job.Priority <= 2) { <span class="text-red-600 font-bold flex items-center gap-1"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>P@job.Priority</span>; }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            @if (upcomingJobs.Count > 2)
                                            { <div class="text-sm text-center text-gray-600 py-2 bg-gray-50 rounded-xl">+@(upcomingJobs.Count - 2) more jobs <a href="/Scheduler?machine=@machine.MachineId" class="text-blue-600 hover:text-blue-700 ml-2 inline-flex items-center gap-1 font-semibold transition-colors"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6a4 4 0 103.446 6.032l4.261 4.26 1.414-1.414-4.26-4.261A4 4 0 0010 6z"/></svg>View All</a></div>; }
                                        </div>
                                    </div>
                                }
                                else if (currentJob == null && activeBuild == null)
                                {
                                    <div class="mb-4 text-sm text-center text-gray-500 py-4 border-2 border-dashed border-gray-300 rounded-xl bg-gray-50">
                                        <svg class="w-8 h-8 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        <div class="font-semibold text-gray-600 mb-2">No upcoming jobs</div>
                                        <button data-action="schedule-job" data-machine="@machine.MachineId" class="btn btn-primary text-xs px-3 py-1.5 rounded-lg font-semibold hover-lift transition-all">
                                            <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>Schedule Job</span>
                                        </button>
                                    </div>
                                }
                                <!-- Enhanced Maintenance Alerts -->
                                @if (machine.MaintenanceStatus == "Due")
                                { <div class="mb-4 px-3 py-2 bg-gradient-to-r from-red-100 to-red-200 text-red-800 rounded-xl text-sm flex items-center gap-2 border border-red-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86A2 2 0 0021 17.1L12.93 4.6a2 2 0 00-3.86 0L3 17.1A2 2 0 005.07 19z"/></svg><span class="font-bold">Maintenance Due</span></div>; }
                                else if (machine.MaintenanceStatus == "Soon")
                                { <div class="mb-4 px-3 py-2 bg-gradient-to-r from-yellow-100 to-yellow-200 text-yellow-800 rounded-xl text-sm flex items-center gap-2 border border-yellow-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01m6-4a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span class="font-bold">Service Soon</span></div>; }
                                <!-- Enhanced Action Buttons -->
                                <div class="mt-auto pt-3 flex gap-2">
                                    @if (machine.IsActive && machine.IsAvailableForScheduling)
                                    {
                                        <button data-action="start-print" data-printer="@machine.MachineId" class="btn btn-success flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift">@(ViewBag.IsAdminView==true?"Start Print":"Start Build")</button>
                                        @if (activeCount > 0)
                                        { <button data-action="complete-print" data-printer="@machine.MachineId" class="btn btn-danger flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift">@(ViewBag.IsAdminView==true?"Complete":"Finish")</button>; }
                                        else
                                        { <button data-action="schedule-job" data-machine="@machine.MachineId" class="btn btn-primary flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift inline-flex items-center justify-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>Schedule</button>; }
                                    }
                                    else
                                    { <div class="flex-1 text-sm px-3 py-2 bg-gradient-to-r from-gray-300 to-gray-400 text-gray-600 rounded-xl text-center font-bold">@(machine.IsActive?"Unavailable":"Offline")</div>; }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            { <div class="text-center py-16 text-gray-500"><svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><div class="text-lg font-semibold text-gray-600 mb-2">No SLS Machines Available</div><div class="text-sm text-gray-500">Check back later or contact an administrator</div></div>; }
        </div>
    </div>

    <!-- Enhanced Recent Activity Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 fade-in">
        <div class="bg-white shadow-lg rounded-2xl border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-green-50 to-green-100">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Recent SLS Completions
                </h3>
            </div>
            <div class="p-6">
                @if (Model.RecentCompletedBuilds.Any())
                {
                    <div class="space-y-3">
                        @foreach (var build in Model.RecentCompletedBuilds.Take(5))
                        {
                            <div class="flex items-center justify-between py-3 px-4 border border-gray-200 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all hover-lift">
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-bold text-gray-900 truncate">
                                        @if (ViewBag.IsAdminView == true) { <span>Build #@build.BuildId - @build.PrinterName</span> } else { <span>@build.PrinterName Build</span> }
                                        @if (!string.IsNullOrEmpty(build.Part?.PartNumber)) { <span class="text-gray-600 font-semibold">(@build.Part.PartNumber)</span> }
                                    </div>
                                    <div class="text-xs text-gray-500 flex flex-wrap gap-3 mt-1">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            @(build.CompletedAt?.ToString("HH:mm") ?? "Unknown")
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                            (@(build.PrintDuration?.TotalHours.ToString("F1") ?? "?")h)
                                        </span>
                                        @if (build.User != null && ViewBag.IsAdminView == true) { 
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                                by @build.User.FullName
                                            </span>
                                        }
                                    </div>
                                </div>
                                <span class="status-badge @GetStatusBadgeClasses(build.Status)">@build.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 text-gray-500">
                        <svg class="w-12 h-12 mx-auto text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <div class="font-semibold text-gray-600">No SLS builds completed today</div>
                        <div class="text-sm text-gray-500 mt-1">Completed builds will appear here</div>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white shadow-lg rounded-2xl border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-amber-50 to-amber-100">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m6-4a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    @(ViewBag.IsAdminView == true ? "Recent Issues" : "Today's Issues")
                </h3>
            </div>
            <div class="p-6">
                @if (Model.RecentDelays.Any())
                {
                    <div class="space-y-3">
                        @foreach (var delay in Model.RecentDelays.Take(5))
                        {
                            <div class="flex items-center justify-between py-3 px-4 border border-gray-200 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all hover-lift">
                                <div class="flex-1">
                                    <div class="text-sm font-bold text-gray-900">@delay.DelayReason</div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        @if (ViewBag.IsAdminView == true) { 
                                            <span>Build #@delay.BuildId - @delay.DelayDuration min delay</span>
                                        } else { 
                                            <span>@delay.DelayDuration minutes delay</span>
                                        }
                                    </div>
                                </div>
                                <span class="status-badge bg-gradient-to-r from-yellow-400 to-yellow-500 text-yellow-900 text-xs px-3 py-1 rounded-full">
                                    @delay.CreatedAt.ToString("HH:mm")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 text-gray-500">
                        <svg class="w-12 h-12 mx-auto text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <div class="font-semibold text-gray-600">No issues recorded today</div>
                        <div class="text-sm text-gray-500 mt-1">Issues and delays will appear here</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Enhanced Performance Metrics (Admin Only) -->
    @if (ViewBag.IsAdminView == true && (Model.OverallEfficiency > 0 || Model.QualityScore > 0))
    {
        <div class="bg-white shadow-lg rounded-2xl border border-gray-200 overflow-hidden fade-in">
            <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-purple-50 to-purple-100">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    SLS Performance Metrics 
                    <span class="text-sm font-normal text-gray-500">Administrator Only</span>
                </h3>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    @if (Model.OverallEfficiency > 0)
                    {
                        <div class="text-center">
                            <div class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-blue-800 bg-clip-text text-transparent mb-2">
                                @Model.OverallEfficiency.ToString("F1")%
                            </div>
                            <div class="text-sm uppercase tracking-wide text-gray-600 font-bold">SLS Fleet Efficiency</div>
                            <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full transition-all duration-500" style="width: @Model.OverallEfficiency.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                    @if (Model.QualityScore > 0)
                    {
                        <div class="text-center">
                            <div class="text-4xl font-bold bg-gradient-to-r from-green-600 to-green-800 bg-clip-text text-transparent mb-2">
                                @Model.QualityScore.ToString("F1")%
                            </div>
                            <div class="text-sm uppercase tracking-wide text-gray-600 font-bold">Print Quality Score</div>
                            <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full transition-all duration-500" style="width: @Model.QualityScore.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                    @if (Model.PartsProducedToday > 0)
                    {
                        <div class="text-center">
                            <div class="text-4xl font-bold bg-gradient-to-r from-purple-600 to-purple-800 bg-clip-text text-transparent mb-2">
                                @Model.PartsProducedToday
                            </div>
                            <div class="text-sm uppercase tracking-wide text-gray-600 font-bold">SLS Parts Produced</div>
                            <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-gradient-to-r from-purple-500 to-purple-600 h-2 rounded-full transition-all duration-500" style="width: @(Math.Min(100, Model.PartsProducedToday * 2))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@functions {
    private string GetMachineCardClasses(string status) => status?.ToLower() switch
    {
        "running" or "building" or "printing" => "border-orange-200 bg-orange-50",
        "idle" => "border-green-200 bg-green-50",
        "maintenance" => "border-gray-200 bg-gray-50",
        "error" or "offline" => "border-red-200 bg-red-50",
        _ => "border-gray-200"
    };

    private string GetStatusBadgeClasses(string status) => status?.ToLower() switch
    {
        "idle" => "bg-green-100 text-green-800",
        "running" or "building" or "printing" => "bg-orange-100 text-orange-800",
        "completed" => "bg-green-100 text-green-800",
        "maintenance" => "bg-gray-100 text-gray-800",
        "error" or "offline" => "bg-red-100 text-red-800",
        "aborted" => "bg-red-100 text-red-800",
        "setup" => "bg-blue-100 text-blue-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetUtilizationBarClass(double utilization)
    {
        return utilization switch
        {
            >= 90 => "bg-red-500",
            >= 70 => "bg-yellow-500",
            >= 50 => "bg-blue-500",
            _ => "bg-green-500"
        };
    }

    private string GetJobCardClasses(bool isNext, bool isRunning, bool isOverdue)
        => isRunning ? "bg-green-50 border-l-2 border-green-400" :
           isOverdue ? "bg-red-50 border-l-2 border-red-400" :
           isNext ? "bg-blue-50 border-l-2 border-blue-400" :
           "bg-gray-50 border-l-2 border-gray-200";

    private string GetJobTimeDisplay(Job job, bool isRunning)
    {
        if (isRunning && job.ActualStart.HasValue)
        {
            var elapsed = DateTime.Now - job.ActualStart.Value;
            return $"Running {elapsed.TotalHours:F1}h";
        }
        if (job.ScheduledStart < DateTime.Now && !isRunning)
        {
            return $"Overdue {Math.Abs((DateTime.Now - job.ScheduledStart).TotalHours):F1}h";
        }
        if (job.ScheduledStart.Date == DateTime.Today)
            return $"Today {job.ScheduledStart:HH:mm}";
        if (job.ScheduledStart.Date == DateTime.Today.AddDays(1))
            return $"Tomorrow {job.ScheduledStart:HH:mm}";
        return job.ScheduledStart.ToString("MM/dd HH:mm");
    }
}

<script>
/* Enhanced Print Tracking Dashboard JavaScript with Scheduler Integration */
(function() {
    'use strict';
    
    console.log('?? [PRINT-TRACKING] Initializing enhanced dashboard with scheduler integration');
    
    // Global print tracking object
    window.PrintTracking = window.PrintTracking || {};
    
    // Initialize dashboard
    window.PrintTracking.init = function() {
        setupPrintTrackingActions();
        setupAutoRefresh();
        setupSchedulerCommunication();
        console.log('?? [PRINT-TRACKING] Enhanced dashboard with integrated schedule initialized successfully');
    };
    
    // Print tracking action buttons with enhanced job management
    function setupPrintTrackingActions() {
        // Start print buttons
        document.addEventListener('click', function(e) {
            if (e.target.matches('[data-action="start-print"]') || e.target.closest('[data-action="start-print"]')) {
                e.preventDefault();
                const button = e.target.matches('[data-action="start-print"]') ? e.target : e.target.closest('[data-action="start-print"]');
                const printerName = button.getAttribute('data-printer');
                const jobId = button.getAttribute('data-job-id'); // Optional: specific job to start
                handleStartPrint(printerName, jobId);
            }
            
            if (e.target.matches('[data-action="complete-print"]') || e.target.closest('[data-action="complete-print"]')) {
                e.preventDefault();
                const button = e.target.matches('[data-action="complete-print"]') ? e.target : e.target.closest('[data-action="complete-print"]');
                const printerName = button.getAttribute('data-printer');
                const buildId = button.getAttribute('data-build-id');
                const jobId = button.getAttribute('data-job-id'); // For completing specific scheduled job
                handleCompletePrint(printerName, buildId, jobId);
            }
            
            // NEW: Handle job scheduling from machine cards
            if (e.target.matches('[data-action="schedule-job"]') || e.target.closest('[data-action="schedule-job"]')) {
                e.preventDefault();
                const button = e.target.matches('[data-action="schedule-job"]') ? e.target : e.target.closest('[data-action="schedule-job"]');
                const machineId = button.getAttribute('data-machine');
                handleScheduleJob(machineId);
            }
        });
    }
    
    // Auto refresh functionality
    function setupAutoRefresh() {
        const refreshInterval = 30000; // 30 seconds
        
        setInterval(function() {
            // Check if any modals are open
            const openModals = document.querySelectorAll('.modal:not(.hidden), [style*="display: flex"]');
            if (openModals.length > 0) {
                console.log('?? [AUTO-REFRESH] Skipping refresh - modal is open');
                return;
            }
            
            console.log('?? [AUTO-REFRESH] Refreshing dashboard data');
            
            // Use HTMX to refresh dashboard content
            if (typeof htmx !== 'undefined') {
                htmx.ajax('GET', '/PrintTracking?handler=RefreshDashboard', {
                    target: '#dashboard-content',
                    swap: 'innerHTML'
                }).catch((error) => {
                    console.warn('Auto-refresh failed (this is normal if page is navigating):', error);
                });
            }
        }, refreshInterval);
    }
    
    // Scheduler communication setup
    function setupSchedulerCommunication() {
        // Listen for scheduler messages
        window.addEventListener('message', function(e) {
            if (e.origin === window.location.origin) {
                const data = e.data;
                
                if (data.type === 'schedulerJobUpdated') {
                    handleSchedulerJobUpdate(data);
                } else if (data.type === 'requestPrintTrackingRefresh') {
                    refreshDashboard();
                }
            }
        });
        
        console.log('?? [SCHEDULER-COMM] Communication setup complete');
    }
    
    // Handle start print action (enhanced with job ID support)
    function handleStartPrint(printerName, jobId = null) {
        console.log('?? [START-PRINT] Starting print for printer:', printerName, 'jobId:', jobId);
        
        if (!printerName) {
            showToast('Error: No printer specified', 'error');
            return;
        }
        
        try {
            showLoadingIndicator('Loading start print form...');
            
            const params = new URLSearchParams();
            params.append('printerName', printerName);
            if (jobId) params.append('jobId', jobId);
            
            // Open start print modal
            if (typeof htmx !== 'undefined') {
                htmx.ajax('GET', `/PrintTracking?handler=StartPrintModal&${params.toString()}`, {
                    target: '#modal-container',
                    swap: 'innerHTML'
                }).then(() => {
                    showModal();
                    hideLoadingIndicator();
                }).catch((error) => {
                    hideLoadingIndicator();
                    console.error('? [START-PRINT] Error loading start print modal:', </style>error);
                    showToast('Error loading start print form', 'error');
                });
            } else {
                hideLoadingIndicator();
                showToast('System error: HTMX not available', 'error');
            }
            
        } catch (error) {
            hideLoadingIndicator();
            console.error('? [START-PRINT] Error in handleStartPrint:', error);
            showToast('Error starting print process', 'error');
        }
    }
    
    // Handle complete print action (enhanced with job ID support)
    function handleCompletePrint(printerName, buildId = null, jobId = null) {
        console.log('?? [COMPLETE-PRINT] Completing print for printer:', printerName, 'buildId:', buildId, 'jobId:', jobId);
        
        if (!printerName && !buildId && !jobId) {
            showToast('Error: No printer, build ID, or job ID specified', 'error');
            return;
        }
        
        try {
            showLoadingIndicator('Loading completion form...');
            
            const params = new URLSearchParams();
            if (buildId) params.append('buildId', buildId);
            if (printerName) params.append('printerName', printerName);
            if (jobId) params.append('jobId', jobId);
            
            // Open complete print modal
            if (typeof htmx !== 'undefined') {
                htmx.ajax('GET', `/PrintTracking?handler=PostPrintModal&${params.toString()}`, {
                    target: '#modal-container',
                    swap: 'innerHTML'
                }).then(() => {
                    showModal();
                    hideLoadingIndicator();
                }).catch((error) => {
                    hideLoadingIndicator();
                    console.error('? [COMPLETE-PRINT] Error loading completion modal:', error);
                    showToast('Error loading completion form', 'error');
                });
            } else {
                hideLoadingIndicator();
                showToast('System error: HTMX not available', 'error');
            }
            
        } catch (error) {
            hideLoadingIndicator();
            console.error('? [COMPLETE-PRINT] Error in handleCompletePrint:', error);
            showToast('Error loading completion form', 'error');
        }
    }

    // NEW: Handle job scheduling from machine cards
    function handleScheduleJob(machineId) {
        console.log('?? [SCHEDULE-JOB] Opening scheduler for machine:', machineId);
        
        if (!machineId) {
            showToast('Error: No machine specified', 'error');
            return;
        }
        
        // Open scheduler in new tab/window with machine pre-selected
        const schedulerUrl = `/Scheduler?handler=ShowAddModal&machineId=${encodeURIComponent(machineId)}&date=${new Date().toISOString().slice(0, 16)}`;
        
        // For admin users, open in modal; for operators, open in new window
        if (document.body.classList.contains('admin-view')) {
            try {
                showLoadingIndicator('Loading scheduler...');
                
                if (typeof htmx !== 'undefined') {
                    htmx.ajax('GET', schedulerUrl, {
                        target: '#modal-container',
                        swap: 'innerHTML'
                    }).then(() => {
                        showModal();
                        hideLoadingIndicator();
                    }).catch((error) => {
                        hideLoadingIndicator();
                        console.error('? [SCHEDULE-JOB] Error loading scheduler modal:', error);
                        
                        // Fallback to new window
                        window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank', 'width=1400,height=900,scrollbars=yes,resizable=yes');
                    });
                } else {
                    hideLoadingIndicator();
                    window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank', 'width=1400,height=900,scrollbars=yes,resizable=yes');
                }
            } catch (error) {
                hideLoadingIndicator();
                console.error('? [SCHEDULE-JOB] Error in handleScheduleJob:', error);
                window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank', 'width=1400,height=900,scrollbars=yes,resizable=yes');
            }
        } else {
            // Operators get new window
            window.open(`/Scheduler?machineType=SLS&machine=${machineId}`, '_blank', 'width=1400,height=900,scrollbars=yes,resizable=yes');
        }
    }

    // Expose functions globally for compatibility
    window.showToast = window.PrintTracking.showToast;
    window.handleStartPrint = handleStartPrint;
    window.handleCompletePrint = handleCompletePrint;
    window.handleScheduleJob = handleScheduleJob; // NEW: Expose job scheduling
    window.refreshDashboard = refreshDashboard;
</script>