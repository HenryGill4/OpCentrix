@using OpCentrix.ViewModels.PrintTracking
@using OpCentrix.Models
@model PrintTrackingDashboardViewModel

<!-- Modernized Print Tracking Dashboard (Enhanced Production Styling) -->
<div id="dashboard-content" class="space-y-6 md:space-y-8 stagger-animation">
    <form id="__afTokenSourcePT" style="display:none;">@Html.AntiForgeryToken()</form>
    <!-- Role-Based Header with Reduced Height -->
    <style>
        .p-5 { padding: 1.25rem !important; }
        /* Animated status effects bound by data-status on .machine-card */
        .machine-card { transition: box-shadow .35s ease, transform .35s ease; }
        @@keyframes pulse-orange { 0%,100%{ box-shadow: 0 0 0 0 rgba(251, 146, 60, .45);} 50%{ box-shadow: 0 0 0 8px rgba(251, 146, 60, .05);} }
        @@keyframes glow-orange  { 0%,100%{ box-shadow: 0 0 12px rgba(251, 146, 60, .35);} 50%{ box-shadow: 0 0 22px rgba(251, 146, 60, .55);} }
        @@keyframes pulse-blue   { 0%,100%{ box-shadow: 0 0 0 0 rgba(59, 130, 246, .45);} 50%{ box-shadow: 0 0 0 8px rgba(59, 130, 246, .07);} }
        @@keyframes pulse-red    { 0%,100%{ box-shadow: 0 0 0 0 rgba(220, 38, 38, .45);} 50%{ box-shadow: 0 0 0 10px rgba(220, 38, 38, .06);} }
        @@keyframes pulse-gray   { 0%,100%{ box-shadow: 0 0 0 0 rgba(107, 114, 128, .35);} 50%{ box-shadow: 0 0 0 6px rgba(107, 114, 128, .05);} }
        .machine-card[data-status="preheating"] { animation: pulse-orange 1.6s ease-in-out infinite; }
        .machine-card[data-status="printing"]   { animation: glow-orange 1.8s ease-in-out infinite; }
        .machine-card[data-status="cooling"]    { animation: pulse-blue 1.7s ease-in-out infinite; }
        .machine-card[data-status="urgent"]     { animation: pulse-red 1.5s ease-in-out infinite; }
        .machine-card[data-status="maintenance"]{ animation: pulse-gray 2.0s ease-in-out infinite; filter: saturate(.85); }
        .machine-card[data-status="idle"],
        .machine-card[data-status="offline"],
        .machine-card[data-status="error"]      { animation: none; }
    </style>
    @if (ViewBag.IsAdminView == true)
    {
        <!-- Admin View Header - Compact professional admin theme -->
        <div class="relative overflow-hidden rounded-xl p-4 md:p-5 text-white shadow-lg bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 scale-in">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_20%,white,transparent_60%)]"></div>
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_70%_80%,white,transparent_50%)]"></div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between relative z-10 gap-4 md:gap-0">
                <div class="flex-1">
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight flex items-center gap-2 mb-1">
                        <span class="text-gradient-white">SLS Print Tracking</span>
                        <span class="px-2 py-1 text-xs font-bold rounded-full bg-white/25 backdrop-blur border border-white/40 hover-scale">ADMIN</span>
                    </h2>
                    <p class="text-blue-100 text-sm md:text-base font-medium">Complete system oversight and control</p>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wide text-blue-200 font-semibold">System Administrator</div>
                    <div class="font-bold text-base md:text-lg text-white">@Model.OperatorName</div>
                    <div class="text-xs text-blue-200 mt-0.5">
                        <span class="inline-flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" /></svg>
                            @DateTime.Now.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2 relative z-10">
                <button onclick="openSchedulerIntegrationPanel()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
                        Scheduler
                    </span>
                </button>
                <button onclick="refreshAllData" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Refresh
                    </span>
                </button>
                <a href="/Admin/Machines" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        Manage
                    </span>
                </a>
                <button class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all" hx-get="/PrintTracking?handler=CreateTaskModal" hx-target="body" hx-swap="beforeend">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/></svg>
                        New Task
                    </span>
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Operator View Header - Compact friendly operator theme -->
        <div class="relative overflow-hidden rounded-xl p-4 md:p-5 text-white shadow-lg bg-gradient-to-br from-green-600 via-green-700 to-emerald-800 scale-in">
            <div class="absolute inset-0 opacity-15 bg-[radial-gradient(circle_at_70%_30%,white,transparent_55%)]"></div>
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_20%_80%,white,transparent_45%)]"></div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between relative z-10 gap-4 md:gap-0">
                <div class="flex-1">
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-1">SLS Print Operations</h2>
                    <p class="text-green-100 text-sm md:text-base font-medium">Your daily print tracking dashboard</p>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wide text-green-200 font-semibold">Print Operator</div>
                    <div class="font-bold text-base md:text-lg text-white">@Model.OperatorName</div>
                    <div class="text-xs text-green-200 mt-0.5">
                        <span class="inline-flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
                            @DateTime.Now.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2 relative z-10">
                <button onclick="quickStartPrint()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        Quick Start
                    </span>
                </button>
                <button onclick="viewMySchedule()" class="btn glass-effect px-3 py-1.5 rounded-lg text-xs font-semibold text-white backdrop-blur border border-white/30 hover-lift transition-all">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
                        My Schedule
                    </span>
                </button>
            </div>
        </div>
    }

    <!-- Global Notification Anchor (OOB swaps will target this) -->
    <div id="global-task-alert-container" class="relative z-40"></div>

    <!-- Enhanced Quick Stats with improved visual hierarchy -->
    <div class="stats-grid fade-in">
        <div class="group relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-sm border border-gray-200/70 dark:border-gray-700/70 p-6 hover-lift transition-all hover:shadow-lg duration-300">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 dark:from-blue-400 dark:to-blue-500 text-white group-hover:scale-110 transition-transform duration-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-bold transition-colors duration-300">Active SLS Builds</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1 transition-colors duration-300">@Model.ActiveBuilds.Count</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 transition-colors duration-300">Currently printing</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-sm border border-gray-200/70 dark:border-gray-700/70 p-6 hover-lift transition-all hover:shadow-lg duration-300">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-green-500 to-green-600 dark:from-green-400 dark:to-green-500 text-white group-hover:scale-110 transition-transform duration-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-bold transition-colors duration-300">Completed Today</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1 transition-colors duration-300">@Model.RecentCompletedBuilds.Count</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 transition-colors duration-300">SLS builds finished</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-sm border border-gray-200/70 dark:border-gray-700/70 p-6 hover-lift transition-all hover:shadow-lg duration-300">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 dark:from-purple-400 dark:to-purple-500 text-white group-hover:scale-110 transition-transform duration-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-bold transition-colors duration-300">SLS Hours Today</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1 transition-colors duration-300">@Model.HoursToday.Values.Sum().ToString("F1")</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 transition-colors duration-300">Production hours</div>
                </div>
            </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-sm border border-gray-200/70 dark:border-gray-700/70 p-6 hover-lift transition-all hover:shadow-lg duration-300">
            <div class="flex items-center gap-4">
                <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-500 text-white group-hover:scale-110 transition-transform duration-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m6-4a9 9 0 11-18 0 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-bold transition-colors duration-300">@(ViewBag.IsAdminView == true ? "Total Issues" : "Issues Today")</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1 transition-colors duration-300">@Model.TotalDelaysToday</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 transition-colors duration-300">Delays reported</div>
                </div>
            </div>
        </div>
    </div>

    <!-- SLS Machine Status Overview with Enhanced Visual Design -->
    <div class="bg-white dark:bg-gray-800 shadow-lg rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden fade-in transition-colors duration-300">
        <div class="px-6 pt-6 pb-4 border-b border-gray-100 dark:border-gray-600 bg-gradient-to-r from-gray-50 to-white dark:from-gray-700 dark:to-gray-600 transition-colors duration-300">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-3 transition-colors duration-300">
                        <span class="relative">SLS Machine Status & Schedule</span>
                        @if (Model.AvailableMachines?.Any() == true)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 transition-colors duration-300">
                                @Model.AvailableMachines.Count machines
                            </span>
                        }
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 font-medium transition-colors duration-300">Selective Laser Sintering printers with upcoming jobs</p>
                </div>
                <div class="flex items-center gap-3">
                    @if (ViewBag.IsAdminView == true)
                    {
                        <a href="/Admin/Machines" class="btn btn-primary text-sm px-4 py-2 rounded-xl flex items-center gap-2 transition-all hover-lift bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span>Manage Machines</span>
                        </a>
                        <a href="/Scheduler?machineType=SLS" class="btn btn-primary text-sm px-4 py-2 rounded-xl flex items-center gap-2 transition-all hover-lift bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
                            <span>Full Scheduler</span>
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="p-6" id="machine-summary">
            @if (Model.AvailableMachines?.Any() == true)
            {
                <div class="machine-grid">
                    @foreach (var machine in Model.AvailableMachines.OrderBy(m => m.Priority))
                    {
                        var activeCount = Model.ActiveJobsByPrinter.GetValueOrDefault(machine.MachineId, 0);
                        var utilization = Model.UtilizationByMachine.GetValueOrDefault(machine.MachineId, 0);
                        var activeBuild = Model.ActiveBuilds.FirstOrDefault(b => b.PrinterName == machine.MachineId);
                        // Manual override precedence
                        var manualRaw = (machine.Status ?? "").Trim();
                        var manualLower = manualRaw.ToLower();
                        bool manualOverride = manualLower == "maintenance" || manualLower == "offline" || manualLower == "error";
                        // Auto-derive status if no manual override
                        string derivedStatus = manualOverride ? manualRaw : (machine.Status ?? "Idle");
                        double? downtimeMinutes = null;
                        Func<string,int> getCool = (id) => id != null && id.ToUpper().StartsWith("INC") ? 120 : (id != null && id.ToUpper().StartsWith("TI") ? 60 : 90);
                        var now = DateTime.Now;
                        if (!manualOverride)
                        {
                            if (activeBuild != null)
                            {
                                // Compute estimated hours similar to progress card
                                var elapsed = now - activeBuild.ActualStartTime;
                                double? estOp = activeBuild.OperatorEstimatedHours.HasValue ? (double)activeBuild.OperatorEstimatedHours.Value : null;
                                var hasScheduledWindow = activeBuild.ScheduledStartTime.HasValue && activeBuild.ScheduledEndTime.HasValue;
                                var scheduledHours = hasScheduledWindow ? (activeBuild.ScheduledEndTime!.Value - activeBuild.ScheduledStartTime!.Value).TotalHours : 0.0;
                                var partEstHours = activeBuild.Part?.EstimatedHours ?? 0.0;
                                double estHours = (estOp.HasValue && estOp.Value > 0)
                                    ? estOp.Value
                                    : (scheduledHours > 0 ? scheduledHours
                                        : (partEstHours > 0 ? partEstHours
                                            : Math.Max(1.0, (elapsed.TotalHours > 0 ? elapsed.TotalHours : 1.0))));

                                var pctElapsed = (elapsed.TotalHours > 0 && estHours > 0) ? (elapsed.TotalHours / estHours) * 100.0 : 0.0;
                                // Always show Printing while active
                                derivedStatus = "Printing";
                            }
                            else
                            {
                                var recent = Model.RecentCompletedBuilds
                                    .Where(b => b.PrinterName == machine.MachineId && b.CompletedAt.HasValue)
                                    .OrderByDescending(b => b.CompletedAt)
                                    .FirstOrDefault();
                                if (recent != null)
                                {
                                    var cool = getCool(machine.MachineId);
                                    var minsSince = (now - recent.CompletedAt!.Value).TotalMinutes;
                                    if (minsSince < cool)
                                    {
                                        derivedStatus = "Cooling";
                                    }
                                    else
                                    {
                                        derivedStatus = "Urgent";
                                        downtimeMinutes = minsSince - cool;
                                    }
                                }
                                else
                                {
                                    // Fallback to current persisted status
                                    var s = (machine.Status ?? "Idle").Trim();
                                    if (!string.IsNullOrEmpty(s))
                                    {
                                        if (string.Equals(s, "Started", StringComparison.OrdinalIgnoreCase)) s = "Printing";
                                        if (string.Equals(s, "Downtime", StringComparison.OrdinalIgnoreCase)) s = "Urgent";
                                        derivedStatus = s;
                                    }
                                }
                            }
                        }
                        <div class="machine-card bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300" data-status="@derivedStatus.ToLower()" data-machine-id="@machine.MachineId" data-desired-status="@derivedStatus" data-current-status="@((machine.Status??""))">
                            <div class="p-5 flex flex-col h-full">
                                <!-- Enhanced Machine Header -->
                                <div class="flex items-start justify-between mb-4">
                                    <div class="min-w-0 flex-1">
                                        <h4 class="font-bold text-gray-900 dark:text-gray-100 text-lg flex items-center flex-wrap gap-2 mb-1 transition-colors duration-300">
                                            <span class="truncate max-w-[140px]">@machine.MachineId</span>
                                            @if (machine.Priority <= 2) { <span class="status-badge bg-gradient-to-r from-red-500 to-red-600 dark:from-red-400 dark:to-red-500 text-white text-xs px-2 py-1 rounded-full">Priority</span>; }
                                            <span class="status-badge bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-400 dark:to-blue-500 text-white text-xs px-2 py-1 rounded-full">SLS</span>
                                        </h4>
                                        <p class="text-sm text-gray-600 dark:text-gray-400 truncate font-medium transition-colors duration-300">@machine.MachineName</p>
                                        @if (ViewBag.IsAdminView == true && !string.IsNullOrEmpty(machine.Location)) {
                                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 flex items-center gap-1 transition-colors duration-300">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                                @machine.Location
                                            </p>
                                        }
                                    </div>
                                    <div class="flex flex-col items-end gap-2">
                                        <div class="relative inline-block text-left">
                                            <button type="button" class="status-badge @GetStatusBadgeClasses(derivedStatus) status-toggle" data-menu="status-menu-@machine.MachineId" aria-haspopup="true" aria-expanded="false">@derivedStatus</button>
                                            <div id="status-menu-@machine.MachineId" class="status-menu hidden absolute right-0 z-20 mt-2 w-40 origin-top-right rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 shadow-lg transition-colors duration-300">
                                                <div class="py-1">
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-amber-50 dark:hover:bg-amber-900/20 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Preheating" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Preheating"}' hx-swap="none">Preheating</button>
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-orange-50 dark:hover:bg-orange-900/20 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Printing" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Printing"}' hx-swap="none">Printing</button>
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-blue-50 dark:hover:bg-blue-900/20 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Cooling" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Cooling"}' hx-swap="none">Cooling</button>
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Idle" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Idle"}' hx-swap="none">Idle</button>
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-red-50 dark:hover:bg-red-900/20 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Urgent" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Urgent"}' hx-swap="none">Urgent</button>
                                                    <button class="w-full text-left px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 transition-colors duration-200" data-status-value="Maintenance" hx-post="?handler=UpdateMachineStatus" hx-include="#__afTokenSourcePT" hx-vals='{"machineId":"@machine.MachineId","status":"Maintenance"}' hx-swap="none">Maintenance</button>
                                                </div>
                                            </div>
                                        </div>
                                        @if (utilization > 0) { <div class="text-xs text-gray-500 dark:text-gray-400 text-right transition-colors duration-300"><div class="font-semibold">@utilization.ToString("F0")% utilized</div></div>; }
                                        @if (derivedStatus == "Urgent" && downtimeMinutes.HasValue)
                                        {
                                            <div class="text-xs font-bold text-red-600 dark:text-red-400 transition-colors duration-300">Downtime @FormatDowntime(downtimeMinutes.Value)</div>
                                        }
                                    </div>
                                </div>

                                <!-- Current Job Display (Fixed resolution) -->
                                @{ 
                                    // Resolve all scheduled jobs for this machine
                                    var scheduledJobsRaw = Model.ScheduledJobsByMachine?.GetValueOrDefault(machine.MachineId, new List<Job>()) ?? new List<Job>();
                                    Job? currentJob = null;
                                    if (activeBuild != null && activeBuild.AssociatedScheduledJobId.HasValue)
                                    {
                                        currentJob = scheduledJobsRaw.FirstOrDefault(j => j.Id == activeBuild.AssociatedScheduledJobId.Value);
                                    }
                                    if (currentJob == null)
                                    {
                                        currentJob = scheduledJobsRaw.FirstOrDefault(j => j.Status == "In Progress" || j.Status == "Building");
                                    }
                                }
                                @if (currentJob != null)
                                {
                                    <div class="mb-4">
                                        <div class="text-sm font-bold text-gray-800 dark:text-gray-200 mb-2 flex items-center gap-2 transition-colors duration-300">
                                            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                            Current Job
                                            <span class="text-gray-500 font-semibold">(@currentJob.PartNumber)</span>
                                        </div>
                                        <div class="px-3 py-3 rounded-xl text-sm leading-tight border-l-4 bg-green-50 dark:bg-green-900/20 border-green-400 dark:border-green-500 transition-colors duration-300">
                                            <div class="font-bold text-gray-900 dark:text-gray-100 flex items-center flex-wrap gap-2 mb-1 transition-colors duration-300">
                                                @currentJob.PartNumber
                                                @if (currentJob.GetType().GetProperty("StackLevel") != null) { var slProp = currentJob.GetType().GetProperty("StackLevel"); var slVal = slProp?.GetValue(currentJob); if (slVal != null) { <span class="px-2 py-1 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-lg text-xs font-bold border border-gray-300 dark:border-gray-600 transition-colors duration-300">@slVal x</span>; } }
                                                <span class="status-badge bg-gradient-to-r from-green-500 to-green-600 text-white text-xs px-2 py-1 rounded-full">ACTIVE</span>
                                                @if (currentJob.Quantity > 1) { <span class="text-gray-600 font-semibold">(&times;@currentJob.Quantity)</span>; }
                                            </div>
                                            <div class="text-xs text-gray-600 flex items-center flex-wrap gap-3">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    @GetJobTimeDisplay(currentJob, true)
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                                    @currentJob.EstimatedHours.ToString("F1")h
                                                </span>
                                                @if (currentJob.Priority <= 2) { <span class="text-red-600 dark:text-red-400 font-bold flex items-center gap-1 transition-colors duration-300"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>P@currentJob.Priority</span>; }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Detailed Active Build Card -->
                                @if (activeBuild != null)
                                {
                                    var elapsed = DateTime.Now - activeBuild.ActualStartTime;
                                    double? estOp = activeBuild.OperatorEstimatedHours.HasValue ? (double)activeBuild.OperatorEstimatedHours.Value : null;
                                    var hasScheduledWindow = activeBuild.ScheduledStartTime.HasValue && activeBuild.ScheduledEndTime.HasValue;
                                    var scheduledHours = hasScheduledWindow ? (activeBuild.ScheduledEndTime!.Value - activeBuild.ScheduledStartTime!.Value).TotalHours : 0.0;
                                    var partEstHours = activeBuild.Part?.EstimatedHours ?? 0.0;
                                    // Fallback chain: Operator estimate -> Scheduled window -> Part estimate -> Safe default
                                    double estHours = (estOp.HasValue && estOp.Value > 0)
                                        ? estOp.Value
                                        : (scheduledHours > 0 ? scheduledHours
                                            : (partEstHours > 0 ? partEstHours
                                                : Math.Max(1.0, (elapsed.TotalHours > 0 ? elapsed.TotalHours * 1.25 : 4.0))));
                                    // Primary: elapsed/estimate. Fallback: machine-reported progress if available.
                                    var pctElapsed = (elapsed.TotalHours > 0 && estHours > 0) ? (elapsed.TotalHours / estHours) * 100.0 : 0.0;
                                    double? opcPct = null;
                                    if (currentJob != null && currentJob.OpcUaBuildProgress > 0)
                                    {
                                        opcPct = currentJob.OpcUaBuildProgress;
                                    }
                                    double pct = pctElapsed;
                                    if (double.IsNaN(pct) || double.IsInfinity(pct) || pct <= 0 || pct > 250)
                                    {
                                        pct = opcPct ?? pctElapsed;
                                    }
                                    var pctDisplay = Math.Clamp(Math.Round(pct), 0, 110);
                                    var pctWidth = Math.Min(100.0, pctDisplay);
                                    <div class="mb-4 rounded-xl border-2 border-blue-200 dark:border-blue-600 bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/30 dark:to-blue-800/30 p-4 text-sm transition-colors duration-300">
                                        <div class="flex justify-between items-start mb-3">
                                            <div class="font-bold text-blue-900 dark:text-blue-100 truncate flex-1 transition-colors duration-300">
                                                Build #@activeBuild.BuildId
                                                @if (!string.IsNullOrEmpty(activeBuild.Part?.PartNumber)) { <span class="text-gray-700 dark:text-gray-300 font-semibold transition-colors duration-300">- @activeBuild.Part.PartNumber</span>; }
                                            </div>
                                            <button data-action="complete-print" data-build-id="@activeBuild.BuildId" data-printer="@machine.MachineId" class="ml-3 px-3 py-1.5 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 dark:from-red-500 dark:to-red-600 dark:hover:from-red-600 dark:hover:to-red-700 text-white rounded-lg text-xs font-bold transition-all hover-lift">Complete</button>
                                        </div>
                                        <div class="grid grid-cols-3 gap-3 text-xs text-gray-700 dark:text-gray-300 mb-3 transition-colors duration-300">
                                            <div><div class="font-semibold text-gray-600 dark:text-gray-400 transition-colors duration-300">Started</div><div class="font-bold">@activeBuild.ActualStartTime.ToString("MM/dd HH:mm")</div></div>
                                            <div><div class="font-semibold text-gray-600 dark:text-gray-400 transition-colors duration-300">Elapsed</div><div class="font-bold">@elapsed.TotalHours.ToString("F1")h</div></div>
                                            <div><div class="font-semibold text-gray-600 dark:text-gray-400 transition-colors duration-300">Estimated</div><div class="font-bold">@estHours.ToString("F1")h</div></div>
                                        </div>
                                        <div>
                                            <div class="flex justify-between text-xs text-gray-700 dark:text-gray-300 mb-2 transition-colors duration-300"><span class="font-semibold">Progress</span><span class="font-bold">@pctDisplay.ToString("F0")%</span></div>
                                            <div class="progress-container h-3 bg-gray-300 dark:bg-gray-600 rounded-full overflow-hidden transition-colors duration-300">
                                                <div class="progress-bar h-3 rounded-full transition-all duration-500 @(pctDisplay>100?"bg-gradient-to-r from-red-500 to-red-600":"bg-gradient-to-r from-blue-500 to-blue-600")" style="width: @pctWidth%"></div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Material -->
                                @if (!string.IsNullOrEmpty(machine.CurrentMaterial))
                                {
                                    <div class="mb-4 px-3 py-2 bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 rounded-xl text-sm flex items-center gap-2 transition-colors duration-300">
                                        <svg class="w-4 h-4 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"/></svg>
                                        <span class="font-bold text-gray-800 dark:text-gray-200 transition-colors duration-300">Material:</span>
                                        <span class="text-gray-700 dark:text-gray-300 font-semibold transition-colors duration-300">@machine.CurrentMaterial</span>
                                    </div>
                                }

                                <!-- Upcoming (exclude current/running) -->
                                @{ var upcomingJobs = (Model.ScheduledJobsByMachine?.GetValueOrDefault(machine.MachineId, new List<Job>()) ?? new List<Job>())
                                        .Where(j => (currentJob == null || j.Id != currentJob.Id) && !(j.Status == "In Progress" || j.Status == "Building") && j.ScheduledStart > DateTime.Now)
                                        .OrderBy(j => j.ScheduledStart)
                                        .ToList();
                                   var nextJob = upcomingJobs.FirstOrDefault(); }
                                @if (upcomingJobs.Any())
                                {
                                    <div class="mb-4">
                                        <div class="text-sm font-bold text-gray-800 dark:text-gray-200 mb-3 flex items-center gap-2 transition-colors duration-300">
                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
                                            Upcoming Jobs <span class="text-gray-500 font-semibold">(@upcomingJobs.Count)</span>
                                        </div>
                                        <div class="space-y-2">
                                            @for (int i=0;i<Math.Min(2, upcomingJobs.Count);i++)
                                            {
                                                var job = upcomingJobs[i];
                                                var isNext = i == 0;
                                                <div class="px-3 py-3 rounded-xl text-sm leading-tight border-l-4 @GetJobCardClasses(isNext, false, false)">
                                                    <div class="flex items-start justify-between gap-3">
                                                        <div class="flex-1 min-w-0">
                                                            <div class="font-bold text-gray-900 truncate flex items-center flex-wrap gap-2 mb-1">
                                                                @job.PartNumber
                                                                @if (job.GetType().GetProperty("StackLevel") != null) { var slProp = job.GetType().GetProperty("StackLevel"); var slVal = slProp?.GetValue(job); if (slVal != null) { <span class="px-2 py-1 bg-white text-gray-700 rounded-lg text-xs font-bold border">@slVal x</span>; } }
                                                                @if (isNext) { <span class="status-badge bg-gradient-to-r from-blue-500 to-blue-600 text-white text-xs px-2 py-1 rounded-full">NEXT</span>; }
                                                                @if (job.Quantity > 1) { <span class="text-gray-600 font-semibold">(&times;@job.Quantity)</span>; }
                                                            </div>
                                                            <div class="text-xs text-gray-600 flex items-center flex-wrap gap-3">
                                                                <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>@GetJobTimeDisplay(job, false)</span>
                                                                                                                                                                                                                                                                <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>@job.EstimatedHours.ToString("F1")h</span>
                                                                @if (job.Priority <= 2) { <span class="text-red-600 font-bold flex items-center gap-1"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>P@job.Priority</span>; }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            @if (upcomingJobs.Count > 2)
                                            { <div class="text-sm text-center text-gray-600 py-2 bg-gray-50 rounded-xl">+@(upcomingJobs.Count - 2) more jobs <a href="/Scheduler?machine=@machine.MachineId" class="text-blue-600 hover:text-blue-700 ml-2 inline-flex items-center gap-1 font-semibold transition-colors"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6a4 4 0 103.446 6.032l4.261 4.26 1.414-1.414-4.26-4.261A4 4 0 0010 6z"/></svg>View All</a></div>; }
                                        </div>
                                    </div>
                                }
                                else if (currentJob == null && activeBuild == null)
                                {
                                    <div class="mb-4 text-sm text-center text-gray-500 dark:text-gray-400 py-4 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700/50 transition-colors duration-300">
                                        <svg class="w-8 h-8 mx-auto text-gray-400 dark:text-gray-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
                                        <div class="font-semibold text-gray-600 dark:text-gray-300 mb-2 transition-colors duration-300">No upcoming jobs</div>
                                        <button data-action="schedule-job" data-machine="@machine.MachineId" data-printer="@machine.MachineId" class="btn btn-primary text-xs px-3 py-1.5 rounded-lg font-semibold hover-lift transition-all">
                                            <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>Schedule Job</span>
                                        </button>
                                    </div>
                                }
                                <!-- Enhanced Maintenance Alerts -->
                                @if (machine.MaintenanceStatus == "Due")
                                { <div class="mb-4 px-3 py-2 bg-gradient-to-r from-red-100 to-red-200 dark:from-red-900/30 dark:to-red-800/30 text-red-800 dark:text-red-200 rounded-xl text-sm flex items-center gap-2 border border-red-300 dark:border-red-600 transition-colors duration-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86A2 2 0 0021 17.1L12.93 4.6a2 2 0 00-3.86 0L3 17.1A2 2 0 005.07 19z"/></svg><span class="font-bold">Maintenance Due</span></div>; }
                                else if (machine.MaintenanceStatus == "Soon")
                                { <div class="mb-4 px-3 py-2 bg-gradient-to-r from-yellow-100 to-yellow-200 dark:from-yellow-900/30 dark:to-yellow-800/30 text-yellow-800 dark:text-yellow-200 rounded-xl text-sm flex items-center gap-2 border border-yellow-300 dark:border-yellow-600 transition-colors duration-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01m6-4a9 9 0 11-18 0 9 0 0118 0z"/></svg><span class="font-bold">Service Soon</span></div>; }
                                <!-- Maintenance summary strip -->
                                <div id="maint-strip-@machine.MachineId" class="mb-4" hx-get="/PrintTracking?handler=MaintenanceSummary&machineId=@machine.MachineId" hx-trigger="load" hx-swap="innerHTML">
                                    <div class="text-xs text-gray-400 dark:text-gray-500 animate-pulse transition-colors duration-300">Loading maintenance...</div>
                                </div>
                                <!-- Enhanced Action Buttons -->
                                <div class="mt-auto pt-3 flex gap-2">
                                    @if (machine.IsActive && machine.IsAvailableForScheduling)
                                    {
                                        <button data-action="start-print" data-printer="@machine.MachineId" class="btn btn-success flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift bg-green-600 dark:bg-green-500 hover:bg-green-700 dark:hover:bg-green-600 text-white">@(ViewBag.IsAdminView==true?"Start Print":"Start Build")</button>
                                        @if (activeCount > 0)
                                        { <button data-action="complete-print" data-printer="@machine.MachineId" class="btn btn-danger flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift bg-red-600 dark:bg-red-500 hover:bg-red-700 dark:hover:bg-red-600 text-white">@(ViewBag.IsAdminView==true?"Complete":"Finish")</button>; }
                                        else
                                        { <button data-action="schedule-job" data-machine="@machine.MachineId" data-printer="@machine.MachineId" class="btn btn-primary flex-1 text-sm px-3 py-2 rounded-xl font-bold transition-all hover-lift inline-flex items-center justify-center gap-1 bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>Schedule</button>; }
                                    }
                                    else
                                    { <div class="flex-1 text-sm px-3 py-2 bg-gradient-to-r from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 text-gray-600 dark:text-gray-300 rounded-xl text-center font-bold transition-colors duration-300">@(machine.IsActive?"Unavailable":"Offline")</div>; }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            { <div class="text-center py-16 text-gray-500"><svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h2a2 2 0 002-2z"/></svg><div class="text-lg font-semibold text-gray-600 mb-2">No SLS Machines Available</div><div class="text-sm text-gray-500">Check back later or contact an administrator</div></div>; }
        </div>
    </div>

    <!-- Recent Activity Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 fade-in">
        <div class="bg-white dark:bg-gray-800 shadow-lg rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-colors duration-300">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-600 bg-gradient-to-r from-green-50 to-green-100 dark:from-green-900/30 dark:to-green-800/30 transition-colors duration-300">
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2 transition-colors duration-300">
                    <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Recent SLS Completions
                </h3>
            </div>
            <div class="p-6">
                @if (Model.RecentCompletedBuilds.Any())
                {
                    <div class="space-y-3">
                        @foreach (var build in Model.RecentCompletedBuilds.Take(5))
                        {
                            var durationHours = build.PrintDuration?.TotalHours ?? (build.CompletedAt.HasValue ? (build.CompletedAt.Value - build.ActualStartTime).TotalHours : 0);
                            <div class="flex items-center justify-between py-3 px-4 border border-gray-200 dark:border-gray-600 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 hover:border-gray-300 dark:hover:border-gray-500 transition-all hover-lift duration-200">
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-bold text-gray-900 dark:text-gray-100 truncate transition-colors duration-300">
                                        @if (ViewBag.IsAdminView == true) { <span>Build #@build.BuildId - @build.PrinterName</span> } else { <span>@build.PrinterName Build</span> }
