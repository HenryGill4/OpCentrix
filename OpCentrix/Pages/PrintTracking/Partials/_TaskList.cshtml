@model List<OpCentrix.Models.MaintenanceV2.OperationalTask>
@using System.Text.Json
@functions {
    public string AdjustBarColor(string original) => original switch { "bg-red-800" or "bg-red-700" => "bg-red-400", "bg-red-600" or "bg-red-500" => "bg-red-300", _ => original };
    public string PriorityLabel(int p) => p switch { 1 => "P1", 2 => "P2", 3 => "P3", 4 => "P4", 5 => "P5", _ => $"P{p}" };
    public string PriorityCss(int p) => p switch { 1 => "bg-red-500 text-white", 2 => "bg-orange-500 text-white", 3 => "bg-amber-300 text-amber-900", 4 => "bg-lime-300 text-lime-800", 5 => "bg-gray-300 text-gray-700", _ => "bg-gray-200 text-gray-700" };
}
@{
    var all = Model ?? new List<OpCentrix.Models.MaintenanceV2.OperationalTask>();
    var open = all.Where(t => t.Status == "Open" || t.Status == "InProgress").ToList();
    var completedRecurring = all.Where(t => t.Status == "Completed" && !string.IsNullOrEmpty(t.ConfigJson)).OrderByDescending(t => t.CompletedAt).Take(25).ToList();
    var newTaskId = ViewData["NewTaskId"] as int?; 
    var nowUtc = DateTime.UtcNow;
    var bannerTasks = open.Where(t => (t.DueAt.HasValue && t.DueAt.Value <= nowUtc) || (t.OverdueFlag ?? 0) == 1).OrderByDescending(t => t.OverdueFlag).ThenBy(t => t.DueAt ?? DateTime.MaxValue).Take(5).ToList();
    var bannerIds = bannerTasks.Select(x=>x.Id).ToHashSet();
    int dueCount = open.Count(t => t.DueAt.HasValue && t.DueAt.Value <= nowUtc && (t.OverdueFlag ?? 0) != 1);
    int overdueCount = open.Count(t => (t.OverdueFlag ?? 0) == 1 || (t.DueAt.HasValue && t.DueAt.Value < nowUtc));
    string ExtractProgressPercent(OpCentrix.Models.MaintenanceV2.OperationalTask t){ if (t.ProgressSummaries == null) return "0"; foreach (var ps in t.ProgressSummaries){ var lastToken = ps.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault(); if (lastToken != null && lastToken.Contains('/')){ var parts = lastToken.Split('/'); if (parts.Length == 2 && double.TryParse(parts[0], out var cur) && double.TryParse(new string(parts[1].TakeWhile(c => char.IsDigit(c) || c=='.').ToArray()), out var max) && max > 0){ return Math.Clamp(cur / max * 100.0, 0, 200).ToString("F0"); } } } return "0"; }
    string GetBarColor(int pct, bool isDue) => isDue ? "bg-red-600" : pct switch { >=150 => "bg-red-800", >=120 => "bg-red-700", >=100 => "bg-red-600", >=90 => "bg-red-500", >=75 => "bg-orange-500", >=60 => "bg-amber-500", >=40 => "bg-yellow-400", >=20 => "bg-lime-400", _ => "bg-green-500" };
}
<div id="task-list-wrapper" class="space-y-5" data-new-task-id="@(newTaskId?.ToString() ?? "")">

    @* Out-of-band alert banner *@
    @if (bannerTasks.Any()) {
        <div id="task-alert-banner" hx-swap-oob="innerHTML:#global-task-alert-container" class="mx-auto max-w-5xl px-4">
            <div class="rounded-xl border border-amber-300 bg-gradient-to-r from-amber-50 via-rose-50 to-red-50 shadow-md backdrop-blur p-4 mb-4" role="alert" aria-live="polite">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 text-amber-600" aria-hidden="true">
                        <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M5.07 19h13.86A2.07 2.07 0 0021 16.93L13.93 4.62a2.07 2.07 0 00-3.86 0L3 16.93A2.07 2.07 0 005.07 19z"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <h4 class="text-sm font-semibold text-amber-800">Tasks Requiring Attention (@bannerTasks.Count)</h4>
                            <div class="flex items-center gap-3 text-[11px]">
                                <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-medium">Due: @dueCount</span>
                                <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-medium">Overdue: @overdueCount</span>
                                <button type="button" data-toggle class="font-semibold text-amber-700 hover:text-amber-900 underline">Hide</button>
                                <button type="button" data-dismiss class="font-semibold text-amber-700 hover:text-amber-900">Dismiss</button>
                            </div>
                        </div>
                        <div id="banner-task-cards" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                            @foreach(var bt in bannerTasks){ var overdue = (bt.OverdueFlag ?? 0) == 1 || (bt.DueAt.HasValue && bt.DueAt.Value < nowUtc); var dueLocal = bt.DueAt?.ToLocalTime().ToString("MM-dd HH:mm") ?? "Due"; <div class="rounded-lg border @((overdue?"border-red-300 bg-white":"border-amber-200 bg-white")) p-3 flex flex-col gap-2 shadow-sm"><div class="flex items-center gap-2"><span class="truncate text-xs font-semibold text-gray-800" title="@bt.Title">@bt.Title</span><span class="text-[10px] px-1.5 py-0.5 rounded @PriorityCss(bt.Priority)">@PriorityLabel(bt.Priority)</span></div><div class="flex items-center gap-2 text-[10px]"><span class="px-1.5 py-0.5 rounded @(overdue?"bg-red-500 text-white":"bg-amber-200 text-amber-800")">@dueLocal</span>@if (overdue){<span class="px-1 py-0.5 rounded bg-red-100 text-red-700 border border-red-300 font-semibold">OVERDUE</span>}</div><form method="post" hx-post="/PrintTracking?handler=CompleteTask&id=@bt.Id" hx-target="#task-panel" hx-swap="innerHTML" class="mt-auto pt-1 text-right">@Html.AntiForgeryToken()<button type="submit" class="text-[11px] text-green-600 hover:text-green-800 font-semibold">Complete</button></form></div> }
                        </div>
                    </div>
                </div>
            </div>
            <script>(()=>{const b=document.getElementById('task-alert-banner');if(!b)return;const l=b.querySelector('#banner-task-cards');const t=b.querySelector('[data-toggle]');const d=b.querySelector('[data-dismiss]');t?.addEventListener('click',()=>{l.classList.toggle('hidden');t.textContent=l.classList.contains('hidden')?'Show':'Hide';});d?.addEventListener('click',()=>b.remove());})();</script>
        </div>
    } else { <div hx-swap-oob="innerHTML:#global-task-alert-container"></div> }

    @* Unified Open Tasks header with counts + actions *@
    <div class="flex flex-wrap items-center justify-between gap-3 mt-2">
        <div class="flex items-center gap-3">
            <h4 class="text-sm font-semibold text-gray-800 flex items-center gap-2">Open Tasks <span class="text-xs font-normal text-gray-500">(@open.Count)</span></h4>
            <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-700 text-[11px] font-medium">Due: @dueCount</span>
            <span class="px-2 py-0.5 rounded bg-red-100 text-red-700 text-[11px] font-medium">Overdue: @overdueCount</span>
            <span class="text-[11px] text-gray-500 hidden sm:inline">Bars = risk (green safe ? red action)</span>
        </div>
        <div class="flex items-center gap-3">
            <button id="toggle-progress" class="text-xs text-blue-600 hover:text-blue-800 font-semibold" onclick="document.getElementById('task-progress-cards').classList.toggle('hidden')">Progress</button>
            <button class="text-xs px-2 py-1 rounded-md bg-blue-600 text-white shadow hover:bg-blue-700" hx-get="/PrintTracking?handler=CreateTaskModal" hx-target="body" hx-swap="beforeend">New</button>
        </div>
    </div>

    @if (open.Any()) {
        <div id="task-progress-cards" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 max-h-56 overflow-y-auto pr-1 mt-1">
            @foreach(var t in open.Where(t=>!bannerIds.Contains(t.Id)).OrderByDescending(t => (t.OverdueFlag ?? 0)).ThenBy(t => t.DueAt ?? DateTime.MaxValue).Take(9)){
                var pctStr = ExtractProgressPercent(t); int.TryParse(pctStr, out var pctVal); var isDue = (t.OverdueFlag ?? 0) == 1 || (t.DueAt.HasValue && t.DueAt.Value <= nowUtc); var barColor = AdjustBarColor(GetBarColor(pctVal, isDue));
                <div class="relative rounded-lg border border-gray-200 bg-white p-3 flex flex-col gap-2 shadow-sm"><div class="flex items-center gap-2"><span class="truncate text-xs font-semibold text-gray-800" title="@t.Title">@t.Title</span><span class="text-[10px] px-1 py-0.5 rounded @PriorityCss(t.Priority)">@PriorityLabel(t.Priority)</span></div><div class="h-2 w-full bg-gray-100 rounded overflow-hidden"><div class="h-full transition-all duration-700 ease-out @barColor" style="width:@Math.Min(pctVal,120)%"></div></div><div class="flex justify-between text-[10px] text-gray-600"><span>@pctVal%</span><span class="truncate">@t.ProgressSummaries?.FirstOrDefault()</span></div></div>
            }
        </div>
    }
