@model OpCentrix.ViewModels.Maintenance.MaintenanceFleetSummaryViewModel
<div class="fleet-maint-summary p-4 rounded-xl border @((Model.OverdueRules>0)?"border-red-300 bg-red-50":"border-gray-200 bg-gray-50") shadow-sm">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 @((Model.OverdueRules>0)?"text-red-600":"text-gray-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7 20h10a2 2 0 002-2V8l-6-6H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            <h4 class="font-bold text-sm @((Model.OverdueRules>0)?"text-red-800":"text-gray-800")">Maintenance Status</h4>
        </div>
        <span class="text-xs text-gray-500">@Model.GeneratedAt.ToLocalTime().ToString("HH:mm:ss")</span>
    </div>
    <div class="mt-3 grid grid-cols-3 gap-4 text-center">
        <div>
            <div class="text-lg font-bold @(Model.OverdueRules>0?"text-red-700":"text-gray-800")">@Model.MachinesWithIssues</div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Machines</div>
        </div>
        <div>
            <div class="text-lg font-bold text-red-700">@Model.OverdueRules</div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Overdue</div>
        </div>
        <div>
            <div class="text-lg font-bold text-amber-600">@Model.DueSoonRules</div>
            <div class="text-[10px] uppercase tracking-wide text-gray-500 font-semibold">Due Soon</div>
        </div>
    </div>
    @if (Model.MachinesOverdue.Any() || Model.MachinesDueSoon.Any())
    {
        <div class="mt-3 text-xs">
            @if (Model.MachinesOverdue.Any())
            {
                <div class="mb-1"><span class="font-semibold text-red-700">Overdue:</span> <span class="text-gray-700">@string.Join(", ", Model.MachinesOverdue)</span></div>
            }
            @if (Model.MachinesDueSoon.Any())
            {
                <div><span class="font-semibold text-amber-600">Due Soon:</span> <span class="text-gray-700">@string.Join(", ", Model.MachinesDueSoon)</span></div>
            }
        </div>
    }
    <div class="mt-3 flex justify-end">
        <a href="/Maintenance" class="text-xs font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">View Details<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></a>
    </div>
</div>