@page
@model OpCentrix.Pages.Tasks.MyTasksModel
@{
    ViewData["Title"] = "My Tasks";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 transition-colors duration-300">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center transition-colors duration-300">
                    <i class="fas fa-user-check text-blue-600 dark:text-blue-400 mr-3"></i>
                    My Tasks
                </h1>
                <p class="text-gray-600 dark:text-gray-400 mt-1 transition-colors duration-300">
                    Your assigned tasks and responsibilities
                </p>
            </div>
            <div class="flex space-x-3">
                <a class="btn btn-outline-primary bg-transparent border-blue-600 dark:border-blue-400 text-blue-600 dark:text-blue-400 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-500 dark:hover:text-white transition-all duration-200" href="/Tasks/Progress">
                    <i class="fa-solid fa-chart-line mr-2"></i>My Progress
                </a>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="stat-card bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700 rounded-lg p-4 text-center transition-colors duration-300">
                <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">@Model.Statistics.Total</div>
                <div class="text-sm text-blue-700 dark:text-blue-300">Total Tasks</div>
            </div>
            <div class="stat-card bg-yellow-50 dark:bg-yellow-900/30 border border-yellow-200 dark:border-yellow-700 rounded-lg p-4 text-center transition-colors duration-300">
                <div class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">@Model.Statistics.Open</div>
                <div class="text-sm text-yellow-700 dark:text-yellow-300">Open</div>
            </div>
            <div class="stat-card bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 rounded-lg p-4 text-center transition-colors duration-300">
                <div class="text-2xl font-bold text-green-600 dark:text-green-400">@Model.Statistics.InProgress</div>
                <div class="text-sm text-green-700 dark:text-green-300">Active</div>
            </div>
            <div class="stat-card bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-700 rounded-lg p-4 text-center transition-colors duration-300">
                <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">@Model.Statistics.Completed</div>
                <div class="text-sm text-emerald-700 dark:text-emerald-300">Completed</div>
            </div>
            <div class="stat-card bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 rounded-lg p-4 text-center transition-colors duration-300">
                <div class="text-2xl font-bold text-red-600 dark:text-red-400">@Model.Statistics.Overdue</div>
                <div class="text-sm text-red-700 dark:text-red-300">Overdue</div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 transition-colors duration-300">
        <form method="get" class="flex items-center space-x-4">
            <div class="flex-1">
                <select name="status" class="form-select bg-white dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100 focus:border-blue-500 dark:focus:border-blue-400 rounded-md transition-colors duration-200">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(Model.StatusFilter == "Open" ? "selected" : null)">Open</option>
                    <option value="InProgress" selected="@(Model.StatusFilter == "InProgress" ? "selected" : null)">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed" ? "selected" : null)">Completed</option>
                </select>
            </div>
            <div>
                <label class="inline-flex items-center">
                    <input type="checkbox" name="overdue" value="true" @(Model.OverdueOnly ? "checked" : "") class="form-check-input mr-2 rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 bg-white dark:bg-gray-700 focus:ring-blue-500 dark:focus:ring-blue-400">
                    <span class="text-sm text-gray-900 dark:text-gray-100 transition-colors duration-300">Overdue Only</span>
                </label>
            </div>
            <button type="submit" class="btn btn-primary bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white border-blue-600 dark:border-blue-500 transition-all duration-200">
                <i class="fa-solid fa-search mr-2"></i>Filter
            </button>
        </form>
    </div>

    <!-- Tasks Sections -->
    @{
        var activeTasks = Model.Tasks.Where(t => t.Task.Status != "Completed").ToList();
        var completedTasks = Model.Tasks.Where(t => t.Task.Status == "Completed").ToList();
    }

    @if (Model.Tasks.Any())
    {
        <!-- Active Tasks Section -->
        @if (activeTasks.Any())
        {
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden transition-colors duration-300">
                <div class="bg-gradient-to-r from-blue-500 to-indigo-600 dark:from-blue-600 dark:to-indigo-700 text-white p-4">
                    <h2 class="text-lg font-semibold flex items-center">
                        <i class="fas fa-tasks mr-2"></i>
                        Active Tasks (@activeTasks.Count)
                    </h2>
                    <p class="text-blue-100 dark:text-blue-200 text-sm mt-1">Tasks that need your attention</p>
                </div>
                
                <div class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var taskViewModel in activeTasks)
                    {
                        var task = taskViewModel.Task;
                        var progressId = "progress-" + task.Id;
                        
                        <div class="p-6 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200 @(taskViewModel.IsOverdue ? "border-l-4 border-red-500 dark:border-red-400" : "") task-card">
                            <div class="space-y-4">
                                <!-- Task Header -->
                                <div class="flex items-start justify-between">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center space-x-3 mb-2">
                                            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 transition-colors duration-300">@task.Title</h3>
                                            
                                            <!-- Status Badge -->
                                            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(GetStatusBadgeClass(task.Status))">
                                                @GetStatusDisplayName(task.Status)
                                            </span>
                                            
                                            <!-- Priority Badge -->
                                            <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @(GetPriorityBadgeClass(task.Priority))">
                                                @GetPriorityLabel(task.Priority)
                                            </span>
                                            
                                            <!-- Overdue Warning -->
                                            @if (taskViewModel.IsOverdue)
                                            {
                                                <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full bg-red-100 dark:bg-red-900/50 text-red-800 dark:text-red-200 border border-red-300 dark:border-red-600">
                                                    <i class="fa-solid fa-exclamation-triangle mr-1"></i>OVERDUE
                                                </span>
                                            }
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <p class="text-gray-700 dark:text-gray-300 mb-3 transition-colors duration-300">@task.Description</p>
                                        }
                                    </div>
                                    
                                    <!-- Action Buttons -->
                                    <div class="flex items-center space-x-2 ml-4">
                                        <a class="btn btn-sm btn-success bg-green-600 dark:bg-green-500 hover:bg-green-700 dark:hover:bg-green-600 text-white border-green-600 dark:border-green-500 transition-all duration-200" href="/Tasks/@task.Id/AddProgress">
                                            <i class="fa-solid fa-plus mr-1"></i>Add Progress
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary bg-transparent border-blue-600 dark:border-blue-400 text-blue-600 dark:text-blue-400 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-500 transition-all duration-200" href="/Tasks/Progress">
                                            <i class="fa-solid fa-chart-line mr-1"></i>Progress
                                        </a>
                                    </div>
                                </div>

                                <!-- Progress Bar and Info -->
                                <div class="bg-gradient-to-r from-gray-50 to-blue-50 dark:from-gray-700 dark:to-blue-900/30 rounded-lg p-4 transition-colors duration-300">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="text-sm font-medium text-gray-700 dark:text-gray-300 transition-colors duration-300">Task Progress</div>
                                        <div class="flex items-center space-x-4">
                                            @if (taskViewModel.CompletionPercentage.HasValue)
                                            {
                                                <span class="text-lg font-bold text-blue-600 dark:text-blue-400">@taskViewModel.CompletionPercentage%</span>
                                            }
                                            @if (taskViewModel.ProgressCount > 0)
                                            {
                                                <button type="button" 
                                                        class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 font-medium flex items-center transition-colors progress-toggle"
                                                        onclick="toggleProgress('@progressId')"
                                                        id="toggle-@progressId">
                                                    <i class="fa-solid fa-chevron-down mr-2 transition-transform" id="icon-@progressId"></i>
                                                    View @taskViewModel.ProgressCount Update@(taskViewModel.ProgressCount == 1 ? "" : "s")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    
                                    <!-- Progress Bar -->
                                    <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-4 mb-3 transition-colors duration-300">
                                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-400 dark:to-blue-500 h-4 rounded-full transition-all duration-700 ease-out" 
                                             style="width: @(taskViewModel.CompletionPercentage ?? 0)%"></div>
                                    </div>
                                    
                                    <!-- Task Details -->
                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                        @if (task.DueAt.HasValue)
                                        {
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-calendar text-gray-500 dark:text-gray-400 mr-2"></i>
                                                <span class="@(taskViewModel.IsOverdue ? "text-red-600 dark:text-red-400 font-semibold" : "text-gray-600 dark:text-gray-400") transition-colors duration-300">
                                                    Due @task.DueAt.Value.ToString("MMM dd, yyyy")
                                                </span>
                                            </div>
                                        }
                                        
                                        @if (task.Account != null)
                                        {
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-building text-gray-500 dark:text-gray-400 mr-2"></i>
                                                <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">@task.Account.Name</span>
                                            </div>
                                        }
                                        
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-clock text-gray-500 dark:text-gray-400 mr-2"></i>
                                            <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">Created @task.CreatedDate.ToString("MMM dd")</span>
                                        </div>
                                        
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-hashtag text-gray-500 dark:text-gray-400 mr-2"></i>
                                            <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">Task #@task.Id</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Collapsible Progress Updates -->
                                @if (taskViewModel.ProgressCount > 0)
                                {
                                    <div id="@progressId" class="progress-entries hidden">
                                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 transition-colors duration-300">
                                            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center transition-colors duration-300">
                                                <i class="fa-solid fa-history mr-2"></i>Progress History
                                            </h4>
                                            <div class="space-y-3 max-h-60 overflow-y-auto">
                                                @foreach (var progress in task.ProgressEntries.OrderByDescending(p => p.CreatedDate))
                                                {
                                                    <div class="bg-gray-50 dark:bg-gray-600 border border-gray-200 dark:border-gray-500 rounded-lg p-3 transition-colors duration-300">
                                                        <div class="flex items-start justify-between">
                                                            <div class="flex-1">
                                                                <div class="flex items-center space-x-2 mb-2">
                                                                    @if (progress.PercentComplete.HasValue)
                                                                    {
                                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200">
                                                                            @progress.PercentComplete%
                                                                        </span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(progress.Status))
                                                                    {
                                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @(GetStatusBadgeClass(progress.Status))">
                                                                            @progress.Status
                                                                        </span>
                                                                    }
                                                                    <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-100 dark:bg-indigo-900/50 px-2 py-1 rounded">@progress.ProgressType</span>
                                                                </div>
                                                                <p class="text-sm text-gray-800 dark:text-gray-200 mb-2 transition-colors duration-300">@progress.ProgressNote</p>
                                                                <div class="flex items-center text-xs text-gray-500 dark:text-gray-400 transition-colors duration-300">
                                                                    <i class="fa-solid fa-clock mr-1"></i>
                                                                    <span>@progress.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
                                                                    @if (progress.CreatedBy != null)
                                                                    {
                                                                        <span class="mx-2">•</span>
                                                                        <span>by @progress.CreatedBy.FullName</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Completed Tasks Section -->
        @if (completedTasks.Any())
        {
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden transition-colors duration-300">
                <div class="bg-gradient-to-r from-green-500 to-emerald-600 dark:from-green-600 dark:to-emerald-700 text-white p-4">
                    <button type="button" 
                            class="w-full text-left flex items-center justify-between"
                            onclick="toggleCompletedTasks()"
                            id="completed-toggle">
                        <div>
                            <h2 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                Completed Tasks (@completedTasks.Count)
                            </h2>
                            <p class="text-green-100 dark:text-green-200 text-sm mt-1">Tasks you've successfully completed</p>
                        </div>
                        <i class="fas fa-chevron-down text-white transition-transform" id="completed-chevron"></i>
                    </button>
                </div>
                
                <div id="completed-tasks" class="divide-y divide-gray-100 dark:divide-gray-700 hidden">
                    @foreach (var taskViewModel in completedTasks)
                    {
                        var task = taskViewModel.Task;
                        var progressId = "completed-progress-" + task.Id;
                        
                        <div class="p-6 bg-green-50 dark:bg-green-900/20 hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors task-card">
                            <div class="space-y-4">
                                <!-- Task Header -->
                                <div class="flex items-start justify-between">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center space-x-3 mb-2">
                                            <h3 class="text-lg font-medium text-gray-800 dark:text-gray-200 transition-colors duration-300">@task.Title</h3>
                                            
                                            <!-- Status Badge -->
                                            <span class="inline-flex items-center px-3 py-1 text-sm font-semibold rounded-full bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200 border border-green-300 dark:border-green-600">
                                                <i class="fas fa-check mr-1"></i>Completed
                                            </span>
                                            
                                            <!-- Completion Date -->
                                            @if (task.CompletedAt.HasValue)
                                            {
                                                <span class="inline-flex items-center px-2 py-1 text-xs rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600">
                                                    <i class="fas fa-calendar-check mr-1"></i>
                                                    Completed @task.CompletedAt.Value.ToString("MMM dd, yyyy")
                                                </span>
                                            }
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <p class="text-gray-600 dark:text-gray-400 mb-3 transition-colors duration-300">@task.Description</p>
                                        }
                                    </div>
                                    
                                    <!-- Progress History Button -->
                                    @if (taskViewModel.ProgressCount > 0)
                                    {
                                        <div class="ml-4">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-success bg-transparent border-green-600 dark:border-green-400 text-green-600 dark:text-green-400 hover:bg-green-600 hover:text-white dark:hover:bg-green-500 progress-toggle transition-all duration-200"
                                                    onclick="toggleProgress('@progressId')"
                                                    id="toggle-@progressId">
                                                <i class="fa-solid fa-history mr-2 transition-transform" id="icon-@progressId"></i>
                                                View History
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Task Details -->
                                <div class="bg-white dark:bg-gray-800 rounded-lg p-3 transition-colors duration-300">
                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                        @if (task.DueAt.HasValue)
                                        {
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-calendar text-gray-500 dark:text-gray-400 mr-2"></i>
                                                <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">
                                                    Due @task.DueAt.Value.ToString("MMM dd, yyyy")
                                                </span>
                                            </div>
                                        }
                                        
                                        @if (task.Account != null)
                                        {
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-building text-gray-500 dark:text-gray-400 mr-2"></i>
                                                <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">@task.Account.Name</span>
                                            </div>
                                        }
                                        
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-clock text-gray-500 dark:text-gray-400 mr-2"></i>
                                            <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">Created @task.CreatedDate.ToString("MMM dd")</span>
                                        </div>
                                        
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-hashtag text-gray-500 dark:text-gray-400 mr-2"></i>
                                            <span class="text-gray-600 dark:text-gray-400 transition-colors duration-300">Task #@task.Id</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Collapsible Progress History -->
                                @if (taskViewModel.ProgressCount > 0)
                                {
                                    <div id="@progressId" class="progress-entries hidden">
                                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg p-4 transition-colors duration-300">
                                            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center transition-colors duration-300">
                                                <i class="fa-solid fa-history mr-2"></i>Complete Progress History
                                            </h4>
                                            <div class="space-y-3 max-h-60 overflow-y-auto">
                                                @foreach (var progress in task.ProgressEntries.OrderByDescending(p => p.CreatedDate))
                                                {
                                                    <div class="bg-gray-50 dark:bg-gray-600 border border-gray-200 dark:border-gray-500 rounded-lg p-3 transition-colors duration-300">
                                                        <div class="flex items-start justify-between">
                                                            <div class="flex-1">
                                                                <div class="flex items-center space-x-2 mb-2">
                                                                    @if (progress.PercentComplete.HasValue)
                                                                    {
                                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200">
                                                                            @progress.PercentComplete%
                                                                        </span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(progress.Status))
                                                                    {
                                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @(GetStatusBadgeClass(progress.Status))">
                                                                            @progress.Status
                                                                        </span>
                                                                    }
                                                                    <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-100 dark:bg-indigo-900/50 px-2 py-1 rounded">@progress.ProgressType</span>
                                                                </div>
                                                                <p class="text-sm text-gray-800 dark:text-gray-200 mb-2 transition-colors duration-300">@progress.ProgressNote</p>
                                                                <div class="flex items-center text-xs text-gray-500 dark:text-gray-400 transition-colors duration-300">
                                                                    <i class="fa-solid fa-clock mr-1"></i>
                                                                    <span>@progress.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
                                                                    @if (progress.CreatedBy != null)
                                                                    {
                                                                        <span class="mx-2">•</span>
                                                                        <span>by @progress.CreatedBy.FullName</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
        else
        {
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-12 text-center transition-colors duration-300">
                <div class="text-gray-400 dark:text-gray-500 mb-4">
                    <i class="fa-solid fa-tasks text-6xl mb-4"></i>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2 transition-colors duration-300">No tasks assigned</h3>
                    <p class="text-gray-600 dark:text-gray-400 transition-colors duration-300">You don't have any tasks assigned to you at the moment.</p>
                </div>
            </div>
        }
    </div>
</div>

@{
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-yellow-100 dark:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 border border-yellow-300 dark:border-yellow-600",
            "InProgress" => "bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200 border border-blue-300 dark:border-blue-600", 
            "Completed" => "bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-200 border border-green-300 dark:border-green-600",
            _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-600"
        };
    }

    string GetPriorityBadgeClass(int priority)
    {
        return priority switch
        {
            1 => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-600",
            2 => "bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200 border border-blue-300 dark:border-blue-600",
            3 => "bg-yellow-100 dark:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 border border-yellow-300 dark:border-yellow-600",
            4 => "bg-orange-100 dark:bg-orange-900/50 text-orange-800 dark:text-orange-200 border border-orange-300 dark:border-orange-600",
            5 => "bg-red-100 dark:bg-red-900/50 text-red-800 dark:text-red-200 border border-red-300 dark:border-red-600",
            _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-600"
        };
    }

    string GetPriorityLabel(int priority)
    {
        return priority switch
        {
            1 => "P1 Lowest",
            2 => "P2 Low", 
            3 => "P3 Normal",
            4 => "P4 High",
            5 => "P5 Critical",
            _ => $"P{priority}"
        };
    }

    string GetStatusDisplayName(string status)
    {
        return status switch
        {
            "Open" => "Open",
            "InProgress" => "In Progress",
            "Completed" => "Completed",
            _ => status
        };
    }
}

<script>
// Progress toggle functionality
function toggleProgress(progressId) {
    const progressDiv = document.getElementById(progressId);
    const toggleButton = document.getElementById('toggle-' + progressId);
    const icon = document.getElementById('icon-' + progressId);
    
    if (progressDiv && toggleButton && icon) {
        const isHidden = progressDiv.classList.contains('hidden');
        
        if (isHidden) {
            progressDiv.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
            toggleButton.setAttribute('aria-expanded', 'true');
        } else {
            progressDiv.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
            toggleButton.setAttribute('aria-expanded', 'false');
        }
    }
}

// Completed tasks toggle functionality
function toggleCompletedTasks() {
    const completedDiv = document.getElementById('completed-tasks');
    const chevron = document.getElementById('completed-chevron');
    
    if (completedDiv && chevron) {
        const isHidden = completedDiv.classList.contains('hidden');
        
        if (isHidden) {
            completedDiv.classList.remove('hidden');
            chevron.style.transform = 'rotate(180deg)';
        } else {
            completedDiv.classList.add('hidden');
            chevron.style.transform = 'rotate(0deg)';
        }
    }
}

// Initialize toggle states
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.progress-toggle').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        
        button.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                this.click();
            }
        });
    });
    
    // Set up completed tasks toggle
    const completedToggle = document.getElementById('completed-toggle');
    if (completedToggle) {
        completedToggle.setAttribute('aria-expanded', 'false');
        
        completedToggle.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleCompletedTasks();
            }
        });
    }
});
</script>

