@page "/Tasks/{id:int}/AddProgress"
@model OpCentrix.Pages.Tasks.AddProgressModel
@{
    ViewData["Title"] = $"Add Progress - {Model.Task?.Title}";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-teal-600 rounded-lg flex items-center justify-center mr-4">
                    <i class="fas fa-plus text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Add Progress Update</h1>
                    <p class="text-gray-600 mt-1">Update your progress on this task</p>
                </div>
            </div>
            <div class="flex space-x-3">
                <a class="btn btn-outline-secondary" href="/Tasks/MyTasks">
                    <i class="fas fa-arrow-left mr-2"></i>Back to My Tasks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-600 mr-2"></i>
                <span class="text-red-800">@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <!-- Task Information -->
    <div class="bg-white border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
            <i class="fas fa-info-circle mr-2 text-blue-500"></i>Task Details
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h4 class="text-sm font-medium text-gray-600 mb-1">Task Title</h4>
                <p class="text-lg font-medium text-gray-900">@Model.Task?.Title</p>
            </div>
            
            <div>
                <h4 class="text-sm font-medium text-gray-600 mb-1">Current Status</h4>
                <span class="inline-flex px-3 py-1 rounded-full text-sm font-medium @(GetStatusBadgeClass(Model.Task?.Status))">
                    @GetStatusDisplayName(Model.Task?.Status)
                </span>
            </div>
            
            <div>
                <h4 class="text-sm font-medium text-gray-600 mb-1">Priority</h4>
                <span class="inline-flex px-3 py-1 rounded-full text-sm font-medium @(GetPriorityBadgeClass(Model.Task?.Priority ?? 0))">
                    @GetPriorityLabel(Model.Task?.Priority ?? 0)
                </span>
            </div>
            
            <div>
                <h4 class="text-sm font-medium text-gray-600 mb-1">Due Date</h4>
                @if (Model.Task?.DueAt.HasValue == true)
                {
                    var isOverdue = Model.Task.DueAt < DateTime.UtcNow;
                    <p class="text-sm @(isOverdue ? "text-red-600 font-semibold" : "text-gray-900")">
                        @Model.Task.DueAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                        @if (isOverdue)
                        {
                            <span class="ml-2 px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full font-medium">
                                <i class="fas fa-exclamation-triangle mr-1"></i>OVERDUE
                            </span>
                        }
                    </p>
                }
                else
                {
                    <p class="text-gray-400 text-sm">No due date set</p>
                }
            </div>
            
            @if (Model.Task?.Account != null)
            {
                <div>
                    <h4 class="text-sm font-medium text-gray-600 mb-1">Client</h4>
                    <p class="text-gray-900 text-sm">@Model.Task.Account.Name</p>
                </div>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(Model.Task?.Description))
        {
            <div class="mt-6">
                <h4 class="text-sm font-medium text-gray-600 mb-2">Task Description</h4>
                <p class="text-gray-900 bg-gray-50 rounded-lg p-4">@Model.Task.Description</p>
            </div>
        }
    </div>

    <!-- Recent Progress (if any) -->
    @if (Model.Task?.ProgressEntries?.Any() == true)
    {
        <div class="bg-white border rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-history mr-2 text-purple-500"></i>Recent Updates
            </h3>
            
            <div class="space-y-4">
                @foreach (var progress in Model.Task.ProgressEntries.Take(3))
                {
                    <div class="border-l-4 border-blue-500 bg-blue-50 p-4 rounded-r-lg">
                        <div class="flex items-start justify-between mb-2">
                            <div class="flex items-center space-x-2">
                                @if (progress.PercentComplete.HasValue)
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        @progress.PercentComplete%
                                    </span>
                                }
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    @progress.ProgressType
                                </span>
                            </div>
                            <span class="text-xs text-gray-500">
                                @progress.CreatedDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                            </span>
                        </div>
                        <p class="text-gray-800 text-sm">@progress.ProgressNote</p>
                    </div>
                }
            </div>
            
            @if (Model.Task.ProgressEntries.Count > 3)
            {
                <p class="text-center text-gray-500 text-sm mt-4">
                    ... and @(Model.Task.ProgressEntries.Count - 3) more update@(Model.Task.ProgressEntries.Count - 3 == 1 ? "" : "s")
                </p>
            }
        </div>
    }

    <!-- Add Progress Form -->
    <div class="bg-white border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-6 flex items-center">
            <i class="fas fa-edit mr-2 text-green-500"></i>Add Your Progress Update
        </h3>
        
        <form method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <!-- Progress Note -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2" asp-for="Input.ProgressNote">
                    What progress have you made? *
                </label>
                <textarea class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" 
                         asp-for="Input.ProgressNote" 
                         rows="4" 
                         placeholder="Describe what you've accomplished, any challenges faced, next steps, etc."
                         required></textarea>
                <span class="text-red-500 text-sm" asp-validation-for="Input.ProgressNote"></span>
                <p class="text-gray-500 text-sm mt-1">Be specific about what you've completed and any important details.</p>
            </div>
            
            <!-- Progress Details -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Completion Percentage -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2" asp-for="Input.PercentComplete">
                        How complete is this task?
                    </label>
                    <div class="relative">
                        <input class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" 
                               asp-for="Input.PercentComplete" 
                               type="number" 
                               min="0" 
                               max="100" 
                               placeholder="0-100" />
                        <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 text-sm">%</span>
                    </div>
                    <span class="text-red-500 text-sm" asp-validation-for="Input.PercentComplete"></span>
                    <p class="text-gray-500 text-xs mt-1">Optional: Estimate completion percentage</p>
                </div>
                
                <!-- Status Update -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2" asp-for="Input.Status">
                        Update Status (Optional)
                    </label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" 
                            asp-for="Input.Status">
                        <option value="">Keep Current Status</option>
                        <option value="Open">Open</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <p class="text-gray-500 text-xs mt-1">Change status if needed</p>
                </div>
                
                <!-- Progress Type -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2" asp-for="Input.ProgressType">
                        Update Type
                    </label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" 
                            asp-for="Input.ProgressType">
                        <option value="Update">General Update</option>
                        <option value="Milestone">Milestone Reached</option>
                        <option value="Issue">Issue/Problem</option>
                        <option value="Resolution">Issue Resolved</option>
                        <option value="Completion">Task Completed</option>
                    </select>
                    <p class="text-gray-500 text-xs mt-1">What kind of update is this?</p>
                </div>
            </div>
            
            <!-- Submit Button -->
            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-600">
                    <i class="fas fa-info-circle mr-1"></i>
                    Your update will be visible to managers and the client.
                </p>
                
                <div class="flex space-x-3">
                    <a class="btn btn-outline-secondary" href="/Tasks/MyTasks">
                        <i class="fas fa-times mr-2"></i>Cancel
                    </a>
                    <button class="btn btn-success" type="submit">
                        <i class="fas fa-plus mr-2"></i>Add Progress Update
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@{
    string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Open" => "bg-yellow-100 text-yellow-800 border border-yellow-300",
            "InProgress" => "bg-blue-100 text-blue-800 border border-blue-300", 
            "Completed" => "bg-green-100 text-green-800 border border-green-300",
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }

    string GetPriorityBadgeClass(int priority)
    {
        return priority switch
        {
            1 => "bg-gray-100 text-gray-800 border border-gray-300",
            2 => "bg-blue-100 text-blue-800 border border-blue-300",
            3 => "bg-yellow-100 text-yellow-800 border border-yellow-300",
            4 => "bg-orange-100 text-orange-800 border border-orange-300",
            5 => "bg-red-100 text-red-800 border border-red-300",
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }

    string GetPriorityLabel(int priority)
    {
        return priority switch
        {
            1 => "Low Priority",
            2 => "Normal", 
            3 => "Medium",
            4 => "High Priority",
            5 => "Critical",
            _ => $"Priority {priority}"
        };
    }

    string GetStatusDisplayName(string? status)
    {
        return status switch
        {
            "Open" => "Open",
            "InProgress" => "In Progress",
            "Completed" => "Completed",
            _ => status ?? "Unknown"
        };
    }
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}