@page
@model OpCentrix.Pages.Tasks.ProgressModel
@{
    ViewData["Title"] = "Task Progress";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-chart-line text-green-600 mr-3"></i>
                    Task Progress Management
                </h1>
                <p class="text-gray-600 mt-1">
                    Add updates to your assigned tasks
                </p>
            </div>
            <div class="flex space-x-3">
                <a class="btn btn-outline-primary" href="/Tasks/MyTasks">
                    <i class="fa-solid fa-arrow-left mr-2"></i>Back to My Tasks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-exclamation-triangle text-red-600 mr-2"></i>
                <span class="text-red-800">@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <!-- Recent Progress Updates -->
    <div class="bg-white border rounded-lg overflow-hidden">
        <div class="bg-gray-50 px-6 py-4 border-b">
            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                <i class="fas fa-clock text-blue-600 mr-2"></i>
                Recent Progress Updates
            </h2>
        </div>

        @if (Model.RecentProgressUpdates.Any())
        {
            <div class="divide-y divide-gray-100">
                @foreach (var update in Model.RecentProgressUpdates)
                {
                    <div class="p-6">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center space-x-3 mb-2">
                                    <h3 class="text-sm font-semibold text-gray-900">@update.Task.Title</h3>
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(GetStatusBadgeClass(update.Task.Status))">
                                        @update.Task.Status
                                    </span>
                                    @if (update.PercentComplete.HasValue)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                            @update.PercentComplete%
                                        </span>
                                    }
                                    <span class="text-xs font-medium text-indigo-600 bg-indigo-100 px-2 py-1 rounded">@update.ProgressType</span>
                                </div>
                                <p class="text-gray-700 mb-2">@update.ProgressNote</p>
                                <div class="flex items-center space-x-4 text-xs text-gray-500">
                                    <span><i class="fa-solid fa-clock mr-1"></i>@update.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
                                    <span><i class="fa-solid fa-hashtag mr-1"></i>Task #@update.Task.Id</span>
                                </div>
                            </div>
                            <div class="ml-4">
                                <a href="/Tasks/@update.TaskId/AddProgress" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-plus mr-1"></i>Add Update
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-12 text-center">
                <div class="text-gray-400 mb-4">
                    <i class="fa-solid fa-chart-line text-6xl mb-4"></i>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No recent progress updates</h3>
                    <p>You haven't added any progress updates recently.</p>
                </div>
            </div>
        }
    </div>

    <!-- Active Tasks Requiring Updates -->
    <div class="bg-white border rounded-lg overflow-hidden">
        <div class="bg-gradient-to-r from-orange-50 to-red-50 px-6 py-4 border-b border-orange-200">
            <h2 class="text-lg font-semibold text-orange-900 flex items-center">
                <i class="fas fa-exclamation-circle text-orange-600 mr-2"></i>
                Tasks Needing Updates
                @if (Model.TasksNeedingUpdates.Any())
                {
                    <span class="ml-2 px-2 py-1 bg-orange-200 text-orange-800 text-xs rounded-full font-medium">
                        @Model.TasksNeedingUpdates.Count
                    </span>
                }
            </h2>
            <p class="text-sm text-orange-700 mt-1">Tasks that haven't been updated recently or are overdue</p>
        </div>

        @if (Model.TasksNeedingUpdates.Any())
        {
            <div class="divide-y divide-gray-100">
                @foreach (var taskViewModel in Model.TasksNeedingUpdates)
                {
                    var task = taskViewModel.Task;
                    
                    <div class="p-6 @(taskViewModel.IsOverdue ? "bg-red-50 border-l-4 border-red-500" : "")">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center space-x-3 mb-2">
                                    <h3 class="text-lg font-semibold text-gray-900">@task.Title</h3>
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(GetStatusBadgeClass(task.Status))">
                                        @task.Status
                                    </span>
                                    <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @(GetPriorityBadgeClass(task.Priority))">
                                        P@(task.Priority)
                                    </span>
                                    @if (taskViewModel.IsOverdue)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800">
                                            <i class="fa-solid fa-exclamation-triangle mr-1"></i>OVERDUE
                                        </span>
                                    }
                                </div>
                                
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <p class="text-gray-700 mb-3">@task.Description</p>
                                }
                                
                                <!-- Progress Bar -->
                                <div class="mb-3">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-sm font-medium text-gray-700">Progress</span>
                                        @if (taskViewModel.CompletionPercentage.HasValue)
                                        {
                                            <span class="text-sm font-semibold text-blue-600">@taskViewModel.CompletionPercentage%</span>
                                        }
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full transition-all duration-500" 
                                             style="width: @(taskViewModel.CompletionPercentage ?? 0)%"></div>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                    @if (task.DueAt.HasValue)
                                    {
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-calendar text-gray-500 mr-2"></i>
                                            <span class="@(taskViewModel.IsOverdue ? "text-red-600 font-semibold" : "text-gray-600")">
                                                Due @task.DueAt.Value.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                    }
                                    
                                    @if (task.Account != null)
                                    {
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-building text-gray-500 mr-2"></i>
                                            <span class="text-gray-600">@task.Account.Name</span>
                                        </div>
                                    }
                                    
                                    @if (taskViewModel.DaysSinceLastUpdate.HasValue)
                                    {
                                        <div class="flex items-center">
                                            <i class="fa-solid fa-history text-gray-500 mr-2"></i>
                                            <span class="text-gray-600">
                                                @(taskViewModel.DaysSinceLastUpdate == 0 ? "Updated today" : $"{taskViewModel.DaysSinceLastUpdate} days ago")
                                            </span>
                                        </div>
                                    }
                                    
                                    <div class="flex items-center">
                                        <i class="fa-solid fa-hashtag text-gray-500 mr-2"></i>
                                        <span class="text-gray-600">Task #@task.Id</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="flex flex-col space-y-2 ml-4">
                                <a href="/Tasks/@task.Id/AddProgress" class="btn btn-success">
                                    <i class="fa-solid fa-plus mr-2"></i>Add Progress
                                </a>
                                <a href="/Tasks/MyTasks" class="btn btn-outline-primary">
                                    <i class="fa-solid fa-list mr-2"></i>All My Tasks
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-12 text-center">
                <div class="text-gray-400 mb-4">
                    <i class="fa-solid fa-check-circle text-6xl mb-4 text-green-500"></i>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">All tasks are up to date!</h3>
                    <p>Great job keeping your tasks updated.</p>
                </div>
            </div>
        }
    </div>
</div>

@{
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-yellow-100 text-yellow-800 border border-yellow-300",
            "InProgress" => "bg-blue-100 text-blue-800 border border-blue-300", 
            "Completed" => "bg-green-100 text-green-800 border border-green-300",
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }

    string GetPriorityBadgeClass(int priority)
    {
        return priority switch
        {
            1 => "bg-gray-100 text-gray-800 border border-gray-300",
            2 => "bg-blue-100 text-blue-800 border border-blue-300",
            3 => "bg-yellow-100 text-yellow-800 border border-yellow-300",
            4 => "bg-orange-100 text-orange-800 border border-orange-300",
            5 => "bg-red-100 text-red-800 border border-red-300",
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }
}

<style>
.task-card {
    transition: all 0.2s ease;
}

.task-card:hover {
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.1);
    transform: translateY(-1px);
}
</style>