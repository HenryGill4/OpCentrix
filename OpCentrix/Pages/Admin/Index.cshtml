@page
@model OpCentrix.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Description"] = "System overview and management controls";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}



<!-- Key Metrics Overview -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total Jobs KPI -->
    <div class="opcentrix-card p-6 hover:shadow-lg transition-all duration-300 bg-gradient-to-br from-blue-50 to-blue-100">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Total Jobs</p>
                <p class="text-3xl font-bold text-blue-600">@Model.TotalJobs</p>
                <p class="text-sm text-green-600 font-medium">@Model.ActiveJobs active</p>
            </div>
            <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center">
                <i class="fas fa-clipboard-list text-white text-lg"></i>
            </div>
        </div>
    </div>

    <!-- Total Parts KPI -->
    <div class="opcentrix-card p-6 hover:shadow-lg transition-all duration-300 bg-gradient-to-br from-green-50 to-green-100">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Total Parts</p>
                <p class="text-3xl font-bold text-green-600">@Model.TotalParts</p>
                <p class="text-sm text-green-600 font-medium">@Model.ActiveParts active</p>
            </div>
            <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center">
                <i class="fas fa-cogs text-white text-lg"></i>
            </div>
        </div>
    </div>

    <!-- Task System Status -->
    <div class="opcentrix-card p-6 hover:shadow-lg transition-all duration-300 bg-gradient-to-br from-purple-50 to-purple-100">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Open Tasks</p>
                <p class="text-3xl font-bold text-purple-600" id="open-tasks-count">@Model.OpenTasks</p>
                <p class="text-sm text-orange-600 font-medium" id="overdue-tasks-count">@Model.OverdueTasks overdue</p>
            </div>
            <div class="w-12 h-12 bg-purple-500 rounded-xl flex items-center justify-center">
                <i class="fas fa-tasks text-white text-lg"></i>
            </div>
        </div>
    </div>

    <!-- System Health -->
    <div class="opcentrix-card p-6 hover:shadow-lg transition-all duration-300 bg-gradient-to-br from-emerald-50 to-emerald-100">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">System Health</p>
                <p class="text-2xl font-bold text-emerald-600">Excellent</p>
                <div class="flex items-center text-sm text-emerald-600">
                    <div class="w-2 h-2 bg-emerald-500 rounded-full mr-2 animate-pulse"></div>
                    All systems operational
                </div>
            </div>
            <div class="w-12 h-12 bg-emerald-500 rounded-xl flex items-center justify-center">
                <i class="fas fa-heartbeat text-white text-lg"></i>
            </div>
        </div>
    </div>
</div>

<!-- Operational Task Management Panel -->
<div class="mb-8" id="task-management">
    <div class="opcentrix-card p-6 border-l-4 border-indigo-500 shadow-lg">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-tasks text-indigo-500 mr-3 text-xl"></i>
                    Task Management Center
                </h2>
                <p class="text-gray-600 mt-1">
                    Streamlined operational task control and maintenance scheduling
                </p>
            </div>
            <div class="flex items-center space-x-2 bg-indigo-50 px-3 py-2 rounded-lg">
                <div class="w-3 h-3 bg-indigo-500 rounded-full animate-pulse"></div>
                <span class="text-sm font-medium text-indigo-700">Active</span>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Task Actions -->
            <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-6">
                <h3 class="font-bold text-gray-900 mb-4 text-lg">
                    <i class="fas fa-bolt text-yellow-500 mr-2"></i>
                    Quick Actions
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button hx-get="/Admin?handler=CreateTaskModal"
                            hx-target="#modal-container"
                            hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-lg transition-all duration-200 flex items-center justify-center space-x-2 shadow-md hover:shadow-lg transform hover:scale-105">
                        <i class="fas fa-plus"></i>
                        <span>New Task</span>
                    </button>
                    
                    <button hx-get="/Admin?handler=MaintenanceTaskModal"
                            hx-target="#modal-container"
                            hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded-lg transition-all duration-200 flex items-center justify-center space-x-2 shadow-md hover:shadow-lg transform hover:scale-105">
                        <i class="fas fa-wrench"></i>
                        <span>Maintenance</span>
                    </button>
                    
                    <a href="/Admin/Tasks" class="bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-lg transition-all duration-200 flex items-center justify-center space-x-2 shadow-md hover:shadow-lg transform hover:scale-105">
                        <i class="fas fa-list"></i>
                        <span>Manage Tasks</span>
                    </a>
                    
                    <button hx-post="/Admin?handler=GenerateTaskReport"
                            hx-target="#task-report-status"
                            class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-lg transition-all duration-200 flex items-center justify-center space-x-2 shadow-md hover:shadow-lg transform hover:scale-105">
                        <i class="fas fa-chart-bar"></i>
                        <span>Reports</span>
                    </button>
                </div>
                <div id="task-report-status" class="mt-3"></div>
            </div>
            
            
            <!-- System Health & Task Overview -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6">
                <h3 class="font-bold text-gray-900 mb-4 text-lg">
                    <i class="fas fa-heartbeat text-blue-500 mr-2"></i>
                    System Overview
                </h3>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div class="text-center">
                        <div class="text-2xl font-bold text-indigo-600" id="inprogress-tasks-count">@Model.InProgressTasks</div>
                        <div class="text-xs text-gray-600">In Progress</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold text-green-600" id="completed-today-count">@Model.CompletedTodayTasks</div>
                        <div class="text-xs text-gray-600">Completed Today</div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center text-sm">
                        <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
                        <span class="text-gray-700">All machines operational</span>
                    </div>
                    <div class="flex items-center text-sm">
                        <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
                        <span class="text-gray-700">Task system monitored</span>
                    </div>
                    <div class="flex items-center text-sm">
                        <div class="w-3 h-3 bg-purple-500 rounded-full mr-2"></div>
                        <span class="text-gray-700">Maintenance scheduled</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Manufacturing Performance Dashboard -->
<div class="mb-8" id="manufacturing-insights">
    <div class="opcentrix-card p-6 border-l-4 border-green-500 shadow-lg">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 flex items-center">
                    <i class="fas fa-industry text-green-500 mr-3 text-xl"></i>
                    Manufacturing Performance
                </h2>
                <p class="text-gray-600 mt-1">
                    Real-time production metrics and operational analytics
                </p>
            </div>
            <div class="flex items-center space-x-2 bg-green-50 px-3 py-2 rounded-lg">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                <span class="text-sm font-medium text-green-700">Live Data</span>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Overall Efficiency -->
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-gray-900">OEE</h3>
                    <i class="fas fa-tachometer-alt text-green-500 text-lg"></i>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-green-600" id="overall-efficiency">87%</div>
                    <div class="text-sm text-gray-600">Overall Equipment Effectiveness</div>
                </div>
            </div>
            
            <!-- Machine Status -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-gray-900">Machines</h3>
                    <i class="fas fa-server text-blue-500 text-lg"></i>
                </div>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700">TI1:</span>
                        <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs font-medium">Running</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700">TI2:</span>
                        <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs font-medium">Running</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700">INC:</span>
                        <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-xs font-medium">Maintenance</span>
                    </div>
                </div>
            </div>
            
            <!-- Quality Metrics -->
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-gray-900">Quality</h3>
                    <i class="fas fa-check-circle text-purple-500 text-lg"></i>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-purple-600" id="quality-score">98.7%</div>
                    <div class="text-sm text-gray-600">First Pass Yield</div>
                </div>
            </div>
            
            <!-- Material Usage -->
            <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-gray-900">Materials</h3>
                    <i class="fas fa-cubes text-orange-500 text-lg"></i>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-orange-600">$12.4k</div>
                    <div class="text-sm text-gray-600">Daily Cost</div>
                    <div class="text-xs text-green-600 mt-1">91% efficiency</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Management Dashboard -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <!-- Quick Actions -->
    <div class="opcentrix-card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                <i class="fas fa-bolt text-blue-600 mr-2"></i>
                Quick Actions
            </h3>
        </div>
        <div class="space-y-3">
            <a href="/Admin/Jobs" class="block w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white text-center py-3 px-4 rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all duration-200 font-medium shadow-lg hover:shadow-xl transform hover:scale-105">
                <i class="fas fa-clipboard-list mr-2"></i>Manage Jobs
            </a>
            <a href="/Admin/Parts" class="block w-full bg-gradient-to-r from-green-600 to-green-700 text-white text-center py-3 px-4 rounded-xl hover:from-green-700 hover:to-green-800 transition-all duration-200 font-medium shadow-lg hover:shadow-xl transform hover:scale-105">
                <i class="fas fa-cogs mr-2"></i>Manage Parts
            </a>
            <a href="/Admin/Users" class="block w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white text-center py-3 px-4 rounded-xl hover:from-purple-700 hover:to-purple-800 transition-all duration-200 font-medium shadow-lg hover:shadow-xl transform hover:scale-105">
                <i class="fas fa-users mr-2"></i>Manage Users
            </a>
            <a href="/Admin/Logs" class="block w-full bg-gradient-to-r from-yellow-600 to-yellow-700 text-white text-center py-3 px-4 rounded-xl hover:from-yellow-700 hover:to-yellow-800 transition-all duration-200 font-medium shadow-lg hover:shadow-xl transform hover:scale-105">
                <i class="fas fa-file-alt mr-2"></i>View Logs
            </a>
        </div>
    </div>

    <!-- Recent Jobs -->
    <div class="opcentrix-card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                <i class="fas fa-clock text-blue-600 mr-2"></i>
                Recent Jobs
            </h3>
            <a href="/Admin/Jobs" class="text-blue-600 hover:text-blue-800 text-sm font-medium">View All</a>
        </div>
        <div class="space-y-3">
            @if (Model.RecentJobs.Any())
            {
                @foreach (var job in Model.RecentJobs.Take(5))
                {
                    <div class="flex items-center space-x-4 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-blue-600 font-bold text-sm">@job.MachineId</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">@job.PartNumber</p>
                            <p class="text-xs text-gray-500">Qty: @job.Quantity • @job.CreatedDate.ToString("MM/dd")</p>
                        </div>
                        <span class="@(job.Status == "Completed" ? "bg-green-100 text-green-800" : job.Status == "Active" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-800") px-2 py-1 rounded text-xs font-medium">
                            @job.Status
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fas fa-clipboard text-gray-300 text-3xl mb-2"></i>
                    <p class="text-gray-500 text-sm">No jobs found</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Parts -->
    <div class="opcentrix-card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                <i class="fas fa-cube text-green-600 mr-2"></i>
                Recent Parts
            </h3>
            <a href="/Admin/Parts" class="text-green-600 hover:text-green-800 text-sm font-medium">View All</a>
        </div>
        <div class="space-y-3">
            @if (Model.RecentParts.Any())
            {
                @foreach (var part in Model.RecentParts.Take(5))
                {
                    <div class="flex items-center space-x-4 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-cube text-green-600"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">@part.PartNumber</p>
                            <p class="text-xs text-gray-500 truncate">@part.Material • @part.CreatedDate.ToString("MM/dd")</p>
                        </div>
                        <span class="@(part.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800") px-2 py-1 rounded text-xs font-medium">
                            @(part.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fas fa-cube text-gray-300 text-3xl mb-2"></i>
                    <p class="text-gray-500 text-sm">No parts found</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- System Overview -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- System Health Status -->
    <div class="opcentrix-card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                <i class="fas fa-shield-alt text-green-600 mr-2"></i>
                System Health
            </h3>
            <div class="flex items-center space-x-2 bg-green-50 px-3 py-1 rounded-lg">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                <span class="text-sm font-medium text-green-700">Operational</span>
            </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Database</span>
                    <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center">
                        <i class="fas fa-check text-white text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-green-600 mt-1">Online</p>
            </div>
            
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Authentication</span>
                    <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center">
                        <i class="fas fa-lock text-white text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-blue-600 mt-1">Secure</p>
            </div>
            
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Scheduler</span>
                    <div class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center">
                        <i class="fas fa-clock text-white text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-purple-600 mt-1">Running</p>
            </div>
            
            <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-lg p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Performance</span>
                    <div class="w-6 h-6 bg-orange-500 rounded-full flex items-center justify-center">
                        <i class="fas fa-tachometer-alt text-white text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-orange-600 mt-1">Optimal</p>
            </div>
        </div>
    </div>

    <!-- Recent Activity Timeline -->
    <div class="opcentrix-card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
                <i class="fas fa-history text-blue-600 mr-2"></i>
                Recent Activity
            </h3>
            <a href="/Admin/Logs" class="text-blue-600 hover:text-blue-800 text-sm font-medium">View All Logs</a>
        </div>
        
        <div class="space-y-3 max-h-80 overflow-y-auto">
            @if (Model.RecentLogEntries.Any())
            {
                @foreach (var log in Model.RecentLogEntries.Take(6))
                {
                    <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        @{
                            var (badgeClass, iconClass) = log.Action switch
                            {
                                "Created" => ("bg-green-100 text-green-800", "fas fa-plus"),
                                "Updated" => ("bg-blue-100 text-blue-800", "fas fa-edit"),
                                "Deleted" => ("bg-red-100 text-red-800", "fas fa-trash"),
                                _ => ("bg-gray-100 text-gray-800", "fas fa-info-circle")
                            };
                        }
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center @badgeClass flex-shrink-0">
                            <i class="@iconClass text-sm"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900">
                                @log.Action @log.PartNumber
                            </p>
                            <p class="text-xs text-gray-500">
                                Machine: @log.MachineId • @log.Operator • @log.Timestamp.ToString("MMM dd, HH:mm")
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fas fa-file-alt text-gray-300 text-3xl mb-2"></i>
                    <p class="text-gray-500 text-sm">No recent activity</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
// Update task statistics and manufacturing data
function updateDashboardData() {
    // Update task counts
    const openTasks = @Model.OpenTasks;
    const inProgressTasks = @Model.InProgressTasks;
    const overdueTasks = @Model.OverdueTasks;
    const completedTodayTasks = @Model.CompletedTodayTasks;
    
    // Update display elements if they exist
    const elements = {
        'open-tasks-count': openTasks,
        'inprogress-tasks-count': inProgressTasks,
        'overdue-tasks-count': overdueTasks,
        'completed-today-count': completedTodayTasks
    };
    
    Object.keys(elements).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = elements[id];
    });
    
    // Simulate real-time manufacturing data
    const metrics = {
        'overall-efficiency': Math.floor(85 + Math.random() * 10) + '%',
        'quality-score': (98 + Math.random() * 2).toFixed(1) + '%'
    };
    
    Object.keys(metrics).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = metrics[id];
    });
}

// Modal management
function showModal(content) {
    const modalContainer = document.getElementById('modal-container');
    if (modalContainer) {
        modalContainer.innerHTML = `
            <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                <div class="bg-white rounded-xl max-w-4xl w-full mx-4 max-h-screen overflow-y-auto">
                    ${content}
                </div>
            </div>`;
        modalContainer.style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
}

function hideModal() {
    const modalContainer = document.getElementById('modal-container');
    if (modalContainer) {
        modalContainer.innerHTML = '';
        modalContainer.style.display = 'none';
        document.body.style.overflow = 'auto';
    }
}

// Notification system
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
    };
    
    notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg text-white transition-all duration-300 ${colors[type]}`;
    notification.innerHTML = `<i class="fas fa-${type === 'success' ? 'check' : type === 'error' ? 'exclamation-triangle' : 'info'}-circle mr-2"></i>${message}`;
    
    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 5000);
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
