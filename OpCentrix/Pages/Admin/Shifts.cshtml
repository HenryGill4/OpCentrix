@page
@model OpCentrix.Pages.Admin.ShiftsModel
@{
    ViewData["Title"] = "Operating Shifts";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<!-- Ensure HTMX is available (CDN fallback) -->
<script>
    if (!window.htmx) {
        document.write('<script src="https://unpkg.com/htmx.org@1.9.12"><\/script>');
    }
</script>
<script>
    document.addEventListener('htmx:configRequest', function (e) {
        var token = document.querySelector('#af-token-form input[name="__RequestVerificationToken"]')?.value
                 || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            e.detail.headers['RequestVerificationToken'] = token;
        }
    });
    document.addEventListener('htmx:afterSwap', function(e){
        if(e.detail && e.detail.target && e.detail.target.id === 'modal-container'){
            if(window.showModal){ window.showModal(); }
        }
    });
    // Global success auto hard-refresh for JSON success responses
    document.addEventListener('htmx:afterRequest', function (e) {
        try{
            var xhr = e.detail.xhr; if(!xhr) return; var ct = (xhr.getResponseHeader && xhr.getResponseHeader('Content-Type'))||''; if(ct.indexOf('application/json')!==-1){ var data = JSON.parse(xhr.responseText||'{}'); if(data && data.success){ // hard refresh (bypass bfcache)
                if(data.redirect){ window.location.href = data.redirect; } else { window.location.href = window.location.href.split('#')[0]; }
            } }
        }catch(err){ console.warn('afterRequest parse error', err); }
    });
</script>

<link rel="stylesheet" href="/css/admin-shifts.css" />

<div class="mb-6 page-intro">
    @if (TempData["ShiftsSeeded"] != null)
    {
        <div class="mb-4 bg-green-50 border border-green-200 text-green-800 px-4 py-2 rounded animate-fade-in">
            <span class="font-medium">Success:</span> Default shifts applied (@TempData["ShiftsSeeded"]) and loaded.
        </div>
    }
    <div class="oc-toolbar flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
        <div class="flex-1 min-w-0">
            <h1 class="oc-h1 tracking-tight">Operating Shifts</h1>
            <p class="oc-sub mt-1 text-sm leading-5">Define working hours and production schedules. The stacked timeline view provides maximum horizontal space per day.</p>
        </div>
        <div class="flex items-center flex-wrap gap-3 action-cluster">
            <!-- Template Actions -->
            <div class="relative inline-block text-left">
                <button id="templateDropdown" type="button" class="btn ghost elevated inline-flex items-center bg-white text-gray-700">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    Templates
                    <svg class="w-4 h-4 ml-2 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="templateChevron">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div id="templateMenu" class="template-menu hidden absolute right-0 mt-2 w-72 rounded-xl shadow-2xl bg-white ring-1 ring-black/5 z-50 overflow-hidden animate-scale-fade">
                    <div class="py-2">
                        <div class="px-4 pb-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">Quick Apply</div>
                        <button onclick="loadTemplate('business')" class="template-item">
                            <div class="ti-icon bg-blue-100 text-blue-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0H3"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0 text-left">
                                <div class="font-medium text-gray-900 line-clamp-1">Standard Business Hours</div>
                                <div class="text-xs text-gray-500">Mon–Fri, 8 AM – 5 PM</div>
                            </div>
                        </button>
                        <button onclick="loadTemplate('twoshift')" class="template-item">
                            <div class="ti-icon bg-green-100 text-green-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0 text-left">
                                <div class="font-medium text-gray-900 line-clamp-1">Two-Shift Schedule</div>
                                <div class="text-xs text-gray-500">Mon–Fri, 6 AM–2 PM & 2 PM–10 PM</div>
                            </div>
                        </button>
                        <button onclick="loadTemplate('24x7')" class="template-item">
                            <div class="ti-icon bg-rose-100 text-rose-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0 text-left">
                                <div class="font-medium text-gray-900 line-clamp-1">24/7 Operations</div>
                                <div class="text-xs text-gray-500">All days, continuous</div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Add Shift Button -->
            <button hx-get="/Admin/Shifts?handler=Add" 
                    hx-target="#modal-container"
                    hx-swap="innerHTML"
                    hx-on:htmx:afterSwap="showModal()"
                    class="btn primary elevated">
                <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <span class="hidden sm:inline">Add Shift</span>
            </button>
            <!-- Assignments Button -->
            <button hx-get="/Admin/Shifts?handler=Assignments"
                    hx-target="#assignmentsDrawer .modal-content"
                    hx-swap="innerHTML"
                    hx-on:htmx:afterSwap="showAssignmentsDrawer()"
                    class="btn secondary elevated">
                <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="hidden sm:inline">Assignments</span>
            </button>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="oc-summary-grid mb-8">
    <div class="oc-stat animate-pop">
        <div class="flex items-center gap-4">
            <div class="oc-stat-icon bg-blue-50 text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <p class="label">Total Shifts</p>
                <p class="value">@Model.Shifts.Count</p>
            </div>
        </div>
    </div>
    <div class="oc-stat animate-pop" style="--pop-d:60ms">
        <div class="flex items-center gap-4">
            <div class="oc-stat-icon bg-green-50 text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <p class="label">Active Shifts</p>
                <p class="value">@Model.Shifts.Count(s => s.IsActive)</p>
            </div>
        </div>
    </div>
    <div class="oc-stat animate-pop" style="--pop-d:120ms">
        <div class="flex items-center gap-4">
            <div class="oc-stat-icon bg-amber-50 text-amber-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div>
                <p class="label">Holiday Schedules</p>
                <p class="value">@Model.HolidayShifts.Count</p>
            </div>
        </div>
    </div>
    <div class="oc-stat animate-pop" style="--pop-d:180ms">
        <div class="flex items-center gap-4">
            <div class="oc-stat-icon bg-purple-50 text-purple-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
                <p class="label">Coverage</p>
                <p class="value">@(Model.ShiftsByDay.Keys.Count) days</p>
            </div>
        </div>
    </div>
</div>

<!-- Stacked Weekly Timeline -->
<div class="oc-card mb-10 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-gradient-to-r from-white to-slate-50">
        <div>
            <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-blue-100 text-blue-600 text-xs font-bold">7</span> Weekly Timeline (Stacked)</h2>
            <p class="text-xs text-gray-500 mt-1">Each day spans full width (00:00 → 24:00). Overlaps & overnight shifts are split and highlighted.</p>
        </div>
        <div class="flex items-center gap-3 text-[10px] tracking-wide font-medium text-gray-500 flex-wrap legend-row">
            <span class="legend-block act">Active</span>
            <span class="legend-block ina">Inactive</span>
            <span class="legend-block hol">Holiday</span>
            <span class="legend-block ov">Overlap</span>
        </div>
    </div>
    <div class="stacked-week" id="stackedWeek">
        @{
            var daysOfWeek = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
            for (int i = 0; i < 7; i++)
            {
                var dayShifts = Model.ShiftsByDay.GetValueOrDefault(i, new List<OpCentrix.Models.OperatingShift>())
                                .OrderBy(s=>s.StartTime).ThenBy(s=>s.EndTime).ToList();
                <div class="day-row" data-day-index="@i">
                    <div class="day-meta">
                        <div class="d-label">@daysOfWeek[i]</div>
                        <div class="d-count">@dayShifts.Count shift@((dayShifts.Count==1)?"":"s")</div>
                        <button type="button" class="d-add" title="Add shift" onclick="quickAddShift(@i)">+</button>
                    </div>
                    <div class="day-track-wrapper">
                        <div class="hour-grid" aria-hidden="true">
                            @for(int h=0; h<=24; h+=2){<div class="hg" style="--h:@h"><span>@(h==0?"12a":h<12? h+"a": h==12? "12p": (h-12)+"p")</span></div>}
                        </div>
                        <div class="track" data-day="@i">
                            @if(dayShifts.Any()){
                                // Build ranges
                                var ranges = new List<(int s,int e, OpCentrix.Models.OperatingShift shift)>();
                                foreach(var sh in dayShifts){
                                    var sm = (int)sh.StartTime.TotalMinutes;
                                    var em = (int)sh.EndTime.TotalMinutes;
                                    if(em < sm) em += 1440; // overnight
                                    ranges.Add((sm,em,sh));
                                }
                                // Overlap detection
                                var overlapIds = new HashSet<int>();
                                for(int a=0;a<ranges.Count;a++){
                                    for(int b=a+1;b<ranges.Count;b++){
                                        if(ranges[b].s < ranges[a].e && ranges[b].e > ranges[a].s){
                                            overlapIds.Add(ranges[a].shift.Id);
                                            overlapIds.Add(ranges[b].shift.Id);
                                        }
                                    }
                                }
                                foreach(var r in ranges){
                                    var sh = r.shift;
                                    var sm = r.s; var em = r.e;
                                    var segments = new List<(int segStart,int segEnd,bool wrap)>();
                                    if(em > 1440){
                                        segments.Add((sm,1440,false));
                                        segments.Add((0,em-1440,true));
                                    } else {
                                        segments.Add((sm,em,false));
                                    }
                                    foreach(var seg in segments){
                                        var length = seg.segEnd - seg.segStart;
                                        double startPct = seg.segStart / 1440.0 * 100.0;
                                        double widthPct = length / 1440.0 * 100.0;
                                        var duration = sh.DurationHours.ToString("F1");
                                        var extraCls = (sh.IsActive?"":" inactive") + (sh.IsHoliday?" holiday":"") + (overlapIds.Contains(sh.Id)?" overlap":"") + (seg.wrap?" wrap":"");
                                        <div class="shift-block@extraCls" style="--start:@startPct:F4;--width:@widthPct:F4" data-id="@sh.Id">
                                            <div class="sb-inner" title="@sh.Description (@((new DateTime(1,1,1)+sh.StartTime).ToString("h:mm")) - @((new DateTime(1,1,1)+sh.EndTime).ToString("h:mm")))">
                                                <div class="sb-times">@((new DateTime(1,1,1)+sh.StartTime).ToString("h:mm")) – @((new DateTime(1,1,1)+sh.EndTime).ToString("h:mm"))</div>
                                                <div class="sb-desc">@sh.Description @if(!string.IsNullOrEmpty(sh.MachineId)){<span class="sb-tag">@sh.MachineId</span>} else {<span class="sb-tag gl">Global</span>}</div>
                                                <div class="sb-meta">
                                                    <span class="chip">@duration h</span>
                                                    @if(sh.IsHoliday){<span class="chip hol">Holiday</span>}
                                                    <span class="chip @(sh.IsActive?"on":"off")">@(sh.IsActive?"Active":"Inactive")</span>
                                                    @if(overlapIds.Contains(sh.Id)){<span class="chip ov">Overlap</span>}
                                                </div>
                                                <div class="sb-actions">
                                                    <button hx-get="/Admin/Shifts?handler=Edit&id=@sh.Id" hx-target="#modal-container" hx-swap="innerHTML" hx-on:htmx:afterSwap="showModal()" class="sb-btn">Edit</button>
                                                    <button hx-get="/Admin/Shifts?handler=ToggleActive&id=@sh.Id" hx-include="#af-token-form" hx-swap="none" class="sb-btn">@(sh.IsActive?"Disable":"Enable")</button>
                                                    <button hx-post="/Admin/Shifts?handler=Delete&id=@sh.Id" hx-include="#af-token-form" hx-confirm="Delete shift?" hx-swap="none" class="sb-btn danger">Del</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            } else {
                                <div class="empty-track">No shifts <button type="button" class="inline-add" onclick="quickAddShift(@i)">Add</button></div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Holiday Shifts Table -->
@if (Model.HolidayShifts.Any())
{
    <div class="oc-card modern-table mb-16">
        <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-slate-50 to-white">
            <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-amber-100 text-amber-600 text-xs font-bold">H</span> Holiday & Special Date Schedules</h2>
            <p class="text-xs text-gray-500 mt-1">Specific-date or holiday overrides.</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50/70 backdrop-blur">
                    <tr>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Description</th>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Hours</th>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Duration</th>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-[10px] font-semibold tracking-wider text-gray-600 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    @foreach (var holiday in Model.HolidayShifts)
                    {
                        <tr class="hover:bg-blue-50/40 transition-colors">
                            <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900 font-medium">
                                @if (holiday.SpecificDate.HasValue)
                                {
                                    @holiday.SpecificDate.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-gray-500">@holiday.DayName</span>
                                }
                            </td>
                            <td class="px-6 py-3 text-sm text-gray-800">@holiday.Description</td>
                            <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                                @((new DateTime(1,1,1)+holiday.StartTime).ToString("h:mm tt")) - @((new DateTime(1,1,1)+holiday.EndTime).ToString("h:mm tt"))
                                @if(!string.IsNullOrEmpty(holiday.MachineId)){<span class="ml-2 inline-block px-2 py-0.5 rounded bg-blue-50 text-blue-700">@holiday.MachineId</span>} else {<span class="ml-2 inline-block px-2 py-0.5 rounded bg-gray-50 text-gray-700">Global</span>}
                            </td>
                            <td class="px-6 py-3 whitespace-nowrap text-xs text-gray-600 font-medium">@holiday.DurationHours.ToString("F1") h</td>
                            <td class="px-6 py-3 whitespace-nowrap">
                                <span class="status-chip @(holiday.IsActive ? "on" : "off")">@(holiday.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="px-6 py-3 whitespace-nowrap text-sm font-medium space-x-2">
                                <button hx-get="/Admin/Shifts?handler=Edit&id=@holiday.Id" 
                                        hx-target="#modal-container" 
                                        hx-swap="innerHTML" 
                                        hx-on:htmx:afterSwap="showModal()" 
                                        class="table-act edit">Edit</button>
                                <button hx-post="/Admin/Shifts?handler=Delete&id=@holiday.Id"
                                        hx-include="#af-token-form"
                                        hx-confirm="Are you sure you want to delete this holiday schedule?"
                                        hx-swap="none"
                                        class="table-act del">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Hidden antiforgery token for fetch requests -->
<form id="af-token-form" method="post" class="hidden">@Html.AntiForgeryToken()</form>

<!-- Assignments Drawer -->
<div id="assignmentsDrawer" class="fixed inset-0 z-[9998] hidden">
    <div class="absolute inset-0 bg-black/50" onclick="hideAssignmentsDrawer()"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-xl bg-white shadow-xl flex flex-col">
        <div class="p-4 border-b flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Operator Assignments</h3>
            <button class="text-gray-400 hover:text-gray-600" onclick="hideAssignmentsDrawer()" type="button">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="modal-content flex-1 overflow-auto"></div>
    </div>
    <style>#assignmentsDrawer.show{ display:block; }</style>
    <script>
        function showAssignmentsDrawer(){var d = document.getElementById('assignmentsDrawer'); if(d){ d.classList.add('show'); d.classList.remove('hidden'); }}
        function hideAssignmentsDrawer(){var d = document.getElementById('assignmentsDrawer'); if(d){ d.classList.remove('show'); d.classList.add('hidden'); }}
    </script>
</div>

<!-- Modal container -->
<div id="modal-container" class="fixed inset-0 z-[9999] hidden oc-modal-container"></div>

<!-- Shifts Page Script -->
<script>
(function() {
    'use strict';
    const templateDropdown = document.getElementById('templateDropdown');
    const templateMenu = document.getElementById('templateMenu');
    const templateChevron = document.getElementById('templateChevron');
    if (templateDropdown && templateMenu) {
        templateDropdown.addEventListener('click', function(e) {
            e.stopPropagation();
            templateMenu.classList.toggle('hidden');
            templateChevron?.classList.toggle('rotate-180');
        });
        document.addEventListener('click', function() {
            if(!templateMenu.classList.contains('hidden')){
                templateMenu.classList.add('hidden');
                templateChevron?.classList.remove('rotate-180');
            }
        });
    }
    window.quickAddShift = function(dayOfWeek) {
        const url = `/Admin/Shifts?handler=Add&dayOfWeek=${dayOfWeek}`;
        htmx.ajax('GET', url, { target: '#modal-container', swap: 'innerHTML' });
    };
    window.loadTemplate = function(template) {
        templateMenu.classList.add('hidden');
        templateChevron?.classList.remove('rotate-180');
        htmx.ajax('GET', `/Admin/Shifts?handler=LoadTemplate&template=${template}`, { swap: 'none' });
    };
    window.applyTemplate = function(template, clearExisting = false) {
        htmx.ajax('POST', '/Admin/Shifts?handler=ApplyTemplate', {
             values: { template: template, clearExisting: clearExisting },
             swap: 'none'
         });
    };
    // (Individual handlers removed; global afterRequest now handles reload)
    window.showModal = function(){
        var m = document.getElementById('modal-container');
        if(m && m.innerHTML.trim()){ m.classList.remove('hidden'); m.classList.add('show'); document.body.classList.add('modal-open'); }
    };
    window.hideModal = function(){
        var m = document.getElementById('modal-container');
        if(m){ m.classList.add('hidden'); m.classList.remove('show'); m.innerHTML=''; document.body.classList.remove('modal-open'); }
    };
})();
</script>