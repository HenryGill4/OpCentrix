@page
@model OpCentrix.Pages.Admin.ProductionStages.IndexModel
@{
    ViewData["Title"] = "Production Stages";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-cogs me-2 text-primary"></i>Production Stages</h2>
            <p class="text-muted mb-0">Define manufacturing stages used across all parts</p>
        </div>
        <div class="d-flex gap-2">
            @if (!Model.ProductionStages.Any())
            {
                <form method="post" asp-page-handler="CreateDefaultStages" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="fas fa-download me-1"></i>Import Defaults
                    </button>
                </form>
            }
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#stageFormModal" onclick="openCreateForm()">
                <i class="fas fa-plus me-1"></i>New Stage
            </button>
        </div>
    </div>

    <!-- Stages Table -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model.ProductionStages.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">Order</th>
                                <th>Stage</th>
                                <th>Department</th>
                                <th style="width:80px;">Type</th>
                                <th style="width:100px;">Duration</th>
                                <th style="width:90px;">Rate</th>
                                <th style="width:80px;">Usage</th>
                                <th style="width:130px;">Options</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stage in Model.ProductionStages.OrderBy(s => s.DisplayOrder))
                            {
                                var stats = Model.StageUsageStatistics.GetValueOrDefault(stage.Id, new StageUsageStats());
                                <tr>
                                    <td>
                                        <span class="badge fs-6" style="background-color: @stage.StageColor;">@stage.DisplayOrder</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="@stage.StageIcon me-2 fs-5" style="color: @stage.StageColor;"></i>
                                            <div>
                                                <strong>@stage.Name</strong>
                                                @if (!string.IsNullOrEmpty(stage.Description))
                                                {
                                                    <div class="small text-muted">@stage.Description</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(stage.Department))
                                        {
                                            <span class="badge bg-info">@stage.Department</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (stage.IsBatchStage)
                                        {
                                            <span class="badge bg-primary">Batch</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Per-Part</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@stage.DefaultDurationHours.ToString("F1")h</strong>
                                        <div class="small text-muted">Setup: @stage.DefaultSetupMinutes min</div>
                                    </td>
                                    <td>$@stage.DefaultHourlyRate.ToString("F0")/hr</td>
                                    <td>
                                        <span class="badge bg-light text-dark" title="Parts using this stage">
                                            <i class="fas fa-cube me-1"></i>@stats.PartUsageCount
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (stage.RequiresQualityCheck) { <span class="badge bg-success" title="Requires QC"><i class="fas fa-check-circle"></i></span> }
                                            @if (stage.RequiresApproval) { <span class="badge bg-warning text-dark" title="Requires Approval"><i class="fas fa-stamp"></i></span> }
                                            @if (stage.RequiresMachineAssignment) { <span class="badge bg-info" title="Machine Required"><i class="fas fa-server"></i></span> }
                                            @if (stage.AllowParallelExecution) { <span class="badge bg-secondary" title="Parallel OK"><i class="fas fa-columns"></i></span> }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Edit"
                                                    data-bs-toggle="modal" data-bs-target="#stageFormModal"
                                                    onclick="openEditForm(@stage.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            @if (stats.TotalUsageCount == 0)
                                            {
                                                <form method="post" asp-page-handler="DeleteStage" class="d-inline"
                                                      onsubmit="return confirm('Delete stage \'@stage.Name\'?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="stageId" value="@stage.Id" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-danger disabled" title="In use by @stats.TotalUsageCount items">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-cogs fa-3x mb-3"></i>
                    <h5>No Production Stages</h5>
                    <p>Click "Import Defaults" to get started or create your first stage.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create/Edit Stage Modal -->
<div class="modal fade" id="stageFormModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateStage" id="stageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewStage.Id" id="stageFormId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title" id="stageFormTitle">
                        <i class="fas fa-plus me-2"></i>New Production Stage
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Row 1: Name + Department -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Stage Name *</label>
                            <input type="text" name="NewStage.Name" id="stageName" class="form-control" required maxlength="100"
                                   placeholder="e.g. SLS Printing" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Department</label>
                            <select name="NewStage.Department" id="stageDepartment" class="form-select">
                                <option value="">--</option>
                                <option value="SLS">SLS</option>
                                <option value="Post-Process">Post-Process</option>
                                <option value="EDM">EDM</option>
                                <option value="Machining">Machining</option>
                                <option value="Finishing">Finishing</option>
                                <option value="Assembly">Assembly</option>
                                <option value="Quality">Quality</option>
                                <option value="Shipping">Shipping</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Color</label>
                            <input type="color" name="NewStage.StageColor" id="stageColor" class="form-control form-control-color w-100" value="#007bff" />
                        </div>

                        <!-- Row 2: Description -->
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <input type="text" name="NewStage.Description" id="stageDescription" class="form-control" maxlength="500"
                                   placeholder="Brief description..." />
                        </div>

                        <!-- Row 3: Timing -->
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Default Duration (h)</label>
                            <input type="number" name="NewStage.DefaultDurationHours" id="stageDuration" class="form-control"
                                   step="0.1" min="0.1" max="100" value="1.0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Setup (min)</label>
                            <input type="number" name="NewStage.DefaultSetupMinutes" id="stageSetup" class="form-control"
                                   min="0" max="480" value="30" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hourly Rate ($)</label>
                            <input type="number" name="NewStage.DefaultHourlyRate" id="stageRate" class="form-control"
                                   step="0.01" min="0" max="500" value="85.00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Material Cost ($)</label>
                            <input type="number" name="NewStage.DefaultMaterialCost" id="stageMaterialCost" class="form-control"
                                   step="0.01" min="0" value="0.00" />
                        </div>

                        <!-- Row 4: Flags -->
                        <div class="col-12">
                            <label class="form-label fw-bold mb-2">Stage Options</label>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" name="NewStage.IsBatchStage" id="stageIsBatch" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageIsBatch">
                                            <strong>Batch Stage</strong>
                                            <div class="small text-muted">Processes multiple parts at once</div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" name="NewStage.RequiresQualityCheck" id="stageQC" class="form-check-input" value="true" checked />
                                        <label class="form-check-label" for="stageQC">Requires QC</label>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input type="checkbox" name="NewStage.RequiresApproval" id="stageApproval" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageApproval">Requires Approval</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" name="NewStage.RequiresMachineAssignment" id="stageMachine" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageMachine">Machine Required</label>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input type="checkbox" name="NewStage.AllowParallelExecution" id="stageParallel" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageParallel">Allow Parallel</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" name="NewStage.AllowSkip" id="stageSkip" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageSkip">Allow Skip</label>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input type="checkbox" name="NewStage.IsOptional" id="stageOptional" class="form-check-input" value="true" />
                                        <label class="form-check-label" for="stageOptional">Optional</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="stageSubmitBtn">
                        <i class="fas fa-save me-1"></i><span id="stageSubmitText">Create Stage</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openCreateForm() {
        document.getElementById('stageFormTitle').innerHTML = '<i class="fas fa-plus me-2"></i>New Production Stage';
        document.getElementById('stageSubmitText').textContent = 'Create Stage';
        document.getElementById('stageForm').action = '?handler=CreateStage';
        document.getElementById('stageFormId').value = '0';
        
        // Reset fields
        document.getElementById('stageName').value = '';
        document.getElementById('stageDepartment').value = '';
        document.getElementById('stageDescription').value = '';
        document.getElementById('stageDuration').value = '1.0';
        document.getElementById('stageSetup').value = '30';
        document.getElementById('stageRate').value = '85.00';
        document.getElementById('stageMaterialCost').value = '0.00';
        document.getElementById('stageColor').value = '#007bff';
        document.getElementById('stageIsBatch').checked = false;
        document.getElementById('stageQC').checked = true;
        document.getElementById('stageApproval').checked = false;
        document.getElementById('stageMachine').checked = false;
        document.getElementById('stageParallel').checked = false;
        document.getElementById('stageSkip').checked = false;
        document.getElementById('stageOptional').checked = false;
    }

    async function openEditForm(stageId) {
        document.getElementById('stageFormTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Stage';
        document.getElementById('stageSubmitText').textContent = 'Update Stage';
        document.getElementById('stageForm').action = '?handler=UpdateStage';
        document.getElementById('stageFormId').value = stageId;

        try {
            const response = await fetch(`?handler=StageDetails&stageId=${stageId}`);
            if (!response.ok) throw new Error('Failed to load stage');
            const s = await response.json();

            document.getElementById('stageName').value = s.name || '';
            document.getElementById('stageDepartment').value = s.department || '';
            document.getElementById('stageDescription').value = s.description || '';
            document.getElementById('stageDuration').value = s.defaultDurationHours || 1;
            document.getElementById('stageSetup').value = s.defaultSetupMinutes || 30;
            document.getElementById('stageRate').value = s.defaultHourlyRate || 85;
            document.getElementById('stageMaterialCost').value = s.defaultMaterialCost || 0;
            document.getElementById('stageColor').value = s.stageColor || '#007bff';
            document.getElementById('stageIsBatch').checked = !!s.isBatchStage;
            document.getElementById('stageQC').checked = !!s.requiresQualityCheck;
            document.getElementById('stageApproval').checked = !!s.requiresApproval;
            document.getElementById('stageMachine').checked = !!s.requiresMachineAssignment;
            document.getElementById('stageParallel').checked = !!s.allowParallelExecution;
            document.getElementById('stageSkip').checked = !!s.allowSkip;
            document.getElementById('stageOptional').checked = !!s.isOptional;
        } catch (err) {
            console.error('Error loading stage:', err);
            alert('Failed to load stage details.');
        }
    }
</script>
}
