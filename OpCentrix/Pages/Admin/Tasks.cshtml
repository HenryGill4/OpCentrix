@page
@model OpCentrix.Pages.Admin.TasksModel
@{
    ViewData["Title"] = "Manage Tasks";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-4">
        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded mb-4">
        <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["Warning"]
    </div>
}

<div class="mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Task Management</h1>
            <p class="text-gray-600 mt-1">Manage operational tasks, maintenance schedules, and assignments</p>
        </div>
        <div class="flex items-center space-x-3">
            <button hx-get="/Admin?handler=CreateTaskModal"
                    hx-target="#modal-container"
                    hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                    class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition">
                <i class="fas fa-plus"></i> New Task
            </button>
            <button hx-get="/Admin?handler=MaintenanceTaskModal"
                    hx-target="#modal-container"
                    hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                <i class="fas fa-wrench"></i> Maintenance
            </button>
        </div>
    </div>
</div>

<!-- Task Overview Cards -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600 mr-4">
                <i class="fas fa-tasks text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Open Tasks</p>
                <h3 class="text-xl font-bold text-gray-900">@Model.OpenTasks</h3>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center text-orange-600 mr-4">
                <i class="fas fa-clock text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">In Progress</p>
                <h3 class="text-xl font-bold text-gray-900">@Model.InProgressTasks</h3>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600 mr-4">
                <i class="fas fa-exclamation-triangle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Overdue</p>
                <h3 class="text-xl font-bold text-gray-900">@Model.OverdueTasks</h3>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-green-600 mr-4">
                <i class="fas fa-check-circle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Completed Today</p>
                <h3 class="text-xl font-bold text-gray-900">@Model.CompletedTodayTasks</h3>
            </div>
        </div>
    </div>
</div>

<!-- Task List -->
<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="border-b border-gray-200 bg-gray-50 px-6 py-4">
        <h3 class="text-lg font-medium text-gray-900">All Tasks</h3>
    </div>
    
    <div class="p-6">
        @if (Model.Tasks.Any())
        {
            <div class="space-y-4">
                @foreach (var task in Model.Tasks)
                {
                    <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <div class="flex items-center space-x-3">
                                    <h4 class="text-lg font-medium text-gray-900">@task.Title</h4>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(
                                        task.Status == "Open" ? "bg-blue-100 text-blue-800" :
                                        task.Status == "InProgress" ? "bg-orange-100 text-orange-800" :
                                        task.Status == "Completed" ? "bg-green-100 text-green-800" :
                                        "bg-gray-100 text-gray-800")">
                                        @task.Status
                                    </span>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(
                                        task.Priority == 1 ? "bg-red-100 text-red-800" :
                                        task.Priority == 2 ? "bg-orange-100 text-orange-800" :
                                        task.Priority == 3 ? "bg-blue-100 text-blue-800" :
                                        "bg-gray-100 text-gray-800")">
                                        Priority @task.Priority
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <p class="text-sm text-gray-600 mt-1">@task.Description</p>
                                }
                                <div class="flex items-center space-x-4 mt-2 text-xs text-gray-500">
                                    <span><i class="fas fa-tag"></i> @task.TaskType</span>
                                    @if (!string.IsNullOrEmpty(task.MachineId))
                                    {
                                        <span><i class="fas fa-cog"></i> @task.MachineId</span>
                                    }
                                    <span><i class="fas fa-calendar"></i> @task.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    @if (task.DueAt.HasValue)
                                    {
                                        <span class="@(task.DueAt < DateTime.Now ? "text-red-600" : "")">
                                            <i class="fas fa-clock"></i> Due: @task.DueAt?.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    }
                                </div>
                            </div>
                            
                            <div class="flex items-center space-x-2">
                                @if (task.Status == "Open")
                                {
                                    <form method="post" asp-page-handler="StartTask" class="inline">
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <button type="submit" class="text-blue-600 hover:text-blue-800 text-sm font-medium px-3 py-1 rounded hover:bg-blue-50">
                                            <i class="fas fa-play mr-1"></i>Start
                                        </button>
                                    </form>
                                }
                                @if (task.Status == "InProgress")
                                {
                                    <form method="post" asp-page-handler="CompleteTask" class="inline">
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <button type="submit" class="text-green-600 hover:text-green-800 text-sm font-medium px-3 py-1 rounded hover:bg-green-50">
                                            <i class="fas fa-check mr-1"></i>Complete
                                        </button>
                                    </form>
                                }
                                
                                <!-- Quick Status Updates -->
                                <div class="relative group">
                                    <button class="text-indigo-600 hover:text-indigo-800 text-sm font-medium px-3 py-1 rounded hover:bg-indigo-50">
                                        <i class="fas fa-edit mr-1"></i>Status
                                    </button>
                                    <div class="absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg border border-gray-200 z-50 opacity-0 group-hover:opacity-100 transition-opacity duration-150 invisible group-hover:visible">
                                        <div class="py-1">
                                            @if (task.Status != "Open")
                                            {
                                                <form method="post" asp-page-handler="UpdateTaskStatus" class="block">
                                                    <input type="hidden" name="taskId" value="@task.Id" />
                                                    <input type="hidden" name="status" value="Open" />
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                        <i class="fas fa-circle text-blue-500 mr-2"></i>Mark as Open
                                                    </button>
                                                </form>
                                            }
                                            @if (task.Status != "InProgress")
                                            {
                                                <form method="post" asp-page-handler="UpdateTaskStatus" class="block">
                                                    <input type="hidden" name="taskId" value="@task.Id" />
                                                    <input type="hidden" name="status" value="InProgress" />
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                        <i class="fas fa-play text-orange-500 mr-2"></i>Mark In Progress
                                                    </button>
                                                </form>
                                            }
                                            @if (task.Status != "Completed")
                                            {
                                                <form method="post" asp-page-handler="UpdateTaskStatus" class="block">
                                                    <input type="hidden" name="taskId" value="@task.Id" />
                                                    <input type="hidden" name="status" value="Completed" />
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                        <i class="fas fa-check text-green-500 mr-2"></i>Mark as Completed
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Edit Task Modal Trigger -->
                                <button hx-get="/Admin?handler=EditTaskModal&taskId=@task.Id"
                                        hx-target="#modal-container"
                                        hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                                        class="text-gray-600 hover:text-gray-800 text-sm font-medium px-3 py-1 rounded hover:bg-gray-50">
                                    <i class="fas fa-edit mr-1"></i>Edit
                                </button>
                                
                                <!-- Delete Task -->
                                <form method="post" asp-page-handler="DeleteTask" class="inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this task?');">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium px-3 py-1 rounded hover:bg-red-50">
                                        <i class="fas fa-trash mr-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <div class="w-24 h-24 mx-auto mb-4">
                    <svg class="w-24 h-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No tasks found</h3>
                <p class="text-gray-500 mb-4">Get started by creating your first operational task.</p>
                <button hx-get="/Admin?handler=CreateTaskModal"
                        hx-target="#modal-container"
                        hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                        class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition">
                    <i class="fas fa-plus"></i> Create First Task
                </button>
            </div>
        }
    </div>
</div>

<script>
// Modal management functions
function showModal(content) {
    const modalContainer = document.getElementById('modal-container');
    if (modalContainer) {
        modalContainer.innerHTML = `
            <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                <div class="bg-white rounded-lg max-w-4xl w-full mx-4 max-h-screen overflow-y-auto">
                    ${content}
                </div>
            </div>`;
        modalContainer.style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
}

function hideModal() {
    const modalContainer = document.getElementById('modal-container');
    if (modalContainer) {
        modalContainer.innerHTML = '';
        modalContainer.style.display = 'none';
        document.body.style.overflow = 'auto';
    }
}

// Notification system
function showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transition-all duration-300 ${
        type === 'success' ? 'bg-green-500 text-white' :
        type === 'error' ? 'bg-red-500 text-white' :
        type === 'warning' ? 'bg-yellow-500 text-white' :
        'bg-blue-500 text-white'
    }`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.remove();
    }, 5000);
}
</script>

<!-- Modal container for dynamic content -->
<div id="modal-container" style="display: none;"></div>