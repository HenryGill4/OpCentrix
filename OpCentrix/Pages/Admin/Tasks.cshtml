@page
@model OpCentrix.Pages.Admin.TasksModel
@{
    ViewData["Title"] = "Tasks - Redirecting";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
        <div class="mb-4">
            <i class="fas fa-arrow-right text-blue-600 text-4xl mb-4"></i>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Task Management Has Moved</h1>
            <p class="text-gray-600 mb-4">The task management system has been upgraded to our new CRM-integrated platform with enhanced features.</p>
        </div>
        
        <div class="bg-white border border-blue-200 rounded-lg p-6 mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">New Features Available:</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <div>
                        <h4 class="font-medium text-gray-900">Enhanced Task Cards</h4>
                        <p class="text-sm text-gray-600">User-organized task views with progress tracking</p>
                    </div>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <div>
                        <h4 class="font-medium text-gray-900">Advanced Filtering</h4>
                        <p class="text-sm text-gray-600">Filter by status, assignee, priority, and account</p>
                    </div>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <div>
                        <h4 class="font-medium text-gray-900">Progress Tracking</h4>
                        <p class="text-sm text-gray-600">Detailed progress entries and completion tracking</p>
                    </div>
                </div>
                <div class="flex items-start space-x-3">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <div>
                        <h4 class="font-medium text-gray-900">CRM Integration</h4>
                        <p class="text-sm text-gray-600">Link tasks to accounts and contacts</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="space-y-3">
            <p class="text-gray-700 text-sm mb-4">You will be automatically redirected to the new task management system.</p>
            <div class="flex justify-center space-x-4">
                <a href="/CRM/Tasks/AdminDashboard" class="btn btn-primary">
                    <i class="fas fa-arrow-right mr-2"></i>Go to New Admin Dashboard
                </a>
                <a href="/CRM/Tasks" class="btn btn-outline-primary">
                    <i class="fas fa-tasks mr-2"></i>Go to Task Management
                </a>
            </div>
        </div>
    </div>
</div>

<script>
// Auto-redirect after 3 seconds
setTimeout(function() {
    window.location.href = '/CRM/Tasks/AdminDashboard';
}, 3000);

// Show countdown
let countdown = 3;
const countdownInterval = setInterval(function() {
    const countdownElement = document.getElementById('countdown');
    if (countdownElement) {
        countdownElement.textContent = countdown;
    }
    countdown--;
    if (countdown < 0) {
        clearInterval(countdownInterval);
    }
}, 1000);
</script>

<style>
.btn {
    @apply inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium transition-colors duration-200;
}
.btn-primary {
    @apply text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500;
}
.btn-outline-primary {
    @apply text-indigo-600 bg-white border-indigo-600 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500;
}
</style>