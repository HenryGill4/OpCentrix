@page
@model OpCentrix.Pages.Admin.JobsModel
@{
    ViewData["Title"] = "Manage Jobs";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Manage Jobs</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">View, edit, and manage manufacturing jobs across all machines</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <button onclick="window.location.href='/Scheduler'" class="bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-6 py-3 rounded-xl font-medium transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-plus mr-2"></i>
                    Add New Job
                </button>
            </div>
        </div>
    </div>

    <!-- Enhanced Filters -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-6 mb-8 transition-colors duration-300">
        <div class="flex items-center mb-4">
            <i class="fa-solid fa-filter text-blue-600 dark:text-blue-400 mr-2"></i>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Filter Jobs</h2>
        </div>
        <form method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="space-y-1">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Search</label>
                <div class="relative">
                    <input type="text" name="search" value="@Model.SearchTerm" 
                           placeholder="Part number, operator, notes..." 
                           class="w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" />
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                </div>
            </div>
            
            <div class="space-y-1">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Status</label>
                <select name="status" class="w-full py-3 px-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200">
                    <option value="">All Statuses</option>
                    <option value="Scheduled" selected="@(Model.StatusFilter == "Scheduled")">Scheduled</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Complete" selected="@(Model.StatusFilter == "Complete")">Complete</option>
                    <option value="Delayed" selected="@(Model.StatusFilter == "Delayed")">Delayed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            
            <div class="space-y-1">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Machine</label>
                <select name="machine" class="w-full py-3 px-4 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200">
                    <option value="">All Machines</option>
                    <option value="TI1" selected="@(Model.MachineFilter == "TI1")">TI1</option>
                    <option value="TI2" selected="@(Model.MachineFilter == "TI2")">TI2</option>
                    <option value="INC" selected="@(Model.MachineFilter == "INC")">INC</option>
                </select>
            </div>
            
            <div class="flex items-end">
                <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-search mr-2"></i>
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Results Summary -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6">
        <div class="flex items-center space-x-2">
            <i class="fa-solid fa-list text-gray-500 dark:text-gray-400"></i>
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Showing <span class="font-semibold text-gray-900 dark:text-gray-100">@((Model.PageNumber - 1) * Model.PageSize + 1)</span> 
                to <span class="font-semibold text-gray-900 dark:text-gray-100">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span> 
                of <span class="font-semibold text-gray-900 dark:text-gray-100">@Model.TotalCount</span> jobs
            </p>
        </div>
        <div class="mt-2 sm:mt-0">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                <i class="fa-solid fa-clock mr-1"></i>
                Updated @DateTime.Now.ToString("HH:mm")
            </span>
        </div>
    </div>

<!-- Jobs Cards Grid -->
@if (Model.Jobs.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        @foreach (var job in Model.Jobs)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
                <!-- Card Header -->
                <div class="bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-700 dark:to-gray-600 p-4 border-b border-gray-200 dark:border-gray-600">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">#@job.Id</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Job ID</p>
                        </div>
                        <div class="text-right">
                            @{
                                var statusClass = job.Status switch
                                {
                                    "Scheduled" => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 border-blue-200 dark:border-blue-800",
                                    "Active" => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 border-green-200 dark:border-green-800",
                                    "Complete" => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200 border-gray-200 dark:border-gray-600",
                                    "Delayed" => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200 border-red-200 dark:border-red-800",
                                    "Cancelled" => "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400 border-gray-200 dark:border-gray-600",
                                    _ => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200 border-gray-200 dark:border-gray-600"
                                };
                            }
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @statusClass">
                                @switch (job.Status)
                                {
                                    case "Scheduled":
                                        <i class="fa-solid fa-clock mr-1"></i>
                                        break;
                                    case "Active":
                                        <i class="fa-solid fa-play mr-1"></i>
                                        break;
                                    case "Complete":
                                        <i class="fa-solid fa-check mr-1"></i>
                                        break;
                                    case "Delayed":
                                        <i class="fa-solid fa-exclamation-triangle mr-1"></i>
                                        break;
                                    case "Cancelled":
                                        <i class="fa-solid fa-ban mr-1"></i>
                                        break;
                                    default:
                                        <i class="fa-solid fa-question mr-1"></i>
                                        break;
                                }
                                @job.Status
                            </span>
                        </div>
                    </div>
                        
                    <!-- Machine Badge -->
                    <div class="flex justify-between items-center">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @(job.MachineId switch { "TI1" => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200", "TI2" => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200", "INC" => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200", _ => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200" })">
                            <i class="fa-solid fa-industry mr-2"></i>
                            @job.MachineId
                        </span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">
                            Qty: <span class="font-semibold text-gray-700 dark:text-gray-300">@job.Quantity</span>
                        </span>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="p-4 space-y-4">
                    <!-- Part Information -->
                    <div>
                        <div class="flex items-center mb-2">
                            <i class="fa-solid fa-puzzle-piece text-blue-600 dark:text-blue-400 mr-2"></i>
                            <h4 class="font-semibold text-gray-900 dark:text-gray-100">Part Information</h4>
                        </div>
                        <p class="text-sm font-mono text-gray-800 dark:text-gray-200 bg-gray-50 dark:bg-gray-700 px-3 py-2 rounded-lg">@job.PartNumber</p>
                        @if (job.Part != null)
                        {
                            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">@job.Part.Description</p>
                        }
                    </div>

                    <!-- Schedule Information -->
                    <div>
                        <div class="flex items-center mb-2">
                            <i class="fa-solid fa-calendar text-purple-600 dark:text-purple-400 mr-2"></i>
                            <h4 class="font-semibold text-gray-900 dark:text-gray-100">Schedule</h4>
                        </div>
                        <div class="space-y-1">
                            <div class="flex justify-between text-xs">
                                <span class="text-gray-600 dark:text-gray-400">Start:</span>
                                <span class="font-mono text-gray-900 dark:text-gray-100">@job.ScheduledStart.ToString("MM/dd HH:mm")</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-gray-600 dark:text-gray-400">End:</span>
                                <span class="font-mono text-gray-900 dark:text-gray-100">@job.ScheduledEnd.ToString("MM/dd HH:mm")</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-gray-600 dark:text-gray-400">Duration:</span>
                                <span class="font-semibold text-blue-600 dark:text-blue-400">@job.ScheduledDuration.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Operator Information -->
                    @if (!string.IsNullOrEmpty(job.Operator))
                    {
                        <div>
                            <div class="flex items-center mb-2">
                                <i class="fa-solid fa-user text-green-600 dark:text-green-400 mr-2"></i>
                                <h4 class="font-semibold text-gray-900 dark:text-gray-100">Operator</h4>
                            </div>
                            <p class="text-sm text-gray-700 dark:text-gray-300">@job.Operator</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="flex items-center mb-2">
                                <i class="fa-solid fa-user text-gray-400 mr-2"></i>
                                <h4 class="font-semibold text-gray-500 dark:text-gray-400">Operator</h4>
                            </div>
                            <p class="text-sm text-gray-500 dark:text-gray-400 italic">Not assigned</p>
                        </div>
                    }
                </div>

                <!-- Card Footer -->
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 border-t border-gray-200 dark:border-gray-600">
                    <div class="flex justify-between items-center">
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                            Created: @job.CreatedDate.ToString("MM/dd/yy")
                        </div>
                        <div class="flex space-x-2">
                            <button hx-get="/Admin/Jobs?handler=Edit&id=@job.Id" 
                                    hx-target="#modal-container"
                                    hx-on:htmx:after-request="showModal(event.detail.xhr.responseText)"
                                    class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-400 bg-blue-100 dark:bg-blue-900 hover:bg-blue-200 dark:hover:bg-blue-800 rounded-lg transition-colors duration-200">
                                <i class="fa-solid fa-edit mr-1"></i>
                                Edit
                            </button>
                            <button hx-post="/Admin/Jobs?handler=Delete&id=@job.Id"
                                    hx-confirm="Are you sure you want to delete this job?"
                                    class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-red-700 dark:text-red-400 bg-red-100 dark:bg-red-900 hover:bg-red-200 dark:hover:bg-red-800 rounded-lg transition-colors duration-200">
                                <i class="fa-solid fa-trash mr-1"></i>
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border-2 border-dashed border-gray-300 dark:border-gray-600 p-12 text-center">
        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-clipboard-list text-2xl text-gray-400 dark:text-gray-500"></i>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">No Jobs Found</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">No jobs match your current filter criteria.</p>
        <div class="space-x-3">
            <button onclick="document.querySelector('form').reset(); document.querySelector('form').submit();" 
                    class="bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg transition-colors duration-200">
                <i class="fa-solid fa-refresh mr-2"></i>
                Clear Filters
            </button>
            <button onclick="window.location.href='/Scheduler'" 
                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors duration-200">
                <i class="fa-solid fa-plus mr-2"></i>
                Create Job
            </button>
        </div>
    </div>
}

    <!-- Enhanced Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 px-6 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <!-- Mobile Pagination -->
                <div class="flex justify-between sm:hidden">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="?page=@(Model.PageNumber - 1)&search=@Model.SearchTerm&status=@Model.StatusFilter&machine=@Model.MachineFilter" 
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <i class="fa-solid fa-chevron-left mr-2"></i>
                            Previous
                        </a>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="?page=@(Model.PageNumber + 1)&search=@Model.SearchTerm&status=@Model.StatusFilter&machine=@Model.MachineFilter" 
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            Next
                            <i class="fa-solid fa-chevron-right ml-2"></i>
                        </a>
                    }
                </div>

                <!-- Desktop Pagination -->
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-file-lines text-gray-500 dark:text-gray-400"></i>
                        <p class="text-sm text-gray-700 dark:text-gray-300">
                            Page <span class="font-semibold text-blue-600 dark:text-blue-400">@Model.PageNumber</span> 
                            of <span class="font-semibold text-blue-600 dark:text-blue-400">@Model.TotalPages</span>
                        </p>
                    </div>
                    
                    <nav class="relative z-0 inline-flex rounded-lg shadow-sm -space-x-px" aria-label="Pagination">
                        <!-- Previous Button -->
                        @if (Model.PageNumber > 1)
                        {
                            <a href="?page=@(Model.PageNumber - 1)&search=@Model.SearchTerm&status=@Model.StatusFilter&machine=@Model.MachineFilter"
                               class="relative inline-flex items-center px-3 py-2 rounded-l-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-200">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        }

                        <!-- Page Numbers -->
                        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                        {
                            @if (i == Model.PageNumber)
                            {
                                <span class="relative inline-flex items-center px-4 py-2 border border-blue-500 dark:border-blue-400 bg-blue-50 dark:bg-blue-900 text-sm font-semibold text-blue-600 dark:text-blue-400">
                                    @i
                                </span>
                            }
                            else
                            {
                                <a href="?page=@i&search=@Model.SearchTerm&status=@Model.StatusFilter&machine=@Model.MachineFilter" 
                                   class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 hover:text-gray-900 dark:hover:text-gray-100 transition-colors duration-200">
                                    @i
                                </a>
                            }
                        }

                        <!-- Next Button -->
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a href="?page=@(Model.PageNumber + 1)&search=@Model.SearchTerm&status=@Model.StatusFilter&machine=@Model.MachineFilter"
                               class="relative inline-flex items-center px-3 py-2 rounded-r-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-200">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
