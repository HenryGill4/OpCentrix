<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpCentrix Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpCentrix.styles.css" asp-append-version="true" />
    
    @* Font Awesome for icons *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Admin Dark Mode System -->
    <script src="~/js/admin-dark-mode.js" asp-append-version="true"></script>
    
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 dark:bg-gray-900 overflow-hidden transition-colors duration-300" data-theme-responsive="true">
    <div class="flex h-screen">
        <!-- Enhanced Admin Sidebar Navigation -->
        <div id="sidebar" style="overflow:auto !important;" class="bg-white dark:bg-gray-800 shadow-lg w-80 fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-in-out">
            <!-- Logo and Brand -->
            <div class="flex items-center justify-between h-16 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-white bg-opacity-20 rounded-lg flex items-center justify-center mr-3 opcentrix-logo-container">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-lg font-bold">OpCentrix</div>
                        <div class="text-xs opacity-75">Admin Control Center</div>
                    </div>
                </div>
                <!-- Expand/Collapse All -->
                @* <div class="hidden md:flex items-center gap-1 text-white opacity-90 ">
                    <button id="expandAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Expand all sections">Expand</button>
                    <button id="collapseAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Collapse all sections">Collapse</button>
                </div> *@
            </div>

            <!-- User Profile Section -->
            <div class="px-4 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 transition-colors duration-300">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-semibold">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="ml-3">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100">@(User.Identity?.Name ?? "Administrator")</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">System Administrator</div>
                    </div>
                </div>
                
                <!-- Theme Toggle -->
                <div class="mt-3 flex items-center justify-between px-4 py-2 border-t border-gray-200 dark:border-gray-700">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Theme</span>
                    <button onclick="toggleTheme()" class="theme-toggle-btn p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200" title="Toggle dark mode">
                        <svg class="w-4 h-4 text-gray-600 dark:text-gray-300 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <svg class="w-4 h-4 text-gray-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        </svg>
                    </button>
                </div>
            </div>

            @{
                var path = ViewContext.HttpContext?.Request?.Path.Value ?? string.Empty;
                var page = ViewContext.RouteData.Values["page"]?.ToString();
                var handler = ViewContext.HttpContext.Request.Query["handler"].ToString();
                
                // Enhanced route detection for better active states
                bool isDashboard = path.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || path.Equals("/Admin/Index", StringComparison.OrdinalIgnoreCase);
                bool isScheduler = path.Equals("/Scheduler", StringComparison.OrdinalIgnoreCase) || path.Equals("/Scheduler/Index", StringComparison.OrdinalIgnoreCase);
                bool isMasterSchedule = path.Equals("/Scheduler/MasterSchedule", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Scheduler/MasterSchedule/", StringComparison.OrdinalIgnoreCase);
                bool isCrmAccounts = path.Equals("/CRM/Accounts", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/CRM/Accounts/", StringComparison.OrdinalIgnoreCase);
                bool isCrmTasks = path.Equals("/CRM/Tasks", StringComparison.OrdinalIgnoreCase) || (path.StartsWith("/CRM/Tasks/", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/CRM/Tasks/Admin", StringComparison.OrdinalIgnoreCase));
                bool isCrmTaskAdmin = path.Equals("/CRM/Tasks/Admin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/CRM/Tasks/Admin/", StringComparison.OrdinalIgnoreCase);
                bool isCrmTaskProgress = path.Contains("/AddProgress", StringComparison.OrdinalIgnoreCase);
                bool isCrmAlerts = path.Equals("/CRM/Alerts", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/CRM/Alerts/", StringComparison.OrdinalIgnoreCase);
                
                // Admin page detection
                bool isAdminUsers = page == "/Admin/Users" || path.Contains("/Admin/Users");
                bool isAdminRoles = page == "/Admin/Roles" || path.Contains("/Admin/Roles");
                bool isAdminSettings = page == "/Admin/Settings" || path.Contains("/Admin/Settings");
                bool isAdminMachines = page == "/Admin/Machines" || path.Contains("/Admin/Machines");
                bool isAdminParts = page == "/Admin/Parts" || path.Contains("/Admin/Parts");
                bool isAdminMaterials = page == "/Admin/Materials" || path.Contains("/Admin/Materials");
                bool isAdminJobs = page == "/Admin/Jobs" || path.Contains("/Admin/Jobs");
                bool isAdminShifts = page == "/Admin/Shifts" || path.Contains("/Admin/Shifts");
                bool isAdminStages = page == "/Admin/Stages" || path.Contains("/Admin/Stages");
                bool isAdminProductionStages = path.Contains("ProductionStages");
                bool isPrintTracking = path.Equals("/PrintTracking", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/PrintTracking/", StringComparison.OrdinalIgnoreCase);
                
                // Helper function to get active class
                Func<bool, string> GetActiveClass = (isActive) => isActive ? "nav-item-active" : "";
            }

            <!-- Navigation Menu -->
            <nav class="mt-3 px-2 space-y-2 flex-1 overflow-y-auto" aria-label="Admin Navigation">
                <!-- Overview -->
                <section class="nav-section" data-key="overview">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200" aria-expanded="true" aria-controls="section-overview">
                        <span>Overview</span>
                        <span class="chevron text-gray-400 dark:text-gray-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-overview" class="nav-section-content space-y-1">
                        <a href="/Admin" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isDashboard) transition-colors duration-200">
                            <i class="fa-solid fa-gauge mr-3"></i>
                            Admin Dashboard
                        </a>
                        <a href="/Scheduler" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isScheduler) transition-colors duration-200">
                            <i class="fa-solid fa-calendar-days mr-3"></i>
                            Job Scheduler
                        </a>
                        <a href="/Scheduler/MasterSchedule" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isMasterSchedule) transition-colors duration-200">
                            <i class="fa-solid fa-chart-line mr-3"></i>
                            Master Schedule
                        </a>
                    </div>
                </section>

                <!-- CRM -->
                <section class="nav-section" data-key="crm">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300" aria-expanded="true" aria-controls="section-crm">
                        <span>CRM</span>
                        <span class="chevron text-emerald-400 dark:text-emerald-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-crm" class="nav-section-content space-y-1">
                        <a href="/CRM/Accounts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isCrmAccounts) transition-colors duration-200">
                            <i class="fa-solid fa-building mr-3"></i>
                            Accounts
                        </a>
                        <a href="/CRM/Tasks" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isCrmTasks) transition-colors duration-200">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Tasks
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a href="/CRM/Tasks/Admin" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isCrmTaskAdmin) transition-colors duration-200">
                                <i class="fa-solid fa-users-gear mr-3"></i>
                                Task Management
                            </a>
                        }
                        <a href="/CRM/Alerts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isCrmAlerts) transition-colors duration-200">
                            <i class="fa-solid fa-bell mr-3"></i>
                            Alerts & Notifications
                        </a>
                    </div>
                </section>

                <!-- System Administration -->
                <section class="nav-section" data-key="system-admin">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300" aria-expanded="true" aria-controls="section-system-admin">
                        <span>System Administration</span>
                        <span class="chevron text-red-400 dark:text-red-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-system-admin" class="nav-section-content space-y-1">
                        <a href="/Admin/Users" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminUsers) transition-colors duration-200">
                            <i class="fa-solid fa-users mr-3"></i>
                            User Management
                        </a>
                        <a href="/Admin/Roles" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminRoles) transition-colors duration-200">
                            <i class="fa-solid fa-shield-halved mr-3"></i>
                            Role Permissions
                        </a>
                        <a href="/Admin/Settings" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminSettings) transition-colors duration-200">
                            <i class="fa-solid fa-gear mr-3"></i>
                            System Settings
                        </a>
                    </div>
                </section>

                <!-- Resource Management -->
                <section class="nav-section" data-key="resources">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300" aria-expanded="true" aria-controls="section-resources">
                        <span>Resource Management</span>
                        <span class="chevron text-blue-400 dark:text-blue-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-resources" class="nav-section-content space-y-1">
                        <a href="/Admin/Machines" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminMachines) transition-colors duration-200">
                            <i class="fa-solid fa-industry mr-3"></i>
                            Machine Management
                            @if (ViewBag.MachineCount != null && ViewBag.MachineCount > 0)
                            {
                                <span class="ml-auto bg-blue-100 dark:bg-blue-800 text-blue-800 dark:text-blue-200 text-xs px-2 py-1 rounded-full">@ViewBag.MachineCount</span>
                            }
                        </a>
                        <a href="/Admin/Parts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminParts) transition-colors duration-200">
                            <i class="fa-solid fa-puzzle-piece mr-3"></i>
                            Parts Management
                            @if (ViewBag.PartCount != null && ViewBag.PartCount > 0)
                            {
                                <span class="ml-auto bg-purple-100 dark:bg-purple-800 text-purple-800 dark:text-purple-200 text-xs px-2 py-1 rounded-full">@ViewBag.PartCount</span>
                            }
                        </a>
                        <a href="/Admin/Materials" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminMaterials) transition-colors duration-200">
                            <i class="fa-solid fa-flask mr-3"></i>
                            Materials Management
                            @if (ViewBag.MaterialCount != null && ViewBag.MaterialCount > 0)
                            {
                                <span class="ml-auto bg-green-100 dark:bg-green-800 text-green-800 dark:text-green-200 text-xs px-2 py-1 rounded-full">@ViewBag.MaterialCount</span>
                            }
                        </a>
                        <a href="/Admin/Jobs" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminJobs) transition-colors duration-200">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Job Management
                        </a>
                        <a href="/Admin/Shifts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminShifts) transition-colors duration-200">
                            <i class="fa-solid fa-business-time mr-3"></i>
                            Operating Shifts
                        </a>
                    </div>
                </section>

                <!-- Manufacturing Operations -->
                <section class="nav-section" data-key="mfg-ops">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" aria-expanded="true" aria-controls="section-mfg-ops">
                        <span>Manufacturing Operations</span>
                        <span class="chevron text-indigo-400 dark:text-indigo-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-mfg-ops" class="nav-section-content space-y-1">
                        <a href="/Admin/Stages" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminStages) transition-colors duration-200">
                            <i class="fa-solid fa-diagram-project mr-3"></i>
                            Multi-Stage Jobs
                        </a>
                        <a href="/Admin/ProductionStages" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isAdminProductionStages) transition-colors duration-200">
                            <i class="fa-solid fa-sitemap mr-3"></i>
                            Production Stages
                        </a>
                        <a href="/PrintTracking" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @GetActiveClass(isPrintTracking) transition-colors duration-200">
                            <i class="fa-solid fa-print mr-3"></i>
                            Print Tracking
                        </a>
                    </div>
                </section>

                @* <!-- Quality Management -->
                <section class="nav-section" data-key="quality">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300" aria-expanded="true" aria-controls="section-quality">
                        <span>Quality Management</span>
                        <span class="chevron text-green-400 dark:text-green-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-quality" class="nav-section-content space-y-1">
                        <a href="/Admin/Checkpoints" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Checkpoints" ? "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300" : "text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 hover:bg-green-50 dark:hover:bg-green-900") transition-colors duration-200">
                            <i class="fa-solid fa-clipboard-check mr-3"></i>
                            Inspection Checkpoints
                        </a>
                        <a href="/Admin/Defects" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Defects" ? "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300" : "text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 hover:bg-green-50 dark:hover:bg-green-900") transition-colors duration-200">
                            <i class="fa-solid fa-triangle-exclamation mr-3"></i>
                            Defect Categories
                        </a>
                    </div>
                </section> *@

                @* <!-- B&T Administration -->
                <section class="nav-section" data-key="bt-admin">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300" aria-expanded="true" aria-controls="section-bt-admin">
                        <span>B&T Administration</span>
                        <span class="chevron text-amber-400 dark:text-amber-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-bt-admin" class="nav-section-content space-y-1">
                        <a href="/Admin/Prototypes" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Prototypes") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-lightbulb mr-3"></i>
                            Prototype Tracking
                        </a>
                        <a href="/Admin/BT/PartClassifications" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/PartClassifications") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-tags mr-3"></i>
                            Part Classifications
                        </a>
                        <a href="/Admin/BT/SerialNumbers" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/SerialNumbers") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-hashtag mr-3"></i>
                            Serial Numbers
                        </a>
                        <a href="/Admin/BT/ComplianceDocuments" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ComplianceDocuments") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-file-shield mr-3"></i>
                            Compliance Documents
                        </a>
                    </div>
                </section> *@

                @* <!-- B&T Analytics -->
                <section class="nav-section" data-key="bt-analytics">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300" aria-expanded="true" aria-controls="section-bt-analytics">
                        <span>B&T Analytics</span>
                        <span class="chevron text-amber-400 dark:text-amber-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-bt-analytics" class="nav-section-content space-y-1">
                        <a href="/Admin/BT/SerializationReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/SerializationReports") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-barcode mr-3"></i>
                            Serialization Reports
                        </a>
                        <a href="/Admin/BT/ComplianceReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ComplianceReports") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-file-lines mr-3"></i>
                            Compliance Reports
                        </a>
                        <a href="/Admin/BT/ProductionTracking" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ProductionTracking") == true ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-900") transition-colors duration-200">
                            <i class="fa-solid fa-clock-rotate-left mr-3"></i>
                            Production Tracking
                        </a>
                    </div>
                </section> *@

                @* <!-- Advanced Workflows -->
                <section class="nav-section" data-key="workflows">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300" aria-expanded="true" aria-controls="section-workflows">
                        <span>Advanced Workflows</span>
                        <span class="chevron text-purple-400 dark:text-purple-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-workflows" class="nav-section-content space-y-1">
                        <a href="/Admin/Workflows/Templates" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/Templates") == true ? "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300" : "text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-900") transition-colors duration-200">
                            <i class="fa-solid fa-table-cells-large mr-3"></i>
                            Workflow Templates
                        </a>
                        <a href="/Admin/Workflows/StageManagement" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/StageManagement") == true ? "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300" : "text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-900") transition-colors duration-200">
                            <i class="fa-solid fa-layer-group mr-3"></i>
                            Stage Management
                        </a>
                        <a href="/Admin/Workflows/ResourceAllocation" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/ResourceAllocation") == true ? "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300" : "text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-900") transition-colors duration-200">
                            <i class="fa-solid fa-people-arrows mr-3"></i>
                            Resource Allocation
                        </a>
                    </div>
                </section> *@

                @* <!-- System Tools -->
                <section class="nav-section" data-key="tools">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300" aria-expanded="true" aria-controls="section-tools">
                        <span>System Tools</span>
                        <span class="chevron text-orange-400 dark:text-orange-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-tools" class="nav-section-content space-y-1">
                        <a href="/Admin/Alerts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Alerts" ? "bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300" : "text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 hover:bg-orange-50 dark:hover:bg-orange-900") transition-colors duration-200">
                            <i class="fa-solid fa-bell mr-3"></i>
                            Admin Alerts Panel
                        </a>
                        <a href="/Admin/FeatureToggles" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/FeatureToggles" ? "bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300" : "text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 hover:bg-orange-50 dark:hover:bg-orange-900") transition-colors duration-200">
                            <i class="fa-solid fa-toggle-on mr-3"></i>
                            Feature Toggles
                        </a>
                        <a href="/Admin/AuditLog" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/AuditLog" ? "bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300" : "text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 hover:bg-orange-50 dark:hover:bg-orange-900") transition-colors duration-200">
                            <i class="fa-solid fa-file-invoice mr-3"></i>
                            Admin Audit Log
                        </a>
                    </div>
                </section> *@

                @* <!-- Data Management -->
                <section class="nav-section" data-key="data">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200" aria-expanded="true" aria-controls="section-data">
                        <span>Data Management</span>
                        <span class="chevron text-gray-400 dark:text-gray-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-data" class="nav-section-content space-y-1">
                        <a href="/Admin/BugReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/BugReports" ? "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300" : "text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-bug mr-3"></i>
                            Bug Reports
                        </a>
                        <a href="/Admin/Archive" class="nav-item group flex items-center px-3 py-2 textsm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Archive" ? "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300" : "text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-box-archive mr-3"></i>
                            Job Archive & Cleanup
                        </a>
                        <a href="/Admin/Database" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Database" ? "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300" : "text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-database mr-3"></i>
                            Database Management
                        </a>
                        <a href="/Admin/Logs" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Logs" ? "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300" : "text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-scroll mr-3"></i>
                            System Logs
                        </a>
                    </div>
                </section> *@
            </nav>
            
            <!-- Footer -->
            <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 transition-colors duration-300">
                <button onclick="window.location.href='/'" class="w-full bg-blue-50 dark:bg-blue-900 hover:bg-blue-100 dark:hover:bg-blue-800 text-blue-600 dark:text-blue-300 rounded-lg py-2 px-4 text-sm font-medium transition-colors mb-2">
                    Return to Main App
                </button>
                <p class="text-xs text-gray-500 dark:text-gray-400 text-center">OpCentrix Admin v4.0</p>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="md:ml-80 flex-1 flex flex-col overflow-hidden">
            <!-- Top Header -->
            <header class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700 flex-shrink-0 transition-colors duration-300">
                <div class="flex justify-between items-center px-4 py-3">
                    <!-- Mobile menu button -->
                    <button type="button" class="md:hidden p-2 rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-500 dark:hover:text-gray-400 focus:outline-none" onclick="toggleSidebar()">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    
                    <!-- Page title and breadcrumb -->
                    <div class="flex-1 min-w-0">
                        <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100 truncate">
                            @ViewData["Title"]
                        </h1>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Comprehensive admin control for OpCentrix manufacturing system</p>
                    </div
                    >
                    
                    <!-- User menu -->
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-500 dark:text-gray-400">@(User.Identity?.Name ?? "Administrator")</span>
                        <button onclick="window.location.href='/Account/Logout'" class="bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800 text-white px-3 py-1 rounded text-sm transition-colors duration-200">
                            Logout
                        </button>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 overflow-auto bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/masterPartForm.js" asp-append-version="true"></script>
    <script src="~/js/admin-navigation.js" asp-append-version="true"></script>
    
    <!-- Global OpCentrix Functions - MUST LOAD FIRST (kept after form script to allow wrapper calls) -->
    <script src="~/js/opcentrix-global.js" asp-append-version="true"></script>
    <!-- Global Modal Container for Admin pages -->
    <div id="modal-container" class="hidden fixed inset-0 z-[9999] bg-black/50 items-center justify-center" style="display:none;"></div>

    <!-- Global Loading Indicator -->
    <div id="loading-indicator" class="hidden fixed inset-0 z-[9998] flex items-center justify-center bg-black/20">
        <div class="bg-white shadow rounded-lg px-4 py-2 text-sm text-gray-700 flex items-center">
            <svg class="animate-spin h-4 w-4 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Loading...</span>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>