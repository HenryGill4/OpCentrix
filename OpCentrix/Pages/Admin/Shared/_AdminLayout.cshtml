<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpCentrix Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpCentrix.styles.css" asp-append-version="true" />
    
    @* Font Awesome for icons *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 overflow-hidden">
    <div class="flex h-screen">
        <!-- Enhanced Admin Sidebar Navigation -->
        <div id="sidebar" style="overflow:auto !important;" class="bg-white shadow-lg w-80 fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
            <!-- Logo and Brand -->
            <div class="flex items-center justify-between h-16 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-white bg-opacity-20 rounded-lg flex items-center justify-center mr-3 opcentrix-logo-container">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-lg font-bold">OpCentrix</div>
                        <div class="text-xs opacity-75">Admin Control Center</div>
                    </div>
                </div>
                <!-- Expand/Collapse All -->
                <div class="hidden md:flex items-center gap-1 text-white opacity-90">
                    <button id="expandAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Expand all sections">Expand</button>
                    <button id="collapseAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Collapse all sections">Collapse</button>
                </div>
            </div>

            <!-- User Profile Section -->
            <div class="px-4 py-4 border-b border-gray-200 bg-gray-50">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-semibold">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="ml-3">
                        <div class="text-sm font-medium text-gray-900">@(User.Identity?.Name ?? "Administrator")</div>
                        <div class="text-xs text-gray-500">System Administrator</div>
                    </div>
                </div>
            </div>

            @{
                var path = ViewContext.HttpContext?.Request?.Path.Value ?? string.Empty;
                bool isDashboard = path.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Admin/Index", StringComparison.OrdinalIgnoreCase);
                bool isScheduler = path.Equals("/Scheduler", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Scheduler/Index", StringComparison.OrdinalIgnoreCase);
                bool isMasterSchedule = path.StartsWith("/Scheduler/MasterSchedule", StringComparison.OrdinalIgnoreCase);
                bool isCrmAccounts = path.StartsWith("/CRM/Accounts", StringComparison.OrdinalIgnoreCase);
                bool isCrmTasks = path.StartsWith("/CRM/Tasks", StringComparison.OrdinalIgnoreCase);
                bool isCrmAlerts = path.StartsWith("/CRM/Alerts", StringComparison.OrdinalIgnoreCase);
            }

            <!-- Navigation Menu -->
            <nav class="mt-3 px-2 space-y-2 flex-1 overflow-y-auto" aria-label="Admin Navigation">
                <!-- Overview -->
                <section class="nav-section" data-key="overview">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-600 hover:text-gray-800" aria-expanded="true" aria-controls="section-overview">
                        <span>Overview</span>
                        <span class="chevron text-gray-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-overview" class="nav-section-content space-y-1">
                        <a href="/Admin" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isDashboard ? "nav-item-active" : "text-gray-700 hover:text-gray-900 hover:bg-gray-100")">
                            <i class="fa-solid fa-gauge mr-3"></i>
                            Admin Dashboard
                        </a>
                        <a href="/Scheduler" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isScheduler ? "nav-item-active" : "text-gray-700 hover:text-gray-900 hover:bg-gray-100")">
                            <i class="fa-solid fa-calendar-days mr-3"></i>
                            Job Scheduler
                        </a>
                        <a href="/Scheduler/MasterSchedule" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isMasterSchedule ? "nav-item-active" : "text-gray-700 hover:text-gray-900 hover:bg-gray-100")">
                            <i class="fa-solid fa-chart-line mr-3"></i>
                            Master Schedule
                        </a>
                    </div>
                </section>

                <!-- CRM -->
                <section class="nav-section" data-key="crm">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-emerald-600 hover:text-emerald-700" aria-expanded="true" aria-controls="section-crm">
                        <span>CRM</span>
                        <span class="chevron text-emerald-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-crm" class="nav-section-content space-y-1">
                        <a href="/CRM/Accounts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmAccounts ? "bg-emerald-100 text-emerald-700" : "text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50")">
                            <i class="fa-solid fa-building mr-3"></i>
                            Accounts
                        </a>
                        <a href="/CRM/Tasks" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmTasks ? "bg-emerald-100 text-emerald-700" : "text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50")">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Tasks
                        </a>
                        <a href="/CRM/Alerts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmAlerts ? "bg-emerald-100 text-emerald-700" : "text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50")">
                            <i class="fa-solid fa-bell mr-3"></i>
                            Alerts
                        </a>
                    </div>
                </section>

                <!-- System Administration -->
                <section class="nav-section" data-key="system-admin">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-red-600 hover:text-red-700" aria-expanded="true" aria-controls="section-system-admin">
                        <span>System Administration</span>
                        <span class="chevron text-red-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-system-admin" class="nav-section-content space-y-1">
                        <a href="/Admin/Users" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Users" ? "bg-red-100 text-red-700" : "text-red-600 hover:text-red-700 hover:bg-red-50")">
                            <i class="fa-solid fa-users mr-3"></i>
                            User Management
                        </a>
                        <a href="/Admin/Roles" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Roles" ? "bg-red-100 text-red-700" : "text-red-600 hover:text-red-700 hover:bg-red-50")">
                            <i class="fa-solid fa-shield-halved mr-3"></i>
                            Role Permissions
                        </a>
                        <a href="/Admin/Settings" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Settings" ? "bg-red-100 text-red-700" : "text-red-600 hover:text-red-700 hover:bg-red-50")">
                            <i class="fa-solid fa-gear mr-3"></i>
                            System Settings
                        </a>
                    </div>
                </section>

                <!-- Resource Management -->
                <section class="nav-section" data-key="resources">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-blue-600 hover:text-blue-700" aria-expanded="true" aria-controls="section-resources">
                        <span>Resource Management</span>
                        <span class="chevron text-blue-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-resources" class="nav-section-content space-y-1">
                        <a href="/Admin/Machines" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Machines" ? "bg-blue-100 text-blue-700" : "text-blue-600 hover:text-blue-700 hover:bg-blue-50")">
                            <i class="fa-solid fa-industry mr-3"></i>
                            Machine Management
                            @if (ViewBag.MachineCount != null && ViewBag.MachineCount > 0)
                            {
                                <span class="ml-auto bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">@ViewBag.MachineCount</span>
                            }
                        </a>
                        <a href="/Admin/Parts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Parts" ? "bg-blue-100 text-blue-700" : "text-blue-600 hover:text-blue-700 hover:bg-blue-50")">
                            <i class="fa-solid fa-puzzle-piece mr-3"></i>
                            Parts Management
                            @if (ViewBag.PartCount != null && ViewBag.PartCount > 0)
                            {
                                <span class="ml-auto bg-purple-100 text-purple-800 text-xs px-2 py-1 rounded-full">@ViewBag.PartCount</span>
                            }
                        </a>
                        <a href="/Admin/Materials" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Materials" ? "bg-blue-100 text-blue-700" : "text-blue-600 hover:text-blue-700 hover:bg-blue-50")">
                            <i class="fa-solid fa-flask mr-3"></i>
                            Materials Management
                            @if (ViewBag.MaterialCount != null && ViewBag.MaterialCount > 0)
                            {
                                <span class="ml-auto bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">@ViewBag.MaterialCount</span>
                            }
                        </a>
                        <a href="/Admin/Jobs" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Jobs" ? "bg-blue-100 text-blue-700" : "text-blue-600 hover:text-blue-700 hover:bg-blue-50")">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Job Management
                        </a>
                        <a href="/Admin/Shifts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Shifts" ? "bg-blue-100 text-blue-700" : "text-blue-600 hover:text-blue-700 hover:bg-blue-50")">
                            <i class="fa-solid fa-business-time mr-3"></i>
                            Operating Shifts
                        </a>
                    </div>
                </section>

                <!-- Manufacturing Operations -->
                <section class="nav-section" data-key="mfg-ops">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 hover:text-indigo-700" aria-expanded="true" aria-controls="section-mfg-ops">
                        <span>Manufacturing Operations</span>
                        <span class="chevron text-indigo-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-mfg-ops" class="nav-section-content space-y-1">
                        <a href="/Admin/Stages" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Stages" ? "bg-indigo-100 text-indigo-700" : "text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50")">
                            <i class="fa-solid fa-diagram-project mr-3"></i>
                            Multi-Stage Jobs
                        </a>
                        <a href="/Admin/ProductionStages" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("ProductionStages") == true ? "bg-indigo-100 text-indigo-700" : "text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50")">
                            <i class="fa-solid fa-sitemap mr-3"></i>
                            Production Stages
                        </a>
                        <a href="/PrintTracking" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50">
                            <i class="fa-solid fa-print mr-3"></i>
                            Print Tracking
                        </a>
                    </div>
                </section>

                <!-- Quality Management -->
                <section class="nav-section" data-key="quality">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-green-600 hover:text-green-700" aria-expanded="true" aria-controls="section-quality">
                        <span>Quality Management</span>
                        <span class="chevron text-green-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-quality" class="nav-section-content space-y-1">
                        <a href="/Admin/Checkpoints" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Checkpoints" ? "bg-green-100 text-green-700" : "text-green-600 hover:text-green-700 hover:bg-green-50")">
                            <i class="fa-solid fa-clipboard-check mr-3"></i>
                            Inspection Checkpoints
                        </a>
                        <a href="/Admin/Defects" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Defects" ? "bg-green-100 text-green-700" : "text-green-600 hover:text-green-700 hover:bg-green-50")">
                            <i class="fa-solid fa-triangle-exclamation mr-3"></i>
                            Defect Categories
                        </a>
                    </div>
                </section>

                <!-- B&T Administration -->
                <section class="nav-section" data-key="bt-admin">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-amber-600 hover:text-amber-700" aria-expanded="true" aria-controls="section-bt-admin">
                        <span>B&T Administration</span>
                        <span class="chevron text-amber-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-bt-admin" class="nav-section-content space-y-1">
                        <a href="/Admin/Prototypes" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Prototypes") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-lightbulb mr-3"></i>
                            Prototype Tracking
                        </a>
                        <a href="/Admin/BT/PartClassifications" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/PartClassifications") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-tags mr-3"></i>
                            Part Classifications
                        </a>
                        <a href="/Admin/BT/SerialNumbers" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/SerialNumbers") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-hashtag mr-3"></i>
                            Serial Numbers
                        </a>
                        <a href="/Admin/BT/ComplianceDocuments" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ComplianceDocuments") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-file-shield mr-3"></i>
                            Compliance Documents
                        </a>
                    </div>
                </section>

                <!-- B&T Analytics -->
                <section class="nav-section" data-key="bt-analytics">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-amber-600 hover:text-amber-700" aria-expanded="true" aria-controls="section-bt-analytics">
                        <span>B&T Analytics</span>
                        <span class="chevron text-amber-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-bt-analytics" class="nav-section-content space-y-1">
                        <a href="/Admin/BT/SerializationReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/SerializationReports") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-barcode mr-3"></i>
                            Serialization Reports
                        </a>
                        <a href="/Admin/BT/ComplianceReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ComplianceReports") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-file-lines mr-3"></i>
                            Compliance Reports
                        </a>
                        <a href="/Admin/BT/ProductionTracking" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("BT/ProductionTracking") == true ? "bg-amber-100 text-amber-700" : "text-amber-600 hover:text-amber-700 hover:bg-amber-50")">
                            <i class="fa-solid fa-clock-rotate-left mr-3"></i>
                            Production Tracking
                        </a>
                    </div>
                </section>

                <!-- Advanced Workflows -->
                <section class="nav-section" data-key="workflows">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-purple-600 hover:text-purple-700" aria-expanded="true" aria-controls="section-workflows">
                        <span>Advanced Workflows</span>
                        <span class="chevron text-purple-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-workflows" class="nav-section-content space-y-1">
                        <a href="/Admin/Workflows/Templates" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/Templates") == true ? "bg-purple-100 text-purple-700" : "text-purple-600 hover:text-purple-700 hover:bg-purple-50")">
                            <i class="fa-solid fa-table-cells-large mr-3"></i>
                            Workflow Templates
                        </a>
                        <a href="/Admin/Workflows/StageManagement" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/StageManagement") == true ? "bg-purple-100 text-purple-700" : "text-purple-600 hover:text-purple-700 hover:bg-purple-50")">
                            <i class="fa-solid fa-layer-group mr-3"></i>
                            Stage Management
                        </a>
                        <a href="/Admin/Workflows/ResourceAllocation" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString().Contains("Workflows/ResourceAllocation") == true ? "bg-purple-100 text-purple-700" : "text-purple-600 hover:text-purple-700 hover:bg-purple-50")">
                            <i class="fa-solid fa-people-arrows mr-3"></i>
                            Resource Allocation
                        </a>
                    </div>
                </section>

                <!-- System Tools -->
                <section class="nav-section" data-key="tools">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-orange-600 hover:text-orange-700" aria-expanded="true" aria-controls="section-tools">
                        <span>System Tools</span>
                        <span class="chevron text-orange-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-tools" class="nav-section-content space-y-1">
                        <a href="/Admin/Alerts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Alerts" ? "bg-orange-100 text-orange-700" : "text-orange-600 hover:text-orange-700 hover:bg-orange-50")">
                            <i class="fa-solid fa-bell mr-3"></i>
                            Admin Alerts Panel
                        </a>
                        <a href="/Admin/FeatureToggles" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/FeatureToggles" ? "bg-orange-100 text-orange-700" : "text-orange-600 hover:text-orange-700 hover:bg-orange-50")">
                            <i class="fa-solid fa-toggle-on mr-3"></i>
                            Feature Toggles
                        </a>
                        <a href="/Admin/AuditLog" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/AuditLog" ? "bg-orange-100 text-orange-700" : "text-orange-600 hover:text-orange-700 hover:bg-orange-50")">
                            <i class="fa-solid fa-file-invoice mr-3"></i>
                            Admin Audit Log
                        </a>
                    </div>
                </section>

                <!-- Data Management -->
                <section class="nav-section" data-key="data">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-600 hover:text-gray-800" aria-expanded="true" aria-controls="section-data">
                        <span>Data Management</span>
                        <span class="chevron text-gray-400"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-data" class="nav-section-content space-y-1">
                        <a href="/Admin/BugReports" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/BugReports" ? "bg-gray-100 text-gray-700" : "text-gray-600 hover:text-gray-700 hover:bg-gray-50")">
                            <i class="fa-solid fa-bug mr-3"></i>
                            Bug Reports
                        </a>
                        <a href="/Admin/Archive" class="nav-item group flex items-center px-3 py-2 textsm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Archive" ? "bg-gray-100 text-gray-700" : "text-gray-600 hover:text-gray-700 hover:bg-gray-50")">
                            <i class="fa-solid fa-box-archive mr-3"></i>
                            Job Archive & Cleanup
                        </a>
                        <a href="/Admin/Database" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Database" ? "bg-gray-100 text-gray-700" : "text-gray-600 hover:text-gray-700 hover:bg-gray-50")">
                            <i class="fa-solid fa-database mr-3"></i>
                            Database Management
                        </a>
                        <a href="/Admin/Logs" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Logs" ? "bg-gray-100 text-gray-700" : "text-gray-600 hover:text-gray-700 hover:bg-gray-50")">
                            <i class="fa-solid fa-scroll mr-3"></i>
                            System Logs
                        </a>
                    </div>
                </section>
            </nav>
            
            <!-- Footer -->
            <div class="p-4 border-t border-gray-200">
                <button onclick="window.location.href='/'" class="w-full bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg py-2 px-4 text-sm font-medium transition-colors mb-2">
                    Return to Main App
                </button>
                <p class="text-xs text-gray-500 text-center">OpCentrix Admin v4.0</p>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="md:ml-80 flex-1 flex flex-col overflow-hidden">
            <!-- Top Header -->
            <header class="bg-white shadow-sm border-b border-gray-200 flex-shrink-0">
                <div class="flex justify-between items-center px-4 py-3">
                    <!-- Mobile menu button -->
                    <button type="button" class="md:hidden p-2 rounded-md text-gray-400 hover:text-gray-500 focus:outline-none" onclick="toggleSidebar()">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    
                    <!-- Page title and breadcrumb -->
                    <div class="flex-1 min-w-0">
                        <h1 class="text-xl font-semibold text-gray-900 truncate">
                            @ViewData["Title"]
                        </h1>
                        <p class="text-sm text-gray-500 mt-1">Comprehensive admin control for OpCentrix manufacturing system</p>
                    </div
                    >
                    
                    <!-- User menu -->
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-500">@(User.Identity?.Name ?? "Administrator")</span>
                        <button onclick="window.location.href='/Account/Logout'" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm">
                            Logout
                        </button>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 overflow-auto bg-gray-50">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/masterPartForm.js" asp-append-version="true"></script>
    
    <!-- Global OpCentrix Functions - MUST LOAD FIRST (kept after form script to allow wrapper calls) -->
    <script src="~/js/opcentrix-global.js" asp-append-version="true"></script>
    <!-- Global Modal Container for Admin pages -->
    <div id="modal-container" class="hidden fixed inset-0 z-[9999] bg-black/50 items-center justify-center" style="display:none;"></div>

    <!-- Global Loading Indicator -->
    <div id="loading-indicator" class="hidden fixed inset-0 z-[9998] flex items-center justify-center bg-black/20">
        <div class="bg-white shadow rounded-lg px-4 py-2 text-sm text-gray-700 flex items-center">
            <svg class="animate-spin h-4 w-4 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Loading...</span>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        }
        
        // Collapsible sections with persisted state
        document.addEventListener('DOMContentLoaded', function () {
            const sections = document.querySelectorAll('.nav-section');
            const storageKey = (key) => `oc:nav:${key}`;

            function setCollapsed(section, collapsed) {
                const btn = section.querySelector('.nav-section-toggle');
                const content = section.querySelector('.nav-section-content');
                if (!btn || !content) return;
                if (collapsed) {
                    section.classList.add('collapsed');
                    btn.setAttribute('aria-expanded', 'false');
                    content.style.display = 'none';
                } else {
                    section.classList.remove('collapsed');
                    btn.setAttribute('aria-expanded', 'true');
                    content.style.display = '';
                }
            }

            sections.forEach(sec => {
                const key = sec.getAttribute('data-key');
                const btn = sec.querySelector('.nav-section-toggle');
                const saved = localStorage.getItem(storageKey(key));
                const collapsed = saved === '0' ? false : (saved === '1' ? true : false);
                setCollapsed(sec, collapsed);

                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const isCollapsed = sec.classList.contains('collapsed');
                    setCollapsed(sec, !isCollapsed);
                    localStorage.setItem(storageKey(key), (!isCollapsed) ? '1' : '0');
                });

                // Keyboard accessibility
                btn.setAttribute('role', 'button');
                btn.setAttribute('tabindex', '0');
                btn.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); btn.click(); }
                });
            });

            // Expand/Collapse all
            const expandAllBtn = document.getElementById('expandAllBtn');
            const collapseAllBtn = document.getElementById('collapseAllBtn');
            if (expandAllBtn && collapseAllBtn) {
                expandAllBtn.addEventListener('click', () => {
                    sections.forEach(sec => { const key = sec.getAttribute('data-key'); setCollapsed(sec, false); localStorage.setItem(storageKey(key), '0'); });
                });
                collapseAllBtn.addEventListener('click', () => {
                    sections.forEach(sec => { const key = sec.getAttribute('data-key'); setCollapsed(sec, true); localStorage.setItem(storageKey(key), '1'); });
                });
            }

            // Active highlighting based on current path
            const currentPath = window.location.pathname;
            document.querySelectorAll('.nav-item').forEach(item => {
                const href = item.getAttribute('href');
                if (href && (currentPath === href || currentPath.startsWith(href + '/'))) {
                    item.classList.add('nav-item-active');
                    // Auto-expand parent section if collapsed
                    const parent = item.closest('.nav-section');
                    if (parent && parent.classList.contains('collapsed')) {
                        const key = parent.getAttribute('data-key');
                        setCollapsed(parent, false);
                        localStorage.setItem(storageKey(key), '0');
                    }
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>