<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpCentrix Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpCentrix.styles.css" asp-append-version="true" />
    
    @* Font Awesome for icons *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Enhanced Dark Mode System for Admin Layout -->
    <script>
        (function() {
            const getTheme = () => {
                const stored = localStorage.getItem('theme');
                if (stored && (stored === 'dark' || stored === 'light')) {
                    return stored;
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            };
            
            const setTheme = (theme) => {
                if (theme !== 'dark' && theme !== 'light') theme = 'light';
                localStorage.setItem('theme', theme);
                
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'light');
                }
                
                window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme } }));
            };
            
            setTheme(getTheme());
            
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                const userPreference = localStorage.getItem('theme');
                if (!userPreference) {
                    setTheme(e.matches ? 'dark' : 'light');
                }
            });
            
            window.toggleTheme = () => {
                const current = getTheme();
                const newTheme = current === 'dark' ? 'light' : 'dark';
                setTheme(newTheme);
            };
            
            window.getCurrentTheme = getTheme;
        })();
    </script>
    
    <!-- Enhanced Dark Mode CSS Framework -->
    <style>
        /* Enhanced Dark Mode System - Class-based approach */
        
        /* Navigation Dark Mode */
        .dark .nav-item {
            color: #d1d5db;
        }
        
        .dark .nav-item:hover {
            background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
            color: #e5e7eb;
        }
        
        .dark .nav-item-active {
            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%) !important;
            color: #bfdbfe !important;
        }
        
        /* Sidebar Dark Mode */
        .dark #sidebar {
            background-color: #1f2937 !important;
            border-right-color: #374151 !important;
        }
        
        /* User Profile Dark Mode */
        .dark .user-info-card {
            background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
            border-bottom-color: #4b5563;
        }
        
        /* Header Dark Mode */
        .dark header {
            background-color: #1f2937 !important;
            border-bottom-color: #374151 !important;
        }
        
        /* Main Content Dark Mode */
        .dark main {
            background-color: #111827 !important;
        }
        
        /* Scrollbar Dark Mode */
        .dark ::-webkit-scrollbar-track {
            background: #374151 !important;
        }
        
        .dark ::-webkit-scrollbar-thumb {
            background: #6b7280 !important;
        }
        
        .dark ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af !important;
        }
        
        /* Theme Toggle Button Animation */
        .theme-toggle-btn {
            position: relative;
            overflow: hidden;
        }
        
        .theme-toggle-btn:hover {
            transform: scale(1.05);
        }
        
        /* Active Navigation Item Enhanced Styles */
        .nav-item-active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: #ffffff;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }
        
        .dark .nav-item-active {
            background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%) !important;
            color: #e0e7ff !important;
        }
        
        /* Section Header Dark Mode */
        .dark .nav-section-toggle {
            color: inherit;
        }
        
        /* Logo Container Dark Mode */
        .dark .opcentrix-logo-container {
            background-color: rgba(255, 255, 255, 0.15);
        }
        
        /* Modal and Loading Indicator Dark Mode */
        .dark #modal-container {
            background-color: rgba(0, 0, 0, 0.75);
        }
        
        .dark #loading-indicator {
            background-color: rgba(0, 0, 0, 0.5);
        }
        
        .dark #loading-indicator > div {
            background-color: #1f2937;
            color: #e5e7eb;
            border-color: #374151;
        }
        
        /* Badge Dark Mode */
        .dark .bg-blue-100 {
            background-color: #1e3a8a !important;
        }
        
        .dark .text-blue-800 {
            color: #bfdbfe !important;
        }
        
        .dark .bg-purple-100 {
            background-color: #581c87 !important;
        }
        
        .dark .text-purple-800 {
            color: #e9d5ff !important;
        }
        
        .dark .bg-green-100 {
            background-color: #14532d !important;
        }
        
        .dark .text-green-800 {
            color: #bbf7d0 !important;
        }
        
        /* Form Elements Dark Mode */
        .dark input,
        .dark select,
        .dark textarea {
            background-color: #374151;
            border-color: #6b7280;
            color: #e5e7eb;
        }
        
        .dark input:focus,
        .dark select:focus,
        .dark textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        /* Cards and Containers Dark Mode */
        .dark .bg-white {
            background-color: #1f2937 !important;
        }
        
        .dark .border-gray-200 {
            border-color: #374151 !important;
        }
        
        .dark .text-gray-900 {
            color: #f9fafb !important;
        }
        
        .dark .text-gray-700 {
            color: #d1d5db !important;
        }
        
        .dark .text-gray-600 {
            color: #9ca3af !important;
        }
        
        .dark .text-gray-500 {
            color: #6b7280 !important;
        }
        
        /* Button Dark Mode Enhancement */
        .dark button:not(.theme-toggle-btn):not([class*="bg-"]) {
            background-color: #374151;
            color: #e5e7eb;
            border-color: #6b7280;
        }
        
        .dark button:not(.theme-toggle-btn):not([class*="bg-"]):hover {
            background-color: #4b5563;
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 dark:bg-gray-900 overflow-hidden transition-colors duration-300" data-theme-responsive="true">
    <div class="flex h-screen">
        <!-- Enhanced Admin Sidebar Navigation -->
        <div id="sidebar" style="overflow:auto !important;" class="bg-white dark:bg-gray-800 shadow-lg w-80 fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-in-out">
            <!-- Logo and Brand -->
            <div class="flex items-center justify-between h-16 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-white bg-opacity-20 rounded-lg flex items-center justify-center mr-3 opcentrix-logo-container">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-lg font-bold">OpCentrix</div>
                        <div class="text-xs opacity-75">Admin Control Center</div>
                    </div>
                </div>
                <!-- Expand/Collapse All -->
                <div class="hidden md:flex items-center gap-1 text-white opacity-90">
                    <button id="expandAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Expand all sections">Expand</button>
                    <button id="collapseAllBtn" class="px-2 py-1 text-xs bg-white/10 hover:bg-white/20 rounded" title="Collapse all sections">Collapse</button>
                </div>
            </div>

            <!-- User Profile Section -->
            <div class="px-4 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 transition-colors duration-300">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-semibold">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="ml-3">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100">@(User.Identity?.Name ?? "Administrator")</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">System Administrator</div>
                    </div>
                </div>
                
                <!-- Theme Toggle -->
                <div class="mt-3 flex items-center justify-between px-4 py-2 border-t border-gray-200 dark:border-gray-700">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Theme</span>
                    <button onclick="toggleTheme()" class="theme-toggle-btn p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200" title="Toggle dark mode">
                        <svg class="w-4 h-4 text-gray-600 dark:text-gray-300 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <svg class="w-4 h-4 text-gray-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        </svg>
                    </button>
                </div>
            </div>

            @{
                var path = ViewContext.HttpContext?.Request?.Path.Value ?? string.Empty;
                bool isDashboard = path.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Admin/Index", StringComparison.OrdinalIgnoreCase);
                bool isScheduler = path.Equals("/Scheduler", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Scheduler/Index", StringComparison.OrdinalIgnoreCase);
                bool isMasterSchedule = path.StartsWith("/Scheduler/MasterSchedule", StringComparison.OrdinalIgnoreCase);
                bool isCrmAccounts = path.StartsWith("/CRM/Accounts", StringComparison.OrdinalIgnoreCase);
                bool isCrmTasks = path.StartsWith("/CRM/Tasks", StringComparison.OrdinalIgnoreCase);
                bool isCrmTaskAdmin = path.StartsWith("/CRM/Tasks/Admin", StringComparison.OrdinalIgnoreCase);
                bool isCrmTaskProgress = path.Contains("/AddProgress", StringComparison.OrdinalIgnoreCase);
                bool isCrmAlerts = path.StartsWith("/CRM/Alerts", StringComparison.OrdinalIgnoreCase);
            }

            <!-- Navigation Menu -->
            <nav class="mt-3 px-2 space-y-2 flex-1 overflow-y-auto" aria-label="Admin Navigation">
                <!-- Overview -->
                <section class="nav-section" data-key="overview">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200" aria-expanded="true" aria-controls="section-overview">
                        <span>Overview</span>
                        <span class="chevron text-gray-400 dark:text-gray-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-overview" class="nav-section-content space-y-1">
                        <a href="/Admin" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isDashboard ? "nav-item-active" : "text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-gauge mr-3"></i>
                            Admin Dashboard
                        </a>
                        <a href="/Scheduler" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isScheduler ? "nav-item-active" : "text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-calendar-days mr-3"></i>
                            Job Scheduler
                        </a>
                        <a href="/Scheduler/MasterSchedule" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isMasterSchedule ? "nav-item-active" : "text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700") transition-colors duration-200">
                            <i class="fa-solid fa-chart-line mr-3"></i>
                            Master Schedule
                        </a>
                    </div>
                </section>

                <!-- CRM -->
                <section class="nav-section" data-key="crm">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300" aria-expanded="true" aria-controls="section-crm">
                        <span>CRM</span>
                        <span class="chevron text-emerald-400 dark:text-emerald-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-crm" class="nav-section-content space-y-1">
                        <a href="/CRM/Accounts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmAccounts ? "bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300" : "text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-900") transition-colors duration-200">
                            <i class="fa-solid fa-building mr-3"></i>
                            Accounts
                        </a>
                        <a href="/CRM/Tasks" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmTasks && !isCrmTaskAdmin ? "bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300" : "text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-900") transition-colors duration-200">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Tasks
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a href="/CRM/Tasks/Admin" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmTaskAdmin ? "bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300" : "text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-900") transition-colors duration-200">
                                <i class="fa-solid fa-users-gear mr-3"></i>
                                Task Management
                            </a>
                        }
                        <a href="/CRM/Alerts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(isCrmAlerts ? "bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300" : "text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-900") transition-colors duration-200">
                            <i class="fa-solid fa-bell mr-3"></i>
                            Alerts & Notifications
                        </a>
                    </div>
                </section>

                <!-- System Administration -->
                <section class="nav-section" data-key="system-admin">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300" aria-expanded="true" aria-controls="section-system-admin">
                        <span>System Administration</span>
                        <span class="chevron text-red-400 dark:text-red-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-system-admin" class="nav-section-content space-y-1">
                        <a href="/Admin/Users" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Users" ? "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300" : "text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900") transition-colors duration-200">
                            <i class="fa-solid fa-users mr-3"></i>
                            User Management
                        </a>
                        <a href="/Admin/Roles" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Roles" ? "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300" : "text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900") transition-colors duration-200">
                            <i class="fa-solid fa-shield-halved mr-3"></i>
                            Role Permissions
                        </a>
                        <a href="/Admin/Settings" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Settings" ? "bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300" : "text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900") transition-colors duration-200">
                            <i class="fa-solid fa-gear mr-3"></i>
                            System Settings
                        </a>
                    </div>
                </section>

                <!-- Resource Management -->
                <section class="nav-section" data-key="resources">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300" aria-expanded="true" aria-controls="section-resources">
                        <span>Resource Management</span>
                        <span class="chevron text-blue-400 dark:text-blue-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
                    <div id="section-resources" class="nav-section-content space-y-1">
                        <a href="/Admin/Machines" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Machines" ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900") transition-colors duration-200">
                            <i class="fa-solid fa-industry mr-3"></i>
                            Machine Management
                            @if (ViewBag.MachineCount != null && ViewBag.MachineCount > 0)
                            {
                                <span class="ml-auto bg-blue-100 dark:bg-blue-800 text-blue-800 dark:text-blue-200 text-xs px-2 py-1 rounded-full">@ViewBag.MachineCount</span>
                            }
                        </a>
                        <a href="/Admin/Parts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Parts" ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900") transition-colors duration-200">
                            <i class="fa-solid fa-puzzle-piece mr-3"></i>
                            Parts Management
                            @if (ViewBag.PartCount != null && ViewBag.PartCount > 0)
                            {
                                <span class="ml-auto bg-purple-100 dark:bg-purple-800 text-purple-800 dark:text-purple-200 text-xs px-2 py-1 rounded-full">@ViewBag.PartCount</span>
                            }
                        </a>
                        <a href="/Admin/Materials" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Materials" ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900") transition-colors duration-200">
                            <i class="fa-solid fa-flask mr-3"></i>
                            Materials Management
                            @if (ViewBag.MaterialCount != null && ViewBag.MaterialCount > 0)
                            {
                                <span class="ml-auto bg-green-100 dark:bg-green-800 text-green-800 dark:text-green-200 text-xs px-2 py-1 rounded-full">@ViewBag.MaterialCount</span>
                            }
                        </a>
                        <a href="/Admin/Jobs" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Jobs" ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900") transition-colors duration-200">
                            <i class="fa-solid fa-list-check mr-3"></i>
                            Job Management
                        </a>
                        <a href="/Admin/Shifts" class="nav-item group flex items-center px-3 py-2 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Admin/Shifts" ? "bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300" : "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900") transition-colors duration-200">
                            <i class="fa-solid fa-business-time mr-3"></i>
                            Operating Shifts
                        </a>
                    </div>
                </section>

                <!-- Manufacturing Operations -->
                <section class="nav-section" data-key="mfg-ops">
                    <button class="nav-section-toggle w-full flex items-center justify-between px-3 py-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" aria-expanded="true" aria-controls="section-mfg-ops">
                        <span>Manufacturing Operations</span>
                        <span class="chevron text-indigo-400 dark:text-indigo-500"><i class="fa-solid fa-chevron-down"></i></span>
                    </button>
