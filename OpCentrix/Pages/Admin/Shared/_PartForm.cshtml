@model OpCentrix.Pages.Admin.PartsModel

<!-- PHASE 3: Modernized Parts Form with Lookup-Driven Architecture and Stage Management -->
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="fas fa-cogs me-2"></i>
        @(Model.Part.Id == 0 ? "Add New Part" : $"Edit Part: {Model.Part.PartNumber}")
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    @if (ViewData.ModelState.Any(ms => ms.Value?.Errors.Count > 0))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Please fix the following errors:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.SelectMany(ms => ms.Value?.Errors ?? new Microsoft.AspNetCore.Mvc.ModelBinding.ModelErrorCollection()))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PHASE 3: Modern Form with HTMX Integration -->
    <form method="post" id="partForm" 
          action="/Admin/Parts?handler=@(Model.Part.Id == 0 ? "Create" : "Update")"
          data-part-id="@Model.Part.Id"
          hx-post="/Admin/Parts?handler=@(Model.Part.Id == 0 ? "Create" : "Update")"
          hx-target="#partModalContent"
          hx-swap="outerHTML"
          hx-trigger="submit"
          hx-include="#partForm [name], #partForm input[type='hidden']"
          hx-indicator="#savePartBtn .spinner-border"
          hx-on::before-request="console.log('🔄 [PARTS] Form submission starting...'); document.getElementById('savePartBtn').disabled = true"
          hx-on::after-request="console.log('✅ [PARTS] Form submission completed'); document.getElementById('savePartBtn').disabled = false"
          hx-on::response-error="console.error('❌ [PARTS] Form submission failed'); document.getElementById('savePartBtn').disabled = false; window.showToast('error', 'Form submission failed. Please try again.')">
        
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Part.Id" />
        @if (Model.Part.Id > 0)
        {
            <input type="hidden" asp-for="Part.CreatedDate" />
            <input type="hidden" asp-for="Part.CreatedBy" />
        }

        <!-- Hidden Stage Management Data -->
        <input type="hidden" id="selectedStageIds" name="SelectedStageIds" value="" />
        <input type="hidden" id="stageExecutionOrders" name="StageExecutionOrders" value="" />
        <input type="hidden" id="stageEstimatedHours" name="StageEstimatedHours" value="" />
        <input type="hidden" id="stageHourlyRates" name="StageHourlyRates" value="" />
        <input type="hidden" id="stageMaterialCosts" name="StageMaterialCosts" value="" />
        
        <!-- Tab Navigation -->
        <ul class="nav nav-tabs nav-justified mb-3" id="partFormTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="basic-tab" type="button" 
                        data-bs-toggle="tab" data-bs-target="#basic" role="tab">
                    <i class="fas fa-info-circle me-1"></i>
                    <span class="d-none d-md-inline">Basic Information</span>
                    <span class="d-md-none">Basic</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="stages-tab" type="button" 
                        data-bs-toggle="tab" data-bs-target="#stages" role="tab">
                    <i class="fas fa-tasks me-1"></i>
                    <span class="d-none d-md-inline">Manufacturing Stages</span>
                    <span class="d-md-none">Stages</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="material-tab" type="button" 
                        data-bs-toggle="tab" data-bs-target="#material" role="tab">
                    <i class="fas fa-flask me-1"></i>
                    <span class="d-none d-md-inline">Material & Process</span>
                    <span class="d-md-none">Material</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="physical-tab" type="button" 
                        data-bs-toggle="tab" data-bs-target="#physical" role="tab">
                    <i class="fas fa-cube me-1"></i>
                    <span class="d-none d-md-inline">Physical Properties</span>
                    <span class="d-md-none">Physical</span>
                </button>
            </li>
            @if (Model.Part.Id > 0)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="assets-tab" type="button" 
                            data-bs-toggle="tab" data-bs-target="#assets" role="tab">
                        <i class="fas fa-paperclip me-1"></i>
                        <span class="d-none d-md-inline">Assets</span>
                        <span class="d-md-none">Files</span>
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content" id="partFormTabsContent">
            
            <!-- TAB 1: Basic Information - MODERNIZED -->
            <div class="tab-pane fade show active" id="basic" role="tabpanel">
                <div class="row g-3">
                    <div class="col-12">
                        <h6 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-info-circle me-2"></i>Essential Part Information
                        </h6>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.PartNumber" class="form-label required">Part Number</label>
                        <input asp-for="Part.PartNumber" class="form-control" required 
                               placeholder="e.g., BT-SUP-001" />
                        <span asp-validation-for="Part.PartNumber" class="text-danger"></span>
                        <div class="form-text">Unique identifier for this part</div>
                    </div>
                    
                    <div class="col-md-8">
                        <label asp-for="Part.Name" class="form-label required">Part Name</label>
                        <input asp-for="Part.Name" class="form-control" required 
                               placeholder="e.g., B&T Suppressor Baffle Stack" />
                        <span asp-validation-for="Part.Name" class="text-danger"></span>
                    </div>
                    
                    <div class="col-12">
                        <label asp-for="Part.Description" class="form-label required">Description</label>
                        <textarea asp-for="Part.Description" class="form-control" rows="3" required 
                                  placeholder="Detailed description of the part including specifications, applications, and special requirements..."></textarea>
                        <span asp-validation-for="Part.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.CustomerPartNumber" class="form-label">Customer Part Number</label>
                        <input asp-for="Part.CustomerPartNumber" class="form-control" 
                               placeholder="Customer's internal part number" />
                        <span asp-validation-for="Part.CustomerPartNumber" class="text-danger"></span>
                    </div>

                    <!-- PHASE 3: New Lookup Fields - MODERNIZED -->
                    <div class="col-md-4">
                        <label asp-for="Part.ComponentTypeId" class="form-label required">Component Type</label>
                        <select asp-for="Part.ComponentTypeId" class="form-select" required>
                            <option value="">Select Component Type</option>
                            @if (Model.PartFormData?.ComponentTypes != null)
                            {
                                @foreach (var componentType in Model.PartFormData.ComponentTypes)
                                {
                                    <option value="@componentType.Id">@componentType.Name - @componentType.Description</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Part.ComponentTypeId" class="text-danger"></span>
                        <div class="form-text">Determines serialization and tracking requirements</div>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.ComplianceCategoryId" class="form-label required">Compliance Category</label>
                        <select asp-for="Part.ComplianceCategoryId" class="form-select" required>
                            <option value="">Select Compliance Category</option>
                            @if (Model.PartFormData?.ComplianceCategories != null)
                            {
                                @foreach (var category in Model.PartFormData.ComplianceCategories)
                                {
                                    <option value="@category.Id" data-regulatory-level="@category.RegulatoryLevel">
                                        @category.Name (@category.RegulatoryLevel)
                                        @if (category.RequiresSpecialHandling) 
                                        { 
                                            <span>- Special Handling Required</span> 
                                        }
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Part.ComplianceCategoryId" class="text-danger"></span>
                        <div class="form-text">Regulatory compliance level and requirements</div>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.PartCategory" class="form-label">Category</label>
                        <select asp-for="Part.PartCategory" class="form-select">
                            <option value="Production">Production</option>
                            <option value="Prototype">Prototype</option>
                            <option value="Tooling">Tooling</option>
                            <option value="Repair">Repair</option>
                        </select>
                        <span asp-validation-for="Part.PartCategory" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.Material" class="form-label required">Primary Material</label>
                        <select asp-for="Part.Material" class="form-select" id="materialSelect" 
                                onchange="window.updateSlsMaterial && window.updateSlsMaterial()" required>
                            <option value="">Select Material</option>
                            <optgroup label="Titanium Alloys">
                                <option value="Ti-6Al-4V Grade 5">Ti-6Al-4V Grade 5 (Standard)</option>
                                <option value="Ti-6Al-4V ELI Grade 23">Ti-6Al-4V ELI Grade 23 (Medical)</option>
                                <option value="CP Titanium Grade 2">CP Titanium Grade 2</option>
                            </optgroup>
                            <optgroup label="Nickel Superalloys">
                                <option value="Inconel 718">Inconel 718 (High Temperature)</option>
                                <option value="Inconel 625">Inconel 625 (Corrosion Resistant)</option>
                            </optgroup>
                            <optgroup label="Stainless Steels">
                                <option value="316L Stainless Steel">316L Stainless Steel</option>
                                <option value="17-4 PH Stainless Steel">17-4 PH Stainless Steel</option>
                            </optgroup>
                            <optgroup label="Aluminum Alloys">
                                <option value="AlSi10Mg">AlSi10Mg (Lightweight)</option>
                            </optgroup>
                        </select>
                        <span asp-validation-for="Part.Material" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.EstimatedHours" class="form-label required">Estimated Hours</label>
                        <input asp-for="Part.EstimatedHours" type="number" step="0.1" min="0.1" class="form-control" required />
                        <span asp-validation-for="Part.EstimatedHours" class="text-danger"></span>
                        <div class="form-text">Legacy field - use stage management for detailed planning</div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="form-check mt-4">
                            <input asp-for="Part.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="Part.IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check mt-4">
                            <input asp-for="Part.IsAssemblyComponent" class="form-check-input" type="checkbox" />
                            <label asp-for="Part.IsAssemblyComponent" class="form-check-label">Assembly Component</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-check mt-4">
                            <input asp-for="Part.IsLegacyForm" class="form-check-input" type="checkbox" disabled />
                            <label asp-for="Part.IsLegacyForm" class="form-check-label text-muted">Legacy Form (Read-only)</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: Manufacturing Stages - MODERNIZED -->
            <div class="tab-pane fade" id="stages" role="tabpanel" aria-labelledby="stages-tab">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold text-dark">
                                        <i class="fas fa-route me-2 text-primary"></i>
                                        Manufacturing Workflow
                                    </h6>
                                    <button type="button" class="btn btn-success btn-sm" id="add-stage-btn">
                                        <i class="fas fa-plus me-1"></i>Add Stage
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Dynamic Stage Requirements Container -->
                                <div id="stage-requirements-container">
                                    <!-- Content loaded dynamically by parts-stage-manager.js -->
                                    <div class="text-center py-4" id="stageLoadingIndicator">
                                        <div class="spinner-border text-primary mb-3" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p class="text-muted">Loading manufacturing stages...</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <!-- Stage Summary Card -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0 fw-bold text-dark">
                                    <i class="fas fa-chart-pie me-2 text-info"></i>
                                    Workflow Summary
                                </h6>
                            </div>
                            <div class="card-body">
                                <div id="stage-summary">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Total Stages:</span>
                                        <span class="fw-bold" id="summary-total-stages">0</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Total Duration:</span>
                                        <span class="fw-bold" id="summary-total-duration">0h</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Total Cost:</span>
                                        <span class="fw-bold" id="summary-total-cost">$0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Complexity:</span>
                                        <span class="fw-bold" id="summary-complexity">Simple</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Available Stages Card -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h6 class="mb-0 fw-bold text-dark">
                                    <i class="fas fa-tools me-2 text-warning"></i>
                                    Available Stages
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2" id="availableStagesContainer">
                                    @if (Model.PartFormData?.AvailableStages != null)
                                    {
                                        @foreach (var stage in Model.PartFormData.AvailableStages.Take(5))
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addStageFromList(@stage.Id)">
                                                <i class="fas fa-plus me-1"></i>@stage.Name
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: Material & Process -->
            <div class="tab-pane fade" id="material" role="tabpanel">
                <div class="row g-3">
                    <div class="col-12">
                        <h6 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-flask me-2"></i>Material & Process Parameters
                        </h6>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Part.SlsMaterial" class="form-label fw-semibold">
                            <i class="fas fa-cube me-1 text-primary"></i>SLS Material
                        </label>
                        <input asp-for="Part.SlsMaterial" id="slsMaterialInput" class="form-control" 
                               placeholder="Ti-6Al-4V Grade 5" />
                        <span asp-validation-for="Part.SlsMaterial" class="text-danger"></span>
                        <div class="form-text">
                            <i class="fas fa-info-circle text-info me-1"></i>
                            Auto-synced with primary material selection
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Part.ProcessType" class="form-label">Primary Process Type</label>
                        <select asp-for="Part.ProcessType" class="form-select">
                            <option value="SLS Metal">SLS Metal</option>
                            <option value="SLS Polymer">SLS Polymer</option>
                            <option value="DMLS">DMLS</option>
                            <option value="EBM">EBM</option>
                            <option value="CNC">CNC Machining</option>
                            <option value="EDM">EDM</option>
                        </select>
                        <span asp-validation-for="Part.ProcessType" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.MaterialCostPerKg" class="form-label">Material Cost ($/kg)</label>
                        <input asp-for="Part.MaterialCostPerKg" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Part.MaterialCostPerKg" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.StandardLaborCostPerHour" class="form-label">Labor Cost ($/hour)</label>
                        <input asp-for="Part.StandardLaborCostPerHour" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Part.StandardLaborCostPerHour" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.SurfaceFinishRequirement" class="form-label">Surface Finish</label>
                        <select asp-for="Part.SurfaceFinishRequirement" class="form-select">
                            <option value="As-built">As-built</option>
                            <option value="Machined">Machined</option>
                            <option value="Polished">Polished</option>
                            <option value="Sandblasted">Sandblasted</option>
                            <option value="Coated">Coated</option>
                            <option value="Anodized">Anodized</option>
                        </select>
                        <span asp-validation-for="Part.SurfaceFinishRequirement" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- TAB 4: Physical Properties -->
            <div class="tab-pane fade" id="physical" role="tabpanel">
                <div class="row g-3">
                    <div class="col-12">
                        <h6 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-cube me-2"></i>Physical Properties & Dimensions
                        </h6>
                    </div>
                    
                    <div class="col-md-3">
                        <label asp-for="Part.LengthMm" class="form-label">Length (mm)</label>
                        <input asp-for="Part.LengthMm" type="number" step="0.1" class="form-control" 
                               placeholder="0.0" onchange="window.calculateVolume && window.calculateVolume()" />
                        <span asp-validation-for="Part.LengthMm" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-3">
                        <label asp-for="Part.WidthMm" class="form-label">Width (mm)</label>
                        <input asp-for="Part.WidthMm" type="number" step="0.1" class="form-control" 
                               placeholder="0.0" onchange="window.calculateVolume && window.calculateVolume()" />
                        <span asp-validation-for="Part.WidthMm" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-3">
                        <label asp-for="Part.HeightMm" class="form-label">Height (mm)</label>
                        <input asp-for="Part.HeightMm" type="number" step="0.1" class="form-control" 
                               placeholder="0.0" onchange="window.calculateVolume && window.calculateVolume()" />
                        <span asp-validation-for="Part.HeightMm" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-3">
                        <label asp-for="Part.WeightGrams" class="form-label">Weight (g)</label>
                        <input asp-for="Part.WeightGrams" type="number" step="0.1" class="form-control" 
                               placeholder="0.0" />
                        <span asp-validation-for="Part.WeightGrams" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Part.VolumeMm3" class="form-label">Volume (mm³)</label>
                        <input asp-for="Part.VolumeMm3" type="number" step="1" class="form-control" 
                               id="volumeInput" readonly />
                        <span asp-validation-for="Part.VolumeMm3" class="text-danger"></span>
                        <div class="form-text">Auto-calculated from L × W × H</div>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Part.Dimensions" class="form-label">Dimensions String</label>
                        <input asp-for="Part.Dimensions" class="form-control" 
                               placeholder="e.g., 100 × 50 × 25 mm" id="dimensionsInput" readonly />
                        <span asp-validation-for="Part.Dimensions" class="text-danger"></span>
                        <div class="form-text">Auto-generated from dimensions</div>
                    </div>
                    
                    <div class="col-md-4">
                        <label asp-for="Part.MaxSurfaceRoughnessRa" class="form-label">Max Surface Roughness Ra (μm)</label>
                        <input asp-for="Part.MaxSurfaceRoughnessRa" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="Part.MaxSurfaceRoughnessRa" class="text-danger"></span>
                    </div>

                    <!-- Quality Requirements -->
                    <div class="col-12 mt-4">
                        <h6 class="text-info border-bottom pb-2 mb-3">
                            <i class="fas fa-certificate me-2"></i>Quality Standards
                        </h6>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-check">
                            <input asp-for="Part.RequiresFDA" class="form-check-input" type="checkbox" />
                            <label asp-for="Part.RequiresFDA" class="form-check-label">
                                <i class="fas fa-shield-alt me-1"></i>FDA Compliance Required
                            </label>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-check">
                            <input asp-for="Part.RequiresAS9100" class="form-check-input" type="checkbox" />
                            <label asp-for="Part.RequiresAS9100" class="form-check-label">
                                <i class="fas fa-certificate me-1"></i>AS9100 Compliance Required
                            </label>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-check">
                            <input asp-for="Part.RequiresNADCAP" class="form-check-input" type="checkbox" />
                            <label asp-for="Part.RequiresNADCAP" class="form-check-label">
                                <i class="fas fa-award me-1"></i>NADCAP Compliance Required
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 5: Assets (Phase 5: Asset Management) -->
            @if (Model.Part.Id > 0)
            {
                <div class="tab-pane fade" id="assets" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="text-primary border-bottom pb-2 mb-3">
                                <i class="fas fa-paperclip me-2"></i>Part Assets & Attachments
                            </h6>
                        </div>
                        
                        <div class="col-12">
                            <!-- Asset Upload Section -->
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0 fw-bold text-dark">
                                        <i class="fas fa-upload me-2 text-success"></i>
                                        Upload New Assets
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="asset-upload-area">
                                        <input type="file" id="asset-upload" 
                                               accept=".step,.stp,.stl,.jpg,.jpeg,.png,.pdf,.doc,.docx" multiple 
                                               class="form-control" />
                                        <div class="form-text mt-2">
                                            <i class="fas fa-info-circle text-info me-1"></i>
                                            Supported: 3D Models (.step, .stp, .stl), Images (.jpg, .png), Documents (.pdf, .doc)
                                        </div>
                                        <button type="button" class="btn btn-primary mt-2" onclick="uploadAssets()">
                                            <i class="fas fa-upload me-1"></i>Upload Assets
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <!-- Existing Assets -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0 fw-bold text-dark">
                                        <i class="fas fa-list-alt me-2 text-info"></i>
                                        Existing Assets
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div id="existing-assets">
                                        <!-- Existing assets loaded here -->
                                        <div class="text-center py-4" id="assetsLoadingIndicator">
                                            <div class="spinner-border text-primary mb-3" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p class="text-muted">Loading existing assets...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Form Action Buttons -->
        <div class="modal-footer bg-light border-top">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="text-muted small">
                    <i class="fas fa-info-circle me-1"></i>
                    @if (Model.Part.Id == 0)
                    {
                        <span>Creating new part with stage assignments</span>
                    }
                    else
                    {
                        <span>Updating part: @Model.Part.PartNumber</span>
                    }
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="submit" id="savePartBtn" class="btn btn-primary">
                        <span class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true"></span>
                        <i class="fas fa-save me-1"></i>
                        <span class="btn-text">@(Model.Part.Id == 0 ? "Create Part" : "Update Part")</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- PHASE 3: Modern JavaScript Integration -->
<script src="~/js/shared/opcentrix-global-functions.js" asp-append-version="true"></script>
<script src="~/js/admin/parts-stage-manager.js" asp-append-version="true"></script>
<script src="~/js/admin/parts-form-manager.js" asp-append-version="true"></script>

<script>
    // Modern Part Form Manager with Stage Integration
    class PartFormManager {
        constructor() {
            this.initializeLookupHandlers();
            this.initializeStageManager();
            this.initializeAssetManager();
            this.initializeMaterialHandlers();
            this.initializeCalculations();
        }

        initializeLookupHandlers() {
            const componentTypeSelect = document.getElementById('Part_ComponentTypeId');
            const complianceCategorySelect = document.getElementById('Part_ComplianceCategoryId');
            
            if (componentTypeSelect) {
                componentTypeSelect.addEventListener('change', () => this.onComponentTypeChange());
            }
            
            if (complianceCategorySelect) {
                complianceCategorySelect.addEventListener('change', () => this.onComplianceCategoryChange());
            }
        }

        initializeStageManager() {
            const addStageBtn = document.getElementById('add-stage-btn');
            if (addStageBtn) {
                addStageBtn.addEventListener('click', () => this.showAddStageModal());
            }
            
            this.loadExistingStageRequirements();
        }

        initializeAssetManager() {
            const assetUpload = document.getElementById('asset-upload');
            if (assetUpload) {
                assetUpload.addEventListener('change', (e) => this.handleAssetUpload(e));
            }
        }

        initializeMaterialHandlers() {
            const materialSelect = document.getElementById('materialSelect');
            if (materialSelect) {
                materialSelect.addEventListener('change', () => this.updateMaterialDefaults());
            }
        }

        initializeCalculations() {
            const dimensionInputs = ['Part_LengthMm', 'Part_WidthMm', 'Part_HeightMm'];
            dimensionInputs.forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('input', () => this.calculateVolume());
                }
            });
        }

        onComponentTypeChange() {
            const select = document.getElementById('Part_ComponentTypeId');
            const selectedOption = select.options[select.selectedIndex];
            
            console.log('🔄 [FORM] Component type changed:', selectedOption.text);
            
            // Update form behavior based on component type
            if (selectedOption.text.includes('Serialized')) {
                this.enableSerializationFields();
            } else {
                this.disableSerializationFields();
            }
        }

        onComplianceCategoryChange() {
            const select = document.getElementById('Part_ComplianceCategoryId');
            const selectedOption = select.options[select.selectedIndex];
            const regulatoryLevel = selectedOption.getAttribute('data-regulatory-level');
            
            console.log('🔄 [FORM] Compliance category changed:', regulatoryLevel);
            
            // Update form behavior based on regulatory level
            if (regulatoryLevel === 'Restricted') {
                this.enableRestrictedFields();
            } else {
                this.disableRestrictedFields();
            }
        }

        enableSerializationFields() {
            // Enable serialization-related fields if they exist
            const serialFields = document.querySelectorAll('[data-serialization-required]');
            serialFields.forEach(field => {
                field.removeAttribute('disabled');
                field.classList.add('required');
            });
        }

        disableSerializationFields() {
            const serialFields = document.querySelectorAll('[data-serialization-required]');
            serialFields.forEach(field => {
                field.setAttribute('disabled', 'true');
                field.classList.remove('required');
            });
        }

        enableRestrictedFields() {
            // Enable compliance-related fields
            const complianceFields = document.querySelectorAll('[data-compliance-required]');
            complianceFields.forEach(field => {
                field.removeAttribute('disabled');
                field.classList.add('required');
            });
        }

        disableRestrictedFields() {
            const complianceFields = document.querySelectorAll('[data-compliance-required]');
            complianceFields.forEach(field => {
                field.setAttribute('disabled', 'true');
                field.classList.remove('required');
            });
        }

        updateMaterialDefaults() {
            const materialSelect = document.getElementById('materialSelect');
            const slsMaterialInput = document.getElementById('slsMaterialInput');
            const materialCostInput = document.getElementById('Part_MaterialCostPerKg');
            
            if (!materialSelect || !slsMaterialInput) return;
            
            const selectedMaterial = materialSelect.value;
            
            // Update SLS material to match
            slsMaterialInput.value = selectedMaterial;
            
            // Update material cost based on selection
            const materialCosts = {
                'Ti-6Al-4V Grade 5': 450.00,
                'Ti-6Al-4V ELI Grade 23': 500.00,
                'CP Titanium Grade 2': 400.00,
                'Inconel 718': 750.00,
                'Inconel 625': 800.00,
                '316L Stainless Steel': 25.00,
                '17-4 PH Stainless Steel': 30.00,
                'AlSi10Mg': 15.00
            };
            
            if (materialCostInput && materialCosts[selectedMaterial]) {
                materialCostInput.value = materialCosts[selectedMaterial];
            }
            
            console.log('✅ [FORM] Material defaults updated:', selectedMaterial);
        }

        calculateVolume() {
            const lengthInput = document.getElementById('Part_LengthMm');
            const widthInput = document.getElementById('Part_WidthMm');
            const heightInput = document.getElementById('Part_HeightMm');
            const volumeInput = document.getElementById('volumeInput');
            const dimensionsInput = document.getElementById('dimensionsInput');
            
            if (!lengthInput || !widthInput || !heightInput || !volumeInput) return;
            
            const length = parseFloat(lengthInput.value) || 0;
            const width = parseFloat(widthInput.value) || 0;
            const height = parseFloat(heightInput.value) || 0;
            
            const volume = length * width * height;
            volumeInput.value = volume.toFixed(1);
            
            if (dimensionsInput) {
                dimensionsInput.value = length && width && height ? 
                    `${length} × ${width} × ${height} mm` : '';
            }
        }

        async loadExistingStageRequirements() {
            const partId = document.querySelector('input[name="Part.Id"]')?.value;
            if (!partId || partId === '0') {
                this.hideStageLoadingIndicator();
                return;
            }

            try {
                const response = await fetch(`/Admin/Parts?handler=PartStages&partId=${partId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                });
                
                if (!response.ok) {
                    if (response.status === 404) {
                        console.log('🔍 [FORM] No existing stage requirements found for part');
                        this.renderStageRequirements([]);
                        return;
                    }
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const stages = await response.json();
                this.renderStageRequirements(stages);
                this.updateStageSummary(stages);
                
                console.log(`✅ [FORM] Loaded ${stages.length} existing stage requirements`);
                
            } catch (error) {
                console.error('❌ [FORM] Failed to load stage requirements:', error);
                this.showStageError('Failed to load stage requirements. Click "Add Stage" to create new workflow.');
            } finally {
                this.hideStageLoadingIndicator();
            }
        }

        renderStageRequirements(stages) {
            const container = document.getElementById('stage-requirements-container');
            if (!container) return;
            
            if (!stages || stages.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-plus-circle fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No manufacturing stages assigned yet.</p>
                        <p class="small text-muted">Click "Add Stage" to create your manufacturing workflow.</p>
                    </div>
                `;
                return;
            }
            
            let stageHtml = '';
            stages.forEach((stage, index) => {
                stageHtml += this.createStageRequirementHtml(stage, index);
            });
            
            container.innerHTML = stageHtml;
        }

        createStageRequirementHtml(stage, index) {
            const productionStage = stage.productionStage || {};
            const stageName = productionStage.name || 'Unknown Stage';
            const estimatedHours = stage.estimatedHours || 0;
            const setupMinutes = stage.setupTimeMinutes || 0;
            const hourlyRate = stage.hourlyRateOverride || productionStage.defaultHourlyRate || 85;
            const materialCost = stage.materialCost || 0;
            const totalCost = this.calculateStageCost(stage);
            
            return `
                <div class="stage-requirement-item border rounded p-3 mb-3" data-stage-id="${stage.id || stage.productionStageId}">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-primary me-2">${stage.executionOrder || index + 1}</span>
                                <h6 class="mb-0 fw-bold">${stageName}</h6>
                                ${stage.isRequired ? '<span class="badge bg-success ms-2">Required</span>' : '<span class="badge bg-secondary ms-2">Optional</span>'}
                            </div>
                            <div class="row g-2 text-sm">
                                <div class="col-md-3">
                                    <span class="text-muted">Duration:</span>
                                    <span class="fw-semibold">${estimatedHours}h</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted">Setup:</span>
                                    <span class="fw-semibold">${setupMinutes}min</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted">Rate:</span>
                                    <span class="fw-semibold">$${hourlyRate}/h</span>
                                </div>
                                <div class="col-md-3">
                                    <span class="text-muted">Cost:</span>
                                    <span class="fw-semibold">$${totalCost.toFixed(2)}</span>
                                </div>
                            </div>
                            ${stage.requirementNotes ? `
                                <div class="mt-2">
                                    <small class="text-muted"><i class="fas fa-sticky-note me-1"></i>${stage.requirementNotes}</small>
                                </div>
                            ` : ''}
                        </div>
                        <div class="btn-group-vertical btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary" onclick="editStage(${stage.id || stage.productionStageId})" title="Edit Stage">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger" onclick="removeStage(${stage.productionStageId || stage.id})" title="Remove Stage">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        calculateStageCost(stage) {
            const hours = stage.estimatedHours || 0;
            const rate = stage.hourlyRateOverride || stage.productionStage?.defaultHourlyRate || 85;
            const setupMinutes = stage.setupTimeMinutes || 0;
            const materialCost = stage.materialCost || 0;
            
            return (hours * rate) + ((setupMinutes / 60) * rate) + materialCost;
        }

        updateStageSummary(stages) {
            const totalStages = stages.length;
            const totalDuration = stages.reduce((sum, stage) => sum + (stage.estimatedHours || 0), 0);
            const totalCost = stages.reduce((sum, stage) => sum + this.calculateStageCost(stage), 0);
            
            const complexity = totalStages <= 2 ? 'Simple' : 
                              totalStages <= 4 ? 'Medium' : 'Complex';
            
            this.updateElement('summary-total-stages', totalStages);
            this.updateElement('summary-total-duration', `${totalDuration.toFixed(1)}h`);
            this.updateElement('summary-total-cost', `$${totalCost.toFixed(2)}`);
            this.updateElement('summary-complexity', complexity);
        }

        updateElement(id, value) {
            const element = document.getElementById(id);
            if (element) {
                element.textContent = value;
            }
        }

        hideStageLoadingIndicator() {
            const indicator = document.getElementById('stageLoadingIndicator');
            if (indicator) {
                indicator.style.display = 'none';
            }
        }

        showStageError(message) {
            const container = document.getElementById('stage-requirements-container');
            if (container) {
                container.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        ${message}
                    </div>
                `;
            }
        }

        showAddStageModal() {
            console.log('🔄 [FORM] Showing add stage modal');
            
            // For now, create a simple selection interface using available stages
            const availableStagesContainer = document.getElementById('availableStagesContainer');
            if (availableStagesContainer) {
                // Highlight the available stages section
                availableStagesContainer.scrollIntoView({ behavior: 'smooth' });
                
                // Add some visual feedback
                availableStagesContainer.classList.add('border', 'border-primary', 'rounded', 'p-2');
                setTimeout(() => {
                    availableStagesContainer.classList.remove('border', 'border-primary', 'rounded', 'p-2');
                }, 2000);
                
                if (window.showToast) {
                    window.showToast('info', 'Click on a stage from the "Available Stages" list to add it');
                }
            } else {
                // Fallback: show alert with common stages
                if (window.showToast) {
                    window.showToast('info', 'Stage selection modal coming soon. Use the Available Stages panel on the right.');
                }
            }
        }

        useDefaultStages() {
            console.log('🔧 [FORM] Using default stages as fallback');
            
            // Clear existing state
            this.selectedStages.clear();
            
            // Create basic default stages structure
            const defaultStages = [
                {
                    id: 'temp-1',
                    productionStage: { name: 'SLS Printing', defaultHourlyRate: 85 },
                    productionStageId: 1,
                    executionOrder: 1,
                    estimatedHours: 4.0,
                    setupTimeMinutes: 45,
                    isRequired: true,
                    materialCost: 0,
                    requirementNotes: 'Primary manufacturing stage'
                },
                {
                    id: 'temp-2',
                    productionStage: { name: 'Post-Processing', defaultHourlyRate: 75 },
                    productionStageId: 2,
                    executionOrder: 2,
                    estimatedHours: 1.0,
                    setupTimeMinutes: 15,
                    isRequired: true,
                    materialCost: 0,
                    requirementNotes: 'Finishing and cleanup'
                }
            ];
            
            this.renderStageRequirements(defaultStages);
            this.updateStageSummary(defaultStages);
            
            if (window.showToast) {
                window.showToast('success', 'Default manufacturing stages loaded');
            }
        }
    }

    // Helper function to get antiforgery token
    function getAntiForgeryToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    // Global functions for stage management
    window.addStageFromList = async function(stageId) {
        console.log('➕ [FORM] Adding stage from list:', stageId);
        
        const partId = document.querySelector('input[name="Part.Id"]')?.value || 0;
        const maxOrder = document.querySelectorAll('.stage-requirement-item').length + 1;
        
        try {
            const response = await fetch('/Admin/Parts?handler=AddStage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken(),
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin',
                body: JSON.stringify({
                    partId: parseInt(partId),
                    stageId: stageId,
                    executionOrder: maxOrder,
                    estimatedHours: 1.0,
                    setupTimeMinutes: 30,
                    materialCost: 0.00,
                    isRequired: true
                })
            });
            
            const result = await response.json();
            if (result.success) {
                console.log('✅ [FORM] Stage added successfully');
                // Reload the stage display
                const manager = window.partFormManager;
                if (manager) {
                    await manager.loadExistingStageRequirements();
                }
                if (window.showToast) {
                    window.showToast('success', result.message);
                }
            } else {
                console.error('❌ [FORM] Failed to add stage:', result.message);
                if (window.showToast) {
                    window.showToast('error', result.message);
                }
            }
        } catch (error) {
            console.error('❌ [FORM] Error adding stage:', error);
            if (window.showToast) {
                window.showToast('error', 'Failed to add stage');
            }
        }
    };

    window.editStage = function(stageId) {
        console.log('✏️ [FORM] Editing stage:', stageId);
        // TODO: Implement stage editing modal
        if (window.showToast) {
            window.showToast('info', 'Stage editing coming soon');
        }
    };

    window.removeStage = async function(stageId) {
        console.log('🗑️ [FORM] Removing stage:', stageId);
        
        if (!confirm('Are you sure you want to remove this stage from the part?')) {
            return;
        }
        
        const partId = document.querySelector('input[name="Part.Id"]')?.value || 0;
        
        try {
            const response = await fetch('/Admin/Parts?handler=RemoveStage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken(),
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin',
                body: JSON.stringify({
                    partId: parseInt(partId),
                    stageId: stageId
                })
            });
            
            const result = await response.json();
            if (result.success) {
                console.log('✅ [FORM] Stage removed successfully');
                // Reload the stage display
                const manager = window.partFormManager;
                if (manager) {
                    await manager.loadExistingStageRequirements();
                }
                if (window.showToast) {
                    window.showToast('success', result.message);
                }
            } else {
                console.error('❌ [FORM] Failed to remove stage:', result.message);
                if (window.showToast) {
                    window.showToast('error', result.message);
                }
            }
        } catch (error) {
            console.error('❌ [FORM] Error removing stage:', error);
            if (window.showToast) {
                window.showToast('error', 'Failed to remove stage');
            }
        }
    };

    // Material helper functions
    window.updateSlsMaterial = function() {
        const manager = window.partFormManager;
        if (manager) {
            manager.updateMaterialDefaults();
        }
    };

    window.calculateVolume = function() {
        const manager = window.partFormManager;
        if (manager) {
            manager.calculateVolume();
        }
    };

    // Initialize form manager when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 [PART-FORM] Initializing modern form manager...');
        try {
            window.partFormManager = new PartFormManager();
            console.log('✅ [PART-FORM] Form manager initialized successfully');
        } catch (error) {
            console.error('❌ [PART-FORM] Failed to initialize form manager:', error);
        }
    });

    // HTMX Success Handler for Parts Form
    document.addEventListener('htmx:afterRequest', function(event) {
        if (event.target.closest('#partModal') && event.detail.successful) {
            console.log('✅ [PARTS] Form submission successful');
            
            if (window.showToast) {
                window.showToast('success', 'Part saved successfully!');
            }
            
            setTimeout(() => {
                const modal = document.getElementById('partModal');
                if (modal && typeof bootstrap !== 'undefined') {
                    const bsModal = bootstrap.Modal.getInstance(modal);
                    if (bsModal) {
                        bsModal.hide();
                    }
                }
                window.location.reload();
            }, 1000);
        } else if (event.detail.xhr && event.detail.xhr.status >= 400) {
            console.error('❌ [PARTS] Form submission failed:', event.detail);
            if (window.showToast) {
                window.showToast('error', 'Form submission failed. Please check your inputs and try again.');
            }
        }
    });

    console.log('✅ [PART-FORM] Modernized form scripts loaded successfully');
</script>