@model OpCentrix.Pages.Printing.IndexModel.PrinterCardViewModel
@{
    var status = (Model.Status ?? "Idle").ToLower();
    string statusBadge = status switch
    {
        "printing" => "bg-orange-100 text-orange-800",
        "cooling" => "bg-purple-100 text-purple-800",
        "completed" => "bg-green-100 text-green-800",
        "urgent" => "bg-red-100 text-red-800",
        "maintenance" => "bg-amber-100 text-amber-800",
        "offline" => "bg-gray-200 text-gray-700",
        "preheating" => "bg-amber-100 text-amber-800",
        _ => "bg-green-100 text-green-800" // idle
    };
}
<div class="machine-card rounded-xl border shadow-sm @((status=="printing")?"border-orange-200 bg-orange-50":(status=="cooling")?"border-purple-200 bg-purple-50":(status=="urgent")?"border-red-200 bg-red-50":(status=="completed")?"border-green-200 bg-green-50":"border-gray-200 bg-white") p-4" data-status="@status" data-machine-id="@Model.MachineId">
  <div class="flex items-start justify-between mb-3">
    <div>
      <div class="text-lg font-bold text-gray-900">@Model.MachineId</div>
      <div class="text-xs text-gray-500">SLS</div>
    </div>
    <div class="flex flex-col items-end gap-0.5">
        <span class="px-2 py-1 rounded-full text-xs font-bold @statusBadge">@Model.Status</span>
        @if (status == "cooling" && Model.CoolingMinutesRemaining.HasValue)
        {
            <span class="text-[10px] leading-tight text-purple-700 font-semibold">Cooling ~ @Model.CoolingMinutesRemaining.Value min remaining</span>
        }
    </div>
  </div>

  @if (Model.ActiveBuild != null)
  {
      var build = Model.ActiveBuild;
      // Display server-provided progress only (no client-side recompute)
      double? pct = Model.ProgressPercent;
      bool pctInvalid = !pct.HasValue || double.IsNaN(pct.Value) || double.IsInfinity(pct.Value) || pct.Value <= 0 || pct.Value > 250;
      if (pctInvalid)
      {
          var elapsedHrs = (DateTime.UtcNow - build.ActualStartTime).TotalHours;
          double estHrs = 0;
          if (build.OperatorEstimatedHours.HasValue && build.OperatorEstimatedHours.Value > 0)
          {
              estHrs = (double)build.OperatorEstimatedHours.Value;
          }
          else if (Model.CurrentJob != null && Model.CurrentJob.EstimatedHours > 0)
          {
              estHrs = Model.CurrentJob.EstimatedHours;
          }
          else if (build.Part?.EstimatedHours > 0)
          {
              estHrs = build.Part.EstimatedHours;
          }
          else
          {
              // Safe fallback: assume elapsed represents ~80% complete to avoid zero
              estHrs = Math.Max(1.0, elapsedHrs / 0.8);
          }
          pct = estHrs > 0 ? (elapsedHrs / estHrs) * 100.0 : 0.0;
      }
      var pctRounded = pct.HasValue ? Math.Round(pct.Value) : (double?)null; // no 110% cap
      <div class="mb-3 rounded-lg border border-blue-200 bg-blue-50 p-3">
        <div class="flex items-center justify-between mb-1">
            <div class="font-semibold text-blue-900">Build #@build.BuildId</div>
            @if (pctRounded.HasValue) { <div class="text-xs font-bold text-blue-800">@pctRounded.Value %</div> }
        </div>
        @if (pctRounded.HasValue)
        {
            <div class="h-2.5 bg-blue-200 rounded-full overflow-hidden">
                <div class="h-2.5 rounded-full transition-all @((pctRounded>100)?"bg-gradient-to-r from-purple-500 to-purple-600":"bg-blue-600")" style="width:@Math.Min(100,pctRounded.Value)%"></div>
            </div>
        }
        <div class="mt-2 text-xs text-blue-900 grid grid-cols-3 gap-2">
            <div><span class="font-semibold">Started:</span> @build.ActualStartTime.ToLocalTime().ToString("MM/dd HH:mm")</div>
            <div><span class="font-semibold">Elapsed:</span> @((DateTime.UtcNow - build.ActualStartTime).TotalHours.ToString("F1"))h</div>
            @if (build.OperatorEstimatedHours.HasValue) { <div><span class="font-semibold">Est:</span> @build.OperatorEstimatedHours.Value.ToString("F1")h</div> }
        </div>
      </div>
  }
  else if (Model.RecentlyCompleted != null)
  {
      var c = Model.RecentlyCompleted;
      <div class="mb-3 rounded-lg border border-green-200 bg-green-50 p-3">
        <div class="flex items-center justify-between mb-1">
            <div class="font-semibold text-green-900">Build #@c.BuildId</div>
            <div class="text-xs font-bold text-green-800">Complete</div>
        </div>
        <div class="text-xs text-green-900 grid grid-cols-3 gap-2">
            <div><span class="font-semibold">Ended:</span> @c.CompletedAt?.ToLocalTime().ToString("MM/dd HH:mm")</div>
            <div><span class="font-semibold">Duration:</span> @((c.ActualEndTime.HasValue? (c.ActualEndTime.Value - c.ActualStartTime).TotalHours : 0).ToString("F1"))h</div>
            <div><span class="font-semibold">Parts:</span> @c.TotalPartsInBuild</div>
        </div>
      </div>
      @if (status == "urgent" && Model.DowntimeMinutes.HasValue)
      {
          <div class="mb-3 rounded-lg border border-red-200 bg-red-50 p-3">
            <div class="flex items-center justify-between mb-1">
                <div class="font-semibold text-red-900">Attention Required</div>
                <div class="text-xs font-bold text-red-800">Urgent</div>
            </div>
            <div class="text-sm text-red-900">Cooldown elapsed. Downtime: <span class="font-bold">@Model.DowntimeMinutes.Value</span> min</div>
          </div>
      }
  }

  @if (Model.CurrentJob != null)
  {
      var j = Model.CurrentJob;
      <div class="mb-3 text-sm">
        <div class="font-bold text-gray-900 mb-1">Current Job <span class="text-gray-600">(@j.PartNumber)</span></div>
        <div class="px-3 py-2 rounded-lg bg-gray-50 border border-gray-200">
          <div class="text-xs text-gray-700 flex flex-wrap gap-3">
            <span><span class="font-semibold">Start:</span> @( (j.ActualStart ?? j.ScheduledStart).ToLocalTime().ToString("MM/dd HH:mm") )</span>
            <span><span class="font-semibold">Est:</span> @j.EstimatedHours.ToString("F1")h</span>
            @if (j.Priority <= 2){ <span class="font-bold text-red-600">P@j.Priority</span> }
          </div>
        </div>
      </div>
  }

  @if (status == "idle" && Model.CoolingMinutesTotal.HasValue)
  {
      <div class="mb-2 px-3 py-2 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-semibold">Ready for changeover</div>
  }

  <div class="mb-2 text-sm font-semibold text-gray-800 flex items-center gap-2">
    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
    Upcoming Jobs (@Model.UpcomingJobs.Count)
  </div>
  @if (Model.UpcomingJobs.Any())
  {
      <div class="space-y-2">
        @foreach (var job in Model.UpcomingJobs.Take(2))
        {
            <div class="px-3 py-2 rounded-lg bg-white border border-gray-200 text-sm">
                <div class="font-semibold text-gray-900">@job.PartNumber <span class="text-gray-500">x@job.Quantity</span></div>
                <div class="text-xs text-gray-600 flex flex-wrap gap-3">
                    <span><span class="font-semibold">When:</span> @job.ScheduledStart.ToLocalTime().ToString("MM/dd HH:mm")</span>
                    <span><span class="font-semibold">Dur:</span> @job.EstimatedHours.ToString("F1")h</span>
                </div>
            </div>
        }
        @if (Model.UpcomingJobs.Count > 2)
        {
            <div class="text-xs text-gray-500 bg-gray-50 text-center py-1 rounded">+@(Model.UpcomingJobs.Count - 2) more</div>
        }
      </div>
  }
  else
  {
      <div class="text-xs text-gray-500 bg-gray-50 text-center py-2 rounded">No upcoming jobs</div>
  }

  <div class="mt-4 flex gap-2">
    <button type="button" class="flex-1 bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-md text-sm font-semibold"
            hx-get="/Scheduler?handler=ShowAddModal&machineId=@Model.MachineId&date=@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" hx-target="#modal-content" hx-swap="innerHTML">Start Print</button>
    <button type="button" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-md text-sm font-semibold"
            hx-get="/Scheduler?handler=ShowAddModal&machineId=@Model.MachineId&date=@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" hx-target="#modal-content" hx-swap="innerHTML">Schedule</button>
  </div>
</div>
