@model OpCentrix.Pages.Printing.IndexModel

@* Polished Operational Task Notification Panel *@
<div class="task-panel space-y-4" aria-live="polite" aria-busy="false">
    <div class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-md bg-gray-100 border border-gray-200">
        <div class="flex flex-wrap gap-3 text-xs font-medium text-gray-700">
            <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a1 1 0 00.86 1.5h18.64a1 1 0 00.86-1.5L13.71 3.86a1 1 0 00-1.72 0z"/></svg> High: <strong>@Model.HighPriorityCount</strong></span>
            <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Overdue: <strong>@Model.OverdueCount</strong></span>
            <span class="inline-flex items-center gap-1 text-blue-700"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg> Total: <strong>@Model.OperationalTasks.Count</strong></span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-gray-500">
            <span>Snapshot @Model.SnapshotUtc.ToLocalTime().ToString("HH:mm:ss")</span>
            <button hx-get="/Printing?handler=TaskNotifications" hx-target="#task-notifications" hx-swap="innerHTML" hx-indicator=".task-refresh-indicator" class="inline-flex items-center gap-1 px-2 py-1 bg-white border border-gray-300 rounded hover:bg-gray-50 text-gray-700 transition text-xs font-medium" aria-label="Refresh tasks">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M5 19a9 9 0 0014.6-2M18.35 5A9 9 0 007.4 3.6"/></svg>
                Refresh
            </button>
            <div class="task-refresh-indicator hidden"><svg class="animate-spin h-4 w-4 text-blue-500" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg></div>
        </div>
    </div>

    @if (Model.OperationalTasks.Any())
    {
        <div class="space-y-3">
            @foreach (var task in Model.OperationalTasks)
            {
                var isOverdue = task.OverdueFlag == 1;
                var dueSoon = !isOverdue && task.DueAt.HasValue && task.DueAt.Value <= DateTime.UtcNow.AddHours(4);
                var priorityClass = task.Priority switch
                {
                    1 => "border-red-500/70 bg-red-50",
                    2 => "border-orange-500/70 bg-orange-50",
                    3 => "border-yellow-500/70 bg-yellow-50",
                    4 => "border-blue-500/60 bg-blue-50",
                    _ => "border-gray-400 bg-gray-50"
                };
                string PriorityIcon() => task.Priority switch
                {
                    1 => "<svg class=\"w-4 h-4 text-red-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 9v4m0 4h.01M10.29 3.86L1.82 18a1 1 0 00.86 1.5h18.64a1 1 0 00.86-1.5L13.71 3.86a1 1 0 00-1.72 0z\"/></svg>",
                    2 => "<svg class=\"w-4 h-4 text-orange-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>",
                    3 => "<svg class=\"w-4 h-4 text-yellow-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>",
                    4 => "<svg class=\"w-4 h-4 text-blue-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z\"/></svg>",
                    _ => "<svg class=\"w-4 h-4 text-gray-500\" fill=\"currentColor\" viewBox=\"0 0 8 8\"><circle cx=\"4\" cy=\"4\" r=\"3\"/></svg>"
                };
                var statusBadgeClass = isOverdue ? "bg-red-100 text-red-800" : dueSoon ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-700";
                string RelativeDue()
                {
                    if (!task.DueAt.HasValue) return task.Status;
                    if (isOverdue) return "Overdue";
                    var diff = task.DueAt.Value - DateTime.UtcNow;
                    if (diff.TotalMinutes <= 0) return "Due now";
                    if (diff.TotalHours < 1) return $"Due in {diff.Minutes}m";
                    if (diff.TotalHours < 4) return $"Due in {(int)diff.TotalHours}h {(diff.Minutes % 60)}m";
                    if (diff.TotalDays < 1) return "Due today";
                    return $"Due {task.DueAt.Value:MM/dd}";
                }
                <div class="task-item border-l-4 border rounded-lg p-4 shadow-sm hover:shadow-md transition-all duration-200 @priorityClass">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="shrink-0" aria-hidden="true">@Html.Raw(PriorityIcon())</span>
                                <h4 class="font-semibold text-gray-900 text-sm leading-tight break-words">@task.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(task.MachineId))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/70 text-gray-800 border border-gray-300 uppercase tracking-wide">@task.MachineId</span>
                                }
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-gray-800 text-white">P@task.Priority</span>
                            </div>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <p class="text-[13px] text-gray-700 mb-2 leading-snug">@task.Description</p>
                            }

                            @if (task.ProgressSummaries?.Any() == true)
                            {
                                <div class="flex flex-wrap gap-1.5 mb-2">
                                    @foreach (var progress in task.ProgressSummaries)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-white text-gray-700 text-[10px] font-medium border border-gray-200">@progress</span>
                                    }
                                </div>
                            }

                            <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full @statusBadgeClass">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    @RelativeDue()
                                </span>
                                @if (task.Priority <= 2)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-600 text-white">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L4.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                        High
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(task.Category))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        @task.Category
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(task.Tags))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-200 text-gray-700">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h10a2 2 0 012 2v4a2 2 0 01-.586 1.414l-7 7a2 2 0 01-2.828 0l-4-4a2 2 0 010-2.828l7-7A2 2 0 0117 3v0"/></svg>
                                        @task.Tags
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex flex-col gap-2 shrink-0 text-[11px]">
                            <form hx-post="/Printing?handler=CompleteTask" hx-target="#task-notifications" hx-swap="innerHTML" hx-indicator="closest .task-item" class="inline">
                                <input type="hidden" name="taskId" value="@task.Id" />
                                <button type="submit" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white rounded-md font-semibold shadow-sm transition disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Complete task @task.Title">
                                    <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Done</span>
                                </button>
                            </form>
                            @if (task.Priority >= 3)
                            {
                                <form hx-post="/Printing?handler=DismissTask" hx-target="#task-notifications" hx-swap="innerHTML" hx-indicator="closest .task-item" class="inline">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <button type="submit" class="px-2.5 py-1 bg-gray-500 hover:bg-gray-600 text-white rounded-md font-semibold shadow-sm transition disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Dismiss task @task.Title">
                                        <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Dismiss</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-6 text-center">
            <div class="flex items-center justify-center mb-3">
                <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <p class="text-green-900 font-semibold text-sm">All clear</p>
            <p class="text-green-700 text-xs mt-1">No pending operational tasks.</p>
        </div>
    }

    @if (Model.OperationalTasks.Count >= 10)
    {
        <div class="pt-2 text-center">
            <a href="/PrintTracking" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 text-xs font-medium">
                View all tasks in Print Tracking
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
    }
</div>