@model OpCentrix.Pages.Printing.IndexModel

@if (Model.OperationalTasks.Any())
{
    <div class="space-y-3">
        @foreach (var task in Model.OperationalTasks)
        {
            var priorityClass = task.Priority switch
            {
                1 => "border-red-500 bg-red-50", // Critical
                2 => "border-orange-500 bg-orange-50", // High
                3 => "border-yellow-500 bg-yellow-50", // Medium
                4 => "border-blue-500 bg-blue-50", // Low
                _ => "border-gray-500 bg-gray-50" // Normal
            };

            var priorityIcon = task.Priority switch
            {
                1 => "??", // Critical
                2 => "??", // High
                3 => "??", // Medium
                4 => "??", // Low
                _ => "??" // Normal
            };

            var isOverdue = task.OverdueFlag == 1;
            var statusBadge = isOverdue ? "bg-red-100 text-red-800" : 
                             task.DueAt.HasValue && task.DueAt.Value <= DateTime.UtcNow.AddHours(4) ? "bg-yellow-100 text-yellow-800" : 
                             "bg-blue-100 text-blue-800";

            <div class="@priorityClass border-l-4 border rounded-lg p-4 shadow-sm hover:shadow-md transition-all duration-200">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-lg">@priorityIcon</span>
                            <h4 class="font-semibold text-gray-900">@task.Title</h4>
                            @if (!string.IsNullOrEmpty(task.MachineId))
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                                    ??? @task.MachineId
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="text-sm text-gray-700 mb-3">@task.Description</p>
                        }

                        <!-- Progress Summary -->
                        @if (task.ProgressSummaries.Any())
                        {
                            <div class="mb-3">
                                @foreach (var progress in task.ProgressSummaries)
                                {
                                    <span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded mr-2 mb-1">
                                        ?? @progress
                                    </span>
                                }
                            </div>
                        }

                        <!-- Status and Due Date -->
                        <div class="flex items-center gap-3 text-sm">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @statusBadge">
                                @if (isOverdue)
                                {
                                    <span>?? Overdue</span>
                                }
                                else if (task.DueAt.HasValue)
                                {
                                    var timeUntilDue = task.DueAt.Value - DateTime.UtcNow;
                                    if (timeUntilDue.TotalHours <= 4)
                                    {
                                        <span>? Due in @((int)timeUntilDue.TotalHours)h @((int)timeUntilDue.TotalMinutes % 60)m</span>
                                    }
                                    else if (timeUntilDue.TotalDays < 1)
                                    {
                                        <span>?? Due today</span>
                                    }
                                    else
                                    {
                                        <span>?? Due @task.DueAt.Value.ToString("MM/dd")</span>
                                    }
                                }
                                else
                                {
                                    <span>?? @task.Status</span>
                                }
                            </span>

                            @if (task.Priority <= 2)
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                    ?? High Priority
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col gap-2 ml-4">
                        <button onclick="completeTask(@task.Id)" 
                                class="px-3 py-1 bg-green-600 hover:bg-green-700 text-white text-xs rounded font-medium transition-colors duration-200">
                            ? Complete
                        </button>
                        
                        @if (task.Priority >= 3) // Allow dismissal for lower priority tasks
                        {
                            <button onclick="dismissTask(@task.Id)" 
                                    class="px-3 py-1 bg-gray-500 hover:bg-gray-600 text-white text-xs rounded font-medium transition-colors duration-200">
                                ?? Dismiss
                            </button>
                        }
                    </div>
                </div>

                <!-- Additional Context -->
                @if (!string.IsNullOrEmpty(task.Category) || !string.IsNullOrEmpty(task.Tags))
                {
                    <div class="mt-3 pt-3 border-t border-gray-200">
                        @if (!string.IsNullOrEmpty(task.Category))
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-700 mr-2">
                                ??? @task.Category
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(task.Tags))
                        {
                            <span class="text-xs text-gray-500">Tags: @task.Tags</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 text-center">
        <div class="flex items-center justify-center mb-2">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        </div>
        <p class="text-green-800 font-medium">? All clear!</p>
        <p class="text-green-700 text-sm mt-1">No pending maintenance tasks at this time.</p>
    </div>
}

@if (Model.OperationalTasks.Count >= 10)
{
    <div class="mt-4 text-center">
        <a href="/PrintTracking" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
            View all tasks in Print Tracking ?
        </a>
    </div>
}