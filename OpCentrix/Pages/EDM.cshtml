<script>
    // Validation helper
    function validateRequiredFields() {
        const requiredFields = ['partNumber', 'quantity', 'edmCutBy', 'edmInitials', 'logDate'];
        const missing = [];
        requiredFields.forEach(id => {
            const el = document.getElementById(id);
            if (!el || !el.value.trim()) { 
                missing.push(id); 
                el?.classList.add('border-red-500','bg-red-50'); 
            } else { 
                el.classList.remove('border-red-500','bg-red-50'); 
            }
        });
        if (missing.length) {
            SafeExecute.showNotification('warning','Please fill in all required fields',`Missing: ${missing.join(', ')}`);
            return false;
        }
        return true;
    }

    // Unified populate function - updated for new compact layout
    window.populatePrintFromData = function(data) {
        try {
            document.getElementById('printLogDate').textContent = data.logDate ? (new Date(data.logDate).toLocaleDateString()) : 'N/A';
            document.getElementById('printShift').textContent = data.shift || 'N/A';
            document.getElementById('printPartNumber').textContent = data.partNumber || 'N/A';
            document.getElementById('printQuantity').textContent = data.quantity || 'N/A';
            document.getElementById('printEdmCutBy').textContent = data.operatorName || 'N/A';
            document.getElementById('printEdmInitials').textContent = data.operatorInitials || 'N/A';
            document.getElementById('printStartTime').textContent = data.startTime || 'N/A';
            document.getElementById('printEndTime').textContent = data.endTime || 'N/A';
            document.getElementById('printMeasurement1').textContent = data.measurement1 || 'N/A';
            document.getElementById('printMeasurement2').textContent = data.measurement2 || 'N/A';
            document.getElementById('printTolerance').textContent = data.toleranceStatus || 'N/A';
            document.getElementById('printEDMScrap').textContent = data.scrapIssues || 'None';
            document.getElementById('printNotes').textContent = data.notes || 'No additional notes';
            document.getElementById('printTotalTime').textContent = data.totalTime || 'N/A';
            document.getElementById('printCutTime').textContent = data.totalTime || 'N/A';
            document.getElementById('printLogNumber').textContent = data.logNumber || document.getElementById('nextLogNumber').textContent;
            document.getElementById('printTimestamp').textContent = data.createdDate ? new Date(data.createdDate).toLocaleString() : new Date().toLocaleString();
        } catch (e) { 
            console.error('Populate print error', e); 
        }
    };

    // Existing populate wrappers updated to use unified
    window.populatePrintSection = function(){
        const data = {
            logDate: document.getElementById('logDate').value,
            shift: document.getElementById('shift').value,
            partNumber: document.getElementById('partNumber').value,
            quantity: document.getElementById('quantity').value,
            operatorName: document.getElementById('edmCutBy').value,
            operatorInitials: document.getElementById('edmInitials').value,
            startTime: document.getElementById('startTime').value,
            endTime: document.getElementById('endTime').value,
            measurement1: document.getElementById('measurement1').value,
            measurement2: document.getElementById('measurement2').value,
            toleranceStatus: document.getElementById('tolerance').value,
            scrapIssues: document.getElementById('EDMScrap').value,
            notes: document.getElementById('Notes').value,
            totalTime: calculateDiffTime(document.getElementById('startTime').value, document.getElementById('endTime').value)
        };
        populatePrintFromData(data);
    };

    window.populatePrintSectionFromLog = function(log){ 
        populatePrintFromData(log); 
    };

    function calculateDiffTime(startTime,endTime){
        if(!startTime || !endTime) return 'Not calculated';
        try { 
            const s=new Date(`2000-01-01T${startTime}`); 
            const e=new Date(`2000-01-01T${endTime}`); 
            if(e>s){ 
                const diff=e-s; 
                const h=Math.floor(diff/3600000); 
                const m=Math.floor((diff%3600000)/60000); 
                return h>0?`${h}h ${m}m`:`${m}m`; 
            } 
        } catch{} 
        return 'Not calculated'; 
    }

    // FIXED: Save & print preview function with proper logic
    window.saveAndPrintPreview = async function(){
        const opId = SafeExecute.generateOperationId();
        console.log(`?? [EDM-${opId}] saveAndPrintPreview start`);
        
        if(!validateRequiredFields()) {
            console.log(`? [EDM-${opId}] Validation failed`);
            return false;
        }
        
        try {
            const form = document.getElementById('edmLogForm');
            const formData = new FormData(form);
            
            // FIXED: Properly determine if this is an update based on the hidden ID field value
            const logIdValue = document.getElementById('logId').value;
            const isUpdate = logIdValue && logIdValue !== '0' && logIdValue !== '';
            
            console.log(`?? [EDM-${opId}] LogId value: '${logIdValue}', IsUpdate: ${isUpdate}`);
            
            // Always use SaveLog handler - the server will determine if it's an update based on LogEntry.Id
            const handler = 'SaveLog';
            
            console.log(`?? [EDM-${opId}] Sending ${handler} request`);
            
            const response = await fetch(`/EDM?handler=${handler}`, { 
                method: 'POST', 
                body: formData, 
                headers: { 
                    'Accept': 'application/json', 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value 
                } 
            });
            
            console.log(`?? [EDM-${opId}] Response status: ${response.status}`);
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error(`? [EDM-${opId}] Server error response:`, errorText);
                throw new Error(`Server error ${response.status}: ${errorText}`);
            }
            
            const result = await response.json();
            console.log(`?? [EDM-${opId}] Response data:`, result);
            
            if (!result.success) { 
                throw new Error(result.message || 'Save failed'); 
            }
            
            // Use the log data from the response
            const logData = result.log;
            if (!logData) {
                console.warn(`?? [EDM-${opId}] No log data in response, using form data`);
                // Fallback to form data if server doesn't return log data
                const fallbackData = {
                    logNumber: result.logNumber || document.getElementById('nextLogNumber').textContent,
                    partNumber: document.getElementById('partNumber').value,
                    quantity: document.getElementById('quantity').value,
                    logDate: document.getElementById('logDate').value,
                    shift: document.getElementById('shift').value,
                    operatorName: document.getElementById('edmCutBy').value,
                    operatorInitials: document.getElementById('edmInitials').value,
                    startTime: document.getElementById('startTime').value,
                    endTime: document.getElementById('endTime').value,
                    measurement1: document.getElementById('measurement1').value,
                    measurement2: document.getElementById('measurement2').value,
                    toleranceStatus: document.getElementById('tolerance').value,
                    scrapIssues: document.getElementById('EDMScrap').value,
                    notes: document.getElementById('Notes').value,
                    totalTime: calculateDiffTime(document.getElementById('startTime').value, document.getElementById('endTime').value),
                    createdDate: new Date().toISOString()
                };
                populatePrintFromData(fallbackData);
            } else {
                console.log(`?? [EDM-${opId}] Populating print with server data:`, logData);
                populatePrintFromData(logData);
            }
            
            const ps = document.getElementById('printSection');
            ps.style.display = 'block';
            ps.scrollIntoView({ behavior: 'smooth' });
            
            SafeExecute.showNotification('success', result.message || 'Log saved', 'Print preview ready');
            
            // Reset form only for new entries
            if (!isUpdate) { 
                form.reset(); 
                document.getElementById('logId').value = ''; 
                // Set default values
                const logDateElement = document.getElementById('logDate');
                if (logDateElement) {
                    logDateElement.value = new Date().toISOString().split('T')[0];
                }
                const operatorElement = document.getElementById('edmCutBy');
                if (operatorElement) {
                    operatorElement.value = '@User.Identity?.Name';
                }
            }
            
            // Update dashboard stats
            await updateDashboardStats();
            
            console.log(`? [EDM-${opId}] saveAndPrintPreview completed successfully`);
            return true;
            
        } catch(err) {
            console.error(`? [EDM-${opId}] saveAndPrintPreview error:`, err);
            SafeExecute.logError(opId, 'saveAndPrintPreview', err); 
            SafeExecute.showUserFriendlyError('saveAndPrintPreview', err); 
            return false; 
        }
    };

    // Keep original functions below (trimmed where necessary)
    window.generateLogNumber = function() { 
        const nextLogNumber = document.getElementById('nextLogNumber'); 
        if (nextLogNumber) { 
            const current = parseInt(nextLogNumber.textContent) || 1; 
            nextLogNumber.textContent = current + 1; 
            return current.toString(); 
        } 
        return '1'; 
    };

    window.saveLogToDatabase = async function() { 
        const opId = SafeExecute.generateOperationId(); 
        console.log(`?? [EDM-${opId}] saveLogToDatabase start`); 
        if(!validateRequiredFields()) return false; 
        try { 
            const form = document.getElementById('edmLogForm'); 
            const formData = new FormData(form); 
            const logId = document.getElementById('logId').value; 
            const isUpdate = logId && logId !== '0' && logId !== ''; 
            const handler = isUpdate ? 'UpdateLog' : 'SaveLog'; 
            const response = await fetch(`/EDM?handler=${handler}`, { 
                method: 'POST', 
                body: formData, 
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value, 
                    'Accept': 'application/json' 
                }
            }); 
            if(response.ok){ 
                const result = await response.json(); 
                if(result.success){ 
                    const action = isUpdate ? 'updated' : 'saved'; 
                    SafeExecute.showNotification('success', result.message, `Log #${result.log?.logNumber || ''} ${action}`); 
                    if(!isUpdate){ 
                        form.reset(); 
                        document.getElementById('logId').value = ''; 
                        const logDateElement = document.getElementById('logDate'); 
                        if(logDateElement){ 
                            logDateElement.value = new Date().toISOString().split('T')[0]; 
                        } 
                        const operatorElement = document.getElementById('edmCutBy'); 
                        if(operatorElement){ 
                            operatorElement.value = '@User.Identity?.Name'; 
                        } 
                        await updateDashboardStats(); 
                    } 
                    return true; 
                } else { 
                    throw new Error(result.message || 'Server returned error'); 
                } 
            } else { 
                throw new Error(`Server error: ${response.status}`); 
            } 
        } catch(error){ 
            SafeExecute.logError(opId,'saveLogToDatabase',error); 
            SafeExecute.showUserFriendlyError('saveLogToDatabase',error); 
            return false; 
        } 
    };

    window.generatePrintout = function(){ 
        if(!validateRequiredFields()) return false; 
        populatePrintSection(); 
        const ps = document.getElementById('printSection'); 
        ps.style.display = 'block'; 
        ps.scrollIntoView({behavior:'smooth'}); 
        SafeExecute.showNotification('success','EDM Log generated','Ready for printing'); 
        return true; 
    };

    window.printAndStore = function(){ 
        try { 
            // Small delay to ensure page layout is complete before printing
            setTimeout(() => {
                window.print(); 
            }, 100);
            SafeExecute.showNotification('success','Print dialog opened','Confirm to print the log'); 
            return true; 
        } catch(e){ 
            SafeExecute.showNotification('error','Print failed',e.message); 
            return false; 
        } 
    };
    
    window.hidePrintSection = function(){ 
        const ps = document.getElementById('printSection'); 
        if(ps) ps.style.display = 'none'; 
    };

    window.clearForm = function(){ 
        const opId = SafeExecute.generateOperationId(); 
        console.log(`?? [EDM-${opId}] clearForm`); 
        const isEditing = document.getElementById('logId').value !== ''; 
        if(!confirm(isEditing ? 'Clear form and cancel edit?' : 'Clear all form data?')) return false; 
        const form = document.getElementById('edmLogForm'); 
        form.reset(); 
        document.getElementById('logId').value = ''; 
        form.setAttribute('asp-page-handler','SaveLog'); 
        document.getElementById('saveButtonText').textContent = 'Save to Database'; 
        document.getElementById('saveButton').classList.remove('bg-orange-600','hover:bg-orange-700'); 
        document.getElementById('saveButton').classList.add('bg-green-600','hover:bg-green-700'); 
        document.getElementById('cancelEditButton').classList.add('hidden'); 
        const logDateElement = document.getElementById('logDate'); 
        if(logDateElement){ 
            logDateElement.value = new Date().toISOString().split('T')[0]; 
        } 
        const operatorElement = document.getElementById('edmCutBy'); 
        if(operatorElement){ 
            operatorElement.value = '@User.Identity?.Name'; 
        } 
        document.querySelectorAll('input,textarea,select').forEach(f=>f.classList.remove('border-red-500','bg-red-50')); 
        SafeExecute.showNotification('success', isEditing ? 'Edit cancelled' : 'Form cleared', isEditing ? 'Returned to new entry mode' : 'All fields reset'); 
        return true; 
    };

    window.updateDashboardStats = async function(){ 
        try { 
            const response = await fetch('/EDM'); 
            if(response.ok){ 
                const html = await response.text(); 
                const parser = new DOMParser(); 
                const doc = parser.parseFromString(html,'text/html'); 
                const updates = { 
                    'totalLogsCount': doc.querySelector('#totalLogsCount')?.textContent, 
                    'todayLogsCount': doc.querySelector('#todayLogsCount')?.textContent, 
                    'lastLogTime': doc.querySelector('#lastLogTime')?.textContent, 
                    'logCount': doc.querySelector('#logCount')?.textContent, 
                    'nextLogNumber': doc.querySelector('#nextLogNumber')?.textContent 
                }; 
                for(const [id,value] of Object.entries(updates)){ 
                    const el = document.getElementById(id); 
                    if(el && value){ 
                        el.textContent = value; 
                    } 
                } 
            } 
        } catch(e){ 
            console.warn('Update stats failed', e); 
        } 
    };

    window.viewStoredLogs = async function(){ 
        const opId = SafeExecute.generateOperationId(); 
        console.log(`?? [EDM-${opId}] viewStoredLogs`); 
        try { 
            const modal = document.getElementById('storedLogsModal'); 
            const content = document.getElementById('storedLogsContent'); 
            content.innerHTML = '<div class="text-center py-8"><div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600 mx-auto"></div><p class="mt-4 text-gray-600">Loading...</p></div>'; 
            modal.classList.remove('hidden'); 
            const response = await fetch('/EDM?handler=LogsJson'); 
            if(!response.ok) throw new Error('Fetch failed'); 
            const logs = await response.json(); 
            if(!Array.isArray(logs) || logs.length === 0){ 
                content.innerHTML = '<div class="text-center text-gray-500 py-8"><p class="text-lg">No logs found</p></div>'; 
                return true; 
            } 
            content.innerHTML = `<div class='space-y-4'>${logs.map(log=>`<div class='border border-gray-200 rounded-lg p-4 hover:bg-gray-50'><div class='flex justify-between items-start'><div class='flex-1'><h4 class='font-semibold text-lg'>Log #${log.logNumber} - ${log.partNumber}</h4><p class='text-gray-600'>Qty: ${log.quantity} | Operator: ${log.operatorName} (${log.operatorInitials})</p><p class='text-sm text-gray-500'>Created: ${new Date(log.createdDate).toLocaleString()}</p>${log.notes? `<p class='text-sm text-gray-700 mt-2 italic'>"${log.notes}"</p>`:''}</div><div class='text-right'><div class='mb-2><span class='inline-block px-2 py-1 text-xs font-medium rounded ${log.toleranceStatus==='? Within Tolerance'?'bg-green-100 text-green-800':log.toleranceStatus==='?? Close to Limit'?'bg-yellow-100 text-yellow-800':log.toleranceStatus==='? Out of Tolerance'?'bg-red-100 text-red-800':'bg-gray-100 text-gray-800'}'>${log.toleranceStatus || 'Not Specified'}</span></div><div class='flex space-x-2'><button onclick='event.preventDefault(); window.editStoredLog(${log.id})' class='bg-blue-500 text-white px-3 py-1 rounded text-xs hover:bg-blue-600'>Edit</button><button onclick='event.preventDefault(); window.printStoredLog(${log.id})' class='bg-green-500 text-white px-3 py-1 rounded text-xs hover:bg-green-600'>Print</button><button onclick='event.preventDefault(); window.deleteStoredLog(${log.id})' class='bg-red-500 text-white px-3 py-1 rounded text-xs hover:bg-red-600'>Delete</button></div></div></div></div>`).join('')}</div>`; 
            return true; 
        } catch(e){ 
            SafeExecute.logError(opId,'viewStoredLogs',e); 
            SafeExecute.showUserFriendlyError('viewStoredLogs',e); 
            return false; 
        } 
    };

    window.editStoredLog = async function(logId){ 
        const opId = SafeExecute.generateOperationId(); 
        try { 
            const response = await fetch(`/EDM?handler=LogDetail&id=${logId}`); 
            if(!response.ok) throw new Error('Fetch failed'); 
            const log = await response.json(); 
            document.getElementById('logId').value = log.id||''; 
            document.getElementById('partNumber').value = log.partNumber||''; 
            document.getElementById('quantity').value = log.quantity||''; 
            document.getElementById('logDate').value = log.logDate? log.logDate.split('T')[0]:''; 
            document.getElementById('shift').value = log.shift||''; 
            document.getElementById('edmCutBy').value = log.operatorName||''; 
            document.getElementById('edmInitials').value = log.operatorInitials||''; 
            document.getElementById('startTime').value = log.startTime||''; 
            document.getElementById('endTime').value = log.endTime||''; 
            document.getElementById('measurement1').value = log.measurement1||''; 
            document.getElementById('measurement2').value = log.measurement2||''; 
            document.getElementById('tolerance').value = log.toleranceStatus||''; 
            document.getElementById('EDMScrap').value = log.scrapIssues||''; 
            document.getElementById('Notes').value = log.notes||''; 
            const form = document.getElementById('edmLogForm'); 
            form.setAttribute('asp-page-handler','UpdateLog'); 
            document.getElementById('saveButtonText').textContent = 'Update Log'; 
            document.getElementById('saveButton').classList.remove('bg-green-600','hover:bg-green-700'); 
            document.getElementById('saveButton').classList.add('bg-orange-600','hover:bg-orange-700'); 
            document.getElementById('cancelEditButton').classList.remove('hidden'); 
            closeStoredLogsModal(); 
            document.getElementById('edmLogForm').scrollIntoView({behavior:'smooth'}); 
            SafeExecute.showNotification('success','Log loaded for editing',`Log #${log.logNumber}`); 
            return true; 
        } catch(e){ 
            SafeExecute.logError(opId,'editStoredLog',e); 
            SafeExecute.showUserFriendlyError('editStoredLog',e); 
            return false; 
        } 
    };

    window.cancelEdit = function(){ 
        if(!confirm('Cancel editing? Unsaved changes will be lost.')) return false; 
        const form = document.getElementById('edmLogForm'); 
        form.reset(); 
        document.getElementById('logId').value = ''; 
        form.setAttribute('asp-page-handler','SaveLog'); 
        const logDateElement = document.getElementById('logDate'); 
        if(logDateElement){ 
            logDateElement.value = new Date().toISOString().split('T')[0]; 
        } 
        const operatorElement = document.getElementById('edmCutBy'); 
        if(operatorElement){ 
            operatorElement.value = '@User.Identity?.Name'; 
        } 
        document.getElementById('saveButtonText').textContent = 'Save to Database'; 
        document.getElementById('saveButton').classList.remove('bg-orange-600','hover:bg-orange-700'); 
        document.getElementById('saveButton').classList.add('bg-green-600','hover:bg-green-700'); 
        document.getElementById('cancelEditButton').classList.add('hidden'); 
        document.querySelectorAll('input,textarea,select').forEach(f=>f.classList.remove('border-red-500','bg-red-50')); 
        SafeExecute.showNotification('success','Edit cancelled','Form reset'); 
        return true; 
    };

    window.deleteStoredLog = async function(logId){ 
        if(!confirm('Delete this log?')) return false; 
        try { 
            const detailResp = await fetch(`/EDM?handler=LogDetail&id=${logId}`); 
            if(!detailResp.ok) throw new Error('Detail fetch failed'); 
            const log = await detailResp.json(); 
            if(!confirm(`Confirm delete Log #${log.logNumber}? This cannot be undone.`)) return false; 
            const response = await fetch(`/EDM?handler=DeleteLog&id=${logId}`, { 
                method:'POST', 
                headers:{ 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value 
                }
            }); 
            if(!response.ok) throw new Error('Delete failed'); 
            const result = await response.json(); 
            if(result.success){ 
                SafeExecute.showNotification('success','Log deleted', result.message); 
                await viewStoredLogs(); 
                await updateDashboardStats(); 
                return true; 
            } 
            throw new Error(result.message||'Delete failed'); 
        } catch(e){ 
            SafeExecute.showNotification('error','Delete failed', e.message); 
            return false; 
        } 
    };

    window.printStoredLog = async function(logId){ 
        try { 
            const resp = await fetch(`/EDM?handler=LogDetail&id=${logId}`); 
            if(!resp.ok) throw new Error('Fetch failed'); 
            const log = await resp.json(); 
            populatePrintSectionFromLog(log); 
            closeStoredLogsModal(); 
            const ps = document.getElementById('printSection'); 
            ps.style.display = 'block'; 
            ps.scrollIntoView({behavior:'smooth'}); 
            SafeExecute.showNotification('success','Log ready','Print preview shown'); 
            return true; 
        } catch(e){ 
            SafeExecute.showNotification('error','Print prep failed', e.message); 
            return false; 
        } 
    };

    window.closeStoredLogsModal = function(){ 
        const modal = document.getElementById('storedLogsModal'); 
        if(modal){ 
            modal.classList.add('hidden'); 
        } 
    };

    document.addEventListener('DOMContentLoaded', function(){ 
        const logDateElement = document.getElementById('logDate'); 
        if(logDateElement && !logDateElement.value){ 
            logDateElement.value = new Date().toISOString().split('T')[0]; 
        } 
        const hour = new Date().getHours(); 
        const shiftSelect = document.getElementById('shift'); 
        if(shiftSelect && !shiftSelect.value){ 
            if(hour>=7 && hour<15) shiftSelect.value = 'Day (7AM-3PM)'; 
            else if(hour>=15 && hour<23) shiftSelect.value = 'Evening (3PM-11PM)'; 
            else shiftSelect.value = 'Night (11PM-7AM)'; 
        } 
        const initialsElement = document.getElementById('edmInitials'); 
        if(initialsElement){ 
            initialsElement.addEventListener('input', function(){ 
                this.value = this.value.toUpperCase(); 
            }); 
        } 
        const partNumberElement = document.getElementById('partNumber'); 
        if(partNumberElement){ 
            partNumberElement.addEventListener('input', function(){ 
                this.value = this.value.toUpperCase(); 
            }); 
        } 
        const operatorElement = document.getElementById('edmCutBy'); 
        if(operatorElement){ 
            operatorElement.addEventListener('input', function(){ 
                const name = this.value.trim(); 
                if(name && initialsElement){ 
                    const initials = name.split(' ').map(p=>p.charAt(0)).join('').toUpperCase().substring(0,4); 
                    initialsElement.value = initials; 
                } 
            }); 
        } 
        SafeExecute.showNotification('success','EDM Page Ready','Initialized successfully'); 
    });
</script>

