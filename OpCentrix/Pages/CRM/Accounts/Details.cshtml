@page
@model OpCentrix.Pages.CRM.Accounts.DetailsModel
@{
    ViewData["Title"] = "Account Details - " + (Model.Account?.Name ?? "Account");
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Enhanced Header Section -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center space-x-3 mb-2">
                        <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm">
                            <span class="text-white text-lg font-bold">
                                @(Model.Account?.Name.Take(2).Aggregate("", (acc, c) => acc + c).ToUpper() ?? "AC")
                            </span>
                        </div>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900 truncate">@Model.Account?.Name</h1>
                            <div class="flex items-center space-x-3 text-sm text-gray-600">
                                <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full @GetStatusBadgeClass(Model.Account?.Status)">
                                    @(Model.Account?.Status ?? "Unknown")
                                </span>
                                <span class="flex items-center">
                                    <i class="fa-solid fa-hashtag mr-1"></i>
                                    Account #@Model.Id
                                </span>
                                <span class="flex items-center">
                                    <i class="fa-solid fa-calendar-plus mr-1"></i>
                                    Created @Model.Account?.CreatedDate.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="flex items-center space-x-2">
                    <a class="btn btn-light" href="/CRM/Accounts">
                        <i class="fa-solid fa-arrow-left mr-2"></i>Back to Accounts
                    </a>
                    <a class="btn btn-outline-secondary" href="/CRM/Accounts/Edit?id=@Model.Id">
                        <i class="fa-solid fa-edit mr-2"></i>Edit Account
                    </a>
                    <a class="btn btn-success" href="/CRM/Contacts/Create?accountId=@Model.Account?.Id">
                        <i class="fa-solid fa-user-plus mr-2"></i>Add Contact
                    </a>
                    <a class="btn btn-primary" href="/CRM/Tasks/Create?accountId=@Model.Account?.Id">
                        <i class="fa-solid fa-plus mr-2"></i>New Task
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Account Overview Cards -->
        <div class="px-6 py-5">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Contacts Card -->
                <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-users text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-purple-700">Contacts</div>
                            <div class="text-lg font-bold text-purple-900">@Model.Contacts.Count</div>
                            <div class="text-xs text-purple-600">
                                @if (Model.Contacts.Any())
                                {
                                    <span>Primary: @(Model.Contacts.FirstOrDefault()?.Name ?? "None set")</span>
                                }
                                else
                                {
                                    <span>No contacts added</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tasks Card -->
                <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-tasks text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-blue-700">Total Tasks</div>
                            <div class="text-lg font-bold text-blue-900">@Model.Tasks.Count</div>
                            <div class="text-xs text-blue-600">
                                @{
                                    var activeTasks = Model.Tasks.Count(t => t.Status != "Completed");
                                }
                                @activeTasks active, @(Model.Tasks.Count - activeTasks) completed
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Activity -->
                <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-chart-line text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-green-700">Activity</div>
                            <div class="text-lg font-bold text-green-900">
                                @{
                                    var daysSinceModified = (DateTime.Now - Model.Account.LastModifiedDate).Days;
                                    if (daysSinceModified == 0)
                                    {
                                        <span>Today</span>
                                    }
                                    else if (daysSinceModified == 1)
                                    {
                                        <span>1 day ago</span>
                                    }
                                    else
                                    {
                                        <span>@daysSinceModified days ago</span>
                                    }
                                }
                            </div>
                            <div class="text-xs text-green-600">Last modified</div>
                        </div>
                    </div>
                </div>

                <!-- Priority Indicator -->
                <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-exclamation-triangle text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-yellow-700">Priority Tasks</div>
                            <div class="text-lg font-bold text-yellow-900">
                                @Model.Tasks.Count(t => t.Priority >= 4 && t.Status != "Completed")
                            </div>
                            <div class="text-xs text-yellow-600">High priority pending</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800 font-medium">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <!-- Left Column: Account Details & Notes -->
        <div class="xl:col-span-2 space-y-6">
            <!-- Account Information -->
            @if (!string.IsNullOrWhiteSpace(Model.Account?.Notes))
            {
                <div class="bg-white border rounded-lg shadow-sm">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                            <i class="fa-solid fa-sticky-note mr-2 text-blue-600"></i>
                            Account Notes
                        </h3>
                    </div>
                    <div class="px-6 py-6">
                        <div class="prose prose-sm max-w-none">
                            <div class="whitespace-pre-wrap text-gray-800 leading-relaxed">@Model.Account!.Notes</div>
                        </div>
                    </div>
                </div>
            }

            <!-- Recent Tasks -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-tasks mr-2 text-green-600"></i>
                        Recent Tasks
                        @if (Model.Tasks.Any())
                        {
                            <span class="ml-2 px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full font-medium">
                                @Model.Tasks.Count task@(Model.Tasks.Count == 1 ? "" : "s")
                            </span>
                        }
                    </h3>
                    <a class="btn btn-success btn-sm" href="/CRM/Tasks/Create?accountId=@Model.Account?.Id">
                        <i class="fa-solid fa-plus mr-1"></i>New Task
                    </a>
                </div>
                
                <div class="overflow-hidden">
                    @if (Model.Tasks.Any())
                    {
                        <div class="divide-y divide-gray-200">
                            @foreach (var task in Model.Tasks.OrderByDescending(t => t.Id).Take(10))
                            {
                                <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center space-x-2 mb-2">
                                                <h4 class="text-sm font-semibold text-gray-900 truncate">@task.Title</h4>
                                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @GetTaskStatusBadgeClass(task.Status)">
                                                    @task.Status
                                                </span>
                                                <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @GetTaskPriorityBadgeClass(task.Priority)">
                                                    @GetPriorityLabel(task.Priority)
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <p class="text-xs text-gray-600 mb-2 truncate">@task.Description</p>
                                            }
                                            <div class="flex items-center space-x-4 text-xs text-gray-500">
                                                @if (task.DueAt.HasValue)
                                                {
                                                    var isOverdue = task.DueAt < DateTime.Now && task.Status != "Completed";
                                                    <span class="flex items-center @(isOverdue ? "text-red-600 font-medium" : "")">
                                                        <i class="fa-solid fa-calendar mr-1"></i>
                                                        Due @task.DueAt.Value.ToString("MMM dd")
                                                        @if (isOverdue)
                                                        {
                                                            <span class="ml-1 text-red-600">(Overdue)</span>
                                                        }
                                                    </span>
                                                }
                                                @if (task.AssignedToUserId.HasValue)
                                                {
                                                    var assignedUser = Model.Users.FirstOrDefault(u => u.Id == task.AssignedToUserId);
                                                    <span class="flex items-center">
                                                        <i class="fa-solid fa-user mr-1"></i>
                                                        @(assignedUser?.FullName ?? "Unknown User")
                                                    </span>
                                                }
                                                <span class="flex items-center">
                                                    <i class="fa-solid fa-calendar-plus mr-1"></i>
                                                    Created @task.CreatedDate.ToString("MMM dd")
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <div class="flex-shrink-0 ml-4">
                                            <a class="btn btn-sm btn-outline-primary" href="/CRM/Tasks/Details?id=@task.Id">
                                                <i class="fa-solid fa-eye mr-1"></i>View
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        @if (Model.Tasks.Count > 10)
                        {
                            <div class="px-6 py-4 bg-gray-50 border-t">
                                <a class="text-sm text-blue-600 hover:text-blue-800" href="/CRM/Tasks?accountId=@Model.Id">
                                    View all @Model.Tasks.Count tasks for this account →
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-12">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-tasks text-gray-400 text-2xl"></i>
                            </div>
                            <h4 class="text-lg font-medium text-gray-900 mb-2">No Tasks Yet</h4>
                            <p class="text-gray-600 mb-6">Create tasks to track projects and follow-ups for this account.</p>
                            <a class="btn btn-primary" href="/CRM/Tasks/Create?accountId=@Model.Account?.Id">
                                <i class="fa-solid fa-plus mr-2"></i>Create First Task
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Contacts & Quick Actions -->
        <div class="space-y-6">
            <!-- Contacts -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-users mr-2 text-purple-600"></i>
                        Contacts
                        @if (Model.Contacts.Any())
                        {
                            <span class="ml-2 px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded-full font-medium">
                                @Model.Contacts.Count contact@(Model.Contacts.Count == 1 ? "" : "s")
                            </span>
                        }
                    </h3>
                    <a class="btn btn-success btn-sm" href="/CRM/Contacts/Create?accountId=@Model.Account?.Id">
                        <i class="fa-solid fa-plus mr-1"></i>Add Contact
                    </a>
                </div>
                
                <div class="px-6 py-6">
                    @if (Model.Contacts.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var contact in Model.Contacts)
                            {
                                <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-lg border">
                                    <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-sm flex-shrink-0">
                                        <span class="text-white text-sm font-bold">
                                            @contact.Name.Take(2).Aggregate("", (acc, c) => acc + c).ToUpper()
                                        </span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="text-sm font-semibold text-gray-900">@contact.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(contact.Title))
                                        {
                                            <div class="text-xs text-gray-600 mb-1">@contact.Title</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(contact.Email))
                                        {
                                            <div class="text-xs text-blue-600">
                                                <a href="mailto:@contact.Email" class="hover:underline">@contact.Email</a>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                        {
                                            <div class="text-xs text-gray-600">
                                                <a href="tel:@contact.Phone" class="hover:underline">@contact.Phone</a>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary" 
                                                onclick="editContact(@contact.Id)"
                                                title="Edit Contact">
                                            <i class="fa-solid fa-edit"></i>
                                        </button>
                                        <form method="post" asp-page-handler="DeleteContact" class="inline" 
                                              onsubmit="return confirmDeleteContact('@contact.Name')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contactId" value="@contact.Id" />
                                            <input type="hidden" name="Id" value="@Model.Id" />
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger" 
                                                    title="Delete Contact">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-users text-gray-400"></i>
                            </div>
                            <h4 class="text-sm font-medium text-gray-900 mb-2">No Contacts Yet</h4>
                            <p class="text-xs text-gray-600 mb-4">Add contacts to manage relationships with this account.</p>
                            <a class="btn btn-sm btn-primary" href="/CRM/Contacts/Create?accountId=@Model.Account?.Id">
                                <i class="fa-solid fa-plus mr-1"></i>Add First Contact
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-bolt mr-2 text-yellow-600"></i>
                        Quick Actions
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-3">
                    <a class="btn btn-outline-primary w-full justify-center" href="/CRM/Tasks?accountId=@Model.Id">
                        <i class="fa-solid fa-list mr-2"></i>View All Tasks
                    </a>
                    <a class="btn btn-outline-secondary w-full justify-center" href="/CRM/Accounts/Edit?id=@Model.Id">
                        <i class="fa-solid fa-edit mr-2"></i>Edit Account Info
                    </a>
                    <a class="btn btn-outline-info w-full justify-center" href="/CRM/Dashboard">
                        <i class="fa-solid fa-tachometer-alt mr-2"></i>CRM Dashboard
                    </a>
                </div>
            </div>

            <!-- Account Information -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-info-circle mr-2 text-gray-600"></i>
                        Account Information
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-4">
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Account ID</span>
                        <span class="text-sm font-medium text-gray-900">#@Model.Id</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Status</span>
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @GetStatusBadgeClass(Model.Account?.Status)">
                            @(Model.Account?.Status ?? "Unknown")
                        </span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Created</span>
                        <span class="text-sm font-medium text-gray-900">@Model.Account?.CreatedDate.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Last Modified</span>
                        <span class="text-sm font-medium text-gray-900">@Model.Account.LastModifiedDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <span class="text-sm text-gray-600">Total Contacts</span>
                        <span class="text-sm font-medium text-gray-900">@Model.Contacts.Count</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <span class="text-sm text-gray-600">Total Tasks</span>
                        <span class="text-sm font-medium text-gray-900">@Model.Tasks.Count</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "active" => "bg-green-100 text-green-800",
        "inactive" => "bg-gray-100 text-gray-800", 
        "prospect" => "bg-blue-100 text-blue-800",
        "closed" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetTaskStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "open" => "bg-yellow-100 text-yellow-800",
        "inprogress" => "bg-blue-100 text-blue-800", 
        "completed" => "bg-green-100 text-green-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetTaskPriorityBadgeClass(int priority) => priority switch
    {
        5 => "bg-red-100 text-red-800",
        4 => "bg-orange-100 text-orange-800",
        3 => "bg-blue-100 text-blue-800",
        2 => "bg-gray-100 text-gray-800",
        1 => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetPriorityLabel(int priority) => priority switch
    {
        5 => "Critical",
        4 => "High",
        3 => "Normal", 
        2 => "Low",
        1 => "Lowest",
        _ => "Normal"
    };
}

<!-- Contact Edit Modal -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="contactModalContent">
            <!-- Modal content loaded dynamically -->
        </div>
    </div>
</div>

<!-- Include HTMX -->
<script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>

<script>
    function editContact(contactId) {
        // Show loading state
        const loadingHtml = `
            <div class='modal-header bg-purple-50 border-b'>
                <h5 class='modal-title text-lg font-semibold text-purple-800 flex items-center'>
                    <div class='spinner-border spinner-border-sm me-2' role='status'>
                        <span class='visually-hidden'>Loading...</span>
                    </div>
                    Loading Contact...
                </h5>
                <button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
            </div>
            <div class='modal-body p-6 text-center'>
                <div class='spinner-border text-purple-600 mb-3' role='status'>
                    <span class='visually-hidden'>Loading...</span>
                </div>
                <p class='text-gray-600'>Loading contact details...</p>
            </div>
        `;
        
        document.getElementById('contactModalContent').innerHTML = loadingHtml;
        const modal = new bootstrap.Modal(document.getElementById('contactModal'));
        modal.show();

        // Load the edit contact modal
        fetch(`/CRM/Accounts/Details?handler=EditContactModal&contactId=${contactId}&id=@Model.Id`, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            return response.text();
        })
        .then(html => {
            document.getElementById('contactModalContent').innerHTML = html;
        })
        .catch(error => {
            console.error('Error loading edit modal:', error);
            document.getElementById('contactModalContent').innerHTML = `
                <div class='modal-header bg-red-50 border-b'>
                    <h5 class='modal-title text-lg font-semibold text-red-800 flex items-center'>
                        <i class='fa-solid fa-exclamation-triangle me-2'></i>
                        Error
                    </h5>
                    <button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
                </div>
                <div class='modal-body p-6 text-center'>
                    <div class='text-red-600 mb-3'>
                        <i class='fa-solid fa-exclamation-triangle fa-2x'></i>
                    </div>
                    <h6 class='text-red-800 mb-2'>Failed to Load Contact</h6>
                    <p class='text-gray-600 mb-4'>There was an error loading the contact details. Please try again.</p>
                    <button type='button' class='btn btn-secondary' data-bs-dismiss='modal'>Close</button>
                </div>
            `;
        });
    }

    // Function to confirm contact deletion
    function confirmDeleteContact(contactName) {
        return confirm(`Are you sure you want to delete the contact "${contactName}"?\\n\\nThis action cannot be undone.`);
    }

    // Initialize Bootstrap components when page loads
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Auto-hide success alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert-success');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    });

    // HTMX event handlers for better UX
    document.addEventListener('htmx:beforeRequest', function(evt) {
        // Show loading state for form submissions
        if (evt.target.matches('#contactModal form')) {
            const submitBtn = evt.target.closest('.modal-content').querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Updating...';
            }
        }
    });

    document.addEventListener('htmx:afterRequest', function(evt) {
        // Reset button state after request
        if (evt.target.matches('#contactModal form')) {
            const submitBtn = evt.target.closest('.modal-content').querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-solid fa-save me-2"></i>Update Contact';
            }
        }
    });
</script>
