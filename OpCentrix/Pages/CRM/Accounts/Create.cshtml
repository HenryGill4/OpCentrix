@page
@model OpCentrix.Pages.CRM.Accounts.CreateModel
@{
    ViewData["Title"] = "Create CRM Account";
}

<div class="p-6 max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold">Create Account</h1>

    <form method="post" class="space-y-3">
        <div>
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Input.Name" />
            <span class="text-danger" asp-validation-for="Input.Name"></span>
        </div>
        <div>
            <label class="form-label">Status</label>
            <input class="form-control" asp-for="Input.Status" placeholder="Active" />
        </div>
        <div>
            <label class="form-label">Notes</label>
            <textarea class="form-control" asp-for="Input.Notes" rows="4"></textarea>
        </div>

        <div class="flex gap-2">
            <button class="btn btn-primary" type="submit">Create</button>
            <a class="btn btn-light" href="/CRM/Accounts">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
