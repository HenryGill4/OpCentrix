@page
@model OpCentrix.Pages.CRM.Accounts.EditModel
@{
    ViewData["Title"] = "Edit Account - " + (Model.Account?.Name ?? "Account");
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Enhanced Header Section -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center space-x-3 mb-2">
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-edit text-white"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900">Edit Account</h1>
                            <p class="text-sm text-gray-600">Update information for @Model.Account?.Name</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center space-x-3">
                    <a class="btn btn-outline-secondary" href="/CRM/Accounts/Details?id=@Model.Id">
                        <i class="fa-solid fa-arrow-left mr-2"></i>Back to Details
                    </a>
                    <a class="btn btn-outline-primary" href="/CRM/Accounts">
                        <i class="fa-solid fa-list mr-2"></i>All Accounts
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800 font-medium">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Main Form -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <!-- Left Column: Edit Form -->
        <div class="xl:col-span-2">
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-building mr-2 text-blue-600"></i>
                        Account Information
                    </h3>
                    <p class="mt-1 text-sm text-gray-600">Update the account details below</p>
                </div>
                
                <div class="px-6 py-6">
                    <form method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <!-- Account Name -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Account Name <span class="text-red-500">*</span>
                            </label>
                            <input class="form-control" asp-for="Input.Name" 
                                   placeholder="Enter the company or organization name..." 
                                   autocomplete="organization" />
                            <span class="text-danger text-sm" asp-validation-for="Input.Name"></span>
                        </div>

                        <!-- Status Selection -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Account Status</label>
                            <select class="form-select" asp-for="Input.Status">
                                <option value="">Select status...</option>
                                <option value="Prospect">Prospect</option>
                                <option value="Active">Active Customer</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Closed">Closed Account</option>
                            </select>
                            <p class="mt-1 text-xs text-gray-500">Choose the current relationship status with this account</p>
                        </div>

                        <!-- Notes Section -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Account Notes
                                <span class="text-gray-500 font-normal">(optional)</span>
                            </label>
                            <textarea class="form-control" asp-for="Input.Notes" rows="8" 
                                      placeholder="Add any important notes about this account..."></textarea>
                            <p class="mt-1 text-xs text-gray-500" id="characterCount">
                                @(2000 - (Model.Input.Notes?.Length ?? 0)) characters remaining
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="border-t pt-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fa-solid fa-save mr-2"></i>Save Changes
                                    </button>
                                    <a class="btn btn-outline-secondary" href="/CRM/Accounts/Details?id=@Model.Id">
                                        <i class="fa-solid fa-times mr-2"></i>Cancel
                                    </a>
                                </div>
                                
                                <div class="text-xs text-gray-500">
                                    <i class="fa-solid fa-info-circle mr-1"></i>
                                    Last modified: @(Model.Account?.CreatedDate.ToString("MMM dd, yyyy"))
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Account Overview & Help -->
        <div class="space-y-6">
            <!-- Current Account Summary -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-info-circle mr-2 text-gray-600"></i>
                        Account Overview
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-4">
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Account ID</span>
                        <span class="text-sm font-medium text-gray-900">#@Model.Id</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Created</span>
                        <span class="text-sm font-medium text-gray-900">@Model.Account?.CreatedDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Total Contacts</span>
                        <span class="text-sm font-medium text-gray-900">@Model.ContactCount</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <span class="text-sm text-gray-600">Total Tasks</span>
                        <span class="text-sm font-medium text-gray-900">@Model.TaskCount</span>
                    </div>
                </div>
            </div>

            <!-- Edit Tips -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-lightbulb mr-2 text-yellow-600"></i>
                        Edit Tips
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-4">
                    <div class="flex items-start space-x-3">
                        <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fa-solid fa-check text-blue-600 text-xs"></i>
                        </div>
                        <div>
                            <h4 class="text-sm font-medium text-gray-900">Status Updates</h4>
                            <p class="text-xs text-gray-600 mt-1">Change status to reflect current relationship with this account.</p>
                        </div>
                    </div>
                    
                    <div class="flex items-start space-x-3">
                        <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fa-solid fa-sticky-note text-green-600 text-xs"></i>
                        </div>
                        <div>
                            <h4 class="text-sm font-medium text-gray-900">Update Notes</h4>
                            <p class="text-xs text-gray-600 mt-1">Add recent interactions, project updates, or important changes.</p>
                        </div>
                    </div>
                    
                    <div class="flex items-start space-x-3">
                        <div class="w-6 h-6 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="fa-solid fa-history text-purple-600 text-xs"></i>
                        </div>
                        <div>
                            <h4 class="text-sm font-medium text-gray-900">Keep History</h4>
                            <p class="text-xs text-gray-600 mt-1">Existing contacts and tasks will remain unchanged after editing.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-bolt mr-2 text-yellow-600"></i>
                        Quick Actions
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-3">
                    <a class="btn btn-outline-primary w-full justify-center" href="/CRM/Accounts/Details?id=@Model.Id">
                        <i class="fa-solid fa-eye mr-2"></i>View Account Details
                    </a>
                    <a class="btn btn-outline-success w-full justify-center" href="/CRM/Contacts/Create?accountId=@Model.Id">
                        <i class="fa-solid fa-user-plus mr-2"></i>Add Contact
                    </a>
                    <a class="btn btn-outline-info w-full justify-center" href="/CRM/Tasks/Create?accountId=@Model.Id">
                        <i class="fa-solid fa-plus mr-2"></i>Create Task
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Character counter for notes
        document.addEventListener('DOMContentLoaded', function() {
            const notesTextarea = document.querySelector('textarea[name="Input.Notes"]');
            const characterCountElement = document.getElementById('characterCount');
            
            if (notesTextarea && characterCountElement) {
                function updateCharacterCount() {
                    const remaining = 2000 - notesTextarea.value.length;
                    characterCountElement.textContent = `${remaining} characters remaining`;
                    
                    // Color coding based on remaining characters
                    if (remaining < 100) {
                        characterCountElement.className = 'mt-1 text-xs text-red-500';
                    } else if (remaining < 200) {
                        characterCountElement.className = 'mt-1 text-xs text-yellow-600';
                    } else {
                        characterCountElement.className = 'mt-1 text-xs text-gray-500';
                    }
                }
                
                notesTextarea.addEventListener('input', updateCharacterCount);
                updateCharacterCount(); // Initial count
            }
        });
    </script>
}