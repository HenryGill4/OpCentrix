@page
@model OpCentrix.Pages.CRM.Accounts.IndexModel
@{
    ViewData["Title"] = "CRM Accounts";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Enhanced Header Section -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
                        <i class="fa-solid fa-building mr-3 text-blue-600"></i>
                        CRM Accounts
                    </h1>
                    <p class="mt-1 text-sm text-gray-600">Manage your customer accounts and relationships</p>
                </div>
                <div class="flex items-center space-x-3">
                    <a class="btn btn-success" href="/CRM/Accounts/Create">
                        <i class="fa-solid fa-plus mr-2"></i>New Account
                    </a>
                    <a class="btn btn-outline-primary" href="/CRM/Dashboard">
                        <i class="fa-solid fa-tachometer-alt mr-2"></i>CRM Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="px-6 py-5">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-building text-white"></i>
                        </div>
                        <div class="ml-3">
                            <div class="text-sm font-medium text-blue-700">Total Accounts</div>
                            <div class="text-lg font-bold text-blue-900">@Model.Accounts.Count</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-check-circle text-white"></i>
                        </div>
                        <div class="ml-3">
                            <div class="text-sm font-medium text-green-700">Active Accounts</div>
                            <div class="text-lg font-bold text-green-900">@Model.Accounts.Count(a => a.Status == "Active")</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-tasks text-white"></i>
                        </div>
                        <div class="ml-3">
                            <div class="text-sm font-medium text-yellow-700">With Tasks</div>
                            <div class="text-lg font-bold text-yellow-900">@Model.AccountsWithTasks</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-users text-white"></i>
                        </div>
                        <div class="ml-3">
                            <div class="text-sm font-medium text-purple-700">With Contacts</div>
                            <div class="text-lg font-bold text-purple-900">@Model.AccountsWithContacts</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Search and Filter Section -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                <i class="fa-solid fa-search mr-2 text-gray-600"></i>
                Search & Filter
            </h3>
        </div>
        <div class="px-6 py-6">
            <form method="get" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Search Accounts</label>
                        <div class="relative">
                            <input class="form-control pl-10" type="text" name="q" value="@Model.Query" 
                                   placeholder="Search by name, status, or notes..." />
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-search text-gray-400"></i>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Status Filter</label>
                        <select class="form-select" name="status">
                            <option value="">All Statuses</option>
                            <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                            <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                            <option value="Prospect" selected="@(Model.StatusFilter == "Prospect")">Prospect</option>
                            <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                        <select class="form-select" name="sortBy">
                            <option value="name" selected="@(Model.SortBy == "name")">Name (A-Z)</option>
                            <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z-A)</option>
                            <option value="created" selected="@(Model.SortBy == "created")">Recently Created</option>
                            <option value="updated" selected="@(Model.SortBy == "updated")">Recently Updated</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <button class="btn btn-primary" type="submit">
                        <i class="fa-solid fa-search mr-2"></i>Search
                    </button>
                    <a class="btn btn-outline-secondary" href="/CRM/Accounts">
                        <i class="fa-solid fa-times mr-2"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Enhanced Accounts List -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                    <i class="fa-solid fa-list mr-2 text-gray-600"></i>
                    Accounts
                    @if (Model.Accounts.Any())
                    {
                        <span class="ml-2 px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full font-medium">
                            @Model.Accounts.Count account@(Model.Accounts.Count == 1 ? "" : "s")
                        </span>
                    }
                </h3>
            </div>
        </div>
        
        <div class="overflow-hidden">
            @if (Model.Accounts.Any())
            {
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Account Information
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Status & Activity
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Relationships
                            </th>
                            <th class="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider" style="width:180px;">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var account in Model.Accounts)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-start space-x-3">
                                        <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm flex-shrink-0">
                                            <span class="text-white text-sm font-bold">
                                                @account.Name.Take(2).Aggregate("", (acc, c) => acc + c).ToUpper()
                                            </span>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-sm font-semibold text-gray-900 truncate">@account.Name</div>
                                            <div class="text-xs text-gray-500">Account ID: #@account.Id</div>
                                            @if (!string.IsNullOrEmpty(account.Notes))
                                            {
                                                <div class="text-xs text-gray-600 mt-1 truncate" title="@account.Notes">
                                                    @(account.Notes.Length > 50 ? account.Notes.Substring(0, 50) + "..." : account.Notes)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="space-y-2">
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @GetStatusBadgeClass(account.Status)">
                                            @(account.Status ?? "Unknown")
                                        </span>
                                        <div class="text-xs text-gray-500">
                                            Created: @account.CreatedDate.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="text-xs text-gray-500">
                                            Last Modified: @account.LastModifiedDate.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="space-y-2">
                                        <div class="flex items-center text-xs text-gray-600">
                                            <i class="fa-solid fa-users mr-1"></i>
                                            <span>@(Model.ContactCounts.GetValueOrDefault(account.Id, 0)) contact@(Model.ContactCounts.GetValueOrDefault(account.Id, 0) == 1 ? "" : "s")</span>
                                        </div>
                                        <div class="flex items-center text-xs text-gray-600">
                                            <i class="fa-solid fa-tasks mr-1"></i>
                                            <span>@(Model.TaskCounts.GetValueOrDefault(account.Id, 0)) task@(Model.TaskCounts.GetValueOrDefault(account.Id, 0) == 1 ? "" : "s")</span>
                                        </div>
                                        @if (Model.ActiveTaskCounts.GetValueOrDefault(account.Id, 0) > 0)
                                        {
                                            <div class="flex items-center text-xs text-orange-600 font-medium">
                                                <i class="fa-solid fa-exclamation-circle mr-1"></i>
                                                <span>@Model.ActiveTaskCounts[account.Id] active</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <div class="flex items-center justify-center space-x-2">
                                        <a class="btn btn-sm btn-outline-primary" href="/CRM/Accounts/Details?id=@account.Id"
                                           title="View account details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary" href="/CRM/Accounts/Edit?id=@account.Id"
                                           title="Edit account">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        <a class="btn btn-sm btn-success" href="/CRM/Tasks/Create?accountId=@account.Id"
                                           title="Create task for this account">
                                            <i class="fa-solid fa-plus"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-building text-gray-400 text-2xl"></i>
                    </div>
                    <h4 class="text-lg font-medium text-gray-900 mb-2">
                        @(string.IsNullOrEmpty(Model.Query) ? "No Accounts Yet" : "No Accounts Found")
                    </h4>
                    <p class="text-gray-600 mb-6">
                        @if (string.IsNullOrEmpty(Model.Query))
                        {
                            <text>Get started by creating your first customer account.</text>
                        }
                        else
                        {
                            <text>Try adjusting your search criteria or create a new account.</text>
                        }
                    </p>
                    <a class="btn btn-primary" href="/CRM/Accounts/Create">
                        <i class="fa-solid fa-plus mr-2"></i>Create First Account
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "active" => "bg-green-100 text-green-800",
        "inactive" => "bg-gray-100 text-gray-800", 
        "prospect" => "bg-blue-100 text-blue-800",
        "closed" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-800"
    };
}
