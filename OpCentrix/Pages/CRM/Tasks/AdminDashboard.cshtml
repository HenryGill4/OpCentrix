@page "/CRM/Tasks/Admin"
@model OpCentrix.Pages.CRM.Tasks.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Task Dashboard";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Header Section -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-users-gear text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Admin Task Dashboard</h1>
                    <p class="text-gray-600 mt-1">Monitor task progress, assignments, and team productivity</p>
                </div>
            </div>
            <div class="flex space-x-3">
                <a class="btn btn-outline-secondary" href="/CRM/Tasks/Create">
                    <i class="fa-solid fa-plus mr-2"></i>New Task
                </a>
                <a class="btn btn-outline-primary" href="/CRM/Alerts">
                    <i class="fa-solid fa-bell mr-2"></i>Alerts
                </a>
                <a class="btn btn-primary" href="/CRM/Tasks">
                    <i class="fa-solid fa-tasks mr-2"></i>All Tasks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-tasks text-blue-600"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Active Tasks</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.TotalActiveTasks</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-exclamation-triangle text-red-600"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Overdue</p>
                    <p class="text-2xl font-bold text-red-600">@Model.OverdueTasks</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-star text-yellow-600"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">High Priority</p>
                    <p class="text-2xl font-bold text-yellow-600">@Model.HighPriorityTasks</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-eye text-purple-600"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-600">Need Attention</p>
                    <p class="text-2xl font-bold text-purple-600">@Model.TasksNeedingAttention</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Overdue Tasks -->
        <div class="bg-white border rounded-lg">
            <div class="border-b px-6 py-4">
                <h3 class="text-lg font-semibold text-red-600">
                    <i class="fa-solid fa-exclamation-triangle mr-2"></i>Overdue Tasks (@Model.OverdueTasksList.Count)
                </h3>
            </div>
            <div class="max-h-96 overflow-y-auto">
                @if (Model.OverdueTasksList.Any())
                {
                    @foreach (var task in Model.OverdueTasksList)
                    {
                        <div class="border-b px-6 py-4 hover:bg-red-50">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h4 class="text-sm font-medium text-gray-900">@task.Title</h4>
                                    <p class="text-xs text-red-600 mt-1">
                                        Due: @task.DueAt?.ToString("MMM d, yyyy 'at' h:mm tt")
                                    </p>
                                    @if (task.AssignedToUserId.HasValue && task.AssignedToUser != null)
                                    {
                                        <p class="text-xs text-gray-500">
                                            Assigned to: @task.AssignedToUser.FullName
                                        </p>
                                    }
                                    @if (task.AssignedToUserId.HasValue && task.AssignedToUser == null)
                                    {
                                        <p class="text-xs text-gray-500">
                                            Assigned to: User @task.AssignedToUserId (User not found)
                                        </p>
                                    }
                                </div>
                                <div class="flex items-center space-x-2">
                                    <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full">
                                        Priority @task.Priority
                                    </span>
                                    <div class="flex space-x-1">
                                        <a href="/CRM/Tasks/Details?id=@task.Id" 
                                           class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 transition-colors"
                                           title="View task">
                                            <i class="fa-solid fa-eye mr-1"></i>View
                                        </a>
                                        <form method="post" asp-page-handler="SendReminder" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SendReminderTaskId" value="@task.Id" />
                                            <button type="submit" 
                                                    class="inline-flex items-center px-2 py-1 text-xs font-medium text-orange-600 bg-orange-50 border border-orange-200 rounded hover:bg-orange-100 transition-colors"
                                                    title="Send reminder">
                                                <i class="fa-solid fa-bell mr-1"></i>Remind
                                            </button>
                                        </form>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form method="post" asp-page-handler="DeleteTask" class="inline" 
                                                  onsubmit="return confirm('Are you sure you want to permanently delete this task? This action cannot be undone.')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="DeleteTaskId" value="@task.Id" />
                                                <button type="submit" 
                                                        class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded hover:bg-red-100 transition-colors"
                                                        title="Delete task">
                                                    <i class="fa-solid fa-trash mr-1"></i>Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-8 text-center text-gray-600">
                        <i class="fa-solid fa-check-circle text-green-500 text-3xl mb-4"></i>
                        <h4 class="text-lg font-medium text-gray-900 mb-2">No Overdue Tasks</h4>
                        <p>Great work! All tasks are on track.</p>
                    </div>
                }
            </div>
        </div>

        <!-- High Priority Tasks -->
        <div class="bg-white border rounded-lg">
            <div class="border-b px-6 py-4">
                <h3 class="text-lg font-semibold text-yellow-600">
                    <i class="fa-solid fa-star mr-2"></i>High Priority Tasks (@Model.HighPriorityTasksList.Count)
                </h3>
            </div>
            <div class="max-h-96 overflow-y-auto">
                @if (Model.HighPriorityTasksList.Any())
                {
                    @foreach (var task in Model.HighPriorityTasksList)
                    {
                        <div class="border-b px-6 py-4 hover:bg-yellow-50">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h4 class="text-sm font-medium text-gray-900">@task.Title</h4>
                                    @if (task.DueAt.HasValue)
                                    {
                                        <p class="text-xs text-yellow-600 mt-1">
                                            Due: @task.DueAt.Value.ToString("MMM d, yyyy 'at' h:mm tt")
                                        </p>
                                    }
                                    @if (task.AssignedToUserId.HasValue && task.AssignedToUser != null)
                                    {
                                        <p class="text-xs text-gray-500">
                                            Assigned to: @task.AssignedToUser.FullName
                                        </p>
                                    }
                                    @if (task.AssignedToUserId.HasValue && task.AssignedToUser == null)
                                    {
                                        <p class="text-xs text-gray-500">
                                            Assigned to: User @task.AssignedToUserId (User not found)
                                        </p>
                                    }
                                </div>
                                <div class="flex items-center space-x-2">
                                    <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full">
                                        Priority @task.Priority
                                    </span>
                                    <div class="flex space-x-1">
                                        <a href="/CRM/Tasks/Details?id=@task.Id" 
                                           class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 transition-colors"
                                           title="View task">
                                            <i class="fa-solid fa-eye mr-1"></i>View
                                        </a>
                                        <form method="post" asp-page-handler="SendReminder" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SendReminderTaskId" value="@task.Id" />
                                            <button type="submit" 
                                                    class="inline-flex items-center px-2 py-1 text-xs font-medium text-orange-600 bg-orange-50 border border-orange-200 rounded hover:bg-orange-100 transition-colors"
                                                    title="Send reminder">
                                                <i class="fa-solid fa-bell mr-1"></i>Remind
                                            </button>
                                        </form>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form method="post" asp-page-handler="DeleteTask" class="inline" 
                                                  onsubmit="return confirm('Are you sure you want to permanently delete this task? This action cannot be undone.')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="DeleteTaskId" value="@task.Id" />
                                                <button type="submit" 
                                                        class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded hover:bg-red-100 transition-colors"
                                                        title="Delete task">
                                                    <i class="fa-solid fa-trash mr-1"></i>Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-8 text-center text-gray-600">
                        <i class="fa-solid fa-star text-yellow-500 text-3xl mb-4"></i>
                        <h4 class="text-lg font-medium text-gray-900 mb-2">No High Priority Tasks</h4>
                        <p>No urgent tasks at the moment.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Progress Updates -->
        <div class="bg-white border rounded-lg">
            <div class="border-b px-6 py-4">
                <h3 class="text-lg font-semibold text-green-600">
                    <i class="fa-solid fa-chart-line mr-2"></i>Recent Progress Updates
                </h3>
            </div>
            <div class="max-h-96 overflow-y-auto">
                @if (Model.TasksWithRecentProgress.Any())
                {
                    @foreach (var progress in Model.TasksWithRecentProgress)
                    {
                        <div class="border-b px-6 py-4 hover:bg-green-50">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h4 class="text-sm font-medium text-gray-900">@progress.TaskTitle</h4>
                                    <p class="text-xs text-gray-600 mt-1">@progress.LastProgressNote</p>
                                    <div class="flex items-center space-x-2 mt-2">
                                        <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                                            @progress.ProgressCount updates
                                        </span>
                                        <span class="text-xs text-gray-500">
                                            by @progress.LastUpdatedBy
                                        </span>
                                        <span class="text-xs text-gray-500">
                                            @progress.LastProgressDate.ToString("MMM d, h:mm tt")
                                        </span>
                                    </div>
                                </div>
                                <a href="/CRM/Tasks/Details?id=@progress.TaskId" 
                                   class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 transition-colors"
                                   title="View task">
                                    <i class="fa-solid fa-eye mr-1"></i>View
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-8 text-center text-gray-600">
                        <i class="fa-solid fa-chart-line text-gray-300 text-3xl mb-4"></i>
                        <h4 class="text-lg font-medium text-gray-900 mb-2">No Recent Progress</h4>
                        <p>No progress updates in the past 7 days.</p>
                    </div>
                }
            </div>
        </div>

        <!-- User Assignment Summary -->
        <div class="bg-white border rounded-lg">
            <div class="border-b px-6 py-4">
                <h3 class="text-lg font-semibold text-blue-600">
                    <i class="fa-solid fa-users mr-2"></i>Team Workload
                </h3>
            </div>
            <div class="max-h-96 overflow-y-auto">
                @if (Model.UserAssignments.Any())
                {
                    @foreach (var assignment in Model.UserAssignments)
                    {
                        <div class="border-b px-6 py-4 hover:bg-blue-50 transition-colors">
                            <div class="flex items-center justify-between">
                                <a href="/CRM/Tasks?assigneeId=@assignment.UserId" class="flex-1 block group">
                                    <h4 class="text-sm font-medium text-gray-900 group-hover:text-blue-600 transition-colors">
                                        @assignment.UserName
                                        <i class="fa-solid fa-external-link text-xs ml-1 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                                    </h4>
                                    <div class="flex items-center space-x-3 mt-2">
                                        <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                                            @assignment.TaskCount tasks
                                        </span>
                                        @if (assignment.OverdueCount > 0)
                                        {
                                            <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full">
                                                @assignment.OverdueCount overdue
                                            </span>
                                        }
                                        @if (assignment.HighPriorityCount > 0)
                                        {
                                            <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full">
                                                @assignment.HighPriorityCount high priority
                                            </span>
                                        }
                                    </div>
                                    <p class="text-xs text-gray-500 mt-1">
                                        Last activity: @assignment.LastActivityDate.ToString("MMM d, yyyy")
                                    </p>
                                </a>
                                <div class="flex space-x-2 ml-4">
                                    <a href="/CRM/Tasks?assigneeId=@assignment.UserId" 
                                       class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 transition-colors"
                                       title="View all user's tasks">
                                        <i class="fa-solid fa-tasks mr-1"></i>All
                                    </a>
                                    <a href="/CRM/Tasks?assigneeId=@assignment.UserId&status=Open" 
                                       class="inline-flex items-center px-2 py-1 text-xs font-medium text-green-600 bg-green-50 border border-green-200 rounded hover:bg-green-100 transition-colors"
                                       title="View user's open tasks">
                                        <i class="fa-solid fa-list mr-1"></i>Open
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-8 text-center text-gray-600">
                        <i class="fa-solid fa-users text-gray-300 text-3xl mb-4"></i>
                        <h4 class="text-lg font-medium text-gray-900 mb-2">No Assigned Tasks</h4>
                        <p>No tasks are currently assigned to users.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>