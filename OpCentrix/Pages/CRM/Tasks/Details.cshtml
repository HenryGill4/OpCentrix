@page
@model OpCentrix.Pages.CRM.Tasks.DetailsModel
@{
    ViewData["Title"] = "Task Details - " + (Model.TaskEntity?.Title ?? "Task");
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Enhanced Header Section -->
    <div class="bg-white border rounded-lg shadow-sm">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center space-x-3 mb-2">
                        <h1 class="text-2xl font-bold text-gray-900 truncate">@Model.TaskEntity?.Title</h1>
                        <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full @GetStatusBadgeClass(Model.TaskEntity?.Status)">
                            @GetStatusDisplayName(Model.TaskEntity?.Status)
                        </span>
                        <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @GetPriorityBadgeClass(Model.TaskEntity?.Priority ?? 3)">
                            @GetPriorityLabel(Model.TaskEntity?.Priority ?? 3)
                        </span>
                    </div>
                    <div class="flex items-center space-x-4 text-sm text-gray-600">
                        <span class="flex items-center">
                            <i class="fa-solid fa-hashtag mr-1"></i>
                            Task #@Model.Id
                        </span>
                        @if (Model.TaskEntity?.DueAt.HasValue == true)
                        {
                            var isOverdue = Model.TaskEntity.DueAt < DateTime.Now && Model.TaskEntity.Status != "Completed";
                            <span class="flex items-center @(isOverdue ? "text-red-600 font-medium" : "")">
                                <i class="fa-solid fa-calendar mr-1"></i>
                                Due @Model.TaskEntity.DueAt.Value.ToString("MMM dd, yyyy")
                                @if (isOverdue)
                                {
                                    <span class="ml-2 px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full font-bold">OVERDUE</span>
                                }
                            </span>
                        }
                        <span class="flex items-center">
                            <i class="fa-solid fa-calendar-plus mr-1"></i>
                            Created @Model.TaskEntity?.CreatedDate.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="flex items-center space-x-2">
                    <a class="btn btn-light" href="/CRM/Tasks">
                        <i class="fa-solid fa-arrow-left mr-2"></i>Back to Tasks
                    </a>
                    @if (Model.TaskEntity?.HasReminder == true && Model.TaskEntity?.Status != "Completed")
                    {
                        <form method="post" asp-page-handler="TestReminder" class="inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-info" type="submit" title="Send a test reminder notification">
                                <i class="fa-solid fa-bell mr-2"></i>Test Reminder
                            </button>
                        </form>
                    }
                    @if (Model.TaskEntity?.Status != "Completed")
                    {
                        <form method="post" asp-page-handler="Complete" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-success" type="submit">
                                <i class="fa-solid fa-check mr-2"></i>Mark Complete
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
        
        <!-- Task Overview Cards -->
        <div class="px-6 py-5">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Assignee Card -->
                <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                    <div class="flex items-center space-x-3">
                        @if (Model.TaskEntity?.AssignedToUserId.HasValue == true)
                        {
                            var assignedUser = Model.Users.FirstOrDefault(u => u.Id == Model.TaskEntity.AssignedToUserId);
                            if (assignedUser != null)
                            {
                                var nameParts = assignedUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                var initials = nameParts.Length >= 2 
                                    ? $"{nameParts[0].FirstOrDefault()}{nameParts[1].FirstOrDefault()}" 
                                    : nameParts.FirstOrDefault()?.FirstOrDefault().ToString() ?? "U";
                                
                                <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm">
                                    <span class="text-white text-sm font-bold">@initials</span>
                                </div>
                                <div>
                                    <div class="text-sm font-medium text-blue-700">Assigned To</div>
                                    <div class="text-sm font-semibold text-blue-900">@assignedUser.FullName</div>
                                    <div class="text-xs text-blue-600">@assignedUser.Role</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                                <i class="fa-solid fa-user-slash text-gray-500"></i>
                            </div>
                            <div>
                                <div class="text-sm font-medium text-gray-600">Assigned To</div>
                                <div class="text-sm font-semibold text-gray-800">Unassigned</div>
                                <div class="text-xs text-gray-500">No assignee</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Account Card -->
                <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-building text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-green-700">Account</div>
                            @if (Model.TaskEntity?.AccountId.HasValue == true)
                            {
                                var account = Model.Accounts.FirstOrDefault(a => a.Id == Model.TaskEntity.AccountId);
                                <div class="text-sm font-semibold text-green-900">@(account?.Name ?? "Unknown Account")</div>
                                <div class="text-xs text-green-600">@(account?.Status ?? "Active")</div>
                            }
                            else
                            {
                                <div class="text-sm font-semibold text-gray-800">No Account</div>
                                <div class="text-xs text-gray-500">General task</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Progress Card -->
                <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-chart-line text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-purple-700">Progress</div>
                            <div class="text-sm font-semibold text-purple-900">@Model.ProgressEntries.Count update@(Model.ProgressEntries.Count == 1 ? "" : "s")</div>
                            @if (Model.ProgressEntries.Any())
                            {
                                var latestProgress = Model.ProgressEntries.OrderByDescending(p => p.CreatedDate).First();
                                <div class="text-xs text-purple-600">
                                    Latest: @latestProgress.CreatedDate.ToString("MMM dd")
                                    @if (latestProgress.PercentComplete.HasValue)
                                    {
                                        <span class="ml-1">(@latestProgress.PercentComplete% complete)</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-xs text-gray-500">No progress yet</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Timing Card -->
                <div class="bg-orange-50 rounded-lg p-4 border border-orange-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-clock text-white"></i>
                        </div>
                        <div>
                            <div class="text-sm font-medium text-orange-700">Timeline</div>
                            @if (Model.TaskEntity?.CompletedAt.HasValue == true)
                            {
                                var duration = Model.TaskEntity.CompletedAt.Value - Model.TaskEntity.CreatedDate;
                                <div class="text-sm font-semibold text-orange-900">Completed</div>
                                <div class="text-xs text-orange-600">Took @Math.Ceiling(duration.TotalDays) day@(duration.TotalDays > 1 ? "s" : "")</div>
                            }
                            else if (Model.TaskEntity?.DueAt.HasValue == true)
                            {
                                var remaining = Model.TaskEntity.DueAt.Value - DateTime.Now;
                                if (remaining.TotalDays > 0)
                                {
                                    <div class="text-sm font-semibold text-orange-900">@Math.Ceiling(remaining.TotalDays) day@(remaining.TotalDays > 1 ? "s" : "") left</div>
                                    <div class="text-xs text-orange-600">Until due date</div>
                                }
                                else
                                {
                                    <div class="text-sm font-semibold text-red-700">Overdue</div>
                                    <div class="text-xs text-red-600">@Math.Abs(Math.Floor(remaining.TotalDays)) day@(Math.Abs(remaining.TotalDays) > 1 ? "s" : "") past due</div>
                                }
                            }
                            else
                            {
                                var age = DateTime.Now - Model.TaskEntity.CreatedDate;
                                <div class="text-sm font-semibold text-orange-900">@Math.Ceiling(age.TotalDays) day@(age.TotalDays > 1 ? "s" : "") old</div>
                                <div class="text-xs text-orange-600">No due date set</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800 font-medium">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <!-- Left Column: Task Details Form -->
        <div class="xl:col-span-2 space-y-6">
            <!-- Task Details Card -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-edit mr-2 text-blue-600"></i>
                        Task Details
                    </h3>
                </div>
                <div class="px-6 py-6">
                    <form method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <!-- Title and Description -->
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    Title <span class="text-red-500">*</span>
                                </label>
                                <input class="form-control" asp-for="Input.Title" placeholder="Enter task title..." />
                                <span class="text-danger text-sm" asp-validation-for="Input.Title"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                                <textarea class="form-control" asp-for="Input.Description" rows="4" 
                                         placeholder="Provide details about this task..."></textarea>
                            </div>
                        </div>

                        <!-- Task Settings Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                                <select class="form-select" asp-for="Input.Status">
                                    <option value="Open">Open</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Priority (1-5)</label>
                                <select class="form-select" asp-for="Input.Priority">
                                    <option value="1">1 - Lowest Priority</option>
                                    <option value="2">2 - Low</option>
                                    <option value="3">3 - Normal</option>
                                    <option value="4">4 - High Priority</option>
                                    <option value="5">5 - Critical</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
                                <input class="form-control" asp-for="Input.DueAt" type="date" />
                            </div>
                        </div>

                        <!-- Assignment Settings -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    Related Account <span class="text-gray-500">(optional)</span>
                                </label>
                                <select class="form-select" asp-for="Input.AccountId">
                                    <option value="">Select an account...</option>
                                    @foreach (var a in Model.Accounts)
                                    {
                                        <option value="@a.Id">@a.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    Assign To <span class="text-gray-500">(optional)</span>
                                </label>
                                <select class="form-select" asp-for="Input.AssignedToUserId">
                                    <option value="">Leave unassigned...</option>
                                    @foreach (var u in Model.Users)
                                    {
                                        <option value="@u.Id">@u.FullName (@u.Role)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="border-t pt-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fa-solid fa-save mr-2"></i>Save Changes
                                    </button>
                                    <a class="btn btn-success" href="/CRM/Tasks/@Model.Id/AddProgress">
                                        <i class="fa-solid fa-plus mr-2"></i>Add Progress
                                    </a>
                                </div>
                                
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="DeleteTask" class="inline"
                                          onsubmit="return confirm('Are you sure you want to permanently delete this task and all its progress entries? This action cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-danger" type="submit">
                                            <i class="fa-solid fa-trash mr-2"></i>Delete Task
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Progress History Card -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-chart-line mr-2 text-green-600"></i>
                        Progress History
                        @if (Model.ProgressEntries.Any())
                        {
                            <span class="ml-2 px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full font-medium">
                                @Model.ProgressEntries.Count update@(Model.ProgressEntries.Count == 1 ? "" : "s")
                            </span>
                        }
                    </h3>
                    <a class="btn btn-success btn-sm" href="/CRM/Tasks/@Model.Id/AddProgress">
                        <i class="fa-solid fa-plus mr-1"></i>Add Progress
                    </a>
                </div>
                
                <div class="px-6 py-6">
                    @if (Model.ProgressEntries.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var progress in Model.ProgressEntries.OrderByDescending(p => p.CreatedDate))
                            {
                                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 hover:shadow-sm transition-shadow">
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1 min-w-0">
                                            <!-- Progress Header -->
                                            <div class="flex items-center space-x-2 mb-3 flex-wrap">
                                                <span class="inline-flex px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full font-medium">
                                                    @progress.ProgressType
                                                </span>
                                                @if (progress.PercentComplete.HasValue)
                                                {
                                                    <span class="inline-flex px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full font-medium">
                                                        @progress.PercentComplete% Complete
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(progress.Status))
                                                {
                                                    <span class="inline-flex px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full font-medium">
                                                        @progress.Status
                                                    </span>
                                                }
                                                @if (!progress.IsVisibleToClient)
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full font-medium">
                                                        <i class="fa-solid fa-lock mr-1"></i>Internal Only
                                                    </span>
                                                }
                                            </div>
                                            
                                            <!-- Progress Content -->
                                            <p class="text-gray-800 mb-3 leading-relaxed">@progress.ProgressNote</p>
                                            
                                            <!-- Progress Meta -->
                                            <div class="flex items-center text-sm text-gray-500 space-x-4">
                                                <span class="flex items-center">
                                                    <i class="fa-solid fa-user mr-1"></i>
                                                    @(progress.CreatedBy?.FullName ?? "Unknown User")
                                                </span>
                                                <span class="flex items-center">
                                                    <i class="fa-solid fa-calendar mr-1"></i>
                                                    @progress.CreatedDate.ToString("MMM d, yyyy 'at' h:mm tt")
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <!-- Delete Button -->
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <div class="flex-shrink-0 ml-4">
                                                <form method="post" asp-page-handler="DeleteProgress" class="inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this progress entry? This action cannot be undone.')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="DeleteProgressId" value="@progress.Id" />
                                                    <button type="submit" 
                                                            class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded hover:bg-red-100 transition-colors"
                                                            title="Delete progress entry">
                                                        <i class="fa-solid fa-trash mr-1"></i>Delete
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-12">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-chart-line text-gray-400 text-2xl"></i>
                            </div>
                            <h4 class="text-lg font-medium text-gray-900 mb-2">No Progress Updates Yet</h4>
                            <p class="text-gray-600 mb-6">Progress updates and status changes will appear here as they are added.</p>
                            <a class="btn btn-success" href="/CRM/Tasks/@Model.Id/AddProgress">
                                <i class="fa-solid fa-plus mr-2"></i>Add First Progress Entry
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Reminders & Notifications -->
        <div class="space-y-6">
            <!-- Reminder Settings Card -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-bell mr-2 text-amber-600"></i>
                        Reminder Settings
                    </h3>
                </div>
                <div class="px-6 py-6">
                    <form method="post" class="space-y-4" id="reminderForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <!-- Copy current values for other fields -->
                        <input type="hidden" asp-for="Input.Title" />
                        <input type="hidden" asp-for="Input.Description" />
                        <input type="hidden" asp-for="Input.Status" />
                        <input type="hidden" asp-for="Input.Priority" />
                        <input type="hidden" asp-for="Input.DueAt" />
                        <input type="hidden" asp-for="Input.AccountId" />
                        <input type="hidden" asp-for="Input.AssignedToUserId" />
                        
                        <!-- Enable Reminder -->
                        <div class="flex items-center space-x-3 p-3 bg-amber-50 rounded-lg border border-amber-200">
                            <input type="checkbox" asp-for="Input.HasReminder" class="form-check-input" id="hasReminder" />
                            <label for="hasReminder" class="form-check-label font-medium text-amber-800">
                                Enable reminder for this task
                            </label>
                        </div>
                        
                        <!-- Reminder Configuration -->
                        <div id="reminderSettings" class="space-y-4" style="@(Model.Input.HasReminder ? "" : "display: none;")">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Remind me</label>
                                <select class="form-select" asp-for="Input.ReminderMinutesBefore">
                                    <option value="5">5 minutes before due date</option>
                                    <option value="15">15 minutes before due date</option>
                                    <option value="30">30 minutes before due date</option>
                                    <option value="60">1 hour before due date</option>
                                    <option value="120">2 hours before due date</option>
                                    <option value="240">4 hours before due date</option>
                                    <option value="480">8 hours before due date</option>
                                    <option value="1440">1 day before due date</option>
                                    <option value="2880">2 days before due date</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Reminder Type</label>
                                <select class="form-select" asp-for="Input.ReminderType">
                                    <option value="Email">Email notification</option>
                                    <option value="Browser">Browser notification</option>
                                    <option value="Both">Both email and browser</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Current Reminder Status -->
                        @if (Model.TaskEntity?.HasReminder == true)
                        {
                            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                                <div class="flex items-start">
                                    <i class="fa-solid fa-bell text-blue-600 mr-3 mt-0.5"></i>
                                    <div>
                                        <p class="text-blue-800 font-medium mb-1">Reminder Active</p>
                                        <p class="text-blue-600 text-sm">
                                            @if (Model.TaskEntity.IsReminderSent)
                                            {
                                                <span><i class="fa-solid fa-check-circle text-green-600 mr-1"></i>Reminder sent @Model.TaskEntity.ReminderSentAt?.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                                            }
                                            else if (Model.TaskEntity.ReminderDateTime.HasValue)
                                            {
                                                <span><i class="fa-solid fa-calendar-check text-blue-600 mr-1"></i>Scheduled for @Model.TaskEntity.ReminderDateTime.Value.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                                            }
                                            else if (Model.TaskEntity.DueAt.HasValue)
                                            {
                                                <span><i class="fa-solid fa-clock text-amber-600 mr-1"></i>Will remind @Model.TaskEntity.ReminderMinutesBefore minutes before due date</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </form>
                </div>
            </div>

            <!-- Notification Preferences Card -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-envelope mr-2 text-green-600"></i>
                        Notification Preferences
                    </h3>
                </div>
                <div class="px-6 py-6">
                    <form method="post" class="space-y-4" id="notificationForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <!-- Copy current values for other fields -->
                        <input type="hidden" asp-for="Input.Title" />
                        <input type="hidden" asp-for="Input.Description" />
                        <input type="hidden" asp-for="Input.Status" />
                        <input type="hidden" asp-for="Input.Priority" />
                        <input type="hidden" asp-for="Input.DueAt" />
                        <input type="hidden" asp-for="Input.AccountId" />
                        <input type="hidden" asp-for="Input.AssignedToUserId" />
                        <input type="hidden" asp-for="Input.HasReminder" />
                        <input type="hidden" asp-for="Input.ReminderMinutesBefore" />
                        <input type="hidden" asp-for="Input.ReminderType" />
                        
                        <div class="space-y-3">
                            <div class="flex items-center space-x-3 p-3 bg-green-50 rounded-lg border border-green-200">
                                <input type="checkbox" asp-for="Input.NotifyOnStatusChange" class="form-check-input" id="notifyStatusChange" />
                                <label for="notifyStatusChange" class="form-check-label text-green-800">
                                    Notify when task status changes
                                </label>
                            </div>
                            
                            <div class="flex items-center space-x-3 p-3 bg-blue-50 rounded-lg border border-blue-200">
                                <input type="checkbox" asp-for="Input.NotifyAssignee" class="form-check-input" id="notifyAssignee" />
                                <label for="notifyAssignee" class="form-check-label text-blue-800">
                                    Notify assignee when task is assigned or updated
                                </label>
                            </div>
                            
                            <div class="flex items-center space-x-3 p-3 bg-purple-50 rounded-lg border border-purple-200">
                                <input type="checkbox" asp-for="Input.NotifyCreator" class="form-check-input" id="notifyCreator" />
                                <label for="notifyCreator" class="form-check-label text-purple-800">
                                    Notify task creator of important updates
                                </label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Task Meta Information -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-info-circle mr-2 text-gray-600"></i>
                        Task Information
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-4">
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Task ID</span>
                        <span class="text-sm font-medium text-gray-900">#@Model.Id</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b border-gray-100">
                        <span class="text-sm text-gray-600">Created</span>
                        <span class="text-sm font-medium text-gray-900">@Model.TaskEntity?.CreatedDate.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                    </div>
                    @if (Model.TaskEntity?.CompletedAt.HasValue == true)
                    {
                        <div class="flex items-center justify-between py-2 border-b border-gray-100">
                            <span class="text-sm text-gray-600">Completed</span>
                            <span class="text-sm font-medium text-green-700">@Model.TaskEntity.CompletedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                        </div>
                    }
                    <div class="flex items-center justify-between py-2">
                        <span class="text-sm text-gray-600">Last Updated</span>
                        <span class="text-sm font-medium text-gray-900">@(Model.ProgressEntries.Any() ? Model.ProgressEntries.OrderByDescending(p => p.CreatedDate).First().CreatedDate.ToString("MMM dd, yyyy") : "No updates")</span>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="bg-white border rounded-lg shadow-sm">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fa-solid fa-bolt mr-2 text-yellow-600"></i>
                        Quick Actions
                    </h3>
                </div>
                <div class="px-6 py-6 space-y-3">
                    <a class="btn btn-outline-primary w-full justify-center" href="/CRM/Alerts">
                        <i class="fa-solid fa-bell mr-2"></i>View All Alerts
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a class="btn btn-outline-secondary w-full justify-center" href="/CRM/Tasks/Admin">
                            <i class="fa-solid fa-users-gear mr-2"></i>Task Admin Dashboard
                        </a>
                    }
                    <a class="btn btn-outline-info w-full justify-center" href="/CRM/Tasks">
                        <i class="fa-solid fa-list mr-2"></i>All Tasks
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "open" => "bg-yellow-100 text-yellow-800",
        "inprogress" => "bg-blue-100 text-blue-800", 
        "completed" => "bg-green-100 text-green-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetStatusDisplayName(string? status) => status?.ToLower() switch
    {
        "open" => "Open",
        "inprogress" => "In Progress",
        "completed" => "Completed",
        _ => "Unknown"
    };

    private string GetPriorityBadgeClass(int priority) => priority switch
    {
        5 => "bg-red-100 text-red-800",
        4 => "bg-orange-100 text-orange-800",
        3 => "bg-blue-100 text-blue-800",
        2 => "bg-gray-100 text-gray-800",
        1 => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetPriorityLabel(int priority) => priority switch
    {
        5 => "Critical",
        4 => "High",
        3 => "Normal", 
        2 => "Low",
        1 => "Lowest",
        _ => "Normal"
    };
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Enhanced reminder settings toggle
        document.addEventListener('DOMContentLoaded', function() {
            const hasReminderCheckbox = document.getElementById('hasReminder');
            const reminderSettings = document.getElementById('reminderSettings');
            
            function toggleReminderSettings() {
                if (hasReminderCheckbox.checked) {
                    reminderSettings.style.display = 'block';
                    reminderSettings.classList.add('animate-fadeIn');
                } else {
                    reminderSettings.style.display = 'none';
                    reminderSettings.classList.remove('animate-fadeIn');
                }
            }
            
            // Initial state
            toggleReminderSettings();
            
            // Listen for changes
            hasReminderCheckbox.addEventListener('change', function() {
                toggleReminderSettings();
                // Auto-submit reminder form when toggled
                const form = document.getElementById('reminderForm');
                if (form) {
                    // Copy current main form values to hidden fields
                    copyFormValues();
                    form.submit();
                }
            });

            // Auto-submit notification preferences when changed
            const notificationCheckboxes = ['notifyStatusChange', 'notifyAssignee', 'notifyCreator'];
            notificationCheckboxes.forEach(id => {
                const checkbox = document.getElementById(id);
                if (checkbox) {
                    checkbox.addEventListener('change', function() {
                        const form = document.getElementById('notificationForm');
                        if (form) {
                            copyFormValues();
                            form.submit();
                        }
                    });
                }
            });

            // Auto-submit reminder settings when changed
            const reminderSelects = document.querySelectorAll('#reminderSettings select');
            reminderSelects.forEach(select => {
                select.addEventListener('change', function() {
                    const form = document.getElementById('reminderForm');
                    if (form) {
                        copyFormValues();
                        form.submit();
                    }
                });
            });

            function copyFormValues() {
                // Get values from main form and copy to hidden fields in other forms
                const mainForm = document.querySelector('form:not([id])'); // The main form without ID
                const titleValue = mainForm.querySelector('[name="Input.Title"]')?.value;
                const descValue = mainForm.querySelector('[name="Input.Description"]')?.value;
                const statusValue = mainForm.querySelector('[name="Input.Status"]')?.value;
                const priorityValue = mainForm.querySelector('[name="Input.Priority"]')?.value;
                const dueAtValue = mainForm.querySelector('[name="Input.DueAt"]')?.value;
                const accountIdValue = mainForm.querySelector('[name="Input.AccountId"]')?.value;
                const assignedToValue = mainForm.querySelector('[name="Input.AssignedToUserId"]')?.value;

                // Copy to reminder form
                const reminderForm = document.getElementById('reminderForm');
                if (reminderForm && titleValue) {
                    reminderForm.querySelector('[name="Input.Title"]').value = titleValue;
                    reminderForm.querySelector('[name="Input.Description"]').value = descValue || '';
                    reminderForm.querySelector('[name="Input.Status"]').value = statusValue || 'Open';
                    reminderForm.querySelector('[name="Input.Priority"]').value = priorityValue || '3';
                    reminderForm.querySelector('[name="Input.DueAt"]').value = dueAtValue || '';
                    reminderForm.querySelector('[name="Input.AccountId"]').value = accountIdValue || '';
                    reminderForm.querySelector('[name="Input.AssignedToUserId"]').value = assignedToValue || '';
                }

                // Copy to notification form
                const notificationForm = document.getElementById('notificationForm');
                if (notificationForm && titleValue) {
                    notificationForm.querySelector('[name="Input.Title"]').value = titleValue;
                    notificationForm.querySelector('[name="Input.Description"]').value = descValue || '';
                    notificationForm.querySelector('[name="Input.Status"]').value = statusValue || 'Open';
                    notificationForm.querySelector('[name="Input.Priority"]').value = priorityValue || '3';
                    notificationForm.querySelector('[name="Input.DueAt"]').value = dueAtValue || '';
                    notificationForm.querySelector('[name="Input.AccountId"]').value = accountIdValue || '';
                    notificationForm.querySelector('[name="Input.AssignedToUserId"]').value = assignedToValue || '';
                    
                    // Copy current reminder settings
                    const hasReminder = document.getElementById('hasReminder')?.checked || false;
                    const reminderMinutes = document.querySelector('[name="Input.ReminderMinutesBefore"]')?.value || '15';
                    const reminderType = document.querySelector('[name="Input.ReminderType"]')?.value || 'Email';
                    
                    notificationForm.querySelector('[name="Input.HasReminder"]').value = hasReminder;
                    notificationForm.querySelector('[name="Input.ReminderMinutesBefore"]').value = reminderMinutes;
                    notificationForm.querySelector('[name="Input.ReminderType"]').value = reminderType;
                }
            }
        });

        // Add smooth animations
        const style = document.createElement('style');
        style.textContent = `
            .animate-fadeIn {
                animation: fadeIn 0.3s ease-in-out;
            }
            @@keyframes fadeIn {
                from { opacity: 0; transform: translateY(-10px); }
                to { opacity: 1; transform: translateY(0); }
            }
        `;
        document.head.appendChild(style);
    </script>
}
