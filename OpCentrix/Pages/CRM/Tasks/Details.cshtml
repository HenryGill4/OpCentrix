@page
@model OpCentrix.Pages.CRM.Tasks.DetailsModel
@{
    ViewData["Title"] = "Task Details";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-3xl space-y-4">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Task: @Model.TaskEntity?.Title</h1>
        <div class="flex gap-2">
            <a class="btn btn-light" href="/CRM/Tasks">Back</a>
            <a class="btn btn-outline-secondary" href="/CRM/Alerts">View Alerts</a>
            @if (Model.TaskEntity?.HasReminder == true && Model.TaskEntity?.Status != "Completed")
            {
                <form method="post" asp-page-handler="TestReminder" class="inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-info btn-sm" type="submit" title="Send a test reminder notification">
                        <i class="fa-solid fa-bell mr-1"></i>Test Reminder
                    </button>
                </form>
            }
            @if (Model.TaskEntity?.Status != "Completed")
            {
                <form method="post" asp-page-handler="Complete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-success" type="submit">Mark Complete</button>
                </form>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <form method="post" class="space-y-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div>
            <label class="form-label">Title</label>
            <input class="form-control" asp-for="Input.Title" />
            <span class="text-danger" asp-validation-for="Input.Title"></span>
        </div>

        <div>
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Input.Description" rows="4"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
                <label class="form-label">Status</label>
                <select class="form-select" asp-for="Input.Status">
                    <option value="Open">Open</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            <div>
                <label class="form-label">Priority</label>
                <input class="form-control" asp-for="Input.Priority" type="number" min="1" max="5" />
            </div>
            <div>
                <label class="form-label">Due Date</label>
                <input class="form-control" asp-for="Input.DueAt" type="date" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="form-label">Account</label>
                <select class="form-select" asp-for="Input.AccountId">
                    <option value="">(none)</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Assignee</label>
                <select class="form-select" asp-for="Input.AssignedToUserId">
                    <option value="">(unassigned)</option>
                    @foreach (var u in Model.Users)
                    {
                        <option value="@u.Id">@u.FullName (@u.Role)</option>
                    }
                </select>
            </div>
        </div>

        <!-- Reminder Settings Section -->
        <div class="border rounded-lg p-4 bg-gray-50">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">
                <i class="fa-solid fa-bell mr-2"></i>Reminder Settings
            </h4>
            
            <div class="space-y-4">
                <!-- Enable Reminder -->
                <div class="flex items-center space-x-3">
                    <input type="checkbox" asp-for="Input.HasReminder" class="form-check-input" id="hasReminder" />
                    <label for="hasReminder" class="form-check-label font-medium">
                        Enable reminder for this task
                    </label>
                </div>
                
                <!-- Reminder Configuration (shown when enabled) -->
                <div id="reminderSettings" class="grid grid-cols-1 md:grid-cols-2 gap-4" style="@(Model.Input.HasReminder ? "" : "display: none;")">
                    <div>
                        <label class="form-label">Remind me</label>
                        <select class="form-select" asp-for="Input.ReminderMinutesBefore">
                            <option value="5">5 minutes before</option>
                            <option value="15">15 minutes before</option>
                            <option value="30">30 minutes before</option>
                            <option value="60">1 hour before</option>
                            <option value="120">2 hours before</option>
                            <option value="240">4 hours before</option>
                            <option value="480">8 hours before</option>
                            <option value="1440">1 day before</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Reminder Type</label>
                        <select class="form-select" asp-for="Input.ReminderType">
                            <option value="Email">Email</option>
                            <option value="Browser">Browser Notification</option>
                            <option value="Both">Email and Browser</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notification Preferences Section -->
        <div class="border rounded-lg p-4 bg-gray-50">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">
                <i class="fa-solid fa-envelope mr-2"></i>Notification Preferences
            </h4>
            
            <div class="space-y-3">
                <div class="flex items-center space-x-3">
                    <input type="checkbox" asp-for="Input.NotifyOnStatusChange" class="form-check-input" id="notifyStatusChange" />
                    <label for="notifyStatusChange" class="form-check-label">
                        Notify when task status changes
                    </label>
                </div>
                
                <div class="flex items-center space-x-3">
                    <input type="checkbox" asp-for="Input.NotifyAssignee" class="form-check-input" id="notifyAssignee" />
                    <label for="notifyAssignee" class="form-check-label">
                        Notify assignee when task is assigned or updated
                    </label>
                </div>
                
                <div class="flex items-center space-x-3">
                    <input type="checkbox" asp-for="Input.NotifyCreator" class="form-check-input" id="notifyCreator" />
                    <label for="notifyCreator" class="form-check-label">
                        Notify task creator of important updates
                    </label>
                </div>
            </div>
        </div>

        <div class="flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-success" href="/CRM/Tasks/@Model.Id/AddProgress">
                <i class="fa-solid fa-chart-line mr-2"></i>Add Progress
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a class="btn btn-outline-primary" href="/CRM/Tasks/Admin">
                    <i class="fa-solid fa-users-gear mr-2"></i>Admin Dashboard
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <form method="post" asp-page-handler="DeleteTask" class="inline"
                      onsubmit="return confirm('Are you sure you want to permanently delete this task and all its progress entries? This action cannot be undone.')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger" type="submit">
                        <i class="fa-solid fa-trash mr-2"></i>Delete Task
                    </button>
                </form>
            }
        </div>

        @if (Model.TaskEntity?.CompletedAt != null)
        {
            <div class="text-sm text-gray-600">Completed: @Model.TaskEntity.CompletedAt.Value.ToString("u")</div>
        }
        
        @if (Model.TaskEntity?.HasReminder == true)
        {
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex items-center">
                    <i class="fa-solid fa-bell text-blue-600 mr-2"></i>
                    <div>
                        <p class="text-blue-800 font-medium">Reminder Active</p>
                        <p class="text-blue-600 text-sm">
                            @if (Model.TaskEntity.IsReminderSent)
                            {
                                <span>Reminder sent @Model.TaskEntity.ReminderSentAt?.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                            }
                            else if (Model.TaskEntity.ReminderDateTime.HasValue)
                            {
                                <span>Reminder scheduled for @Model.TaskEntity.ReminderDateTime.Value.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                            }
                            else if (Model.TaskEntity.DueAt.HasValue)
                            {
                                <span>Will remind @Model.TaskEntity.ReminderMinutesBefore minutes before due date</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        }
    </form>
</div>

<!-- Progress History Section -->
<div class="p-6 max-w-5xl space-y-6">
    <div class="bg-white border rounded-lg">
        <div class="border-b px-6 py-4 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">
                <i class="fa-solid fa-chart-line mr-2"></i>Progress History
            </h3>
            <a class="btn btn-success" href="/CRM/Tasks/@Model.Id/AddProgress">
                <i class="fa-solid fa-plus mr-2"></i>Add Progress
            </a>
        </div>
        
        <!-- Progress History Display -->
        <div class="p-6">
            @if (Model.ProgressEntries.Any())
            {
                <div class="space-y-4">
                    @foreach (var progress in Model.ProgressEntries)
                    {
                        <div class="bg-gray-50 border rounded-lg p-4">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center space-x-2 mb-2">
                                        <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full font-medium">
                                            @progress.ProgressType
                                        </span>
                                        @if (progress.PercentComplete.HasValue)
                                        {
                                            <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full font-medium">
                                                @progress.PercentComplete% Complete
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(progress.Status))
                                        {
                                            <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full font-medium">
                                                Status: @progress.Status
                                            </span>
                                        }
                                        @if (!progress.IsVisibleToClient)
                                        {
                                            <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full font-medium">
                                                Internal Only
                                            </span>
                                        }
                                    </div>
                                    <p class="text-gray-800 mb-2">@progress.ProgressNote</p>
                                    <div class="flex items-center text-sm text-gray-500">
                                        <i class="fa-solid fa-user mr-1"></i>
                                        <span class="mr-3">@(progress.CreatedBy?.FullName ?? "Unknown User")</span>
                                        <i class="fa-solid fa-calendar mr-1"></i>
                                        <span>@progress.CreatedDate.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                                    </div>
                                </div>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <div class="flex-shrink-0 ml-4">
                                        <form method="post" asp-page-handler="DeleteProgress" class="inline"
                                              onsubmit="return confirm('Are you sure you want to delete this progress entry? This action cannot be undone.')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="DeleteProgressId" value="@progress.Id" />
                                            <button type="submit" 
                                                    class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded hover:bg-red-100 transition-colors"
                                                    title="Delete progress entry">
                                                <i class="fa-solid fa-trash mr-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i class="fa-solid fa-chart-line text-gray-300 text-3xl mb-4"></i>
                    <h4 class="text-lg font-medium text-gray-900 mb-2">No Progress Entries Yet</h4>
                    <p class="text-gray-600 mb-4">Progress updates will appear here as they are added.</p>
                    <a class="btn btn-success" href="/CRM/Tasks/@Model.Id/AddProgress">
                        <i class="fa-solid fa-plus mr-2"></i>Add First Progress Entry
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show/hide reminder settings based on checkbox
        document.addEventListener('DOMContentLoaded', function() {
            const hasReminderCheckbox = document.getElementById('hasReminder');
            const reminderSettings = document.getElementById('reminderSettings');
            
            function toggleReminderSettings() {
                if (hasReminderCheckbox.checked) {
                    reminderSettings.style.display = 'grid';
                } else {
                    reminderSettings.style.display = 'none';
                }
            }
            
            // Initial state
            toggleReminderSettings();
            
            // Listen for changes
            hasReminderCheckbox.addEventListener('change', toggleReminderSettings);
        });
    </script>
}
