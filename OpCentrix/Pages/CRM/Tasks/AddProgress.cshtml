@page "/CRM/Tasks/{id:int}/AddProgress"
@model OpCentrix.Pages.CRM.Tasks.AddProgressModel
@{
    ViewData["Title"] = $"Add Progress - {Model.TaskEntity?.Title}";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-4xl mx-auto space-y-6">
    <!-- Header Section -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-teal-600 rounded-lg flex items-center justify-center mr-4">
                    <i class="fa-solid fa-chart-line text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Add Progress Update</h1>
                    <p class="text-gray-600 mt-1">Task: @Model.TaskEntity?.Title</p>
                </div>
            </div>
            <div class="flex space-x-3">
                <a class="btn btn-outline-secondary" href="/CRM/Tasks/Details?id=@Model.Id">
                    <i class="fa-solid fa-arrow-left mr-2"></i>Back to Task
                </a>
                <a class="btn btn-primary" href="/CRM/Tasks">
                    <i class="fa-solid fa-tasks mr-2"></i>All Tasks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Task Summary -->
    <div class="bg-white border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">
            <i class="fa-solid fa-info-circle mr-2"></i>Task Information
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-600">Task Title</label>
                <p class="text-gray-900 font-medium">@Model.TaskEntity?.Title</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Current Status</label>
                <span class="inline-flex px-2 py-1 bg-blue-100 text-blue-800 text-sm rounded-full">
                    @Model.TaskEntity?.Status
                </span>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Priority</label>
                <span class="inline-flex px-2 py-1 bg-yellow-100 text-yellow-800 text-sm rounded-full">
                    Priority @Model.TaskEntity?.Priority
                </span>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Due Date</label>
                <p class="text-gray-900">
                    @if (Model.TaskEntity?.DueAt.HasValue == true)
                    {
                        @Model.TaskEntity.DueAt.Value.ToString("MMM d, yyyy 'at' h:mm tt")
                    }
                    else
                    {
                        <span class="text-gray-400">No due date set</span>
                    }
                </p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.TaskEntity?.Description))
        {
            <div class="mt-4">
                <label class="block text-sm font-medium text-gray-600">Description</label>
                <p class="text-gray-900 mt-1">@Model.TaskEntity.Description</p>
            </div>
        }
    </div>

    <!-- Progress Form -->
    <div class="bg-white border rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-6">
            <i class="fa-solid fa-plus mr-2"></i>Add Progress Update
        </h3>
        
        <form method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div>
                <label class="form-label" asp-for="Input.ProgressNote">Progress Note *</label>
                <textarea class="form-control" asp-for="Input.ProgressNote" rows="4" 
                         placeholder="Describe your progress on this task..." required></textarea>
                <span class="text-danger" asp-validation-for="Input.ProgressNote"></span>
                <p class="text-sm text-gray-500 mt-1">Provide a detailed update on what you've accomplished.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="form-label" asp-for="Input.PercentComplete">Completion Percentage</label>
                    <input class="form-control" asp-for="Input.PercentComplete" type="number" min="0" max="100" 
                           placeholder="0-100" />
                    <span class="text-danger" asp-validation-for="Input.PercentComplete"></span>
                    <p class="text-sm text-gray-500 mt-1">Optional: How much of the task is complete?</p>
                </div>
                
                <div>
                    <label class="form-label" asp-for="Input.ProgressType">Progress Type</label>
                    <select class="form-select" asp-for="Input.ProgressType">
                        <option value="Update">Update</option>
                        <option value="Milestone">Milestone</option>
                        <option value="Issue">Issue</option>
                        <option value="Resolution">Resolution</option>
                    </select>
                    <p class="text-sm text-gray-500 mt-1">What type of progress update is this?</p>
                </div>
                
                <div>
                    <label class="form-label" asp-for="Input.Status">Status Change (Optional)</label>
                    <select class="form-select" asp-for="Input.Status">
                        <option value="">No Change</option>
                        <option value="Open">Open</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <p class="text-sm text-gray-500 mt-1">Update task status if needed.</p>
                </div>
            </div>
            
            <div class="flex items-center">
                <input type="checkbox" class="form-check-input" asp-for="Input.IsVisibleToClient" id="isVisibleToClient" />
                <label for="isVisibleToClient" class="form-check-label ml-2">
                    <span class="font-medium">Visible to client</span>
                    <p class="text-sm text-gray-500">Uncheck if this is an internal-only update</p>
                </label>
            </div>
            
            <div class="flex gap-3 pt-4 border-t">
                <button class="btn btn-success" type="submit">
                    <i class="fa-solid fa-plus mr-2"></i>Add Progress Entry
                </button>
                <a class="btn btn-outline-secondary" href="/CRM/Tasks/Details?id=@Model.Id">
                    <i class="fa-solid fa-times mr-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}