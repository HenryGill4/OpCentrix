@page
@model OpCentrix.Pages.CRM.Tasks.CreateModel
@{
    ViewData["Title"] = "Create Task";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Header Section -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Create New Task</h1>
                <p class="text-gray-600 mt-1">Add a new task to track and manage customer activities</p>
            </div>
            <a class="btn btn-light" href="/CRM/Tasks">
                <i class="fa-solid fa-arrow-left mr-2"></i>Back to Tasks
            </a>
        </div>
    </div>

    <!-- Form Section -->
    <div class="bg-white border rounded-lg p-6">
        <form method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            
            <!-- Basic Information -->
            <div class="border-b pb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Title <span class="text-red-500">*</span></label>
                        <input class="form-control" asp-for="Input.Title" placeholder="Enter task title..." />
                        <span class="text-danger text-sm" asp-validation-for="Input.Title"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <textarea class="form-control" asp-for="Input.Description" rows="4" placeholder="Provide details about this task..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Task Details -->
            <div class="border-b pb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Task Details</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Priority (1-5)</label>
                        <select class="form-select" asp-for="Input.Priority">
                            <option value="1">1 - Low Priority</option>
                            <option value="2">2 - Normal</option>
                            <option value="3" selected>3 - Medium (Default)</option>
                            <option value="4">4 - High Priority</option>
                            <option value="5">5 - Critical</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
                        <input class="form-control" asp-for="Input.DueAt" type="date" />
                    </div>
                </div>
            </div>

            <!-- Assignments -->
            <div class="border-b pb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Assignments</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Related Account <span class="text-gray-500">(optional)</span></label>
                        <select class="form-select" asp-for="Input.AccountId">
                            <option value="">Select an account...</option>
                            @foreach (var a in Model.Accounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Assign To <span class="text-gray-500">(optional)</span></label>
                        <select class="form-select" asp-for="Input.AssignedToUserId">
                            <option value="">Leave unassigned...</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.FullName (@u.Role)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Reminders & Notifications -->
            <div class="border-b pb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">
                    <i class="fa-solid fa-bell mr-2"></i>Reminders & Notifications
                </h3>
                
                <div class="space-y-4">
                    <!-- Reminder Settings -->
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="flex items-center mb-3">
                            <input type="checkbox" class="form-check-input" asp-for="Input.HasReminder" id="hasReminder" onchange="toggleReminderSettings()" />
                            <label class="form-check-label ml-2 font-medium" for="hasReminder">
                                Set reminder for this task
                            </label>
                        </div>
                        
                        <div id="reminderSettings" class="space-y-3" style="display: none;">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Remind me</label>
                                    <select class="form-select" asp-for="Input.ReminderMinutesBefore">
                                        <option value="5">5 minutes before due date</option>
                                        <option value="15" selected>15 minutes before due date</option>
                                        <option value="30">30 minutes before due date</option>
                                        <option value="60">1 hour before due date</option>
                                        <option value="240">4 hours before due date</option>
                                        <option value="1440">1 day before due date</option>
                                        <option value="2880">2 days before due date</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Reminder type</label>
                                    <select class="form-select" asp-for="Input.ReminderType">
                                        <option value="Email">Email notification</option>
                                        <option value="Browser">Browser notification</option>
                                        <option value="Both">Both email and browser</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notification Preferences -->
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-medium text-gray-900 mb-3">Notification Preferences</h4>
                        <div class="space-y-2">
                            <div class="flex items-center">
                                <input type="checkbox" class="form-check-input" asp-for="Input.NotifyOnStatusChange" checked />
                                <label class="form-check-label ml-2 text-sm">Notify when task status changes</label>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" class="form-check-input" asp-for="Input.NotifyAssignee" checked />
                                <label class="form-check-label ml-2 text-sm">Notify assignee when task is created or updated</label>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" class="form-check-input" asp-for="Input.NotifyCreator" checked />
                                <label class="form-check-label ml-2 text-sm">Notify task creator of important updates</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 pt-6 border-t">
                <a class="btn btn-light" href="/CRM/Tasks">Cancel</a>
                <button class="btn btn-primary" type="submit">
                    <i class="fa-solid fa-save mr-2"></i>Create Task
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function toggleReminderSettings() {
            const checkbox = document.getElementById('hasReminder');
            const settings = document.getElementById('reminderSettings');
            
            if (checkbox.checked) {
                settings.style.display = 'block';
            } else {
                settings.style.display = 'none';
            }
        }

        // Initialize reminder settings visibility on page load
        document.addEventListener('DOMContentLoaded', function() {
            toggleReminderSettings();
        });
    </script>
}
