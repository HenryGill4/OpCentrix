@page
@model OpCentrix.Pages.CRM.Tasks.IndexModel
@{
    ViewData["Title"] = "Tasks";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Header Section with Statistics -->
    <div class="bg-white border rounded-lg p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">
                    Tasks Management
                    @if (Model.AssigneeFilter.HasValue)
                    {
                        var assignee = Model.Assignees.FirstOrDefault(a => a.Id == Model.AssigneeFilter.Value);
                        if (assignee != null)
                        {
                            <span class="text-lg text-blue-600 font-medium">for @assignee.FullName</span>
                        }
                    }
                </h1>
                <p class="text-gray-600 mt-1">
                    @if (Model.AssigneeFilter.HasValue)
                    {
                        var assignee = Model.Assignees.FirstOrDefault(a => a.Id == Model.AssigneeFilter.Value);
                        if (assignee != null)
                        {
                            <text>Personal task dashboard for @assignee.FullName (@assignee.Role)</text>
                        }
                    }
                    else
                    {
                        <text>Comprehensive task management and collaboration platform</text>
                    }
                </p>
            </div>
            <div class="flex space-x-3">
                @if (Model.AssigneeFilter.HasValue)
                {
                    <a class="btn btn-outline-secondary" href="/CRM/Tasks">
                        <i class="fa-solid fa-arrow-left mr-2"></i>All Tasks
                    </a>
                }
                <a class="btn btn-primary" href="/CRM/Tasks/Create">
                    <i class="fa-solid fa-plus mr-2"></i>New Task
                </a>
                <a class="btn btn-outline-primary" href="/CRM/Alerts">
                    <i class="fa-solid fa-bell mr-2"></i>Alerts
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a class="btn btn-outline-success" href="/CRM/Tasks/Admin">
                        <i class="fa-solid fa-users-gear mr-2"></i>Admin Dashboard
                    </a>
                }
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4 mb-6">
            <a href="/CRM/Tasks" class="stat-card bg-blue-50 border border-blue-200 rounded-lg p-4 text-center hover:bg-blue-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-blue-600">@Model.Statistics.TotalTasks</div>
                <div class="text-sm text-blue-700">Total Tasks</div>
            </a>
            <a href="/CRM/Tasks?status=Open" class="stat-card bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-center hover:bg-yellow-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-yellow-600">@Model.Statistics.OpenTasks</div>
                <div class="text-sm text-yellow-700">Open</div>
            </a>
            <a href="/CRM/Tasks?status=InProgress" class="stat-card bg-green-50 border border-green-200 rounded-lg p-4 text-center hover:bg-green-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-green-600">@Model.Statistics.InProgressTasks</div>
                <div class="text-sm text-green-700">In Progress</div>
            </a>
            <a href="/CRM/Tasks?status=Completed" class="stat-card bg-gray-50 border border-gray-200 rounded-lg p-4 text-center hover:bg-gray-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-gray-600">@Model.Statistics.CompletedTasks</div>
                <div class="text-sm text-gray-700">Completed</div>
            </a>
            <a href="/CRM/Tasks?overdue=true" class="stat-card bg-red-50 border border-red-200 rounded-lg p-4 text-center hover:bg-red-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-red-600">@Model.Statistics.OverdueTasks</div>
                <div class="text-sm text-red-700">Overdue</div>
            </a>
            <a href="/CRM/Tasks?priority=4&priority=5" class="stat-card bg-orange-50 border border-orange-200 rounded-lg p-4 text-center hover:bg-orange-100 transition-colors cursor-pointer">
                <div class="text-2xl font-bold text-orange-600">@Model.Statistics.HighPriorityTasks</div>
                <div class="text-sm text-orange-700">High Priority</div>
            </a>
            <a href="/CRM/Tasks" class="stat-card bg-purple-50 border border-purple-200 rounded-lg p-4 text-center hover:bg-purple-100 transition-colors cursor-pointer" 
               onclick="filterTasksDueToday(event)">
                <div class="text-2xl font-bold text-purple-600">@Model.Statistics.TasksDueToday</div>
                <div class="text-sm text-purple-700">Due Today</div>
            </a>
            <a href="/CRM/Tasks" class="stat-card bg-indigo-50 border border-indigo-200 rounded-lg p-4 text-center hover:bg-indigo-100 transition-colors cursor-pointer"
               onclick="filterTasksDueThisWeek(event)">
                <div class="text-2xl font-bold text-indigo-600">@Model.Statistics.TasksDueThisWeek</div>
                <div class="text-sm text-indigo-700">Due This Week</div>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fa-solid fa-check-circle text-green-600 mr-2"></i>
                <span class="text-green-800">@Model.StatusMessage</span>
            </div>
        </div>
    }

    <!-- Enhanced Filters Section -->
    <div class="bg-white border rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">
            <i class="fa-solid fa-filter mr-2"></i>Filter & Search Tasks
        </h3>
        <form method="get" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 items-end">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                <select class="form-select" name="status">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter) ? "selected" : null)">All Statuses</option>
                    <option value="Open" selected="@(Model.StatusFilter=="Open" ? "selected" : null)">Open</option>
                    <option value="InProgress" selected="@(Model.StatusFilter=="InProgress" ? "selected" : null)">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter=="Completed" ? "selected" : null)">Completed</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Assignee</label>
                <select class="form-select" name="assignee">
                    <option value="" selected="@(Model.AssigneeFilter == null ? "selected" : null)">All Assignees</option>
                    @foreach (var u in Model.Assignees)
                    {
                        <option value="@u.Id" selected="@(Model.AssigneeFilter==u.Id ? "selected" : null)">@u.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Priority</label>
                <select class="form-select" name="priority">
                    <option value="" selected="@(Model.PriorityFilter == null ? "selected" : null)">All Priorities</option>
                    <option value="1" selected="@(Model.PriorityFilter==1 ? "selected" : null)">Lowest (1)</option>
                    <option value="2" selected="@(Model.PriorityFilter==2 ? "selected" : null)">Low (2)</option>
                    <option value="3" selected="@(Model.PriorityFilter==3 ? "selected" : null)">Normal (3)</option>
                    <option value="4" selected="@(Model.PriorityFilter==4 ? "selected" : null)">High (4)</option>
                    <option value="5" selected="@(Model.PriorityFilter==5 ? "selected" : null)">Critical (5)</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Account</label>
                <select class="form-select" name="account">
                    <option value="" selected="@(Model.AccountFilter == null ? "selected" : null)">All Accounts</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Id" selected="@(Model.AccountFilter==a.Id ? "selected" : null)">@a.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Quick Filters</label>
                <div class="flex items-center">
                    <input type="checkbox" name="overdue" value="true" @(Model.OverdueFilter == true ? "checked" : "") class="form-check-input mr-2" id="overdueCheck">
                    <label for="overdueCheck" class="text-sm text-red-600 font-medium">Overdue Only</label>
                </div>
            </div>
            <div>
                <button class="btn btn-primary w-full" type="submit">
                    <i class="fa-solid fa-search mr-2"></i>Apply Filters
                </button>
            </div>
        </form>
        <div class="mt-3 flex space-x-2">
            <a class="btn btn-outline-secondary btn-sm" href="/CRM/Tasks">
                <i class="fa-solid fa-times mr-1"></i>Clear All
            </a>
            <a class="btn btn-outline-info btn-sm" href="/CRM/Tasks?overdue=true">
                <i class="fa-solid fa-exclamation-triangle mr-1"></i>Show Overdue
            </a>
            <a class="btn btn-outline-warning btn-sm" href="/CRM/Tasks?status=Open">
                <i class="fa-solid fa-clock mr-1"></i>Show Open
            </a>
        </div>
    </div>

    <!-- Enhanced Tasks Display by User Cards -->
    <div class="space-y-6">
        @if (Model.UserTaskCards.Any() || Model.UnassignedTasks.Any())
        {
            <!-- User Task Cards -->
            @foreach (var userCard in Model.UserTaskCards)
            {
                <div class="bg-white border rounded-lg overflow-hidden shadow-sm">
                    <!-- User Card Header -->
                    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-b px-6 py-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <!-- User Avatar -->
                                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center shadow-lg">
                                    <span class="text-white text-lg font-bold">
                                        @{
                                            var nameParts = userCard.User.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                            var initials = nameParts.Length >= 2 
                                                ? $"{nameParts[0].FirstOrDefault()}{nameParts[1].FirstOrDefault()}" 
                                                : nameParts.FirstOrDefault()?.FirstOrDefault().ToString() ?? "U";
                                        }
                                        @initials
                                    </span>
                                </div>
                                
                                <!-- User Info -->
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">@userCard.User.FullName</h3>
                                    <p class="text-sm text-gray-600">@userCard.User.Role</p>
                                </div>
                            </div>
                            
                            <!-- Task Summary Badges -->
                            <div class="flex items-center space-x-2">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    @userCard.TaskCounts.Total Total
                                </span>
                                @if (userCard.TaskCounts.Open > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                        @userCard.TaskCounts.Open Open
                                    </span>
                                }
                                @if (userCard.TaskCounts.InProgress > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        @userCard.TaskCounts.InProgress In Progress
                                    </span>
                                }
                                @if (userCard.TaskCounts.Overdue > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        @userCard.TaskCounts.Overdue Overdue
                                    </span>
                                }
                                @if (userCard.TaskCounts.HighPriority > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                        @userCard.TaskCounts.HighPriority High Priority
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tasks List for this User -->
                    <div class="divide-y divide-gray-100">
                        @foreach (var taskViewModel in userCard.Tasks)
                        {
                            var task = taskViewModel.Task;
                            var taskId = "task-" + task.Id;
                            var progressId = "progress-" + task.Id;
                            <div class="p-4 hover:bg-gray-50 transition-colors @(taskViewModel.IsOverdue ? "border-l-4 border-red-500" : "") task-card" data-task-id="@task.Id">
                                <div class="space-y-3">
                                    <!-- Enhanced Task Header -->
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center space-x-3 mb-2">
                                                <h4 class="text-sm font-semibold text-gray-900 truncate">@task.Title</h4>
                                                
                                                <!-- Status Badge -->
                                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(GetStatusBadgeClass(task.Status))">
                                                    @GetStatusDisplayName(task.Status)
                                                </span>
                                                
                                                <!-- Priority Badge -->
                                                <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @(GetPriorityBadgeClass(task.Priority))">
                                                    @GetPriorityLabel(task.Priority)
                                                </span>
                                                
                                                <!-- Overdue Warning -->
                                                @if (taskViewModel.IsOverdue)
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800">
                                                        <i class="fa-solid fa-exclamation-triangle mr-1"></i>OVERDUE
                                                    </span>
                                                }
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <p class="text-gray-600 text-sm mb-2 line-clamp-2">@task.Description</p>
                                            }
                                        </div>
                                        
                                        <!-- Action Buttons -->
                                        <div class="flex items-center space-x-2 ml-4">
                                            <a class="btn btn-sm btn-outline-primary" href="/CRM/Tasks/Details?id=@task.Id">
                                                <i class="fa-solid fa-eye mr-1"></i>View
                                            </a>
                                            <a class="btn btn-sm btn-success" href="/CRM/Tasks/@task.Id/AddProgress">
                                                <i class="fa-solid fa-plus mr-1"></i>Progress
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <form method="post" asp-page-handler="DeleteTask" class="inline"
                                                      onsubmit="return confirm('Are you sure you want to permanently delete this task and all its progress entries? This action cannot be undone.')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="DeleteTaskId" value="@task.Id" />
                                                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="AssigneeFilter" value="@Model.AssigneeFilter" />
                                                    <input type="hidden" name="PriorityFilter" value="@Model.PriorityFilter" />
                                                    <input type="hidden" name="AccountFilter" value="@Model.AccountFilter" />
                                                    <input type="hidden" name="OverdueFilter" value="@Model.OverdueFilter" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="fa-solid fa-trash mr-1"></i>Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    <!-- Progress Bar and Info -->
                                    <div class="bg-gray-50 rounded-lg p-3">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="text-sm font-medium text-gray-700">Progress</div>
                                            <div class="flex items-center space-x-4">
                                                @if (taskViewModel.CompletionPercentage.HasValue)
                                                {
                                                    <span class="text-sm font-semibold text-gray-900">@taskViewModel.CompletionPercentage%</span>
                                                }
                                                @if (taskViewModel.ProgressCount > 0)
                                                {
                                                    <button type="button" 
                                                            class="text-xs text-blue-600 hover:text-blue-800 font-medium flex items-center transition-colors progress-toggle"
                                                            onclick="toggleProgress('@progressId')"
                                                            id="toggle-@progressId">
                                                        <i class="fa-solid fa-chevron-down mr-1 transition-transform" id="icon-@progressId"></i>
                                                        @taskViewModel.ProgressCount update@(taskViewModel.ProgressCount == 1 ? "" : "s")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        
                                        <!-- Progress Bar -->
                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                            <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500 ease-out" 
                                                 style="width: @(taskViewModel.CompletionPercentage ?? 0)%"></div>
                                        </div>
                                        
                                        <!-- Task Info Row -->
                                        <div class="flex items-center space-x-4 text-xs text-gray-500 mt-2">
                                            @if (task.DueAt.HasValue)
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-calendar mr-1"></i>
                                                    <span class="@(taskViewModel.IsOverdue ? "text-red-600 font-medium" : "")">
                                                        Due @task.DueAt.Value.ToString("MMM dd, yyyy")
                                                    </span>
                                                </div>
                                            }
                                            
                                            @if (task.Account != null)
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-building mr-1"></i>
                                                    <span>@task.Account.Name</span>
                                                </div>
                                            }
                                            
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-hashtag mr-1"></i>
                                                <span>Task #@task.Id</span>
                                            </div>
                                            
                                            @if (task.CreatedDate > DateTime.Now.AddDays(-7))
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-clock mr-1"></i>
                                                    <span>Created @task.CreatedDate.ToString("MMM dd")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Collapsible Progress Entries -->
                                    @if (taskViewModel.ProgressCount > 0)
                                    {
                                        <div id="@progressId" class="progress-entries hidden transition-all duration-300">
                                            <div class="border-t border-gray-200 pt-3">
                                                <h5 class="text-xs font-semibold text-gray-700 mb-2 flex items-center">
                                                    <i class="fa-solid fa-list mr-2"></i>Progress Updates
                                                </h5>
                                                <div class="space-y-2 max-h-60 overflow-y-auto">
                                                    @foreach (var progress in task.ProgressEntries.OrderByDescending(p => p.CreatedDate).Take(5))
                                                    {
                                                        <div class="bg-white border border-gray-200 rounded-lg p-3">
                                                            <div class="flex items-start justify-between">
                                                                <div class="flex-1">
                                                                    <div class="flex items-center space-x-2 mb-1">
                                                                        @if (progress.PercentComplete.HasValue)
                                                                        {
                                                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                                                @progress.PercentComplete%
                                                                            </span>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(progress.Status))
                                                                        {
                                                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @(GetStatusBadgeClass(progress.Status))">
                                                                                @progress.Status
                                                                            </span>
                                                                        }
                                                                        <span class="text-xs font-medium text-indigo-600">@progress.ProgressType</span>
                                                                    </div>
                                                                    <p class="text-sm text-gray-800 mb-1">@progress.ProgressNote</p>
                                                                    <div class="flex items-center space-x-3 text-xs text-gray-500">
                                                                        <span class="flex items-center">
                                                                            <i class="fa-solid fa-user mr-1"></i>
                                                                            @(progress.CreatedBy?.FullName ?? "Unknown")
                                                                        </span>
                                                                        <span class="flex items-center">
                                                                            <i class="fa-solid fa-clock mr-1"></i>
                                                                            @progress.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (task.ProgressEntries.Count > 5)
                                                    {
                                                        <div class="text-center">
                                                            <a href="/CRM/Tasks/Details?id=@task.Id" class="text-xs text-blue-600 hover:text-blue-800 font-medium">
                                                                View all @task.ProgressEntries.Count progress updates
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            
            <!-- Unassigned Tasks Card -->
            @if (Model.UnassignedTasks.Any())
            {
                <div class="bg-white border rounded-lg overflow-hidden shadow-sm">
                    <!-- Unassigned Header -->
                    <div class="bg-gradient-to-r from-gray-50 to-slate-50 border-b px-6 py-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <!-- Unassigned Icon -->
                                <div class="w-12 h-12 bg-gradient-to-br from-gray-400 to-gray-500 rounded-full flex items-center justify-center shadow-lg">
                                    <i class="fa-solid fa-user-slash text-white text-lg"></i>
                                </div>
                                
                                <!-- Unassigned Info -->
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">Unassigned Tasks</h3>
                                    <p class="text-sm text-gray-600">Tasks that need to be assigned to team members</p>
                                </div>
                            </div>
                            
                            <!-- Task Count Badge -->
                            <div class="flex items-center space-x-2">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    @Model.UnassignedTasks.Count Total
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Unassigned Tasks List -->
                    <div class="divide-y divide-gray-100">
                        @foreach (var taskViewModel in Model.UnassignedTasks)
                        {
                            var task = taskViewModel.Task;
                            var taskId = "task-" + task.Id;
                            var progressId = "progress-" + task.Id;
                            <div class="p-4 hover:bg-gray-50 transition-colors @(taskViewModel.IsOverdue ? "border-l-4 border-red-500" : "") task-card" data-task-id="@task.Id">
                                <div class="space-y-3">
                                    <!-- Enhanced Task Header -->
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center space-x-3 mb-2">
                                                <h4 class="text-sm font-semibold text-gray-900 truncate">@task.Title</h4>
                                                
                                                <!-- Status Badge -->
                                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(GetStatusBadgeClass(task.Status))">
                                                    @GetStatusDisplayName(task.Status)
                                                </span>
                                                
                                                <!-- Priority Badge -->
                                                <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full @(GetPriorityBadgeClass(task.Priority))">
                                                    @GetPriorityLabel(task.Priority)
                                                </span>
                                                
                                                <!-- Overdue Warning -->
                                                @if (taskViewModel.IsOverdue)
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800">
                                                        <i class="fa-solid fa-exclamation-triangle mr-1"></i>OVERDUE
                                                    </span>
                                                }
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <p class="text-gray-600 text-sm mb-2 line-clamp-2">@task.Description</p>
                                            }
                                        </div>
                                        
                                        <!-- Action Buttons -->
                                        <div class="flex items-center space-x-2 ml-4">
                                            <a class="btn btn-sm btn-outline-primary" href="/CRM/Tasks/Details?id=@task.Id">
                                                <i class="fa-solid fa-eye mr-1"></i>View
                                            </a>
                                            <a class="btn btn-sm btn-success" href="/CRM/Tasks/@task.Id/AddProgress">
                                                <i class="fa-solid fa-plus mr-1"></i>Progress
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <form method="post" asp-page-handler="DeleteTask" class="inline"
                                                      onsubmit="return confirm('Are you sure you want to permanently delete this task and all its progress entries? This action cannot be undone.')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="DeleteTaskId" value="@task.Id" />
                                                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="AssigneeFilter" value="@Model.AssigneeFilter" />
                                                    <input type="hidden" name="PriorityFilter" value="@Model.PriorityFilter" />
                                                    <input type="hidden" name="AccountFilter" value="@Model.AccountFilter" />
                                                    <input type="hidden" name="OverdueFilter" value="@Model.OverdueFilter" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="fa-solid fa-trash mr-1"></i>Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    <!-- Progress Bar and Info -->
                                    <div class="bg-gray-50 rounded-lg p-3">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="text-sm font-medium text-gray-700">Progress</div>
                                            <div class="flex items-center space-x-4">
                                                @if (taskViewModel.CompletionPercentage.HasValue)
                                                {
                                                    <span class="text-sm font-semibold text-gray-900">@taskViewModel.CompletionPercentage%</span>
                                                }
                                                @if (taskViewModel.ProgressCount > 0)
                                                {
                                                    <button type="button" 
                                                            class="text-xs text-blue-600 hover:text-blue-800 font-medium flex items-center transition-colors progress-toggle"
                                                            onclick="toggleProgress('@progressId')"
                                                            id="toggle-@progressId">
                                                        <i class="fa-solid fa-chevron-down mr-1 transition-transform" id="icon-@progressId"></i>
                                                        @taskViewModel.ProgressCount update@(taskViewModel.ProgressCount == 1 ? "" : "s")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        
                                        <!-- Progress Bar -->
                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                            <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500 ease-out" 
                                                 style="width: @(taskViewModel.CompletionPercentage ?? 0)%"></div>
                                        </div>
                                        
                                        <!-- Task Info Row -->
                                        <div class="flex items-center space-x-4 text-xs text-gray-500 mt-2">
                                            @if (task.DueAt.HasValue)
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-calendar mr-1"></i>
                                                    <span class="@(taskViewModel.IsOverdue ? "text-red-600 font-medium" : "")">
                                                        Due @task.DueAt.Value.ToString("MMM dd, yyyy")
                                                    </span>
                                                </div>
                                            }
                                            
                                            @if (task.Account != null)
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-building mr-1"></i>
                                                    <span>@task.Account.Name</span>
                                                </div>
                                            }
                                            
                                            @if (taskViewModel.CreatedByUser != null)
                                            {
                                                <div class="flex items-center">
                                                    <i class="fa-solid fa-user-plus mr-1"></i>
                                                    <span>Created by @taskViewModel.CreatedByUser.FullName</span>
                                                </div>
                                            }
                                            
                                            <div class="flex items-center">
                                                <i class="fa-solid fa-hashtag mr-1"></i>
                                                <span>Task #@task.Id</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Collapsible Progress Entries -->
                                    @if (taskViewModel.ProgressCount > 0)
                                    {
                                        <div id="@progressId" class="progress-entries hidden transition-all duration-300">
                                            <div class="border-t border-gray-200 pt-3">
                                                <h5 class="text-xs font-semibold text-gray-700 mb-2 flex items-center">
                                                    <i class="fa-solid fa-list mr-2"></i>Progress Updates
                                                </h5>
                                                <div class="space-y-2 max-h-60 overflow-y-auto">
                                                    @foreach (var progress in task.ProgressEntries.OrderByDescending(p => p.CreatedDate).Take(5))
                                                    {
                                                        <div class="bg-white border border-gray-200 rounded-lg p-3">
                                                            <div class="flex items-start justify-between">
                                                                <div class="flex-1">
                                                                    <div class="flex items-center space-x-2 mb-1">
                                                                        @if (progress.PercentComplete.HasValue)
                                                                        {
                                                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                                                @progress.PercentComplete%
                                                                            </span>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(progress.Status))
                                                                        {
                                                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @(GetStatusBadgeClass(progress.Status))">
                                                                                @progress.Status
                                                                            </span>
                                                                        }
                                                                        <span class="text-xs font-medium text-indigo-600">@progress.ProgressType</span>
                                                                    </div>
                                                                    <p class="text-sm text-gray-800 mb-1">@progress.ProgressNote</p>
                                                                    <div class="flex items-center space-x-3 text-xs text-gray-500">
                                                                        <span class="flex items-center">
                                                                            <i class="fa-solid fa-user mr-1"></i>
                                                                            @(progress.CreatedBy?.FullName ?? "Unknown")
                                                                        </span>
                                                                        <span class="flex items-center">
                                                                            <i class="fa-solid fa-clock mr-1"></i>
                                                                            @progress.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (task.ProgressEntries.Count > 5)
                                                    {
                                                        <div class="text-center">
                                                            <a href="/CRM/Tasks/Details?id=@task.Id" class="text-xs text-blue-600 hover:text-blue-800 font-medium">
                                                                View all @task.ProgressEntries.Count progress updates
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white border rounded-lg p-12 text-center">
                <div class="text-gray-400 mb-4">
                    <i class="fa-solid fa-clipboard-list text-4xl mb-4"></i>
                    <h4 class="text-lg font-medium text-gray-900 mb-2">No tasks found</h4>
                    <p>No tasks match your current filters.</p>
                    @if (Model.StatusFilter != null || Model.AssigneeFilter != null || Model.PriorityFilter != null || Model.AccountFilter != null || Model.OverdueFilter != null)
                    {
                        <p class="text-sm mt-2">
                            <a href="/CRM/Tasks" class="text-blue-600 hover:text-blue-800">Clear all filters</a> to see all tasks.
                        </p>
                    }
                    else
                    {
                        <p class="text-sm mt-2">Get started by creating your first task.</p>
                    }
                </div>
                <a href="/CRM/Tasks/Create" class="btn btn-primary">
                    <i class="fa-solid fa-plus mr-2"></i>Create First Task
                </a>
            </div>
        }
    </div>
</div>

@{
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-yellow-100 text-yellow-800 border border-yellow-300",
            "InProgress" => "bg-blue-100 text-blue-800 border border-blue-300", 
            "Completed" => "bg-green-100 text-green-800 border border-green-300",
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }

    string GetPriorityBadgeClass(int priority)
    {
        return priority switch
        {
            1 => "bg-gray-100 text-gray-800 border border-gray-300",     // Priority 1 = Lowest (Gray)
            2 => "bg-blue-100 text-blue-800 border border-blue-300",     // Priority 2 = Low (Blue)
            3 => "bg-yellow-100 text-yellow-800 border border-yellow-300", // Priority 3 = Normal (Yellow)
            4 => "bg-orange-100 text-orange-800 border border-orange-300", // Priority 4 = High (Orange)
            5 => "bg-red-100 text-red-800 border border-red-300",      // Priority 5 = Critical (Red)
            _ => "bg-gray-100 text-gray-800 border border-gray-300"
        };
    }

    string GetPriorityLabel(int priority)
    {
        return priority switch
        {
            1 => "P1 Lowest",
            2 => "P2 Low", 
            3 => "P3 Normal",
            4 => "P4 High",
            5 => "P5 Critical",
            _ => $"P{priority}"
        };
    }

    string GetStatusDisplayName(string status)
    {
        return status switch
        {
            "Open" => "Open",
            "InProgress" => "In Progress",
            "Completed" => "Completed",
            _ => status
        };
    }
}

<!-- JavaScript for enhanced interactivity -->
<script>
function filterTasksDueToday(event) {
    event.preventDefault();
    const today = new Date().toISOString().split('T')[0];
    window.location.href = `/CRM/Tasks?dueDate=${today}`;
}

function filterTasksDueThisWeek(event) {
    event.preventDefault();
    const today = new Date();
    const nextWeek = new Date(today.getTime() + 7 * 24 * 60 * 60 * 1000);
    const todayStr = today.toISOString().split('T')[0];
    const nextWeekStr = nextWeek.toISOString().split('T')[0];
    window.location.href = `/CRM/Tasks?dueDateFrom=${todayStr}&dueDateTo=${nextWeekStr}`;
}

// Add hover effects and tooltips
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips for progress notes
    const progressNotes = document.querySelectorAll('[title]');
    progressNotes.forEach(element => {
        element.addEventListener('mouseenter', function() {
            // You can add custom tooltip logic here if needed
        });
    });

    // Add smooth transitions
    const taskCards = document.querySelectorAll('.user-task-item');
    taskCards.forEach(card => {
        card.style.transition = 'background-color 0.2s ease';
        
        card.addEventListener('mouseenter', function() {
            // Removed the transform animation that was causing zoom issues
            this.style.backgroundColor = 'rgba(249, 250, 251, 1)'; // bg-gray-50
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.backgroundColor = '';
        });
    });

    // Add click tracking for statistics cards - FIXED: Removed scale animation causing zoom issues
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
        card.addEventListener('click', function() {
            // Removed the scale animation that was causing the zoom in/out bug
            // Just add a subtle color change instead
            const originalBg = this.style.backgroundColor;
            this.style.backgroundColor = 'rgba(59, 130, 246, 0.1)'; // subtle blue
            setTimeout(() => {
                this.style.backgroundColor = originalBg;
            }, 150);
        });
    });
});

// Progress toggle functionality
function toggleProgress(progressId) {
    const progressDiv = document.getElementById(progressId);
    const toggleButton = document.getElementById('toggle-' + progressId);
    const icon = document.getElementById('icon-' + progressId);
    
    if (progressDiv && toggleButton && icon) {
        const isHidden = progressDiv.classList.contains('hidden');
        
        if (isHidden) {
            // Show progress
            progressDiv.classList.remove('hidden');
            progressDiv.classList.add('show');
            icon.style.transform = 'rotate(180deg)';
            toggleButton.setAttribute('aria-expanded', 'true');
        } else {
            // Hide progress
            progressDiv.classList.remove('show');
            setTimeout(() => {
                progressDiv.classList.add('hidden');
            }, 300); // Match the CSS transition duration
            icon.style.transform = 'rotate(0deg)';
            toggleButton.setAttribute('aria-expanded', 'false');
        }
    }
}

// Initialize progress toggle states
document.addEventListener('DOMContentLoaded', function() {
    // Set initial ARIA states for progress toggles
    document.querySelectorAll('.progress-toggle').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('role', 'button');
        button.setAttribute('tabindex', '0');
        
        // Add keyboard support
        button.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                this.click();
            }
        });
    });
    
    // Set initial state for all progress sections
    document.querySelectorAll('.progress-entries').forEach(div => {
        div.classList.add('hidden');
    });
});
</script>

