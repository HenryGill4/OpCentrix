        text-decoration: none;
    }

    .progress-entries {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out, padding 0.3s ease-out;
    }

    .progress-entries.show {
        max-height: 500px;
        transition: max-height 0.3s ease-in, padding 0.3s ease-in;
    }

    /* Line clamp utility */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

