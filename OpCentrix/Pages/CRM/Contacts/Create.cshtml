@page
@model OpCentrix.Pages.CRM.Contacts.CreateModel
@{
    ViewData["Title"] = "Create CRM Contact";
    Layout = "~/Pages/Admin/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold">Create Contact</h1>

    <div class="text-sm text-gray-600">Account: <span class="font-semibold">@Model.AccountName</span></div>

    <form method="post" class="space-y-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Input.AccountId" />

        <div>
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Input.Name" />
            <span class="text-danger" asp-validation-for="Input.Name"></span>
        </div>

        <div>
            <label class="form-label">Title</label>
            <input class="form-control" asp-for="Input.Title" />
        </div>

        <div>
            <label class="form-label">Email</label>
            <input class="form-control" asp-for="Input.Email" />
            <span class="text-danger" asp-validation-for="Input.Email"></span>
        </div>

        <div>
            <label class="form-label">Phone</label>
            <input class="form-control" asp-for="Input.Phone" />
            <span class="text-danger" asp-validation-for="Input.Phone"></span>
        </div>

        <div class="flex gap-2">
            <button class="btn btn-primary" type="submit">Create</button>
            <a class="btn btn-light" href="/CRM/Accounts/Details?id=@Model.Input.AccountId">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
