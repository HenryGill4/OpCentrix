    <!-- Sidebar and Navigation JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebar-toggle');
            const sidebarCollapse = document.getElementById('sidebar-collapse');
            const mobileSidebarClose = document.getElementById('mobile-sidebar-close');
            const sidebarOverlay = document.getElementById('sidebar-overlay');
            const mainContentArea = document.getElementById('main-content-area');
            
            let isSidebarCollapsed = false;
            let isMobile = window.innerWidth < 768;
            let isMobileSidebarOpen = false;
            
            // Enhanced Mobile sidebar toggle with animations
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (isMobile) {
                        isMobileSidebarOpen = !isMobileSidebarOpen;
                        
                        if (isMobileSidebarOpen) {
                            // Show sidebar
                            sidebar.classList.remove('sidebar-mobile-hidden');
                            sidebarOverlay.classList.remove('opacity-0', 'pointer-events-none');
                            sidebarOverlay.classList.add('opacity-50');
                            document.body.style.overflow = 'hidden'; // Prevent background scrolling
                            
                            // Update hamburger icon to X
                            const icon = sidebarToggle.querySelector('i');
                            if (icon) {
                                icon.classList.remove('fa-bars');
                                icon.classList.add('fa-times');
                            }
                            
                            console.log('📱 Mobile sidebar opened');
                        } else {
                            // Hide sidebar
                            sidebar.classList.add('sidebar-mobile-hidden');
                            sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                            sidebarOverlay.classList.remove('opacity-50');
                            document.body.style.overflow = ''; // Restore scrolling
                            
                            // Update X icon back to hamburger
                            const icon = sidebarToggle.querySelector('i');
                            if (icon) {
                                icon.classList.remove('fa-times');
                                icon.classList.add('fa-bars');
                            }
                            
                            console.log('📱 Mobile sidebar closed');
                        }
                    }
                });
            }
            
            // Mobile sidebar close button
            if (mobileSidebarClose) {
                mobileSidebarClose.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (isMobile && isMobileSidebarOpen) {
                        closeMobileSidebar();
                    }
                });
            }
            
            // Desktop sidebar collapse
            if (sidebarCollapse) {
                sidebarCollapse.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (!isMobile) {
                        isSidebarCollapsed = !isSidebarCollapsed;
                        sidebar.classList.toggle('sidebar-collapsed');
                        mainContentArea.classList.toggle('content-area-expanded');
                        
                        // Update collapse icon
                        const icon = sidebarCollapse.querySelector('i');
                        if (icon) {
                            if (isSidebarCollapsed) {
                                icon.classList.remove('fa-angle-double-left');
                                icon.classList.add('fa-angle-double-right');
                            } else {
                                icon.classList.remove('fa-angle-double-right');
                                icon.classList.add('fa-angle-double-left');
                            }
                        }
                        
                        console.log('🖥️ Desktop sidebar', isSidebarCollapsed ? 'collapsed' : 'expanded');
                    }
                });
            }
            
            // Enhanced mobile sidebar close functionality
            function closeMobileSidebar() {
                if (isMobile && isMobileSidebarOpen) {
                    isMobileSidebarOpen = false;
                    sidebar.classList.add('sidebar-mobile-hidden');
                    sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                    sidebarOverlay.classList.remove('opacity-50');
                    document.body.style.overflow = '';
                    
                    // Update icon back to hamburger
                    const sidebarToggleIcon = sidebarToggle?.querySelector('i');
                    if (sidebarToggleIcon) {
                        sidebarToggleIcon.classList.remove('fa-times');
                        sidebarToggleIcon.classList.add('fa-bars');
                    }
                    
                    console.log('📱 Mobile sidebar closed via overlay/link');
                }
            }
            
            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', closeMobileSidebar);
            }
            
            // Close mobile sidebar when clicking nav links
            const navLinks = sidebar?.querySelectorAll('a.nav-item, a.nav-subitem');
            if (navLinks) {
                navLinks.forEach(link => {
                    link.addEventListener('click', function() {
                        // Small delay to allow navigation to start
                        setTimeout(closeMobileSidebar, 100);
                    });
                });
            }
            
            // Close mobile sidebar on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && isMobile && isMobileSidebarOpen) {
                    closeMobileSidebar();
                }
            });
            
            // Enhanced window resize handler
            window.addEventListener('resize', function() {
                const wasMobile = isMobile;
                isMobile = window.innerWidth < 768;
                
                if (wasMobile !== isMobile) {
                    if (isMobile) {
                        // Switched to mobile
                        sidebar.classList.remove('sidebar-collapsed');
                        sidebar.classList.add('sidebar-mobile-hidden');
                        mainContentArea.classList.remove('content-area-expanded');
                        document.body.style.overflow = '';
                        isMobileSidebarOpen = false;
                        
                        // Reset toggle icon
                        const sidebarToggleIcon = sidebarToggle?.querySelector('i');
                        if (sidebarToggleIcon) {
                            sidebarToggleIcon.classList.remove('fa-times');
                            sidebarToggleIcon.classList.add('fa-bars');
                        }
                        
                        console.log('📱 Switched to mobile mode');
                    } else {
                        // Switched to desktop
                        sidebar.classList.remove('sidebar-mobile-hidden');
                        sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                        sidebarOverlay.classList.remove('opacity-50');
                        document.body.style.overflow = '';
                        isMobileSidebarOpen = false;
                        
                        // Reset toggle icon
                        const sidebarToggleIcon = sidebarToggle?.querySelector('i');
                        if (sidebarToggleIcon) {
                            sidebarToggleIcon.classList.remove('fa-times');
                            sidebarToggleIcon.classList.add('fa-bars');
                        }
                        
                        if (isSidebarCollapsed) {
                            sidebar.classList.add('sidebar-collapsed');
                            mainContentArea.classList.add('content-area-expanded');
                        }
                        
                        console.log('🖥️ Switched to desktop mode');
                    }
                }
            });
            
            // Initialize mobile state
            if (isMobile) {
                sidebar.classList.add('sidebar-mobile-hidden');
                sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                isMobileSidebarOpen = false;
                console.log('📱 Initialized in mobile mode');
            }
            
            // Navigation group toggle
            window.toggleNavGroup = function(groupId) {
                const group = document.getElementById(groupId + '-group');
                const chevron = document.getElementById(groupId + '-chevron');
                
                if (group && chevron) {
                    group.classList.toggle('hidden');
                    chevron.classList.toggle('rotate-180');
                    
                    console.log(`📂 Navigation group '${groupId}' toggled`);
                }
            };
            
            // Load user task notifications
            loadUserTaskNotifications();
            
            // Refresh task notifications every 60 seconds
            setInterval(loadUserTaskNotifications, 60000);
            
            // Test notification bell functionality
            console.log('🔔 Initializing notification bell for user role:', '@userRole');
            console.log('🔔 User role check: userRole != "Admin" && userRole != "Manager":', ('@userRole' != 'Admin' && '@userRole' != 'Manager'));
            
            const bellElement = document.getElementById('quick-tasks-bell');
            const dropdownElement = document.getElementById('quick-tasks-dropdown');
            
            if (bellElement) {
                console.log('🔔 Bell element found and ready');
                
                // Test click handler
                bellElement.addEventListener('click', function(e) {
                    console.log('🔔 Bell clicked via event listener');
                    e.preventDefault();
                    e.stopPropagation();
                });
            } else {
                console.log('🔔 Bell element not found - user role:', '@userRole');
                console.log('🔔 Bell should be visible for roles other than Admin/Manager');
                
                // Show what roles would see the bell
                const allowedRoles = ['PrintingSpecialist', 'Operator', 'EDMSpecialist', 'CoatingSpecialist', 'QualityInspector', 'QCSpecialist', 'ShippingSpecialist', 'BTSpecialist'];
                console.log('🔔 Roles that should see the bell:', allowedRoles);
            }
            
            if (dropdownElement) {
                console.log('🔔 Dropdown element found and ready');
            } else {
                console.log('🔔 Dropdown element not found');
            }
            
            // Enhanced Dark Mode Debug and Monitoring
            if (window.location.search.includes('debug=theme')) {
                // Add debug indicator
                const debugIndicator = document.createElement('div');
                debugIndicator.className = 'theme-indicator';
                debugIndicator.textContent = `Theme: ${getCurrentTheme()}`;
                document.body.appendChild(debugIndicator);
                document.body.classList.add('debug-mode');
                
                // Update indicator when theme changes
                window.addEventListener('themeChanged', (e) => {
                    debugIndicator.textContent = `Theme: ${e.detail.theme}`;
                });
                
                console.log('🎨 Dark Mode Debug Info:', {
                    currentTheme: getCurrentTheme(),
                    storedPreference: localStorage.getItem('theme'),
                    systemPreference: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
                    htmlClasses: document.documentElement.className,
                    dataTheme: document.documentElement.getAttribute('data-theme')
                });
            }
            
            // Monitor for theme inconsistencies
            window.addEventListener('themeChanged', (e) => {
                const htmlHasDark = document.documentElement.classList.contains('dark');
                const expectedDark = e.detail.theme === 'dark';
                
                if (htmlHasDark !== expectedDark) {
                    console.warn('🚨 Theme inconsistency detected! Fixing...', {
                        expected: expectedDark,
                        actual: htmlHasDark,
                        theme: e.detail.theme
                    });
                    
                    // Force correction
                    if (expectedDark) {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                }
            });
        });
        
        // Function to load user task notifications
        function loadUserTaskNotifications() {
            console.log('🔔 Loading user task notifications...');
            
            fetch('/api/tasks/user-notifications', {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                console.log('🔔 Notifications API response status:', response.status);
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log('🔔 Notifications data received:', data);
                updateTaskBadges(data);
            })
            .catch(error => {
                console.error('🔔 Error loading task notifications:', error);
                
                // Show fallback data for testing
                const fallbackData = {
                    myTasksCount: 0,
                    urgentTasksCount: 0,
                    taskPriorities: {
                        critical: 0,
                        urgent: 0,
                        high: 0,
                        normal: 0,
                        low: 0
                    }
                };
                updateTaskBadges(fallbackData);
            });
        }
        
        // Function to get priority class based on task data
        function getTaskBadgePriorityClass(data) {
            if (!data || !data.taskPriorities) return 'task-badge-normal';
            
            const priorities = data.taskPriorities;
            
            // Check for critical priority tasks (priority 5)
            if (priorities.critical > 0) return 'task-badge-critical';
            
            // Check for urgent priority tasks (priority 4)
            if (priorities.urgent > 0) return 'task-badge-urgent';
            
            // Check for high priority tasks (priority 3)
            if (priorities.high > 0) return 'task-badge-high';
            
            // Check for normal priority tasks (priority 2)
            if (priorities.normal > 0) return 'task-badge-normal';
            
            // Default to low priority (priority 1)
            return 'task-badge-low';
        }
        
        // Function to update task badges and notifications
        function updateTaskBadges(data) {
            // Update My Tasks badge
            const myTasksBadge = document.getElementById('my-tasks-badge');
            if (myTasksBadge && data && data.myTasksCount !== undefined) {
                myTasksBadge.textContent = data.myTasksCount;
                
                if (data.myTasksCount > 0) {
                    // Remove all existing priority classes
                    myTasksBadge.className = myTasksBadge.className.replace(/task-badge-\w+/g, '');
                    
                    // Add base task-badge class and priority-specific class
                    myTasksBadge.className = 'task-badge ml-auto ' + getTaskBadgePriorityClass(data);
                    myTasksBadge.style.display = 'inline';
                } else {
                    myTasksBadge.style.display = 'none';
                }
            }
            
            // Update notification count in top bar with animations - Updated for new structure
            const notificationCount = document.getElementById('task-notification-count');
            const bellIcon = document.querySelector('#quick-tasks-bell .fas.fa-bell');
            
            if (notificationCount && data && data.urgentTasksCount !== undefined) {
                notificationCount.textContent = data.urgentTasksCount;
                notificationCount.style.display = data.urgentTasksCount > 0 ? 'flex' : 'none';
                
                // Apply bell animations based on urgency
                if (bellIcon) {
                    // Remove existing animation classes
                    bellIcon.classList.remove('bell-notification', 'bell-urgent');
                    
                    if (data.urgentTasksCount > 0) {
                        // Check if we have critical or urgent tasks
                        if (data.taskPriorities && (data.taskPriorities.critical > 0 || data.taskPriorities.urgent > 3)) {
                            bellIcon.classList.add('bell-urgent');
                        } else if (data.urgentTasksCount > 0) {
                            bellIcon.classList.add('bell-notification');
                        }
                    }
                }
            }
        }
        
        // Enhanced Quick tasks dropdown toggle for new structure
        function toggleQuickTasksDropdown() {
            console.log('🔔 Toggle quick tasks dropdown called');
            const dropdown = document.getElementById('quick-tasks-dropdown');
            const bell = document.getElementById('quick-tasks-bell');
            
            if (!dropdown) {
                console.error('🔔 Dropdown element not found');
                return;
            }
            
            if (!bell) {
                console.error('🔔 Bell element not found');
                return;
            }
            
            const isHidden = dropdown.classList.contains('hidden');
            console.log(`🔔 Dropdown is currently ${isHidden ? 'hidden' : 'visible'}`);
            
            if (isHidden) {
                // Show dropdown
                dropdown.classList.remove('hidden');
                console.log('🔔 Showing dropdown');
                
                // Load quick tasks content if not already loaded
                if (!dropdown.dataset.loaded) {
                    console.log('🔔 Loading tasks content...');
                    dropdown.innerHTML = '<div class="p-4 text-center text-gray-500"><i class="fas fa-spinner fa-spin mr-2"></i>Loading tasks...</div>';
                    
                    fetch('/api/tasks/quick-dropdown', {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'text/html'
                        }
                    })
                    .then(response => {
                        console.log('🔔 API response status:', response.status);
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }
                        return response.text();
                    })
                    .then(html => {
                        console.log('🔔 Tasks content loaded successfully');
                        dropdown.innerHTML = html;
                        dropdown.dataset.loaded = 'true';
                    })
                    .catch(err => {
                        console.error('🔔 Failed to load quick tasks:', err);
                        dropdown.innerHTML = '<div class="p-4 text-red-600 text-sm text-center">Error loading tasks. Please try again.</div>';
                    });
                }
            } else {
                // Hide dropdown
                dropdown.classList.add('hidden');
                console.log('🔔 Hiding dropdown');
            }
        }
        
        // Global function to make it accessible from onclick
        window.toggleQuickTasksDropdown = toggleQuickTasksDropdown;
        
        // Updated click handler for new structure
        document.addEventListener('click', function(e) {
            const quickTasksBell = document.getElementById('quick-tasks-bell');
            const quickTasksDropdown = document.getElementById('quick-tasks-dropdown');
            
            // Don't hide dropdown if click was inside it
            if (quickTasksDropdown && quickTasksDropdown.contains(e.target)) {
                return;
            }
            
            // If click was on the bell, let the onclick handler deal with it
            if (quickTasksBell && (quickTasksBell.contains(e.target) || e.target === quickTasksBell)) {
                return;
            }
            
            // Hide dropdown if click was outside
            if (quickTasksDropdown && !quickTasksDropdown.classList.contains('hidden')) {
                quickTasksDropdown.classList.add('hidden');
                console.log('🔔 Hiding dropdown due to outside click');
            }
        });
    </script>

    @if (isAuthenticated)
    {
        <!-- Session Management Script - Enhanced for Sidebar Layout -->
        <script>
            // Enhanced session timeout management with sidebar awareness
            (function() {
                let sessionTimeoutMinutes = 120; // 2 hours
                let warningTimeoutMinutes = 5; // 5 minutes warning
                let sessionTimeoutTimer;
                let warningTimer;
                let countdownTimer;

                function resetSessionTimeout() {
                    clearTimeout(sessionTimeoutTimer);
                    clearTimeout(warningTimer);
                    clearInterval(countdownTimer);
                    hideTimeoutWarning();

                    const warningTime = (sessionTimeoutMinutes - warningTimeoutMinutes) * 60 * 1000;
                    warningTimer = setTimeout(showTimeoutWarning, warningTime);
                    
                    sessionTimeoutTimer = setTimeout(() => {
                        window.location.href = '/Account/Logout';
                    }, sessionTimeoutMinutes * 60 * 1000);
                }

                function showTimeoutWarning() {
                    const warning = document.getElementById('session-timeout-warning');
                    if (warning) {
                        warning.style.display = 'block';
                        
                        let countdown = warningTimeoutMinutes * 60;
                        const countdownSpan = document.getElementById('timeout-countdown');
                        
                        countdownTimer = setInterval(() => {
                            if (countdown <= 0) {
                                clearInterval(countdownTimer);
                                window.location.href = '/Account/Logout';
                                return;
                            }
                            
                            const minutes = Math.floor(countdown / 60);
                            const seconds = countdown % 60;
                            if (countdownSpan) {
                                countdownSpan.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                            }
                            countdown--;
                        }, 1000);
                    }
                }

                function hideTimeoutWarning() {
                    const warning = document.getElementById('session-timeout-warning');
                    if (warning) {
                        warning.style.display = 'none';
                    }
                    clearInterval(countdownTimer);
                }

                window.performLogout = function() {
                    if (confirm('Are you sure you want to logout?')) {
                        clearTimeout(sessionTimeoutTimer);
                        clearTimeout(warningTimer);
                        clearInterval(countdownTimer);
                        window.location.href = '/Account/Logout';
                    }
                };

                window.extendSession = function() {
                    fetch('/Account/ExtendSession', { method: 'POST' })
                        .then(() => {
                            resetSessionTimeout();
                            hideTimeoutWarning();
                        })
                        .catch(() => {
                            window.location.href = '/Account/Login';
                        });
                };

                // Enhanced activity tracking with sidebar awareness
                let lastActivity = Date.now();
                function trackActivity() {
                    const now = Date.now();
                    if (now - lastActivity > 30000) {
                        lastActivity = now;
                        resetSessionTimeout();
                    }
                }

                ['click', 'keypress', 'scroll'].forEach(event => {
                    document.addEventListener(event, trackActivity, { passive: true });
                });

                resetSessionTimeout();
            })();
        </script>
    }

