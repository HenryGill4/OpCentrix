@* Enhanced Sidebar Navigation for Option A: Stage-Aware Manufacturing Execution System *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpCentrix</title>
    
    @* Load master responsive CSS FIRST *@
    <link rel="stylesheet" href="~/css/responsive-master.css" asp-append-version="true" />
    
    @* Load OpCentrix styles *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stage-cohort-enhancements.css" asp-append-version="true" />
    
    @* Font Awesome for icons (including fas fa-calendar-plus) *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    @* Use Tailwind CDN only in development, production CSS in production *@
    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
    {
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            'opcentrix': {
                                'primary': '#3B82F6',
                                'secondary': '#6366F1',
                                'accent': '#10B981'
                            },
                            'stage': {
                                'sls': '#3B82F6',
                                'cnc': '#8B5CF6', 
                                'edm': '#EC4899',
                                'coating': '#F59E0B',
                                'qc': '#10B981',
                                'shipping': '#6366F1'
                            }
                        },
                        fontFamily: {
                            'sans': ['Inter', 'ui-sans-serif', 'system-ui']
                        }
                    }
                }
            }
        </script>
    }
    else
    {
        <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
    }
    
    @* Load Bootstrap LAST and only what we need *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    @* HTMX for dynamic content *@
    <script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
    
    @* Render Styles section *@
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        /* Sidebar styles */
        .sidebar {
            transition: transform 0.3s ease-in-out;
        }
        
        .sidebar-collapsed {
            transform: translateX(-16rem);
        }
        
        @@media (max-width: 768px) {
            .sidebar-mobile-hidden {
                transform: translateX(-100%);
            }
        }
        
        .content-area {
            margin-left: 16rem; /* 64 * 0.25rem = 16rem */
            transition: margin-left 0.3s ease-in-out;
        }
        
        .content-area-expanded {
            margin-left: 0;
        }
        
        @@media (max-width: 768px) {
            .content-area {
                margin-left: 0;
            }
        }
        
        /* Enhanced scrollbar */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        
        .sidebar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        
        .sidebar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 2px;
        }
        
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-gray-50">
    @{
        var user = Context.User;
        var isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        var userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        var userName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "";
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString()?.TrimStart('/');
    }

    @if (isAuthenticated)
    {
        <!-- Sidebar Navigation -->
        <div id="sidebar" class="sidebar fixed inset-y-0 left-0 z-50 w-64 bg-white shadow-lg border-r border-gray-200 overflow-y-auto">
            <!-- Logo and Header -->
            <div class="sidebar-header flex items-center h-16 px-6 border-b border-gray-200">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center mr-3 shadow-md">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="text-lg font-bold text-white">OpCentrix</span>
                        </div>
                        <p class="text-xs text-blue-100 leading-none">Manufacturing Execution</p>
                    </div>
                </div>
            </div>

            <!-- User Info Card -->
            <div class="user-info-card p-4 border-b border-gray-200">
                <div class="flex items-center space-x-3">
                    <div class="user-avatar w-10 h-10 rounded-full flex items-center justify-center shadow-md">
                        <span class="text-white font-semibold text-sm">@(userName.FirstOrDefault())</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-900 truncate">@userName</p>
                        <p class="text-xs text-gray-600">@userRole</p>
                    </div>
                </div>
            </div>

            <!-- Navigation Menu -->
            <nav class="flex-1 px-4 py-4 space-y-1">
                
                <!-- Dashboard -->
                <a href="/" class="nav-item @(currentPage == "" || currentPage == "Index" ? "nav-item-active" : "")">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Manufacturing Sections - Role-Based Access -->
                @if (userRole != "Admin" && userRole != "Manager")
                {
                    <!-- My Tasks for All Employees -->
                    <a href="/Tasks/MyTasks" class="nav-item @(currentPage?.Contains("Tasks/MyTasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-clipboard-list"></i>
                        <span>My Tasks</span>
                        <span id="my-tasks-badge" class="task-badge bg-blue-500 text-white text-xs px-2 py-0.5 rounded-full ml-auto">0</span>
                    </a>

                    @if (userRole == "PrintingSpecialist" || userRole == "Operator")
                    {
                        <a href="/PrintTracking" class="nav-item @(currentPage?.Contains("PrintTracking") == true ? "nav-item-active" : "")">
                            <i class="fas fa-cube text-blue-500"></i>
                            <span>SLS Printing</span>
                        </a>
                    }

                    @if (userRole == "EDMSpecialist" || userRole == "Operator")
                    {
                        <a href="/EDM" class="nav-item @(currentPage?.Contains("EDM") == true ? "nav-item-active" : "")">
                            <i class="fas fa-bolt text-pink-500"></i>
                            <span>EDM Operations</span>
                        </a>
                    }

                    @if (userRole == "CoatingSpecialist" || userRole == "Operator")
                    {
                        <a href="/Coating" class="nav-item @(currentPage?.Contains("Coating") == true ? "nav-item-active" : "")">
                            <i class="fas fa-paint-brush text-orange-500"></i>
                            <span>Coating</span>
                        </a>
                    }

                    @if (userRole == "QualityInspector" || userRole == "QCSpecialist" || userRole == "Operator")
                    {
                        <a href="/QC" class="nav-item @(currentPage?.Contains("QC") == true ? "nav-item-active" : "")">
                            <i class="fas fa-check-circle text-green-500"></i>
                            <span>Quality Control</span>
                        </a>
                    }

                    @if (userRole == "ShippingSpecialist" || userRole == "Operator")
                    {
                        <a href="/Shipping" class="nav-item @(currentPage?.Contains("Shipping") == true ? "nav-item-active" : "")">
                            <i class="fas fa-truck text-indigo-500"></i>
                            <span>Shipping</span>
                        </a>
                    }

                    @if (userRole == "BTSpecialist")
                    {
                        <a href="/BT/Dashboard" class="nav-item">
                            <i class="fas fa-chart-pie text-amber-500"></i>
                            <span>B&T Operations</span>
                        </a>
                        <a href="/BT/SerialNumbers" class="nav-item">
                            <i class="fas fa-barcode text-amber-500"></i>
                            <span>Serial Numbers</span>
                        </a>
                        <a href="/BT/Compliance" class="nav-item">
                            <i class="fas fa-shield-alt text-amber-500"></i>
                            <span>Compliance</span>
                        </a>
                    }
                }

                @* Management & Admin Sections *@
                @if (userRole is "Admin" or "Manager" or "Supervisor")
                {
                    <!-- My Tasks for Management -->
                    <a href="/Tasks/MyTasks" class="nav-item @(currentPage?.Contains("Tasks/MyTasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-clipboard-list"></i>
                        <span>My Tasks</span>
                        <span id="my-tasks-badge" class="task-badge bg-blue-500 text-white text-xs px-2 py-0.5 rounded-full ml-auto">0</span>
                    </a>

                    <!-- Scheduling -->
                    <a href="/Scheduler" class="nav-item @(currentPage?.Contains("Scheduler") == true ? "nav-item-active" : "")">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Production Scheduler</span>
                    </a>

                    <!-- Production Areas - Condensed -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('production')">
                            <i class="fas fa-cogs"></i>
                            <span>Production Areas</span>
                            <i class="fas fa-chevron-down nav-chevron" id="production-chevron"></i>
                        </button>
                        <div id="production-group" class="nav-group-content hidden">
                            <a href="/PrintTracking" class="nav-subitem @(currentPage?.Contains("PrintTracking") == true ? "nav-item-active" : "")">
                                <i class="fas fa-cube text-blue-500"></i>
                                <span>SLS Printing</span>
                            </a>
                            <a href="/EDM" class="nav-subitem @(currentPage?.Contains("EDM") == true ? "nav-item-active" : "")">
                                <i class="fas fa-bolt text-pink-500"></i>
                                <span>EDM Operations</span>
                            </a>
                            <a href="/Coating" class="nav-subitem @(currentPage?.Contains("Coating") == true ? "nav-item-active" : "")">
                                <i class="fas fa-paint-brush text-orange-500"></i>
                                <span>Coating</span>
                            </a>
                            <a href="/QC" class="nav-subitem @(currentPage?.Contains("QC") == true ? "nav-item-active" : "")">
                                <i class="fas fa-check-circle text-green-500"></i>
                                <span>Quality Control</span>
                            </a>
                            <a href="/Shipping" class="nav-subitem @(currentPage?.Contains("Shipping") == true ? "nav-item-active" : "")">
                                <i class="fas fa-truck text-indigo-500"></i>
                                <span>Shipping</span>
                            </a>
                        </div>
                    </div>

                    <!-- Team Management -->
                    <a href="/CRM/Tasks" class="nav-item @(currentPage?.Contains("CRM/Tasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-tasks"></i>
                        <span>Team Tasks</span>
                    </a>

                    <a href="/CRM/Tasks/Create" class="nav-item">
                        <i class="fas fa-plus-circle"></i>
                        <span>Assign Tasks</span>
                    </a>

                    <div class="nav-group">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('clients')">
                            <i class="fas fa-handshake"></i>
                            <span>Client Relations</span>
                            <i class="fas fa-chevron-down nav-chevron" id="clients-chevron"></i>
                        </button>
                        <div id="clients-group" class="nav-group-content hidden">
                            <a href="/CRM/Accounts" class="nav-subitem">
                                <i class="fas fa-building"></i>
                                <span>Accounts</span>
                            </a>
                            <a href="/CRM/Contacts" class="nav-subitem">
                                <i class="fas fa-address-book"></i>
                                <span>Contacts</span>
                            </a>
                        </div>
                    </div>

                    <!-- B&T Manufacturing Section -->
                    @if (userRole == "Admin" || userRole == "Manager")
                    {
                        <a href="/BT/Dashboard" class="nav-item">
                            <i class="fas fa-chart-pie text-amber-500"></i>
                            <span>B&T Operations</span>
                        </a>
                        
                        <div class="nav-group">
                            <button class="nav-group-toggle" onclick="toggleNavGroup('bt-details')">
                                <i class="fas fa-cog"></i>
                                <span>B&T Details</span>
                                <i class="fas fa-chevron-down nav-chevron" id="bt-details-chevron"></i>
                            </button>
                            <div id="bt-details-group" class="nav-group-content hidden">
                                <a href="/BT/SerialNumbers" class="nav-subitem">
                                    <i class="fas fa-barcode"></i>
                                    <span>Serial Numbers</span>
                                </a>
                                <a href="/BT/Compliance" class="nav-subitem">
                                    <i class="fas fa-shield-alt"></i>
                                    <span>Compliance</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Admin Access -->
                    @if (userRole == "Admin")
                    {
                        <a href="/Admin" class="nav-item @(currentPage?.Contains("Admin") == true ? "nav-item-active" : "")">
                            <i class="fas fa-tools text-red-500"></i>
                            <span>Admin Panel</span>
                        </a>
                    }
                }
            </nav>

            <!-- Footer Actions -->
            <div class="p-4 border-t border-gray-200 bg-gray-50">
                <button onclick="performLogout()" class="logout-btn w-full text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center justify-center">
                    <i class="fas fa-sign-out-alt mr-2"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Mobile overlay -->
        <div id="sidebar-overlay" class="fixed inset-0 bg-black opacity-0 pointer-events-none transition-opacity duration-300 md:hidden z-40"></div>
    }

    <!-- Top Bar for Mobile and Sidebar Toggle -->
    <div class="@(isAuthenticated ? "content-area" : "")" id="main-content-area">
        @if (isAuthenticated)
        {
            <!-- Top bar -->
            <div class="sticky top-0 z-40 bg-white shadow-sm border-b border-gray-200">
                <div class="flex items-center justify-between h-14 px-4">
                    <button id="sidebar-toggle" class="text-gray-500 hover:text-gray-700 md:hidden">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    
                    <div class="hidden md:flex items-center">
                        <button id="sidebar-collapse" class="text-gray-500 hover:text-gray-700 mr-4">
                            <i class="fas fa-angle-double-left text-lg"></i>
                        </button>
                        <h1 class="text-lg font-semibold text-gray-900">@ViewData["Title"]</h1>
                    </div>
                    
                    <!-- Page title for mobile -->
                    <h1 class="text-lg font-semibold text-gray-900 md:hidden">@ViewData["Title"]</h1>
                    
                    <!-- Right side actions -->
                    <div class="flex items-center space-x-3">
                        @if (userRole != "Admin" && userRole != "Manager")
                        {
                            <!-- Quick Task Actions for Employees -->
                            <div class="relative">
                                <button id="quick-tasks-btn" class="text-gray-500 hover:text-gray-700 relative">
                                    <i class="fas fa-bell text-lg"></i>
                                    <span id="task-notification-count" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center hidden">0</span>
                                </button>
                                <!-- Quick task dropdown will be populated via HTMX -->
                                <div id="quick-tasks-dropdown" class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-gray-200 hidden">
                                    <!-- Content loaded via HTMX -->
                                </div>
                            </div>
                        }
                        
                        <!-- User menu -->
                        <div class="flex items-center text-sm text-gray-600">
                            <span class="hidden sm:block">@userName</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Session Timeout Warning -->
        <div id="session-timeout-warning" class="session-timeout-warning">
            <div class="max-w-7xl mx-auto px-4 flex items-center justify-center space-x-4">
                <div class="flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span id="timeout-message">Your session will expire in <span id="timeout-countdown">5</span> minutes</span>
                </div>
                <button onclick="extendSession()" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                    Extend Session
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <main class="@(isAuthenticated ? "p-6 min-h-screen" : "min-h-screen")">
            @if (!isAuthenticated)
            {
                <!-- Login page styling -->
                <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100">
                    @RenderBody()
                </div>
            }
            else
            {
                @RenderBody()
            }
        </main>
    </div>

    <!-- Bug Report Tool - Available on all pages -->
    @await Html.PartialAsync("_BugReportTool")

    <!-- Enhanced Footer -->
    <footer class="@(isAuthenticated ? "ml-64" : "") bg-white border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="flex items-center space-x-4">
                    <div class="w-8 h-8 opcentrix-gradient rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-900">&copy; @DateTime.Now.Year OpCentrix</p>
                        <p class="text-xs text-gray-500">Stage-Aware Manufacturing Execution System</p>
                    </div>
                </div>
                <div class="mt-4 md:mt-0">
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-2">
                            <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                        </div>
                        <p class="text-xs text-gray-500">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript Libraries - SAFE MODE -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/masterPartForm.js" asp-append-version="true"></script>
    <script src="~/js/scheduler-runtime.js" asp-append-version="true"></script>
    <script src="~/js/scheduler-ui.js" asp-append-version="true"></script>
    <script src="~/js/job-form.js" asp-append-version="true"></script>

    <!-- Sidebar and Navigation JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebar-toggle');
            const sidebarCollapse = document.getElementById('sidebar-collapse');
            const sidebarOverlay = document.getElementById('sidebar-overlay');
            const mainContentArea = document.getElementById('main-content-area');
            
            let isSidebarCollapsed = false;
            let isMobile = window.innerWidth < 768;
            
            // Mobile sidebar toggle
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function() {
                    if (isMobile) {
                        sidebar.classList.toggle('sidebar-mobile-hidden');
                        sidebarOverlay.classList.toggle('opacity-0');
                        sidebarOverlay.classList.toggle('pointer-events-none');
                    }
                });
            }
            
            // Desktop sidebar collapse
            if (sidebarCollapse) {
                sidebarCollapse.addEventListener('click', function() {
                    if (!isMobile) {
                        isSidebarCollapsed = !isSidebarCollapsed;
                        sidebar.classList.toggle('sidebar-collapsed');
                        mainContentArea.classList.toggle('content-area-expanded');
                    }
                });
            }
            
            // Close mobile sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.add('sidebar-mobile-hidden');
                    sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                });
            }
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const wasMobile = isMobile;
                isMobile = window.innerWidth < 768;
                
                if (wasMobile !== isMobile) {
                    if (isMobile) {
                        // Switched to mobile
                        sidebar.classList.remove('sidebar-collapsed');
                        sidebar.classList.add('sidebar-mobile-hidden');
                        mainContentArea.classList.remove('content-area-expanded');
                    } else {
                        // Switched to desktop
                        sidebar.classList.remove('sidebar-mobile-hidden');
                        sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
                        
                        if (isSidebarCollapsed) {
                            sidebar.classList.add('sidebar-collapsed');
                            mainContentArea.classList.add('content-area-expanded');
                        }
                    }
                }
            });
            
            // Navigation group toggle
            window.toggleNavGroup = function(groupId) {
                const group = document.getElementById(groupId + '-group');
                const chevron = document.getElementById(groupId + '-chevron');
                
                if (group && chevron) {
                    group.classList.toggle('hidden');
                    chevron.classList.toggle('rotate-180');
                }
            };
            
            // Load user task notifications
            loadUserTaskNotifications();
            
            // Refresh task notifications every 60 seconds
            setInterval(loadUserTaskNotifications, 60000);
        });
        
        // Function to load user task notifications
        function loadUserTaskNotifications() {
            fetch(`/api/tasks/user-notifications`)
                .then(response => response.json())
                .then(data => {
                    updateTaskBadges(data);
                })
                .catch(error => {
                    console.error('Error loading task notifications:', error);
                });
        }
        
        // Function to get priority class based on task data
        function getTaskBadgePriorityClass(data) {
            if (!data || !data.taskPriorities) return 'task-badge-normal';
            
            const priorities = data.taskPriorities;
            
            // Check for critical priority tasks (priority 5)
            if (priorities.critical > 0) return 'task-badge-critical';
            
            // Check for urgent priority tasks (priority 4)
            if (priorities.urgent > 0) return 'task-badge-urgent';
            
            // Check for high priority tasks (priority 3)
            if (priorities.high > 0) return 'task-badge-high';
            
            // Check for normal priority tasks (priority 2)
            if (priorities.normal > 0) return 'task-badge-normal';
            
            // Default to low priority (priority 1)
            return 'task-badge-low';
        }
        
        // Function to update task badges and notifications
        function updateTaskBadges(data) {
            // Update My Tasks badge
            const myTasksBadge = document.getElementById('my-tasks-badge');
            if (myTasksBadge && data && data.myTasksCount !== undefined) {
                myTasksBadge.textContent = data.myTasksCount;
                
                if (data.myTasksCount > 0) {
                    // Remove all existing priority classes
                    myTasksBadge.className = myTasksBadge.className.replace(/task-badge-\w+/g, '');
                    
                    // Add base task-badge class and priority-specific class
                    myTasksBadge.className = 'task-badge ml-auto ' + getTaskBadgePriorityClass(data);
                    myTasksBadge.style.display = 'inline';
                } else {
                    myTasksBadge.style.display = 'none';
                }
            }
            
            // Update notification count in top bar
            const notificationCount = document.getElementById('task-notification-count');
            if (notificationCount && data && data.urgentTasksCount !== undefined) {
                notificationCount.textContent = data.urgentTasksCount;
                notificationCount.style.display = data.urgentTasksCount > 0 ? 'flex' : 'none';
            }
        }
        
        // Quick tasks dropdown toggle
        document.addEventListener('click', function(e) {
            const quickTasksBtn = document.getElementById('quick-tasks-btn');
            const quickTasksDropdown = document.getElementById('quick-tasks-dropdown');
            
            if (quickTasksBtn && quickTasksBtn.contains(e.target)) {
                e.preventDefault();
                quickTasksDropdown.classList.toggle('hidden');
                
                // Load quick tasks content if not already loaded
                if (!quickTasksDropdown.dataset.loaded) {
                    fetch(`/api/tasks/quick-dropdown`)
                        .then(response => response.text())
                        .then(html => {
                            quickTasksDropdown.innerHTML = html;
                            quickTasksDropdown.dataset.loaded = 'true';
                        });
                }
            } else if (quickTasksDropdown && !quickTasksDropdown.contains(e.target)) {
                quickTasksDropdown.classList.add('hidden');
            }
        });
    </script>

    @if (isAuthenticated)
    {
        <!-- Session Management Script - Enhanced for Sidebar Layout -->
        <script>
            // Enhanced session timeout management with sidebar awareness
            (function() {
                let sessionTimeoutMinutes = 120; // 2 hours
                let warningTimeoutMinutes = 5; // 5 minutes warning
                let sessionTimeoutTimer;
                let warningTimer;
                let countdownTimer;

                function resetSessionTimeout() {
                    clearTimeout(sessionTimeoutTimer);
                    clearTimeout(warningTimer);
                    clearInterval(countdownTimer);
                    hideTimeoutWarning();

                    const warningTime = (sessionTimeoutMinutes - warningTimeoutMinutes) * 60 * 1000;
                    warningTimer = setTimeout(showTimeoutWarning, warningTime);
                    
                    sessionTimeoutTimer = setTimeout(() => {
                        window.location.href = '/Account/Logout';
                    }, sessionTimeoutMinutes * 60 * 1000);
                }

                function showTimeoutWarning() {
                    const warning = document.getElementById('session-timeout-warning');
                    if (warning) {
                        warning.style.display = 'block';
                        
                        let countdown = warningTimeoutMinutes * 60;
                        const countdownSpan = document.getElementById('timeout-countdown');
                        
                        countdownTimer = setInterval(() => {
                            if (countdown <= 0) {
                                clearInterval(countdownTimer);
                                window.location.href = '/Account/Logout';
                                return;
                            }
                            
                            const minutes = Math.floor(countdown / 60);
                            const seconds = countdown % 60;
                            if (countdownSpan) {
                                countdownSpan.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                            }
                            countdown--;
                        }, 1000);
                    }
                }

                function hideTimeoutWarning() {
                    const warning = document.getElementById('session-timeout-warning');
                    if (warning) {
                        warning.style.display = 'none';
                    }
                    clearInterval(countdownTimer);
                }

                window.performLogout = function() {
                    if (confirm('Are you sure you want to logout?')) {
                        clearTimeout(sessionTimeoutTimer);
                        clearTimeout(warningTimer);
                        clearInterval(countdownTimer);
                        window.location.href = '/Account/Logout';
                    }
                };

                window.extendSession = function() {
                    fetch('/Account/ExtendSession', { method: 'POST' })
                        .then(() => {
                            resetSessionTimeout();
                            hideTimeoutWarning();
                        })
                        .catch(() => {
                            window.location.href = '/Account/Login';
                        });
                };

                // Enhanced activity tracking with sidebar awareness
                let lastActivity = Date.now();
                function trackActivity() {
                    const now = Date.now();
                    if (now - lastActivity > 30000) {
                        lastActivity = now;
                        resetSessionTimeout();
                    }
                }

                ['click', 'keypress', 'scroll'].forEach(event => {
                    document.addEventListener(event, trackActivity, { passive: true });
                });

                resetSessionTimeout();
            })();
        </script>
    }

