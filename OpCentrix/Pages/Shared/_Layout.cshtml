@* Enhanced Sidebar Navigation for Option A: Stage-Aware Manufacturing Execution System *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpCentrix</title>
    
    @* Load master responsive CSS FIRST *@
    <link rel="stylesheet" href="~/css/responsive-master.css" asp-append-version="true" />
    
    @* Load OpCentrix styles *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stage-cohort-enhancements.css" asp-append-version="true" />
    
    @* Font Awesome for icons (including fas fa-calendar-plus) *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    @* Use Tailwind CDN only in development, production CSS in production *@
    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
    {
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            'opcentrix': {
                                'primary': '#3B82F6',
                                'secondary': '#6366F1',
                                'accent': '#10B981'
                            },
                            'stage': {
                                'sls': '#3B82F6',
                                'cnc': '#8B5CF6', 
                                'edm': '#EC4899',
                                'coating': '#F59E0B',
                                'qc': '#10B981',
                                'shipping': '#6366F1'
                            }
                        },
                        fontFamily: {
                            'sans': ['Inter', 'ui-sans-serif', 'system-ui']
                        }
                    }
                }
            }
        </script>
    }
    else
    {
        <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
    }
    
    @* Load Bootstrap LAST and only what we need *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    @* HTMX for dynamic content *@
    <script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
    
    @* Render Styles section *@
    @await RenderSectionAsync("Styles", required: false)
    
    <!-- Enhanced Dark Mode System - Responds to both system settings and user preference -->
    <script>
        // Dark mode initialization - Must run before page renders
        (function() {
            // Enhanced theme detection that respects both system and user preference
            const getTheme = () => {
                const stored = localStorage.getItem('theme');
                if (stored && (stored === 'dark' || stored === 'light')) {
                    return stored;
                }
                // Only fall back to system preference if no user preference is stored
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            };
            
            const setTheme = (theme) => {
                // Validate theme value
                if (theme !== 'dark' && theme !== 'light') {
                    theme = 'light';
                }
                
                localStorage.setItem('theme', theme);
                
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'light');
                }
                
                // Dispatch custom event for components that need to react to theme changes
                window.dispatchEvent(new CustomEvent('themeChanged', { 
                    detail: { theme } 
                }));
            };
            
            // Set initial theme
            setTheme(getTheme());
            
            // Enhanced system theme change listener - only applies if user hasn't manually set a preference
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                const userPreference = localStorage.getItem('theme');
                // Only auto-switch if user hasn't explicitly set a preference
                if (!userPreference) {
                    setTheme(e.matches ? 'dark' : 'light');
                }
            });
            
            // Enhanced theme toggle with user preference override
            window.toggleTheme = () => {
                const current = getTheme();
                const newTheme = current === 'dark' ? 'light' : 'dark';
                setTheme(newTheme);
                
                // Provide user feedback
                console.log(`Theme switched to ${newTheme} mode`);
            };
            
            // Get current theme state
            window.getCurrentTheme = getTheme;
            
            // Reset to system preference
            window.resetToSystemTheme = () => {
                localStorage.removeItem('theme');
                const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                setTheme(systemTheme);
            };
            
            // Force theme (for testing or admin controls)
            window.forceTheme = (theme) => {
                if (theme === 'dark' || theme === 'light') {
                    setTheme(theme);
                }
            };
        })();
    </script>
    
    <style>
        /* Enhanced Sidebar styles - Responds to both system and user preference */
        .sidebar {
            transition: transform 0.3s ease-in-out;
        }
        
        .sidebar-collapsed {
            transform: translateX(-16rem);
        }
        
        @@media (max-width: 768px) {
            .sidebar-mobile-hidden {
                transform: translateX(-100%);
            }
        }
        
        .content-area {
            margin-left: 16rem; /* 64 * 0.25rem = 16rem */
            transition: margin-left 0.3s ease-in-out;
        }
        
        .content-area-expanded {
            margin-left: 0;
        }
        
        @@media (max-width: 768px) {
            .content-area {
                margin-left: 0;
            }
        }
        
        /* Enhanced scrollbar - Class-based dark mode only */
        .sidebar::-webkit-scrollbar {
            width: 4px;
            transition: all 0.3s ease;
        }
        
        .sidebar::-webkit-scrollbar-track {
            background: #f1f5f9;
            transition: background 0.3s ease;
        }
        
        /* Class-based dark mode - NOT media query */
        :root.dark .sidebar::-webkit-scrollbar-track,
        html.dark .sidebar::-webkit-scrollbar-track {
            background: #1e293b;
        }
        
        .sidebar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 2px;
            transition: background 0.3s ease;
        }
        
        /* Class-based dark mode - NOT media query */
        :root.dark .sidebar::-webkit-scrollbar-thumb,
        html.dark .sidebar::-webkit-scrollbar-thumb {
            background: #475569;
        }
        
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        
        /* Class-based dark mode - NOT media query */
        :root.dark .sidebar::-webkit-scrollbar-thumb:hover,
        html.dark .sidebar::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        
        /* Enhanced theme indicator for debugging */
        .theme-indicator {
            position: fixed;
            top: 10px;
            right: 10px;
            padding: 4px 8px;
            background: rgba(0,0,0,0.7);
            color: white;
            border-radius: 4px;
            font-size: 10px;
            z-index: 9999;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        /* Show theme indicator in development mode */
        .debug-mode .theme-indicator {
            opacity: 1;
        }
        
        /* Enhanced body background with better transition support */
        body {
            background-color: #f9fafb;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        
        /* Class-based dark mode for body - ensures it responds to user preference */
        :root.dark body,
        html.dark body {
            background-color: #111827 !important;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 transition-colors duration-300" data-theme-responsive="true">
    @{
        var user = Context.User;
        var isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        var userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        var userName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "";
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString()?.TrimStart('/');
    }

    @if (isAuthenticated)
    {
        <!-- Sidebar Navigation -->
        <div id="sidebar" class="sidebar fixed inset-y-0 left-0 z-50 w-64 bg-white dark:bg-gray-800 shadow-lg border-r border-gray-200 dark:border-gray-700 overflow-y-auto transition-colors duration-300">
            <!-- Logo and Header -->
            <div class="sidebar-header flex items-center h-16 px-6 border-b border-gray-200 dark:border-gray-700 transition-colors duration-300">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-white dark:bg-gray-700 rounded-lg flex items-center justify-center mr-3 shadow-md">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 11.172V5l-1-1z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="text-lg font-bold text-white">OpCentrix</span>
                        </div>
                        <p class="text-xs text-blue-100 leading-none">Manufacturing Execution</p>
                    </div>
                </div>
            </div>

            <!-- User Info Card -->
            <div class="user-info-card p-4 border-b border-gray-200 dark:border-gray-700 transition-colors duration-300">
                <div class="flex items-center space-x-3">
                    <div class="user-avatar w-10 h-10 rounded-full flex items-center justify-center shadow-md">
                        <span class="text-white font-semibold text-sm">@(userName.FirstOrDefault())</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate transition-colors duration-300">@userName</p>
                        <p class="text-xs text-gray-600 dark:text-gray-400 transition-colors duration-300">@userRole</p>
                    </div>
                </div>
                
                <!-- Dark Mode Toggle -->
                <div class="mt-3 flex items-center justify-between">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Theme</span>
                    <button onclick="toggleTheme()" class="theme-toggle-btn p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200">
                        <svg class="w-4 h-4 text-gray-600 dark:text-gray-300 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <svg class="w-4 h-4 text-gray-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Collapse Button (visible only when sidebar is open on mobile) -->
            <div class="mobile-collapse-container md:hidden px-4 py-2 border-b border-gray-200 dark:border-gray-700 transition-colors duration-300">
                <button id="mobile-sidebar-close" class="mobile-collapse-btn w-full flex items-center justify-center px-3 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200">
                    <i class="fas fa-chevron-left mr-2"></i>
                    <span class="text-sm font-medium">Close Menu</span>
                </button>
            </div>

            <!-- Navigation Menu -->
            <nav class="flex-1 px-4 py-4 space-y-1">
                
                <!-- Dashboard -->
                <a href="/" class="nav-item @(currentPage == "" || currentPage == "Index" ? "nav-item-active" : "")">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Manufacturing Sections - Role-Based Access -->
                @if (userRole != "Admin" && userRole != "Manager")
                {
                    <!-- My Tasks for All Employees -->
                    <a href="/Tasks/MyTasks" class="nav-item @(currentPage?.Contains("Tasks/MyTasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-clipboard-list"></i>
                        <span>My Tasks</span>
                        <span id="my-tasks-badge" class="task-badge bg-blue-500 text-white text-xs px-2 py-0.5 rounded-full ml-auto">0</span>
                    </a>

                    @if (userRole == "PrintingSpecialist" || userRole == "Operator")
                    {
                        <a href="/PrintTracking" class="nav-item @(currentPage?.Contains("PrintTracking") == true ? "nav-item-active" : "")">
                            <i class="fas fa-cube text-blue-500"></i>
                            <span>SLS Printing</span>
                        </a>
                    }

                    @if (userRole == "EDMSpecialist" || userRole == "Operator")
                    {
                        <a href="/EDM" class="nav-item @(currentPage?.Contains("EDM") == true ? "nav-item-active" : "")">
                            <i class="fas fa-bolt text-pink-500"></i>
                            <span>EDM Operations</span>
                        </a>
                    }

                    @if (userRole == "CoatingSpecialist" || userRole == "Operator")
                    {
                        <a href="/Coating" class="nav-item @(currentPage?.Contains("Coating") == true ? "nav-item-active" : "")">
                            <i class="fas fa-paint-brush text-orange-500"></i>
                            <span>Coating</span>
                        </a>
                    }

                    @if (userRole == "QualityInspector" || userRole == "QCSpecialist" || userRole == "Operator")
                    {
                        <a href="/QC" class="nav-item @(currentPage?.Contains("QC") == true ? "nav-item-active" : "")">
                            <i class="fas fa-check-circle text-green-500"></i>
                            <span>Quality Control</span>
                        </a>
                    }

                    @if (userRole == "ShippingSpecialist" || userRole == "Operator")
                    {
                        <a href="/Shipping" class="nav-item @(currentPage?.Contains("Shipping") == true ? "nav-item-active" : "")">
                            <i class="fas fa-truck text-indigo-500"></i>
                            <span>Shipping</span>
                        </a>
                    }

                    @if (userRole == "BTSpecialist")
                    {
                        <a href="/BT/Dashboard" class="nav-item">
                            <i class="fas fa-chart-pie text-amber-500"></i>
                            <span>B&T Operations</span>
                        </a>
                        <a href="/BT/SerialNumbers" class="nav-item">
                            <i class="fas fa-barcode text-amber-500"></i>
                            <span>Serial Numbers</span>
                        </a>
                        <a href="/BT/Compliance" class="nav-item">
                            <i class="fas fa-shield-alt text-amber-500"></i>
                            <span>Compliance</span>
                        </a>
                    }
                }

                @* Management & Admin Sections *@
                @if (userRole is "Admin" or "Manager" or "Supervisor")
                {
                    <!-- My Tasks for Management -->
                    <a href="/Tasks/MyTasks" class="nav-item @(currentPage?.Contains("Tasks/MyTasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-clipboard-list"></i>
                        <span>My Tasks</span>
                        <span id="my-tasks-badge" class="task-badge bg-blue-500 text-white text-xs px-2 py-0.5 rounded-full ml-auto">0</span>
                    </a>

                    <!-- Scheduling -->
                    <a href="/Scheduler" class="nav-item @(currentPage?.Contains("Scheduler") == true ? "nav-item-active" : "")">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Production Scheduler</span>
                    </a>

                    <!-- Production Areas - Condensed -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('production')">
                            <i class="fas fa-cogs"></i>
                            <span>Production Areas</span>
                            <i class="fas fa-chevron-down nav-chevron" id="production-chevron"></i>
                        </button>
                        <div id="production-group" class="nav-group-content hidden">
                            <a href="/PrintTracking" class="nav-subitem @(currentPage?.Contains("PrintTracking") == true ? "nav-item-active" : "")">
                                <i class="fas fa-cube text-blue-500"></i>
                                <span>SLS Printing</span>
                            </a>
                            <a href="/EDM" class="nav-subitem @(currentPage?.Contains("EDM") == true ? "nav-item-active" : "")">
                                <i class="fas fa-bolt text-pink-500"></i>
                                <span>EDM Operations</span>
                            </a>
                            <a href="/Coating" class="nav-subitem @(currentPage?.Contains("Coating") == true ? "nav-item-active" : "")">
                                <i class="fas fa-paint-brush text-orange-500"></i>
                                <span>Coating</span>
                            </a>
                            <a href="/QC" class="nav-subitem @(currentPage?.Contains("QC") == true ? "nav-item-active" : "")">
                                <i class="fas fa-check-circle text-green-500"></i>
                                <span>Quality Control</span>
                            </a>
                            <a href="/Shipping" class="nav-subitem @(currentPage?.Contains("Shipping") == true ? "nav-item-active" : "")">
                                <i class="fas fa-truck text-indigo-500"></i>
                                <span>Shipping</span>
                            </a>
                        </div>
                    </div>

                    <!-- Team Management -->
                    <a href="/CRM/Tasks" class="nav-item @(currentPage?.Contains("CRM/Tasks") == true ? "nav-item-active" : "")">
                        <i class="fas fa-tasks"></i>
                        <span>Team Tasks</span>
                    </a>

                    <a href="/CRM/Tasks/Create" class="nav-item">
                        <i class="fas fa-plus-circle"></i>
                        <span>Assign Tasks</span>
                    </a>

                    <div class="nav-group">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('clients')">
                            <i class="fas fa-handshake"></i>
                            <span>Client Relations</span>
                            <i class="fas fa-chevron-down nav-chevron" id="clients-chevron"></i>
                        </button>
                        <div id="clients-group" class="nav-group-content hidden">
                            <a href="/CRM/Accounts" class="nav-subitem">
                                <i class="fas fa-building"></i>
                                <span>Accounts</span>
                            </a>
                            <a href="/CRM/Contacts" class="nav-subitem">
                                <i class="fas fa-address-book"></i>
                                <span>Contacts</span>
                            </a>
                        </div>
                    </div>

                    <!-- B&T Manufacturing Section -->
                    @if (userRole == "Admin" || userRole == "Manager")
                    {
                        <a href="/BT/Dashboard" class="nav-item">
                            <i class="fas fa-chart-pie text-amber-500"></i>
                            <span>B&T Operations</span>
                        </a>
                        
                        <div class="nav-group">
                            <button class="nav-group-toggle" onclick="toggleNavGroup('bt-details')">
                                <i class="fas fa-cog"></i>
                                <span>B&T Details</span>
                                <i class="fas fa-chevron-down nav-chevron" id="bt-details-chevron"></i>
                            </button>
                            <div id="bt-details-group" class="nav-group-content hidden">
                                <a href="/BT/SerialNumbers" class="nav-subitem">
                                    <i class="fas fa-barcode"></i>
                                    <span>Serial Numbers</span>
                                </a>
                                <a href="/BT/Compliance" class="nav-subitem">
                                    <i class="fas fa-shield-alt"></i>
                                    <span>Compliance</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Admin Access -->
                    @if (userRole == "Admin")
                    {
                        <a href="/Admin" class="nav-item @(currentPage?.Contains("Admin") == true ? "nav-item-active" : "")">
                            <i class="fas fa-tools text-red-500"></i>
                            <span>Admin Panel</span>
                        </a>
                    }
                }
            </nav>

            <!-- Footer Actions -->
            <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700 transition-colors duration-300">
                <button onclick="performLogout()" class="logout-btn w-full text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center justify-center">
                    <i class="fas fa-sign-out-alt mr-2"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Mobile overlay -->
        <div id="sidebar-overlay" class="fixed inset-0 bg-black opacity-0 pointer-events-none transition-opacity duration-300 md:hidden z-40"></div>
    }

    <!-- Top Bar for Mobile and Sidebar Toggle -->
    <div class="@(isAuthenticated ? "content-area" : "")" id="main-content-area">
        @if (isAuthenticated)
        {
            <!-- Top bar -->
            <div class="sticky top-0 z-40 bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700 transition-colors duration-300">
                <div class="flex items-center justify-between h-14 px-4">
                    <button id="sidebar-toggle" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 md:hidden transition-colors duration-200">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    
                    <div class="hidden md:flex items-center">
                        <button id="sidebar-collapse" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 mr-4 transition-colors duration-200">
                            <i class="fas fa-angle-double-left text-lg"></i>
                        </button>
                        <h1 class="text-lg font-semibold text-gray-900 dark:text-gray-100 transition-colors duration-300">@ViewData["Title"]</h1>
                    </div>
                    
                    <!-- Page title for mobile -->
                    <h1 class="text-lg font-semibold text-gray-900 dark:text-gray-100 md:hidden transition-colors duration-300">@ViewData["Title"]</h1>
                    
                    <!-- Right side actions -->
                    <div class="flex items-center space-x-3">
                        @if (userRole != "Admin" && userRole != "Manager")
                        {
                            <!-- Quick Task Notifications for Employees - Clean Bell Icon -->
                            <div class="relative" id="quick-tasks-container">
                                <div class="relative cursor-pointer text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors duration-200" 
                                     id="quick-tasks-bell" 
                                     onclick="toggleQuickTasksDropdown()">
                                    <i class="fas fa-bell text-lg"></i>
                                    <span id="task-notification-count" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center hidden">0</span>
                                </div>
                                
                                <!-- Quick task dropdown will be populated via HTMX -->
                                <div id="quick-tasks-dropdown" class="absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 hidden transition-colors duration-300">
                                    <!-- Content loaded dynamically -->
                                </div>
                            </div>
                        }
                        
                        <!-- User menu -->
                        <div class="flex items-center text-sm text-gray-600 dark:text-gray-400 transition-colors duration-300">
                            <span class="hidden sm:block">@userName</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Session Timeout Warning -->
        <div id="session-timeout-warning" class="session-timeout-warning">
            <div class="max-w-7xl mx-auto px-4 flex items-center justify-center space-x-4">
                <div class="flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span id="timeout-message">Your session will expire in <span id="timeout-countdown">5</span> minutes</span>
                </div>
